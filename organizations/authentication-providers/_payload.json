4],{"title":231,"path":232,"stem":233,"icon":234},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":236,"path":237,"stem":238,"icon":239},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":241,"path":242,"stem":243,"icon":178},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":245,"path":246,"stem":247,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":249,"path":250,"stem":251,"icon":252},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":254,"path":255,"stem":256,"icon":257},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":259,"path":260,"stem":261,"icon":262},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":264,"title":265,"body":266,"description":339,"extension":340,"links":341,"meta":342,"navigation":343,"path":31,"seo":344,"stem":32,"__hash__":345},"docs\u002F02.organizations\u002F02.authentication-providers.md","Authentication Providers",{"type":267,"value":268,"toc":333},"minimark",[269,278,286,297,302,305,318,321,325],[270,271,272,273,277],"p",{},"An ",[274,275,276],"strong",{},"authentication provider"," is an identity provider, such as Okta or a Microsoft Entra ID directory, that your organization's members use to sign in to the Kinotic portal.",[270,279,280,281,285],{},"Google is included with every Kinotic server. Okta and Microsoft Entra ID through your organization's own client are ",[282,283,284],"a",{"href":260},"Enterprise Features",", whether your organization offers them at its own login, an application's login or a tenant's login. An application's login can still offer Microsoft through Kinotic's managed registration without them.",[270,287,288,289,292,293,296],{},"You add providers in the Kinotic portal under ",[274,290,291],{},"Organization settings > Authentication providers",". Each provider is offered on your organization's login page once its ",[274,294,295],{},"callback URL"," is registered at the provider.",[298,299,301],"h2",{"id":300},"setup-order","Setup order",[270,303,304],{},"Every provider follows the same order:",[306,307,308,312,315],"ol",{},[309,310,311],"li",{},"Create an application (client) registration at the provider and note its client ID and secret.",[309,313,314],{},"Add the provider in Kinotic. Kinotic creates the configuration and shows its exact callback URL.",[309,316,317],{},"Register that callback URL as a redirect URI at the provider.",[270,319,320],{},"The callback URL contains the configuration's id, which is only created when you first save the provider in Kinotic. That is why the provider registration is created first with a placeholder redirect URI and updated afterwards.",[298,322,324],{"id":323},"guides","Guides",[326,327,328],"ul",{},[309,329,330],{},[282,331,332],{"href":36},"Okta SSO setup",{"title":334,"searchDepth":335,"depth":335,"links":336},"",2,[337,338],{"id":300,"depth":335,"text":301},{"id":323,"depth":335,"text":324},"Let your organization's members sign in to the Kinotic portal with your own identity provider.","md",null,{},{"title":30,"icon":33},{"title":265,"description":339},"Y0SXDSSX7QtOCc7ty8aWQO_h-QMjk6_Qq--jTahoo5A",[347,349],{"title":26,"path":27,"stem":28,"description":348,"icon":21,"children":-1},"Set up a Kinotic organization -- its members, how they sign in, and the Apps it builds.",{"title":35,"path":36,"stem":37,"description":350,"icon":38,"children":-1},"Configure Okta as a single sign-on provider for your Kinotic organization.",1794294076406]