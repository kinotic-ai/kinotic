},"In the Okta Admin Console, go to ",[278,322,323],{},"Applications > Applications"," and click ",[278,326,327],{},"Create App Integration",[294,329,330,331,334,335,338,339,342,343,281],{},"Select the ",[278,332,333],{},"Classic experience"," tab, choose ",[278,336,337],{},"OIDC - OpenID Connect"," as the sign-in method, and ",[278,340,341],{},"Web Application"," as the application type. Click ",[278,344,345],{},"Next",[274,347,348],{},[349,350],"img",{"alt":351,"src":352},"Create app integration dialog","\u002Fimages\u002Fdocs\u002Fokta\u002F01-create-app-integration.png",[274,354,355],{},[349,356],{"alt":357,"src":358},"OIDC - OpenID Connect and Web Application selected","\u002Fimages\u002Fdocs\u002Fokta\u002F02-oidc-web-application.png",[316,360,362],{"start":361},3,[294,363,364,365,368,369,372,373,376,377,281],{},"Enter an ",[278,366,367],{},"App integration name",", for example ",[302,370,371],{},"Kinotic",", and under ",[278,374,375],{},"Client definition"," choose ",[278,378,379],{},"Use Okta-generated client ID",[274,381,382],{},[349,383],{"alt":367,"src":384},"\u002Fimages\u002Fdocs\u002Fokta\u002F03-app-name.png",[316,386,388,399],{"start":387},4,[294,389,390,391,394,395,398],{},"Under ",[278,392,393],{},"Grant type",", keep ",[278,396,397],{},"Authorization Code"," checked.",[294,400,401,402,405,406,409],{},"Leave ",[278,403,404],{},"Sign-in redirect URIs"," as Okta's placeholder (",[302,407,408],{},"http:\u002F\u002Flocalhost:8080\u002Fauthorization-code\u002Fcallback",") for now. You will replace it with Kinotic's callback URL in step 4.",[274,411,412],{},[349,413],{"alt":414,"src":415},"Grant type and redirect URIs","\u002Fimages\u002Fdocs\u002Fokta\u002F04-grant-type-redirect-uris.png",[316,417,419],{"start":418},6,[294,420,390,421,424,425,428,429,432,433,281],{},[278,422,423],{},"Assignments",", choose ",[278,426,427],{},"Allow everyone in your organization to access",", or ",[278,430,431],{},"Limit access to selected groups"," to restrict who can sign in. Click ",[278,434,435],{},"Save",[274,437,438],{},[349,439],{"alt":423,"src":440},"\u002Fimages\u002Fdocs\u002Fokta\u002F05-assignments.png",[286,442,444],{"id":443},"_2-copy-the-client-credentials","2. Copy the client credentials",[274,446,447,448,451,452,455],{},"On the saved app's ",[278,449,450],{},"General"," tab, find ",[278,453,454],{},"Client Credentials",":",[291,457,458,464],{},[294,459,460,461,281],{},"Copy the ",[278,462,463],{},"Client ID",[294,465,390,466,469],{},[278,467,468],{},"Client Secrets",", use the copy button to copy the secret.",[274,471,472],{},[349,473],{"alt":474,"src":475},"Client credentials","\u002Fimages\u002Fdocs\u002Fokta\u002F06-client-credentials.png",[477,478,480],"alert",{"type":479},"warning","Treat the client secret like a password. Paste it directly into Kinotic; don't share it in chat or screenshots.",[286,482,484],{"id":483},"_3-add-the-provider-in-kinotic","3. Add the provider in Kinotic",[316,486,487],{},[294,488,489,490,493,494,497,498,281],{},"In the Kinotic portal, open ",[278,491,492],{},"Organization settings"," and select the ",[278,495,496],{},"Authentication providers"," tab. Click ",[278,499,500],{},"Add provider",[274,502,503],{},[349,504],{"alt":505,"src":506},"Authentication providers tab","\u002Fimages\u002Fdocs\u002Fokta\u002F07-kinotic-providers-empty.png",[316,508,510],{"start":509},2,[294,511,512],{},"Fill in the form:",[514,515,516,529],"table",{},[517,518,519],"thead",{},[520,521,522,526],"tr",{},[523,524,525],"th",{},"Field",[523,527,528],{},"Value",[530,531,532,545,557,575,584,594,604,614],"tbody",{},[520,533,534,540],{},[535,536,537],"td",{},[278,538,539],{},"Provider",[535,541,542],{},[302,543,544],{},"Okta",[520,546,547,552],{},[535,548,549],{},[278,550,551],{},"Display name",[535,553,554,555],{},"The text on the login button, for example ",[302,556,544],{},[520,558,559,564],{},[535,560,561],{},[278,562,563],{},"Okta domain",[535,565,566,567,570,571,574],{},"Your Okta org domain, for example ",[302,568,569],{},"yourorg.okta.com"," -- no ",[302,572,573],{},"https:\u002F\u002F"," and no path",[520,576,577,581],{},[535,578,579],{},[278,580,463],{},[535,582,583],{},"The client ID from Okta",[520,585,586,591],{},[535,587,588],{},[278,589,590],{},"Client secret",[535,592,593],{},"The client secret from Okta",[520,595,596,601],{},[535,597,598],{},[278,599,600],{},"Public client (no secret)",[535,602,603],{},"Leave unchecked. Check it only for a public client that has no secret",[520,605,606,611],{},[535,607,608],{},[278,609,610],{},"Enabled",[535,612,613],{},"On, so the login page offers this provider",[520,615,616,621],{},[535,617,618],{},[278,619,620],{},"Advanced > Audience",[535,622,623,624,627],{},"Optional. Set it only when the ",[302,625,626],{},"aud"," claim of Okta's tokens is not the client ID",[274,629,630],{},[349,631],{"alt":632,"src":633},"Add provider form","\u002Fimages\u002Fdocs\u002Fokta\u002F08-kinotic-add-provider.png",[274,635,636],{},[349,637],{"alt":638,"src":639},"Advanced section with Audience","\u002Fimages\u002Fdocs\u002Fokta\u002F09-kinotic-add-provider-advanced.png",[316,641,642],{"start":361},[294,643,644,645,281],{},"Click ",[278,646,500],{},[274,648,649],{},"Kinotic creates the configuration and the drawer shows two URLs, each with a copy button:",[291,651,652,661],{},[294,653,654,657,658],{},[278,655,656],{},"Callback URL"," -- ",[302,659,660],{},"https:\u002F\u002F\u003Capi-host>\u002Fapi\u002Fauth\u002Forg\u002Flogin\u002Fsso\u002Fcallback\u002F\u003Cconfig-id>",[294,662,663,657,666,669],{},[278,664,665],{},"Direct sign-in link",[302,667,668],{},"https:\u002F\u002F\u003Capi-host>\u002Fapi\u002Fauth\u002Forg\u002Flogin\u002F\u003Corg>\u002Fstart\u002F\u003Cconfig-id>",", useful for a tile in Okta's app launcher.",[274,671,460,672,281],{},[278,673,656],{},[274,675,676],{},[349,677],{"alt":678,"src":679},"Provider added with callback URL","\u002Fimages\u002Fdocs\u002Fokta\u002F10-kinotic-callback-url.png",[477,681,683,684,281],