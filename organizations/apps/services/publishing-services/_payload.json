ass":310},[300,1452,1453],{"class":413},"deviceId",[300,1455,417],{"class":310},[300,1457,420],{"class":397},[300,1459,1460],{"class":310},")",[300,1462,401],{"class":310},[300,1464,1465,1468,1470,1473],{"class":302,"line":517},[300,1466,1467],{"class":310},"        this.",[300,1469,1453],{"class":314},[300,1471,1472],{"class":310}," =",[300,1474,1475],{"class":314}," deviceId\n",[300,1477,1479],{"class":302,"line":1478},14,[300,1480,459],{"class":310},[300,1482,1484],{"class":302,"line":1483},15,[300,1485,344],{"emptyLinePlaceholder":343},[300,1487,1489,1492,1494,1496],{"class":302,"line":1488},16,[300,1490,1491],{"class":407},"    getStatus",[300,1493,1421],{"class":310},[300,1495,420],{"class":397},[300,1497,401],{"class":310},[300,1499,1501,1503,1505,1508,1510,1513,1515],{"class":302,"line":1500},17,[300,1502,433],{"class":306},[300,1504,436],{"class":310},[300,1506,1507],{"class":333},"Status for device ",[300,1509,442],{"class":310},[300,1511,1512],{"class":310},"this.",[300,1514,1453],{"class":314},[300,1516,1517],{"class":310},"}`\n",[300,1519,1521],{"class":302,"line":1520},18,[300,1522,459],{"class":310},[300,1524,1526],{"class":302,"line":1525},19,[300,1527,520],{"class":310},[274,1529,1530,1531,1534,1535,1537],{},"When a caller targets a specific scope (e.g., ",[278,1532,1533],{},"device-42","), the platform routes the request to the instance whose ",[278,1536,1453],{}," matches.",[1176,1539,1541],{"id":1540},"context","@Context",[274,1543,1544,1545,1548,1549,1552,1553,1556],{},"A method decorator that marks a method as receiving the request context: a ",[278,1546,1547],{},"ServiceContext"," carrying the calling participant — the same caller a Java service receives as its ",[278,1550,1551],{},"Participant"," parameter — plus whatever a registered ",[278,1554,1555],{},"ContextInterceptor"," adds.",[274,1558,1559,1563],{},[1560,1561,1562],"strong",{},"The context parameter must be the method's final parameter."," Callers never pass it — the platform appends it after the caller-supplied arguments.",[291,1565,1567],{"className":293,"code":1566,"language":295,"meta":296,"style":296},"import { Publish, Context, type ServiceContext } from '@kinotic-ai\u002Fcore'\nimport { isOrganizationParticipant, requireParticipant } from '@kinotic-ai\u002Fmanagement-api'\n\n@Publish('com.example')\nclass OrderService {\n    @Context\n    async listOrders(status: string, context: ServiceContext): Promise\u003COrder[]> {\n        const caller = requireParticipant(context.participant, isOrganizationParticipant)\n        return this.orders.findByOrganization(caller.organizationId, status)\n    }\n}\n",[278,1568,1569,1599,1623,1627,1643,1651,1658,1703,1730,1760,1764],{"__ignoreMap":296},[300,1570,1571,1573,1575,1577,1579,1582,1584,1586,1589,1591,1593,1595,1597],{"class":302,"line":303},[300,1572,307],{"class":306},[300,1574,311],{"class":310},[300,1576,315],{"class":314},[300,1578,318],{"class":310},[300,1580,1581],{"class":314}," Context",[300,1583,318],{"class":310},[300,1585,838],{"class":306},[300,1587,1588],{"class":314}," ServiceContext",[300,1590,324],{"class":310},[300,1592,327],{"class":306},[300,1594,330],{"class":310},[300,1596,334],{"class":333},[300,1598,337],{"class":310},[300,1600,1601,1603,1605,1608,1610,1613,1615,1617,1619,1621],{"class":302,"line":340},[300,1602,307],{"class":306},[300,1604,311],{"class":310},[300,1606,1607],{"class":314}," isOrganizationParticipant",[300,1609,318],{"class":310},[300,1611,1612],{"class":314}," requireParticipant",[300,1614,324],{"class":310},[300,1616,327],{"class":306},[300,1618,330],{"class":310},[300,1620,594],{"class":333},[300,1622,337],{"class":310},[300,1624,1625],{"class":302,"line":347},[300,1626,344],{"emptyLinePlaceholder":343},[300,1628,1629,1631,1633,1635,1637,1639,1641],{"class":302,"line":371},[300,1630,350],{"class":310},[300,1632,376],{"class":353},[300,1634,357],{"class":314},[300,1636,360],{"class":310},[300,1638,383],{"class":333},[300,1640,360],{"class":310},[300,1642,368],{"class":314},[300,1644,1645,1647,1649],{"class":302,"line":390},[300,1646,394],{"class":393},[300,1648,698],{"class":397},[300,1650,401],{"class":310},[300,1652,1653,1655],{"class":302,"line":404},[300,1654,1407],{"class":310},[300,1656,1657],{"class":314},"Context\n",[300,1659,1660,1663,1666,1668,1671,1673,1675,1677,1680,1682,1684,1686,1689,1692,1695,1698,1701],{"class":302,"line":430},[300,1661,1662],{"class":393},"    async",[300,1664,1665],{"class":407}," listOrders",[300,1667,357],{"class":310},[300,1669,1670],{"class":413},"status",[300,1672,417],{"class":310},[300,1674,420],{"class":397},[300,1676,318],{"class":310},[300,1678,1679],{"class":413}," context",[300,1681,417],{"class":310},[300,1683,1588],{"class":397},[300,1685,423],{"class":310},[300,1687,1688],{"class":397}," Promise",[300,1690,1691],{"class":310},"\u003C",[300,1693,1694],{"class":397},"Order",[300,1696,1697],{"class":314},"[]",[300,1699,1700],{"class":310},">",[300,1702,401],{"class":310},[300,1704,1705,1708,1711,1713,1715,1717,1719,1721,1724,1726,1728],{"class":302,"line":456},[300,1706,1707],{"class":393},"        const",[300,1709,1710],{"class":314}," caller",[300,1712,1472],{"class":310},[300,1714,1612],{"class":353},[300,1716,357],{"class":407},[300,1718,1540],{"class":314},[300,1720,631],{"class":310},[300,1722,1723],{"class":314},"participant",[300,1725,318],{"class":310},[300,1727,1607],{"class":314},[300,1729,368],{"class":407},[300,1731,1732,1734,1736,1739,1741,1744,1746,1749,1751,1753,1755,1758],{"class":302,"line":462},[300,1733,433],{"class":306},[300,1735,1432],{"class":310},[300,1737,1738],{"class":314},"orders",[300,1740,631],{"class":310},[300,1742,1743],{"class":353},"findByOrganization",[300,1745,357],{"class":407},[300,1747,1748],{"class":314},"caller",[300,1750,631],{"class":310},[300,1752,647],{"class":314},[300,1754,318],{"class":310},[300,1756,1757],{"class":314}," status",[300,1759,368],{"class":407},[300,1761,1762],{"class":302,"line":467},[300,1763,459],{"class":310},[300,1765,1766],{"class":302,"line":498},[300,1767,520],{"class":310},[274,1769,1770,1773,1774,1207,1777,1207,1779,1782],{},[278,1771,1772],{},"context.participant"," is the participant the gateway authenticated on the calling connection, serialized with its scope discriminator and ids (",[278,1775,1776],{},"type",[278,1778,647],{},[278,1780,1781],{},"applicationId","). It is absent only for an invocation that originated inside the platform with no participant bound, such as a scheduled job.",[274,1784,1785,1788,1789,1792,1793,1207,1796,1799,1800,1803,1804,1807],{},[278,1786,1787],{},"requireParticipant"," is the counterpart of a Java service's ",[278,1790,1791],{},"securityContext.requireParticipant(OrganizationParticipant.class)",": it returns the participant narrowed by the guard you pass (",[278,1794,1795],{},"isSystemParticipant",[278,1797,1798],{},"isOrganizationParticipant",", or ",[278,1801,1802],{},"isApplicationParticipant","), throws if the invocation carries no participant, and fails the invocation with an ",[278,1805,1806],{},"AuthorizationException"," — the same name a Java refusal carries — when the caller does not hold that scope. The guards alone narrow without throwing, for a method that serves more than one scope.",[274,1809,1189,1810,1812,1813,1816],{},[278,1811,1555],{}," registered through ",[278,1814,1815],{},"Kinotic.serviceRegistry.registerContextInterceptor(...)"," receives the context with the participant already set and returns the context the method sees, so it can add data derived from the caller or from the request headers:",[291,1818,1820],{"className":293,"code":1819,"language":295,"meta":296,"style":296},"Kinotic.serviceRegistry.registerContextInterceptor({\n    async intercept(event, context) {\n        return { ...context, tenant: await tenants.forParticipant(context.participant) }\n    }\n})\n",[278,1821,1822,1840,1860,1901,1905],{"__ignoreMap":296},[300,1823,1824,1826,1828,1830,1832,1835,1837],{"class":302,"line":303},[30