stem":252,"icon":36},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","03.platform\u002F12.reference\u002F04.sign-in-design",{"title":254,"path":255,"stem":256,"icon":257},"Development Server","\u002Fplatform\u002Fdevelopment-server","03.platform\u002F13.development-server","i-lucide-server-cog",{"title":259,"path":260,"stem":261,"icon":262},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","03.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":264,"path":265,"stem":266,"icon":267},"Enterprise License","\u002Fplatform\u002Fenterprise-license","03.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":269,"title":141,"body":270,"description":399,"extension":400,"links":401,"meta":402,"navigation":403,"path":142,"seo":404,"stem":143,"__hash__":405},"docs\u002F02.organizations\u002F03.apps\u002F05.deployment\u002F01.workflow.md",{"type":271,"value":272,"toc":387},"minimark",[273,277,281,288,292,295,317,321,324,329,332,346,350,353,367,371,374],[274,275,31],"h2",{"id":276},"overview",[278,279,280],"p",{},"Kinotic provides a built-in deployment pipeline that takes your application from development through staging to production. The pipeline is designed around feature-based development with isolated environments and security-first build processes.",[278,282,283,287],{},[284,285,286],"strong",{},"Pipeline stages:"," Development -> Staging -> Production",[274,289,291],{"id":290},"development","Development",[278,293,294],{},"The development stage is optimized for rapid iteration:",[296,297,298,305,311],"ul",{},[299,300,301,304],"li",{},[284,302,303],{},"Feature isolation"," — Each feature branch gets its own development pod, so developers can test changes without affecting others.",[299,306,307,310],{},[284,308,309],{},"Automatic deployment"," — Changes deploy as code is saved, providing immediate feedback during development.",[299,312,313,316],{},[284,314,315],{},"Firecracker VM isolation"," — Builds execute in isolated Firecracker VMs for both speed and security. Each build runs in its own lightweight VM, preventing untrusted code from affecting the host or other builds.",[274,318,320],{"id":319},"staging","Staging",[278,322,323],{},"The staging environment acts as a gate between development and production. It operates in two phases:",[325,326,328],"h3",{"id":327},"pre-merge-checks","Pre-Merge Checks",[278,330,331],{},"Before a feature branch is merged, the staging environment runs:",[296,333,334,340],{},[299,335,336,339],{},[284,337,338],{},"Vulnerability scanning"," — Automated security checks on dependencies and application code.",[299,341,342,345],{},[284,343,344],{},"Migration execution tests"," — Migration scripts are executed against a staging data store to verify they run correctly before reaching production.",[325,347,349],{"id":348},"post-merge","Post-Merge",[278,351,352],{},"After a feature branch is merged:",[296,354,355,361],{},[299,356,357,360],{},[284,358,359],{},"Full application build"," — The complete application is built and deployed to the staging environment.",[299,362,363,366],{},[284,364,365],{},"Human-in-the-loop approval"," — A team member reviews the staging deployment and explicitly approves promotion to production. No automatic promotion occurs.",[274,368,370],{"id":369},"production","Production",[278,372,373],{},"Production deployment happens only after staging approval:",[296,375,376,381],{},[299,377,378,380],{},[284,379,359],{}," — All projects within the application are built and deployed together.",[299,382,383,386],{},[284,384,385],{},"Deployed after approval"," — The production environment is updated only when a team member has reviewed and approved the staging deployment.",{"title":388,"searchDepth":389,"depth":389,"links":390},"",2,[391,392,393,398],{"id":276,"depth":389,"text":31},{"id":290,"depth":389,"text":291},{"id":319,"depth":389,"text":320,"children":394},[395,397],{"id":327,"depth":396,"text":328},3,{"id":348,"depth":396,"text":349},{"id":369,"depth":389,"text":370},"The Kinotic deployment pipeline from development to production.","md",null,{},{"icon":144},{"title":141,"description":399},"6HG-oXEsZAEv8c8yen3fyLHXJx3lkuThfkLPYcDlwao",[407,409],{"title":131,"path":132,"stem":133,"description":408,"icon":36,"children":-1},"Authentication methods and identity management in Kinotic.",{"title":146,"path":147,"stem":148,"description":410,"icon":149,"children":-1},"Development, staging, and production environment configuration.",1792930939714]