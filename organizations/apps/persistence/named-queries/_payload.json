0,"path":251,"stem":252,"icon":36},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","03.platform\u002F12.reference\u002F04.sign-in-design",{"title":254,"path":255,"stem":256,"icon":257},"Development Server","\u002Fplatform\u002Fdevelopment-server","03.platform\u002F13.development-server","i-lucide-server-cog",{"title":259,"path":260,"stem":261,"icon":262},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","03.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":264,"path":265,"stem":266,"icon":267},"Enterprise License","\u002Fplatform\u002Fenterprise-license","03.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":269,"title":114,"body":270,"description":1096,"extension":1097,"links":1098,"meta":1099,"navigation":378,"path":115,"seo":1100,"stem":116,"__hash__":1101},"docs\u002F02.organizations\u002F03.apps\u002F03.persistence\u002F05.named-queries.md",{"type":271,"value":272,"toc":1085},"minimark",[273,282,285,290,317,321,331,625,631,634,638,680,684,699,739,743,754,782,786,850,854,875,879,891,1073,1081],[274,275,276,277,281],"p",{},"Named queries let you define custom query methods on your repositories. You declare methods with the ",[278,279,280],"code",{},"@Query"," decorator, sync them with the server, and the CLI generates the implementation.",[274,283,284],{},"A named query belongs to the entity of its repository and acts on that entity alone: the statement names that entity, and a statement that names any other entity fails.",[286,287,289],"h2",{"id":288},"workflow","Workflow",[291,292,293,301,307],"ol",{},[294,295,296,297,300],"li",{},"Run ",[278,298,299],{},"kinotic sync"," to sync your entities and generate the base repository classes",[294,302,303,304,306],{},"Add custom methods with the ",[278,305,280],{}," decorator to the generated repository class",[294,308,296,309,312,313,316],{},[278,310,311],{},"kinotic generate"," to regenerate the repository with your query implementations (",[278,314,315],{},"generate"," runs locally without syncing to the server)",[286,318,320],{"id":319},"defining-named-queries","Defining Named Queries",[274,322,323,324,326,327,330],{},"Add methods with the ",[278,325,280],{}," decorator to your repository class. Use ",[278,328,329],{},":paramName"," syntax for parameter binding; each parameter takes the method argument of the same name.",[332,333,338],"pre",{"className":334,"code":335,"language":336,"meta":337,"style":337},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100')\n    findByStatus(status: string): Promise\u003COrder[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('UPDATE Order SET status = :status WHERE id = :id WITH REFRESH')\n    updateStatus(id: string, status: string): Promise\u003CWriteCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[278,339,340,373,380,403,408,432,471,478,484,489,507,547,552,557,562,580,609,614,619],{"__ignoreMap":337},[341,342,345,349,353,357,360,363,366,370],"span",{"class":343,"line":344},"line",1,[341,346,348],{"class":347},"s7zQu","import",[341,350,352],{"class":351},"sMK4o"," {",[341,354,356],{"class":355},"sTEyZ"," Query",[341,358,359],{"class":351}," }",[341,361,362],{"class":347}," from",[341,364,365],{"class":351}," '",[341,367,369],{"class":368},"sfazB","@kinotic-ai\u002Fpersistence",[341,371,372],{"class":351},"'\n",[341,374,376],{"class":343,"line":375},2,[341,377,379],{"emptyLinePlaceholder":378},true,"\n",[341,381,383,386,390,394,397,400],{"class":343,"line":382},3,[341,384,385],{"class":347},"export",[341,387,389],{"class":388},"spNyl"," class",[341,391,393],{"class":392},"sBMFI"," OrderRepository",[341,395,396],{"class":388}," extends",[341,398,399],{"class":392}," BaseOrderRepository",[341,401,402],{"class":351}," {\n",[341,404,406],{"class":343,"line":405},4,[341,407,379],{"emptyLinePlaceholder":378},[341,409,411,414,418,421,424,427,429],{"class":343,"line":410},5,[341,412,413],{"class":351},"    @",[341,415,417],{"class":416},"s2Zo4","Query",[341,419,420],{"class":355},"(",[341,422,423],{"class":351},"'",[341,425,426],{"class":368},"SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100",[341,428,423],{"class":351},[341,430,431],{"class":355},")\n",[341,433,435,439,441,445,448,451,454,457,460,463,466,469],{"class":343,"line":434},6,[341,436,438],{"class":437},"swJcz","    findByStatus",[341,440,420],{"class":351},[341,442,444],{"class":443},"sHdIc","status",[341,446,447],{"class":351},":",[341,449,450],{"class":392}," string",[341,452,453],{"class":351},"):",[341,455,456],{"class":392}," Promise",[341,458,459],{"class":351},"\u003C",[341,461,462],{"class":392},"Order",[341,464,465],{"class":355},"[]",[341,467,468],{"class":351},">",[341,470,402],{"class":351},[341,472,474],{"class":343,"line":473},7,[341,475,477],{"class":476},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[341,479,481],{"class":343,"line":480},8,[341,482,483],{"class":351},"    }\n",[341,485,487],{"class":343,"line":486},9,[341,488,379],{"emptyLinePlaceholder":378},[341,490,492,494,496,498,500,503,505],{"class":343,"line":491},10,[341,493,413],{"class":351},[341,495,417],{"class":416},[341,497,420],{"class":355},[341,499,423],{"class":351},[341,501,502],{"class":368},"UPDATE Order SET status = :status WHERE id = :id WITH REFRESH",[341,504,423],{"class":351},[341,506,431],{"class":355},[341,508,510,513,515,518,520,522,525,528,530,532,534,536,538,541,543,545],{"class":343,"line":509},11,[341,511,512],{"class":437},"    updateStatus",[341,514,420],{"class":351},[341,516,517],{"class":443},"id",[341,519,447],{"class":351},[341,521,450],{"class":392},[341,523,524],{"class":351},",",[341,526,527],{"class":443}," status",[341,529,447],{"class":351},[341,531,450],{"class":392},[341,533,453],{"class":351},[341,535,456],{"class":392},[341,537,459],{"class":351},[341,539,540],{"class":392},"WriteCount",[341,542,465],{"class":355},[341,544,468],{"class":351},[341,546,402],{"class":351},[341,548,550],{"class":343,"line":549},12,[341,551,477],{"class":476},[341,553,555],{"class":343,"line":554},13,[341,556,483],{"class":351},[341,558,560],{"class":343,"line":559},14,[341,561,379],{"emptyLinePlaceholder":378},[341,563,565,567,569,571,573,576,578],{"class":343,"line":564},15,[341,566,413],{"class":351},[341,568,417],{"class":416},[341,570,420],{"class":355},[341,572,423],{"class":351},[341,574,575],{"class":368},"SELECT COUNT(*) AS count FROM Order WHERE status = :status",[341,577,423],{"class":351},[341,579,431],{"class":355},[341,581,583,586,588,590,592,594,596,598,600,603,605,607],{"class":343,"line":582},16,[341,584,585],{"class":437},"    countByStatus",[341,587,420],{"class":351},[341,589,444],{"class":443},[341,591,447],{"class":351},[341,593,450],{"class":392},[341,595,453],{"class":351},[341,597,456],{"class":392},[341,599,459],{"class":351},[341,601,602],{"class":392},"StatusCount",[341,604,465],{"class":355},[341,606,468],{"class":351},[341,608,402],{"class":351},[341,610,612],{"class":343,"line":611},17,[341,613,477],{"class":476},[341,615,617],{"class":343,"line":616},18,[341,618,483],{"class":351},[341,620,622],{"class":343,"line":621},19,[341,623,624],{"class":351},"}\n",[274,626,627,628,630],{},"The method body is left empty because ",[278,629,311],{}," fills in the implementation.",[274,632,633],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[286,635,637],{"id":636},"statements","Statements",[274,639,640,641,644,645,644,648,651,652,655,656,660,661,651,664,667,668,651,671,674,675,679],{},"A named query is one statement. ",[278,642,643],{},"SELECT",", ",[278,646,647],{},"INSERT",[278,649,650],{},"UPDATE"," and ",[278,653,654],{},"DELETE"," are statements of the ",[657,658,659],"a",{"href":172},"Kinotic SQL grammar",", the one migrations use, written without the terminating semicolon. Keywords match in any case, but entity and field names are case-sensitive and must be written the way the entity class spells them: ",[278,662,663],{},"Person",[278,665,666],{},"lastName",", not ",[278,669,670],{},"person",[278,672,673],{},"LASTNAME",". A field name in the wrong case is not an error: the query gets nothing back, no rows read and none written. See ",[657,676,678],{"href":677},"\u002Forganizations\u002Fapps\u002Freference\u002Fmigration-sql-grammar#case","Case",".",[681,682,643],"h3",{"id":683},"select",[274,685,686,687,690,691,694,695,698],{},"Returns the rows of the entity that match the ",[278,688,689],{},"WHERE"," clause, shaped the way the entity class shapes them: nested objects and lists come back whole, since the rows are read from the stored documents. ",[278,692,693],{},"SELECT *"," returns whole rows; ",[278,696,697],{},"SELECT firstName, address"," returns the listed top-level fields only, each whole.",[700,701,702,712,719],"ul",{},[294,703,704,707,708,711],{},[278,705,706],{},"ORDER BY"," orders the rows. A sort the caller gives on a ",[278,709,710],{},"Pageable"," follows it.",[294,713,714,715,718],{},"A method that returns an array gets every matching row up to ",[278,716,717],{},"LIMIT",", or 1000 rows when the statement names no limit.",[294,720,721,722,725,726,729,730,732,733,735,736,679],{},"A method with a ",[278,723,724],{},"pageable: Pageable"," parameter returns a ",[278,727,728],{},"Page",", and the ",[278,731,710],{}," sets the page size. Cursor paging orders by the statement's ",[278,734,706],{},", so give it one that orders the rows fully, such as ",[278,737,738],{},"ORDER BY lastName, id",[681,740,742],{"id":741},"insert-update-and-delete","INSERT, UPDATE and DELETE",[274,744,745,746,749,750,753],{},"A write returns one row, ",[278,747,748],{},"{ count }",", holding the number of rows it wrote. Add ",[278,751,752],{},"WITH REFRESH"," when the next read must see the write.",[700,755,756,772],{},[294,757,758,760,761,764,765,651,768,771],{},[278,759,647],{}," stores the row the way the repository's ",[278,762,763],{},"save"," would: the row states the entity's id field, and the platform stores it under the participant's tenant, so the row is found by id afterwards. ",[278,766,767],{},"ROUTING",[278,769,770],{},"DOCUMENT_ID"," are not accepted, since both are derived.",[294,773,774,651,776,778,779,781],{},[278,775,650],{},[278,777,654],{}," act on the rows that match the ",[278,780,689],{}," clause.",[681,783,785],{"id":784},"aggregates","Aggregates",[274,787,788,789,791,792,644,795,644,798,644,801,644,804,644,807,644,810,813,814,817,818,824,825,828,829,832,833,835,836,839,840,843,844,847,848,679],{},"A ",[278,790,643],{}," that calls a function (",[278,793,794],{},"COUNT(*)",[278,796,797],{},"SUM",[278,799,800],{},"AVG",[278,802,803],{},"MIN",[278,805,806],{},"MAX",[278,808,809],{},"PERCENTILE",[278,811,812],{},"HISTOGRAM",", …) or has a ",[278,815,816],{},"GROUP BY"," is an aggregate. It runs on Elasticsearch SQL, so it can call any of ",[657,819,823],{"href":820,"rel":821},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Freference\u002Fquery-languages\u002Fsql\u002Fsql-functions",[822],"nofollow","its functions",", and returns one row per group, shaped by the projection: ",[278,826,827],{},"AS"," names a column, and a column or group can be a sub-field (",[278,830,831],{},"address.city","). It is written in the same grammar as every other statement, with the same ",[278,834,689],{}," clause and ",[278,837,838],{},":name"," parameters, and names the query's own entity in ",[278,841,842],{},"FROM","; see ",[657,845,643],{"href":846},"\u002Forganizations\u002Fapps\u002Freference\u002Fmigration-sql-grammar#select",". A paged aggregate takes a cursor ",[278,849,710],{},[286,851,853],{"id":852},"multi-tenancy","Multi-tenancy",[274,855,856,857,859,860,862,863,865,866,868,869,871,872,874],{},"Every named query is confined to the participant's tenant, the way every repository method is: a ",[278,858,643],{}," or aggregate reads only the rows of that tenant, an ",[278,861,647],{}," stores its row under it, and an ",[278,864,650],{}," or ",[278,867,654],{}," touches only its rows, whatever the ",[278,870,689],{}," clause says. An ",[278,873,647],{}," may state the entity's tenant field with the participant's own tenant; any other value is refused.",[286,876,878],{"id":877},"admin-repository-queries","Admin Repository Queries",[274,880,881,882,886,887,890],{},"A named query on an ",[657,883,885],{"href":884},"\u002Forganizations\u002Fapps\u002Fpersistence\u002Fmulti-tenancy#admin-repository","admin repository"," runs against the tenants the caller selects, so it declares a ",[278,888,889],{},"TenantSelection"," parameter like every other admin repository method. The generated implementation sends it as the query's tenant selection rather than as a query parameter. A read runs against every tenant the selection names; a write acts on one tenant, so its selection names exactly one.",[332,892,894],{"className":334,"code":893,"language":336,"meta":337,"style":337},"import { Query, type TenantSelection } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderAdminRepository extends BaseOrderAdminRepository {\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string, tenantSelection: TenantSelection): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n\nconst openOrders = await new OrderAdminRepository().countByStatus('OPEN', ['tenant-123', 'tenant-456'])\n",[278,895,896,922,926,942,946,962,997,1001,1005,1009,1013],{"__ignoreMap":337},[341,897,898,900,902,904,906,909,912,914,916,918,920],{"class":343,"line":344},[341,899,348],{"class":347},[341,901,352],{"class":351},[341,903,356],{"class":355},[341,905,524],{"class":351},[341,907,908],{"class":347}," type",[341,910,911],{"class":355}," TenantSelection",[341,913,359],{"class":351},[341,915,362],{"class":347},[341,917,365],{"class":351},[341,919,369],{"class":368},[341,921,372],{"class":351},[341,923,924],{"class":343,"line":375},[341,925,379],{"emptyLinePlaceholder":378},[341,927,928,930,932,935,937,940],{"class":343,"line":382},[341,929,385],{"class":347},[341,931,389],{"class":388},[341,933,934],{"class":392}," OrderAdminRepository",[341,936,396],{"class":388},[341,938,939],{"class":392}," BaseOrderAdminRepository",[341,941,402],{"class":351},[341,943,944],{"class":343,"line":405},[341,945,379],{"emptyLinePlaceholder":378},[341,947,948,950,952,954,956,958,960],{"class":343,"line":410},[341,949,413],{"class":351},[341,951,417],{"class":416},[341,953,420],{"class":355},[341,955,423],{"class":351},[341,957,575],{"class":368},[341,959,423],{"class":351},[341,961,431],{"class":355},[341,963,964,966,968,970,972,974,976,979,981,983,985,987,989,991,993,995],{"class":343,"line":434},[341,965,585],{"class":437},[341,967,420],{"class":351},[341,969,444],{"class":443},[341,971,447],{"class":351},[341,973,450],{"class":392},[341,975,524],{"class":351},[341,977,978],{"class":443}," tenantSelection",[341,980,447],{"class":351},[341,982,911],{"class":392},[341,984,453],{"class":351},[341,986,456],{"class":392},[341,988,459],{"class":351},[341,990,602],{"class":392},[341,992,465],{"class":355},[341,994,468],{"class":351},[341,996,402],{"class":351},[341,998,999],{"class":343,"line":473},[341,1000,477],{"class":476},[341,1002,1003],{"class":343,"line":480},[341,1004,483],{"class":351},[341,1006,1007],{"class":343,"line":486},[341,1008,