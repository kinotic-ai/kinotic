\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[286,302,303,352,359,377,394,403,428,433,441,456,461,475,489],{"__ignoreMap":300},[304,305,308,312,316,320,323,326,328,331,333,336,339,342,345,349],"span",{"class":306,"line":307},"line",1,[304,309,311],{"class":310},"s7zQu","import",[304,313,315],{"class":314},"sMK4o"," {",[304,317,319],{"class":318},"sTEyZ"," Entity",[304,321,322],{"class":314},",",[304,324,325],{"class":318}," AutoGeneratedId",[304,327,322],{"class":314},[304,329,330],{"class":318}," TenantId",[304,332,322],{"class":314},[304,334,335],{"class":318}," MultiTenancyType",[304,337,338],{"class":314}," }",[304,340,341],{"class":310}," from",[304,343,344],{"class":314}," '",[304,346,348],{"class":347},"sfazB","@kinotic-ai\u002Fpersistence",[304,350,351],{"class":314},"'\n",[304,353,355],{"class":306,"line":354},2,[304,356,358],{"emptyLinePlaceholder":357},true,"\n",[304,360,362,365,369,372,374],{"class":306,"line":361},3,[304,363,364],{"class":314},"@",[304,366,368],{"class":367},"s2Zo4","Entity",[304,370,371],{"class":318},"(MultiTenancyType",[304,373,293],{"class":314},[304,375,376],{"class":318},"SHARED)\n",[304,378,380,383,387,391],{"class":306,"line":379},4,[304,381,382],{"class":310},"export",[304,384,386],{"class":385},"spNyl"," class",[304,388,390],{"class":389},"sBMFI"," Person",[304,392,393],{"class":314}," {\n",[304,395,397,400],{"class":306,"line":396},5,[304,398,399],{"class":314},"    @",[304,401,402],{"class":318},"AutoGeneratedId\n",[304,404,406,410,413,416,419,422,425],{"class":306,"line":405},6,[304,407,409],{"class":408},"swJcz","    id",[304,411,412],{"class":314},":",[304,414,415],{"class":389}," string",[304,417,418],{"class":314}," |",[304,420,421],{"class":389}," null",[304,423,424],{"class":314}," =",[304,426,427],{"class":314}," null\n",[304,429,431],{"class":306,"line":430},7,[304,432,358],{"emptyLinePlaceholder":357},[304,434,436,438],{"class":306,"line":435},8,[304,437,399],{"class":314},[304,439,440],{"class":318},"TenantId\n",[304,442,444,447,449,451,453],{"class":306,"line":443},9,[304,445,446],{"class":408},"    tenantId",[304,448,412],{"class":314},[304,450,415],{"class":389},[304,452,424],{"class":314},[304,454,455],{"class":314}," ''\n",[304,457,459],{"class":306,"line":458},10,[304,460,358],{"emptyLinePlaceholder":357},[304,462,464,467,469,471,473],{"class":306,"line":463},11,[304,465,466],{"class":408},"    firstName",[304,468,412],{"class":314},[304,470,415],{"class":389},[304,472,424],{"class":314},[304,474,455],{"class":314},[304,476,478,481,483,485,487],{"class":306,"line":477},12,[304,479,480],{"class":408},"    lastName",[304,482,412],{"class":314},[304,484,415],{"class":389},[304,486,424],{"class":314},[304,488,455],{"class":314},[304,490,492],{"class":306,"line":491},13,[304,493,494],{"class":314},"}\n",[274,496,497,498,500],{},"The ",[286,499,288],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[278,502,504],{"id":503},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[274,506,507,508,511,512,515,516,519],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and who assigns it is the application's ",[286,509,510],{},"tenantManagement"," setting: ",[286,513,514],{},"SYSTEM"," gives every user a tenant of their own at creation, ",[286,517,518],{},"TENANT_ADMINISTRATORS"," leaves tenants to the people who create them — a customer signing up, or the organization in the portal — whose administrators decide who joins.",[521,522,523,540],"table",{},[524,525,526],"thead",{},[527,528,529,535,537],"tr",{},[530,531,532,533],"th",{},"Application ",[286,534,510],{},[530,536,368],{},[530,538,539],{},"Result",[541,542,543,558,571,591],"tbody",{},[527,544,545,550,555],{},[546,547,548],"td",{},[286,549,518],{},[546,551,552],{},[286,553,554],{},"MultiTenancyType.NONE",[546,556,557],{},"One shared dataset — every user sees every other user's rows",[527,559,560,564,568],{},[546,561,562],{},[286,563,514],{},[546,565,566],{},[286,567,554],{},[546,569,570],{},"Still one shared dataset; the setting has nothing to act on",[527,572,573,577,585],{},[546,574,575],{},[286,576,518],{},[546,578,579,582,583],{},[286,580,581],{},"SHARED"," + ",[286,584,288],{},[546,586,587,588],{},"A user created into no tenant has none, and its writes fail with ",[286,589,590],{},"tenantId cannot be null or blank for shared multi tenancy",[527,592,593,597,603],{},[546,594,595],{},[286,596,514],{},[546,598,599,582,601],{},[286,600,581],{},[286,602,288],{},[546,604,605],{},"Each user isolated in their own tenant",[274,607,608,609,612,613,615,616,293],{},"Choose it when the application is created — ",[286,610,611],{},"createApplicationIfNotExist"," takes it as an argument, defaulting to ",[286,614,518],{}," — and change it afterwards only from the portal, under ",[617,618,619],"strong",{},"Application → Settings → Tenants",[274,621,622,624,625,627],{},[286,623,514],{}," applies to users created while it is in force. Existing users are never backfilled, so choosing it for an application that already has users leaves those users without a tenant, and every write they make to a ",[286,626,581],{}," entity fails. Settle it before the application has users.",[278,629,631],{"id":630},"tenants-and-their-sites","Tenants and their sites",[274,633,634,635,637,638,641,642,645,646,649,650,653,654,657,658,661,662,665,666,670,671,673,674,676],{},"Under ",[286,636,518],{}," a tenant is a ",[286,639,640],{},"Tenant"," of the application, created by your organization in the portal or through ",[286,643,644],{},"TenantService"," (",[286,647,648],{},"createTenantIfNotExist(applicationId, name, description)","), whose id is its slugified name: lowercase letters, digits and single dashes, at most 24 characters so it leads a hostname label, and unique within your organization, so a name whose slug a tenant of another of your applications already holds is refused. The tenant's users carry that id as their ",[286,651,652],{},"tenantId",". Each of the application's published UIs is also served for the tenant at ",[286,655,656],{},"\u003CtenantId>--\u003CapplicationId>--\u003CuiName>"," under your organization's subdomain of the sites domain, and a sign-in from that site is to the tenant: it admits the tenant's users only, and offers the tenant's own identity providers (",[286,659,660],{},"TenantOidcConfiguration",", added for the tenant on the application's ",[617,663,664],{},"Settings → Sign-in providers"," tab in the portal) before the application's — see ",[667,668,131],"a",{"href":669},"\u002Forganizations\u002Fapps\u002Fsecurity\u002Fauthentication#signing-in-to-a-tenant",". A tenant whose users were created with a ",[286,672,652],{}," no ",[286,675,640],{}," row names has no login of its own until the row is created.",[274,678,634,679,681,682,686,687,689],{},[286,680,514],{}," tenants are minted per user and have no rows or sites; the user signs in at the application's own sites. It is the one under which new people may ",[667,683,685],{"href":684},"\u002Forganizations\u002Fapps\u002Fsecurity\u002Fauthentication#signing-up","sign up"," at the application's own login, since each new user gets a tenant of their own; under ",[286,688,518],{}," a person joins a tenant by invitation or through one of the tenant's own providers that signs people up.",[278,691,693],{"id":692},"tenants-and-services","Tenants and services",[274,695,696,697,699],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[286,698,581],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[278,701,703],{"id":702},"tenant-isolated-repository","Tenant-Isolated Repository",[274,705,706,707,710],{},"The standard generated ",[286,708,709],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[295,712,714],{"className":297,"code":713,"language":299,"meta":300,"style":300},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[286,715,716,736,740,746],{"__ignoreMap":300},[304,717,718,721,724,727,730,733],{"class":306,"line":307},[304,719,720],{"class":385},"const",[304,722,723],{"class":318}," service ",[304,725,726],{"class":314},"=",[304,728,729],{"class":314}," new",[304,731,732],{"class":367}," PersonRepository",[304,734,735],{"class":318},"()\n",[304,737,738],{"class":306,"line":354},[304,739,358],{"emptyLinePlaceholder":357},[304,741,742],{"class":306,"line":361},[304,743,745],{"class":744},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[304,747,748,750,753,755,758,761,763,766,769,772,775,777,781,783,786,788,791,793],{"class":306,"line":379},[304,749,720],{"class":385},[304,751,752],{"class":318}," people ",[304,754,726],{"class":314},[304,756,757],{"class":310}," await",[304,759,760],{"class":318}," service",[304,762,293],{"class":314},[304,764,765],{"class":367},"findAll",[304,767,768],{"class":318},"(",[304,770,771],{"class":314},"{",[304,773,774],{"class":408}," page",[304,776,412],{"class":314},[304,778,780],{"class":779},"sbssI"," 0",[304,782,322],{"class":314},[304,784,785],{"class":408}," size",[304,787,412],{"class":314},[304,789,790],{"class":779}," 10",[304,792,338],{"class":314},[304,794,795],{"class":318},")\n",[274,797,798],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[278,800,802],{"id":801},"admin-repository","Admin Repository",[274,804,805,806,809,810,812,813,816,817,820],{},"When you run ",[286,807,808],{},"kinotic sync"," on an entity with a ",[286,811,288],{}," field, the CLI generates both a tenant-scoped repository (",[286,814,815],{},"PersonRepository",") and an admin repository (",[286,818,819],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[295,822,824],{"className":297,"code":823,"language":299,"meta":300,"style":300},"const adminService = new PersonAdminRepository()\n",[286,825,826],{"__ignoreMap":300},[304,827,828,830,833,835,837,840],{"class":306,"line":307},[304,829,720],{"class":385},[304,831,832],{"class":318}," adminService ",[304,834,726],{"class":314},[304,836,729],{"class":314},[304,838,839],{"class":367}," PersonAdminRepository",[304,841,735],{"class":318},[843,844,846],"h3",{"id":845},"access-all-tenants","Access All Tenants",[295,848,850],{"className":297,"code":849,"language":299,"meta":300,"style":300},"const allPeople = await adminService.findAll(['*'], { page: 0, size: 10 })\n",[286,851,852],{"__ignoreMap":300},[304,853,854,856,859,861,863,866,868,870,873,876,879,881,884,886,888,890,892,894,896,898,900,902,904],{"class":306,"line":307},[304,855,720],{"class":385},[304,857,858],{"class":318}," allPeople ",[304,860,726],{"class":314},[304,862,757],{"class":310},[304,864,865],{"class":318}," adminService",[304,867,293],{"class":314},[304,869,765],{"class":367},[304,871,872],{"class":318},"([",[304,874,875],{"class":314},"'",[304,877,878],{"class":347},"*",[304,880,875],{"class":314},[304,882,883],{"class":318},"]",[304,885,322],{"class":314},[304,887,315],{"class":314},[304,889,774],{"class":408},[304,891,412],{"class":314},[304,893,780],{"class":779},[304,895,322],{"class":314},[304,897,785],{"class":408},[304,899,412],{"class":314},[304,901,790],{"class":779},[304,903,338],{"class":314},[304,905,795],{"class":318},[843,907,909],{"id":908},"access-a-specific-tenant","Access a Specific Tenant",[295,911,913],{"className":297,"code":912,"language":299,"meta":300,"style":300},"const tenantPeople = await adminService.findAll(['tenant-123'], { page: 0, size: 10 })\n",[286,914,915],{"__ignoreMap":300},[304,916,917,919,922,924,926,928,930,932,934,936,939,941,943,945,947,949,951,953,955,957,959,961,963],{"class":306,"line":307},[304,918,720],{"class":385},[304,920,921],{"class":318}," tenantPeople ",[304,923,726],{"class":314},[304,925,757],{"class":310},[304,927,865],{"class":318},[304,929,293],{"class":314},[304,931,765],{"class":367},[304,933,872],{"class":318},[304,935,875],{"class":314},[304,937,938],{"class":347},"tenant-123",[304,940,875],{"class":314},[304,942,883],{"class":318},[304,944,322],{"class":314},[304,946,315],{"class":314},[304,948,774],{"class":408},[304,950,412],{"class":314},[304,952,780],{"class":779},[304,954,322],{"class":314},[304,956,785],{"class":408},[304,958,412],{"class":314},[304,960,790],{"class":779},[304,962,338],{"class":314},[304,964,795],{"class":318},[843,966,968],{"id":967},"access-multiple-tenants","Access Multiple Tenants",[295,970,972],{"className":297,"code":971,"language":299,"meta":300,"style":300},"const multiPeople = await adminService.findAll(['tenant-123', 'tenant-456'], { page: 0, size: 10 })\n",[286,973,974],{"__ignoreMap":300},[304,975,976,978,981,983,985,987,989,991,993,995,997,999,1001,1003,1006,1008,1010,1012,1014,1016,1018,1020,1022,1024,1026,1028,1030],{"class":306,"line":307},[304,977,720],{"class":385},[304,979,980],{"class":318}," multiPeople ",[304,982,726],{"class":314},[304,984,757],{"class":310},[304,986,865],{"class":318},[304,988,293],{"class":314},[304,990,765],{"class":367},[304,992,872],{"class":318},[304,994,875],{"class":314},[304,996,938],{"class":347},[304,998,875],{"class":314},[304,1000,322],{"class":314},[304,1002,344],{"class":314},[304,1004,1005],{"class":347},"tenant-456",[304,1007,875],{"class":314},[304,1009,883],{"class":318},[304,1011,322],{"class":314},[304,1013,315],{"class":314},[304,1015,774],{"class":408},[304,1017,412],{"class":314},[304,1019,780],{"class":779},[304,1021,322],{"class":314},[304,1023,785],{"class":408},[304,1025,412],{"class":314},[304,1027,790],{"class":779},[304,1029,338],{"class":314},[304,1031,795],{"class":318},[278,1033,1035],{"id":1034},"tenant-selection","Tenant Selection",[274,1037,1038],{},"Admin repository methods accept a tenant selection array as the first argument:",[521,1040,1041,1051],{},[524,1042,1043],{},[527,1044,1045,1048],{},[530,1046,1047],{},"Selection",[530,1049,1050],{},"Behavior",[541,1052,1053,1063,1073],{},[527,1054,1055,1060],{},[546,1056,1057],{},[286,1058,1059],{},"['*']",[546,1061,1062],{},"Access data from all tenants",[527,1064,1065,1070],{},[546,1066,1067],{},[286,1068,1069],{},"['tenant-123']",[546,1071,1072],{},"Access data from a single tenant",[527,1074,1075,1080],{},[546,1076,1077],{},[286,1078,1079],{},"['tenant-123', 'tenant-456']",[546,1081,1082],{},"Access data from multiple tenants",[278,1084,1086],{"id":1085},"security-considerations","Security Considerations",[274,1088,1089,1090,1094,1095,1097,1098,1100],{},"A participant that belongs to a tenant is confined to it. Through the admin repository, including its ",[667,1091,1093],{"href":1092},"\u002Forganizations\u002Fapps\u002Fpersistence\u002Fnamed-queries#admin-repository-queries","named queries",", it may select only its own tenant; naming another tenant, or ",[286,1096,1059],{},", is refused with an authorization error. On save, a blank ",[286,1099,288],{}," is filled with the participant's tenant and any other value is rejected. Selecting other tenants is possible only for a participant without a tenant, which is how a microservice in a project's deployment connects (organization scope), and such a participant must name the tenant of every entity it saves.",[274,1102,1103],{},"The standard tenant-isolated repository is the default and should be used for regular application logic.",[1105,1106,1107],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);