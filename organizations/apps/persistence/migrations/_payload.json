:251,"stem":252,"icon":36},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","03.platform\u002F12.reference\u002F04.sign-in-design",{"title":254,"path":255,"stem":256,"icon":257},"Development Server","\u002Fplatform\u002Fdevelopment-server","03.platform\u002F13.development-server","i-lucide-server-cog",{"title":259,"path":260,"stem":261,"icon":262},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","03.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":264,"path":265,"stem":266,"icon":267},"Enterprise License","\u002Fplatform\u002Fenterprise-license","03.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":269,"title":122,"body":270,"description":797,"extension":798,"links":799,"meta":800,"navigation":801,"path":123,"seo":802,"stem":124,"__hash__":803},"docs\u002F02.organizations\u002F03.apps\u002F03.persistence\u002F07.migrations.md",{"type":271,"value":272,"toc":785},"minimark",[273,282,288,293,296,306,309,328,335,339,359,370,373,377,404,408,438,443,446,455,458,492,495,539,549,553,556,565,571,580,583,598,605,625,629,635,644,648,651,660,663,693,718,734,738,775,781],[274,275,276,277,281],"p",{},"Migrations change the data of an application's entities in a controlled, versioned way: seed rows, backfill a field, remove rows, or copy data from one entity to another. They are written in a SQL-like syntax and executed automatically during ",[278,279,280],"code",{},"kinotic sync",".",[274,283,284,285,287],{},"An entity's schema is not what a migration changes. The entity class is the schema: ",[278,286,280],{}," publishes every entity before it runs the migrations, and publishing creates or updates the entity's backing store. A migration only moves data within that store.",[289,290,292],"h2",{"id":291},"file-naming","File Naming",[274,294,295],{},"Migration files follow a strict naming convention:",[297,298,303],"pre",{"className":299,"code":301,"language":302},[300],"language-text","V\u003Cnumber>__\u003Cdescription>.sql\n","text",[278,304,301],{"__ignoreMap":305},"",[274,307,308],{},"Examples:",[310,311,312,318,323],"ul",{},[313,314,315],"li",{},[278,316,317],{},"V1__seed_roles.sql",[313,319,320],{},[278,321,322],{},"V2__backfill_status.sql",[313,324,325],{},[278,326,327],{},"V3__copy_legacy_orders.sql",[274,329,330,331,334],{},"The version number determines execution order. The double underscore (",[278,332,333],{},"__",") separates the version from the description.",[289,336,338],{"id":337},"how-it-works","How It Works",[340,341,342,345,348,351,354],"ol",{},[313,343,344],{},"Entities are published, so every entity a migration names has its backing store",[313,346,347],{},"Migration files are discovered and sorted by version number",[313,349,350],{},"Only unapplied migrations are parsed, resolved and executed",[313,352,353],{},"Each migration is recorded after successful execution to prevent re-runs",[313,355,356,357],{},"Migrations run during ",[278,358,280],{},[274,360,361,362,365,366,369],{},"A migration names entities, never storage. ",[278,363,364],{},"INSERT INTO Person"," addresses the ",[278,367,368],{},"Person"," entity of the application being synchronized, and the platform resolves that name to the entity's backing store when the migration runs. A name that is not one of the application's published entities fails the run, as does a statement that is not one of the data statements below.",[274,371,372],{},"A migration file containing a syntax error fails the entire migration run — nothing from that file is applied and the file is not recorded. The error names the file, line, and offending token. A migration run is resolved as a whole before anything executes, so an unknown entity in the last file stops the first file from running too.",[289,374,376],{"id":375},"example-migration","Example Migration",[297,378,382],{"className":379,"code":380,"language":381,"meta":305,"style":305},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- V1__seed_roles.sql\nINSERT INTO Role (id, tenantId, name) VALUES ('role-admin', 'acme', 'Administrator') WITH REFRESH;\nINSERT INTO Role (id, tenantId, name) VALUES ('role-member', 'acme', 'Member') WITH REFRESH;\n","sql",[278,383,384,392,398],{"__ignoreMap":305},[385,386,389],"span",{"class":387,"line":388},"line",1,[385,390,391],{},"-- V1__seed_roles.sql\n",[385,393,395],{"class":387,"line":394},2,[385,396,397],{},"INSERT INTO Role (id, tenantId, name) VALUES ('role-admin', 'acme', 'Administrator') WITH REFRESH;\n",[385,399,401],{"class":387,"line":400},3,[385,402,403],{},"INSERT INTO Role (id, tenantId, name) VALUES ('role-member', 'acme', 'Member') WITH REFRESH;\n",[289,405,407],{"id":406},"supported-statements","Supported Statements",[274,409,410,411,413,414,417,418,413,421,424,425,428,429,432,433,281],{},"A migration uses the four data statements. Each names an entity of the application. Keywords match in any case, but entity and field names are case-sensitive and must be written the way the entity class spells them: ",[278,412,368],{}," and ",[278,415,416],{},"firstName",", not ",[278,419,420],{},"person",[278,422,423],{},"FIRSTNAME",". An entity name in the wrong case fails the run, naming the entity meant; a field name in the wrong case is not an error, so an ",[278,426,427],{},"UPDATE"," or ",[278,430,431],{},"DELETE"," that uses one changes no rows. See ",[434,435,437],"a",{"href":436},"\u002Forganizations\u002Fapps\u002Freference\u002Fmigration-sql-grammar#case","Case",[439,440,442],"h3",{"id":441},"insert-into","INSERT INTO",[274,444,445],{},"Add a row to an entity.",[297,447,449],{"className":379,"code":448,"language":381,"meta":305,"style":305},"INSERT INTO Person (id, tenantId, firstName, lastName, age) VALUES ('p-1', 'acme', 'Jane', 'Doe', 28) WITH REFRESH;\n",[278,450,451],{"__ignoreMap":305},[385,452,453],{"class":387,"line":388},[385,454,448],{},[274,456,457],{},"The row has to carry the entity's id field, and on a multi-tenant entity its tenant field, with the same names the entity class gives them. The platform stores the row the way the entity's repository would have, so it is found by id and by tenant afterwards:",[310,459,460,474],{},[313,461,462,466,467,428,470,473],{},[463,464,465],"strong",{},"The id field"," — the entity's ",[278,468,469],{},"@Id",[278,471,472],{},"@AutoGeneratedId"," field. A migration cannot have an id generated for it; every row states its own.",[313,475,476,479,480,483,484,487,488,491],{},[463,477,478],{},"The tenant field"," — on an entity whose multi-tenancy type is ",[278,481,482],{},"SHARED",", the field holding its tenant: the entity's own ",[278,485,486],{},"@TenantId"," field where it declares one, otherwise the platform's tenant field, ",[278,489,490],{},"tenantId"," by default. A migration runs for the organization, not for a tenant, so every row says which tenant it belongs to.",[274,493,494],{},"Composite fields take an object literal, and a list of them an array of object literals:",[297,496,498],{"className":379,"code":497,"language":381,"meta":305,"style":305},"INSERT INTO Person (id, tenantId, firstName, address, tags) VALUES (\n    'p-1',\n    'acme',\n    'Jane',\n    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n) WITH REFRESH;\n",[278,499,500,505,510,515,521,527,533],{"__ignoreMap":305},[385,501,502],{"class":387,"line":388},[385,503,504],{},"INSERT INTO Person (id, tenantId, firstName, address, tags) VALUES (\n",[385,506,507],{"class":387,"line":394},[385,508,509],{},"    'p-1',\n",[385,511,512],{"class":387,"line":400},[385,513,514],{},"    'acme',\n",[385,516,518],{"class":387,"line":517},4,[385,519,520],{},"    'Jane',\n",[385,522,524],{"class":387,"line":523},5,[385,525,526],{},"    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n",[385,528,530],{"class":387,"line":529},6,[385,531,532],{},"    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n",[385,534,536],{"class":387,"line":535},7,[385,537,538],{},") WITH REFRESH;\n",[274,540,541,542,413,545,548],{},"An application's migration leaves ",[278,543,544],{},"ROUTING",[278,546,547],{},"DOCUMENT_ID"," to the platform, which derives both from the row's id and tenant fields.",[439,550,552],{"id":551},"update-set-where","UPDATE ... SET ... WHERE",[274,554,555],{},"Modify existing rows.",[297,557,559],{"className":379,"code":558,"language":381,"meta":305,"style":305},"UPDATE Person SET active = false WHERE age \u003C 18 WITH REFRESH;\n",[278,560,561],{"__ignoreMap":305},[385,562,563],{"class":387,"line":388},[385,564,558],{},[274,566,567,568,570],{},"An ",[278,569,427],{}," reaches every tenant's rows that match; narrow it with the tenant field when one tenant is meant:",[297,572,574],{"className":379,"code":573,"language":381,"meta":305,"style":305},"UPDATE Person SET plan = 'trial' WHERE tenantId = 'acme' WITH REFRESH;\n",[278,575,576],{"__ignoreMap":305},[385,577,578],{"class":387,"line":388},[385,579,573],{},[274,581,582],{},"A composite field is set from the same literals INSERT uses. An object literal merges into the\nstored object — recursively, and leaving sub-fields it does not mention alone — so you can change\none sub-field by naming only that one. Arrays and scalars are replaced outright:",[297,584,586],{"className":379,"code":585,"language":381,"meta":305,"style":305},"-- street keeps its stored value; only city changes\nUPDATE Person SET address = { city: 'Shelbyville' } WHERE id = 'p-1' WITH REFRESH;\n",[278,587,588,593],{"__ignoreMap":305},[385,589,590],{"class":387,"line":388},[385,591,592],{},"-- street keeps its stored value; only city changes\n",[385,594,595],{"class":387,"line":394},[385,596,597],{},"UPDATE Person SET address = { city: 'Shelbyville' } WHERE id = 'p-1' WITH REFRESH;\n",[274,599,600,601,604],{},"Since omitting a sub-field keeps it, ",[278,602,603],{},"null"," is what clears one. The literal's nesting addresses the\nfield, so any depth is reachable:",[297,606,608],{"className":379,"code":607,"language":381,"meta":305,"style":305},"UPDATE Person SET address = { street: null } WHERE id = 'p-1' WITH REFRESH;          -- address.street\nUPDATE Person SET address = { coords: { lat: null } } WHERE id = 'p-1' WITH REFRESH; -- address.coords.lat\nUPDATE Person SET nickname = null WHERE id = 'p-1' WITH REFRESH;                     -- the whole field\n",[278,609,610,615,620],{"__ignoreMap":305},[385,611,612],{"class":387,"line":388},[385,613,614],{},"UPDATE Person SET address = { street: null } WHERE id = 'p-1' WITH REFRESH;          -- address.street\n",[385,616,617],{"class":387,"line":394},[385,618,619],{},"UPDATE Person SET address = { coords: { lat: null } } WHERE id = 'p-1' WITH REFRESH; -- address.coords.lat\n",[385,621,622],{"class":387,"line":400},[385,623,624],{},"UPDATE Person SET nickname = null WHERE id = 'p-1' WITH REFRESH;                     -- the whole field\n",[439,626,628],{"id":627},"delete-from-where","DELETE FROM ... WHERE",[274,630,631,632,634],{},"Remove rows matching a condition. Like ",[278,633,427],{},", it reaches every tenant unless the condition names one.",[297,636,638],{"className":379,"code":637,"language":381,"meta":305,"style":305},"DELETE FROM Person WHERE active = false WITH REFRESH;\n",[278,639,640],{"__ignoreMap":305},[385,641,642],{"class":387,"line":388},[385,643,637],{},[439,645,647],{"id":646},"reindex","REINDEX",[274,649,650],{},"Copy rows from one entity to another, for example when a field changes type and the entity is republished beside the old one.",[297,652,654],{"className":379,"code":653,"language":381,"meta":305,"style":305},"REINDEX LegacyOrder INTO Order WITH (SKIP_IF_NO_SOURCE = TRUE);\n",[278,655,656],{"__ignoreMap":305},[385,657,658],{"class":387,"line":388},[385,659,653],{},[274,661,662],{},"Both names are entities of the application. The rows are copied as stored, so their ids and tenants travel with them.",[274,664,665,666,669,670,676,677,680,681,684,685,688,689,692],{},"A ",[278,667,668],{},"SCRIPT"," transforms each row as it is copied, in ",[434,671,675],{"href":672,"rel":673},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fexplore-analyze\u002Fscripting\u002Fmodules-scripting-painless",[674],"nofollow","Painless",". The row is ",[278,678,679],{},"ctx._source",", and ",[278,682,683],{},"ctx.op"," set to ",[278,686,687],{},"'noop'"," skips it or ",[278,690,691],{},"'delete'"," removes it from the destination:",[297,694,696],{"className":379,"code":695,"language":381,"meta":305,"style":305},"REINDEX LegacyOrder INTO Order WITH (\n    SCRIPT = 'ctx._source.total = Double.parseDouble(ctx._source.total); if (ctx._source.status == \"void\") { ctx.op = \"noop\" }',\n    SKIP_IF_NO_SOURCE = TRUE\n);\n",[278,697,698,703,708,713],{"__ignoreMap":305},[385,699,700],{"class":387,"line":388},[385,701,702],{},"REINDEX LegacyOrder INTO Order WITH (\n",[385,704,705],{"class":387,"line":394},[385,706,707],{},"    SCRIPT = 'ctx._source.total = Double.parseDouble(ctx._source.total); if (ctx._source.status == \"void\") { ctx.op = \"noop\" }',\n",[385,709,710],{"class":387,"line":400},[385,711,712],{},"    SKIP_IF_NO_SOURCE = TRUE\n",[385,714,715],{"class":387,"line":517},[385,716,717],{},");\n",[274,719,720,721,724,725,428,727,729,730,733],{},"The script reaches ",[278,722,723],{},"ctx"," only as ",[278,726,679],{},[278,728,683],{},", and does not call ",[278,731,732],{},"metadata()","; a row's index, id and routing are the platform's. A migration whose script does otherwise fails the run.",[289,735,737],{"id":736},"best-practices","Best Practices",[310,739,740,746,755,763,769],{},[313,741,742,745],{},[463,743,744],{},"Increment version numbers sequentially"," - Gaps are allowed but order must be maintained",[313,747,748,754],{},[463,749,750,751],{},"Use ",[278,752,753],{},"WITH REFRESH"," on INSERT, UPDATE, and DELETE when subsequent migrations depend on the changed data being immediately visible",[313,756,757,762],{},[463,758,750,759],{},[278,760,761],{},"SKIP_IF_NO_SOURCE = TRUE"," on REINDEX operations for idempotent data migrations",[313,764,765,768],{},[463,766,767],{},"Keep migrations small and focused"," - One logical change per migration file",[313,770,771,774],{},[463,772,773],{},"Never modify a migration after it has been applied"," - Create a new migration instead",[274,776,777,778,281],{},"For the complete SQL grammar reference, see the ",[434,779,780],{"href":172},"Migration SQL Grammar Reference",[782,783,784],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":305,"searchDepth":394,"depth":394,"links":786},[787,788,789,790,796],{"id":291,"depth":394,"text":292},{"id":337,"depth":394,"text":338},{"id":375,"depth":394,"text":376},{"id":406,"depth":394,"text":407,"children":791},[792,793,794,795],{"id":441,"depth":400,"text":442},{"id":551,"depth":400,"text":552},{"id":627,"depth":400,"text":628},{"id":646,"depth":400,"text":647},{"id":736,"depth":394,"text":737},"Versioned data migrations for an application's entities, run during kinotic sync.","md",null,{},true,{"title":122,"description":797},"GWI9EiqK0hxWCYCh2cw3pjmarCUVtT3x79ahpWuFaJc",[805,807],{"title":118,"path":119,"stem":120,"description":806,"children":-1},"Multi-tenant data isolation in Kinotic with automatic tenant filtering.",{"title":131,"path":132,"stem":133,"description":808,"icon":36,"children":-1},"Authentication methods and identity management in Kinotic.",1792930939530]