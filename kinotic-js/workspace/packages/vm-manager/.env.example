# Unique identifier for this vm-manager node
KINOTIC_NODE_ID=

# Kinotic server connection
KINOTIC_SERVER_HOST=localhost
KINOTIC_SERVER_PORT=58503
KINOTIC_SERVER_LOGIN=kinotic
KINOTIC_SERVER_PASSCODE=kinotic

# Heartbeat interval in milliseconds
KINOTIC_HEARTBEAT_INTERVAL_MS=30000

# Host directory holding per-VM log directories (default: ~/.kinotic/vm-logs)
KINOTIC_VM_LOGS_DIR=

# Log shipping to Loki via a managed Grafana Alloy process (default: true)
KINOTIC_LOG_SHIPPING_ENABLED=true
# Base URL of the Loki HTTP API (default: http://localhost:3100)
KINOTIC_LOKI_URL=
# Alloy binary to run; when unset, `alloy` on the PATH is used, else the
# KINOTIC_ALLOY_VERSION release is downloaded to ~/.kinotic/alloy/bin
KINOTIC_ALLOY_PATH=
KINOTIC_ALLOY_VERSION=
