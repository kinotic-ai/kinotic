# Unique identifier for this vm-manager node
KINOTIC_NODE_ID=

# Kinotic server connection
KINOTIC_SERVER_HOST=localhost
KINOTIC_SERVER_PORT=58503

# The machine identity the vm-manager authenticates with: its id as KINOTIC_CLIENT_ID and the
# secret issued at provisioning as KINOTIC_CLIENT_SECRET. The machine must be SYSTEM scope — no
# organization or application — since that is what may host the VmManager service in the system zone.
KINOTIC_CLIENT_ID=
KINOTIC_CLIENT_SECRET=

# Heartbeat interval in milliseconds
KINOTIC_HEARTBEAT_INTERVAL_MS=30000

# Host directory holding per-VM log directories (default: ~/.kinotic/vm-logs)
KINOTIC_VM_LOGS_DIR=

# Base URL of the Loki HTTP API that workload logs are shipped to via a managed
# Grafana Alloy process; leave unset to disable log shipping
KINOTIC_LOKI_URL=

# Base directory every workload volume mount on this node must live under
# (default: /var/lib/kinotic/workloads, or ~/.kinotic/workloads on a BOXLITE node)
KINOTIC_WORKLOAD_DATA_DIR=
