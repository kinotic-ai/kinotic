{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"declaration": true,
		"isolatedDeclarations": true,
		// bunup resolves the "@/*" alias through baseUrl, so it must stay; silence the TS 6 baseUrl deprecation
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			]
		}
	},
	"include": ["src/**/*"],

}
