{
  "name": "@kinotic-ai/project-sync",
  "version": "5.0.0-beta.1",
  "type": "module",
  "description": "Synchronizes a Kinotic project's committed entity definitions (.config/c3) and migrations with the server over an already-connected Kinotic client. Code generation stays in the CLI; this package only pushes what generate committed.",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/kinotic-ai/kinotic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinotic-ai/kinotic.git",
    "directory": "kinotic-js/workspace/packages/project-sync"
  },
  "license": "Elastic License 2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "coverage": "bun test --coverage --pass-with-no-tests"
  },
  "peerDependencies": {
    "@kinotic-ai/core": ">=5.0.0-beta.5",
    "@kinotic-ai/idl": ">=5.0.0-beta.1",
    "@kinotic-ai/os-api": ">=5.0.0-beta.16"
  },
  "devDependencies": {
    "@kinotic-ai/core": "workspace:*",
    "@kinotic-ai/idl": "workspace:*",
    "@kinotic-ai/os-api": "workspace:*",
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
