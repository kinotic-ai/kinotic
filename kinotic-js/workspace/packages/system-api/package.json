{
  "name": "@kinotic-ai/system-api",
  "version": "5.0.0-beta.9",
  "type": "module",
  "description": "Client API for the Kinotic platform's system plane: the workload and node orchestration services platform machines and operators use.",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/kinotic-ai/kinotic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinotic-ai/kinotic.git",
    "directory": "kinotic-js/workspace/packages/system-api"
  },
  "license": "Elastic License 2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "coverage": "bun test --coverage --pass-with-no-tests"
  },
  "dependencies": {
    "@kinotic-ai/management-api": "workspace:^"
  },
  "peerDependencies": {
    "@kinotic-ai/core": ">=5.0.0-beta.9"
  },
  "devDependencies": {
    "@kinotic-ai/core": "workspace:*",
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
