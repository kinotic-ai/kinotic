{
    "name": "@kinotic-ai/kinotic-cli",
    "version": "5.2.0-beta.1",
    "description": "Kinotic CLI provides the ability to build, deploy, and manage Kinotic applications that run on the Kinotic OS.",
    "author": "Kinotic Developers",
    "bin": {
        "kinotic": "./bin/run.js"
    },
    "homepage": "https://kinotic-ai",
    "repository": "https://github.com/kinotic-ai/kinotic",
    "license": "Elastic License 2.0\"",
    "main": "dist/index.js",
    "type": "module",
    "files": [
        "/bin",
        "/dist",
        "/npm-shrinkwrap.json"
    ],
    "dependencies": {
        "@inquirer/prompts": "^8.3.2",
        "@kinotic-ai/core": "^5.0.0-beta.2",
        "@kinotic-ai/idl": "^5.0.0-beta.0",
        "@kinotic-ai/os-api": "^5.0.0-beta.3",
        "@kinotic-ai/persistence": "^5.0.0-beta.2",
        "@kinotic-ai/spawn": "^5.0.0-beta.0",
        "@oclif/core": "^4.9.0",
        "c12": "^3.3.3",
        "chalk": "^5.6.2",
        "liquidjs": "10.27.0",
        "open": "^11.0.0",
        "p-timeout": "^7.0.1",
        "radash": "^12.1.1",
        "simple-git": "3.36.0",
        "ts-morph": "^27.0.2"
    },
    "devDependencies": {
        "@types/chai": "^5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.5.0",
        "chai": "^6",
        "eslint": "^9",
        "eslint-config-prettier": "^10",
        "mocha": "^11",
        "shx": "^0.4.0",
        "tsc-alias": "^1.8.16",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "oclif": {
        "bin": "kinotic",
        "dirname": "kinotic",
        "commands": "./dist/commands",
        "topicSeparator": " ",
        "topics": {
            "spawn": {
                "description": "Works with Kinotic spawn templates"
            }
        }
    },
    "scripts": {
        "build": "shx rm -rf dist && tsc -b && tsc-alias -f && pnpm run copy-files",
        "lint": "eslint . --ext .ts --config .eslintrc",
        "prepack": "pnpm build",
        "test": "mocha --forbid-only \"test/**/*.test.ts\"",
        "version": "git add README.md",
        "copy-files": "cp -r ./src/templates/  ./dist/templates/",
        "prepublishOnly": "node -e \"if(require('./package.json').version.includes('-beta.')&&!process.env.KINOTIC_BETA_PUBLISH){console.error('This is a beta prerelease; publish it with: pnpm release');process.exit(1)}\"",
        "release": "KINOTIC_BETA_PUBLISH=1 pnpm publish --tag beta"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [],
    "types": "dist/index.d.ts"
}
