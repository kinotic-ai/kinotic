{
    // The servers run in docker compose (deployment/docker-compose); these run the UIs and the
    // vm-manager node from source against them. .vscode/DEBUGGING.md walks through each.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Portal: Dev Server",
            "request": "launch",
            "type": "node-terminal",
            "command": "pnpm dev",
            "cwd": "${workspaceFolder}/kinotic-frontend"
        },
        {
            "name": "System Console: Dev Server",
            "request": "launch",
            "type": "node-terminal",
            "command": "pnpm dev:system",
            "cwd": "${workspaceFolder}/kinotic-frontend"
        },
        {
            "name": "Portal: Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/kinotic-frontend/apps/portal",
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
        },
        {
            "name": "System Console: Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5174",
            "webRoot": "${workspaceFolder}/kinotic-frontend/apps/system",
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
        },
        {
            "name": "Chrome: Attach",
            "request": "attach",
            "type": "chrome",
            "port": 9222,
            "webRoot": "${workspaceFolder}/kinotic-frontend/apps/portal"
        },
        {
            "name": "vm-manager Node",
            "request": "launch",
            "type": "node-terminal",
            "command": "bun run dev",
            "cwd": "${workspaceFolder}/kinotic-js/workspace/packages/vm-manager"
        }
    ]
}
