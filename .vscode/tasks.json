{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compose: Up",
            "detail": "Start the servers, the UIs and their infrastructure in docker compose",
            "type": "shell",
            "command": "docker compose up -d",
            "options": {
                "cwd": "${workspaceFolder}/deployment/docker-compose"
            },
            "problemMatcher": []
        },
        {
            "label": "Compose: Down",
            "detail": "Stop the compose stack, keeping its data",
            "type": "shell",
            "command": "docker compose down",
            "options": {
                "cwd": "${workspaceFolder}/deployment/docker-compose"
            },
            "problemMatcher": []
        },
        {
            "label": "Gradle: Build Server Images",
            "detail": "Build the server and migration images compose runs from the working tree",
            "type": "shell",
            "command": "./gradlew :kinotic-server-management:bootBuildImage :kinotic-server-system:bootBuildImage :kinotic-server-app:bootBuildImage :kinotic-migration:bootBuildImage",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Frontend: Install Dependencies",
            "type": "shell",
            "command": "pnpm install",
            "options": {
                "cwd": "${workspaceFolder}/kinotic-frontend"
            },
            "problemMatcher": []
        },
        {
            "label": "Frontend: Build",
            "type": "shell",
            "command": "pnpm build",
            "options": {
                "cwd": "${workspaceFolder}/kinotic-frontend"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
