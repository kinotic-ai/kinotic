m":234,"icon":235},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":237,"path":238,"stem":239,"icon":174},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":241,"path":242,"stem":243,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":245,"path":246,"stem":247,"icon":248},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":250,"path":251,"stem":252,"icon":253},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":255,"path":256,"stem":257,"icon":258},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":260,"title":250,"body":261,"description":774,"extension":775,"links":776,"meta":777,"navigation":778,"path":251,"seo":779,"stem":252,"__hash__":780},"docs\u002F04.platform\u002F14.supply-chain-security.md",{"type":262,"value":263,"toc":758},"minimark",[264,268,281,286,346,350,354,456,460,520,524,584,588,623,627,673,677],[265,266,26],"h2",{"id":267},"overview",[269,270,271,272,276,277,280],"p",{},"Every Kinotic service image is inventoried and scanned for known vulnerabilities before it is published. An image with a Critical vulnerability that has a published fix is never promoted to Docker Hub. Every control on this page runs automatically in the ",[273,274,275],"code",{},"Build and Publish"," workflow (",[273,278,279],{},".github\u002Fworkflows\u002Fgradle-build.yml","), and each one leaves evidence in GitHub.",[282,283,285],"h3",{"id":284},"scope","Scope",[287,288,289,302],"table",{},[290,291,292],"thead",{},[293,294,295,299],"tr",{},[296,297,298],"th",{},"Image",[296,300,301],{},"Published as",[303,304,305,316,326,336],"tbody",{},[293,306,307,311],{},[308,309,310],"td",{},"Kinotic management server",[308,312,313],{},[273,314,315],{},"kinoticai\u002Fkinotic-server-management",[293,317,318,321],{},[308,319,320],{},"Kinotic system server",[308,322,323],{},[273,324,325],{},"kinoticai\u002Fkinotic-server-system",[293,327,328,331],{},[308,329,330],{},"Kinotic app server",[308,332,333],{},[273,334,335],{},"kinoticai\u002Fkinotic-server-app",[293,337,338,341],{},[308,339,340],{},"Kinotic migration",[308,342,343],{},[273,344,345],{},"kinoticai\u002Fkinotic-migration",[265,347,349],{"id":348},"controls","Controls",[282,351,353],{"id":352},"software-inventory-sbom","Software inventory (SBOM)",[287,355,356,364],{},[290,357,358],{},[293,359,360,362],{},[296,361],{},[296,363],{},[303,365,366,377,395,413,446],{},[293,367,368,374],{},[308,369,370],{},[371,372,373],"strong",{},"Control",[308,375,376],{},"Each build produces a software bill of materials for each image, one for its amd64 build and one for its arm64 build, the two platforms its published tag holds. It lists every operating-system package and application library in the image, with its version.",[293,378,379,384],{},[308,380,381],{},[371,382,383],{},"Format",[308,385,386,387,394],{},"CycloneDX JSON, generated with ",[388,389,393],"a",{"href":390,"rel":391},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fsyft",[392],"nofollow","Syft"," from the built image, not from source manifests. The inventory therefore matches what runs.",[293,396,397,402],{},[308,398,399],{},[371,400,401],{},"Frequency",[308,403,404,405,408,409,412],{},"Every build of the images: each pull request into ",[273,406,407],{},"develop"," or ",[273,410,411],{},"main",", each push to them that changes application code, and nightly.",[293,414,415,420],{},[308,416,417],{},[371,418,419],{},"Evidence",[308,421,422,423,426,427,426,430,433,434,437,438,441,442,445],{},"Workflow run artifacts named ",[273,424,425],{},"sbom-kinotic-server-management.cdx.json",", ",[273,428,429],{},"sbom-kinotic-server-system.cdx.json",[273,431,432],{},"sbom-kinotic-server-app.cdx.json"," and ",[273,435,436],{},"sbom-kinotic-migration.cdx.json"," for the amd64 builds, and the same names with ",[273,439,440],{},"-arm64"," before ",[273,443,444],{},".cdx.json"," for the arm64 builds.",[293,447,448,453],{},[308,449,450],{},[371,451,452],{},"Retention",[308,454,455],{},"90 days.",[282,457,459],{"id":458},"vulnerability-scanning","Vulnerability scanning",[287,461,462,470],{},[290,463,464],{},[293,465,466,468],{},[296,467],{},[296,469],{},[303,471,472,486,495],{},[293,473,474,478],{},[308,475,476],{},[371,477,373],{},[308,479,480,485],{},[388,481,484],{"href":482,"rel":483},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fgrype",[392],"Grype"," scans each image's SBOM against current vulnerability advisories: GitHub Security Advisories, the National Vulnerability Database, and operating-system vendor feeds. The scan covers the same artifact the inventory records.",[293,487,488,492],{},[308,489,490],{},[371,491,401],{},[308,493,494],{},"Every build, including each pull request, and nightly. The nightly run checks newly published advisories against the current images.",[293,496,497,501],{},[308,498,499],{},[371,500,419],{},[308,502,503,504,426,507,426,510,433,513,516,517,519],{},"Findings of every severity are recorded as GitHub code scanning alerts in the categories ",[273,505,506],{},"image-kinotic-server-management",[273,508,509],{},"image-kinotic-server-system",[273,511,512],{},"image-kinotic-server-app",[273,514,515],{},"image-kinotic-migration"," for the amd64 builds, and the same categories with ",[273,518,440],{}," appended for the arm64 builds, with open and fixed history per finding. Each workflow run's summary lists the fixable findings for each image and platform.",[282,521,523],{"id":522},"release-gate","Release gate",[287,525,526,534],{},[290,527,528],{},[293,529,530,532],{},[296,531],{},[296,533],{},[303,535,536,554,564],{},[293,537,538,542],{},[308,539,540],{},[371,541,373],{},[308,543,544,545,548,549,408,551,553],{},"A build fails when either image has a ",[371,546,547],{},"Critical"," vulnerability with a published fix. On a pull request, the failure is reported on the change before it merges. Only an image from a fully passing build of ",[273,550,407],{},[273,552,411],{}," is promoted from the staging registry (ghcr.io) to Docker Hub.",[293,555,556,561],{},[308,557,558],{},[371,559,560],{},"Effect",[308,562,563],{},"An image is published only when, at build time, it has no known Critical vulnerability with an available fix.",[293,565,566,570],{},[308,567,568],{},[371,569,419],{},[308,571,572,573,576,577,580,581,583],{},"The ",[273,574,575],{},"SBOM and Vulnerability Scan"," jobs and the ",[273,578,579],{},"Build Result"," job of each workflow run. ",[273,582,579],{}," performs the promotion and records which job withheld it.",[282,585,587],{"id":586},"integrity-of-the-scanning-tools","Integrity of the scanning tools",[287,589,590,598],{},[290,591,592],{},[293,593,594,596],{},[296,595],{},[296,597],{},[303,599,600,609],{},[293,601,602,606],{},[308,603,604],{},[371,605,373],{},[308,607,608],{},"Third-party actions in the scan job are pinned to full commit SHAs rather than version tags, so a repointed tag cannot change the code that runs. The scan job has read-only access to repository contents and holds no publishing, signing or deployment credentials.",[293,610,611,616],{},[308,612,613],{},[371,614,615],{},"Maintenance",[308,617,618,619,622],{},"Dependabot proposes updates to every workflow action weekly, including the pinned SHAs (",[273,620,621],{},".github\u002Fdependabot.yml",").",[282,624,626],{"id":625},"source-code-analysis","Source code analysis",[287,628,629,637],{},[290,630,631],{},[293,632,633,635],{},[296,634],{},[296,636],{},[303,638,639,648,660],{},[293,640,641,645],{},[308,642,643],{},[371,644,373],{},[308,646,647],{},"CodeQL static analysis of the Java and TypeScript source.",[293,649,650,654],{},[308,651,652],{},[371,653,401],{},[308,655,656,657,659],{},"Every push to ",[273,658,407],{},", and weekly.",[293,661,662,666],{},[308,663,664],{},[371,665,419],{},[308,667,668,669,672],{},"GitHub code scanning alerts from the ",[273,670,671],{},"CodeQL"," workflow.",[265,674,676],{"id":675},"control-mapping","Control mapping",[287,678,679,694],{},[290,680,681],{},[293,682,683,685,688,691],{},[296,684,373],{},[296,686,687],{},"NIST SP 800-171 Rev 2",[296,689,690],{},"SOC 2",[296,692,693],{},"ISO\u002FIEC 27001:2022",[303,695,696,709,721,734,747],{},[293,697,698,700,703,706],{},[308,699,353],{},[308,701,702],{},"3.4.1",[308,704,705],{},"CC7.1",[308,707,708],{},"A.5.9, A.8.9",[293,710,711,713,716,718],{},[308,712,459],{},[308,714,715],{},"3.11.2",[308,717,705],{},[308,719,720],{},"A.8.8",[293,722,723,725,728,731],{},[308,724,523],{},[308,726,727],{},"3.11.3, 3.14.1",[308,729,730],{},"CC7.1, CC8.1",[308,732,733],{},"A.8.8, A.8.32",[293,735,736,738,741,744],{},[308,737,587],{},[308,739,740],{},"3.4.1, 3.14.1",[308,742,743],{},"CC8.1",[308,745,746],{},"A.8.25, A.8.28",[293,748,749,751,753,755],{},[308,750,626],{},[308,752,715],{},[308,754,705],{},[308,756,757],{},"A.8.28",{"title":759,"searchDepth":760,"depth":760,"links":761},"",2,[762,766,773],{"id":267,"depth":760,"text":26,"children":763},[764],{"id":284,"depth":765,"text":285},3,{"id":348,"depth":760,"text":349,"children":767},[768,769,770,771,772],{"id":352,"depth":765,"text":353},{"id":458,"depth":765,"text":459},{"id":522,"depth":765,"text":523},{"id":586,"depth":765,"text":587},{"id":625,"depth":765,"text":626},{"id":675,"depth":760,"text":676},"How Kinotic inventories, scans and gates the container images it publishes, and where the evidence for each control is kept.","md",null,{},{"icon":253},{"title":250,"description":774},"3bxL12YLlGxJ2XhWn3LghQJw0kqDVah8TbqiylwY34M",[782,784],{"title":245,"path":246,"stem":247,"description":783,"icon":248,"children":-1},"A development environment for a few peers on one physical host, what it keeps in Azure, and how their applications move to Kinotic Cloud.",{"title":255,"path":256,"stem":257,"description":785,"icon":258,"children":-1},"Which parts of Kinotic are Enterprise Features, what running them in production requires, and how the license treats substitute implementations.",1793107377618]