m":234,"icon":235},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":237,"path":238,"stem":239,"icon":174},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":241,"path":242,"stem":243,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":245,"path":246,"stem":247,"icon":248},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":250,"path":251,"stem":252,"icon":253},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":255,"path":256,"stem":257,"icon":258},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":260,"title":250,"body":261,"description":763,"extension":764,"links":765,"meta":766,"navigation":767,"path":251,"seo":768,"stem":252,"__hash__":769},"docs\u002F04.platform\u002F14.supply-chain-security.md",{"type":262,"value":263,"toc":747},"minimark",[264,268,281,286,346,350,354,448,452,509,513,573,577,612,616,662,666],[265,266,26],"h2",{"id":267},"overview",[269,270,271,272,276,277,280],"p",{},"Every Kinotic service image is inventoried and scanned for known vulnerabilities before it is published. An image with a Critical vulnerability that has a published fix is never promoted to Docker Hub. Every control on this page runs automatically in the ",[273,274,275],"code",{},"Build and Publish"," workflow (",[273,278,279],{},".github\u002Fworkflows\u002Fgradle-build.yml","), and each one leaves evidence in GitHub.",[282,283,285],"h3",{"id":284},"scope","Scope",[287,288,289,302],"table",{},[290,291,292],"thead",{},[293,294,295,299],"tr",{},[296,297,298],"th",{},"Image",[296,300,301],{},"Published as",[303,304,305,316,326,336],"tbody",{},[293,306,307,311],{},[308,309,310],"td",{},"Kinotic management server",[308,312,313],{},[273,314,315],{},"kinoticai\u002Fkinotic-server-management",[293,317,318,321],{},[308,319,320],{},"Kinotic system server",[308,322,323],{},[273,324,325],{},"kinoticai\u002Fkinotic-server-system",[293,327,328,331],{},[308,329,330],{},"Kinotic app server",[308,332,333],{},[273,334,335],{},"kinoticai\u002Fkinotic-server-app",[293,337,338,341],{},[308,339,340],{},"Kinotic migration",[308,342,343],{},[273,344,345],{},"kinoticai\u002Fkinotic-migration",[265,347,349],{"id":348},"controls","Controls",[282,351,353],{"id":352},"software-inventory-sbom","Software inventory (SBOM)",[287,355,356,364],{},[290,357,358],{},[293,359,360,362],{},[296,361],{},[296,363],{},[303,365,366,377,395,413,438],{},[293,367,368,374],{},[308,369,370],{},[371,372,373],"strong",{},"Control",[308,375,376],{},"Each build produces a software bill of materials for each image. It lists every operating-system package and application library in the image, with its version.",[293,378,379,384],{},[308,380,381],{},[371,382,383],{},"Format",[308,385,386,387,394],{},"CycloneDX JSON, generated with ",[388,389,393],"a",{"href":390,"rel":391},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fsyft",[392],"nofollow","Syft"," from the built image, not from source manifests. The inventory therefore matches what runs.",[293,396,397,402],{},[308,398,399],{},[371,400,401],{},"Frequency",[308,403,404,405,408,409,412],{},"Every build of the images: each pull request into ",[273,406,407],{},"develop"," or ",[273,410,411],{},"main",", each push to them that changes application code, and nightly.",[293,414,415,420],{},[308,416,417],{},[371,418,419],{},"Evidence",[308,421,422,423,426,427,426,430,433,434,437],{},"Workflow run artifacts named ",[273,424,425],{},"sbom-kinotic-server-management.cdx.json",", ",[273,428,429],{},"sbom-kinotic-server-system.cdx.json",[273,431,432],{},"sbom-kinotic-server-app.cdx.json"," and ",[273,435,436],{},"sbom-kinotic-migration.cdx.json",".",[293,439,440,445],{},[308,441,442],{},[371,443,444],{},"Retention",[308,446,447],{},"90 days.",[282,449,451],{"id":450},"vulnerability-scanning","Vulnerability scanning",[287,453,454,462],{},[290,455,456],{},[293,457,458,460],{},[296,459],{},[296,461],{},[303,463,464,478,487],{},[293,465,466,470],{},[308,467,468],{},[371,469,373],{},[308,471,472,477],{},[388,473,476],{"href":474,"rel":475},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fgrype",[392],"Grype"," scans each image's SBOM against current vulnerability advisories: GitHub Security Advisories, the National Vulnerability Database, and operating-system vendor feeds. The scan covers the same artifact the inventory records.",[293,479,480,484],{},[308,481,482],{},[371,483,401],{},[308,485,486],{},"Every build, including each pull request, and nightly. The nightly run checks newly published advisories against the current images.",[293,488,489,493],{},[308,490,491],{},[371,492,419],{},[308,494,495,496,426,499,426,502,433,505,508],{},"Findings of every severity are recorded as GitHub code scanning alerts in the categories ",[273,497,498],{},"image-kinotic-server-management",[273,500,501],{},"image-kinotic-server-system",[273,503,504],{},"image-kinotic-server-app",[273,506,507],{},"image-kinotic-migration",", with open and fixed history per finding. Each workflow run's summary lists the fixable findings for each image.",[282,510,512],{"id":511},"release-gate","Release gate",[287,514,515,523],{},[290,516,517],{},[293,518,519,521],{},[296,520],{},[296,522],{},[303,524,525,543,553],{},[293,526,527,531],{},[308,528,529],{},[371,530,373],{},[308,532,533,534,537,538,408,540,542],{},"A build fails when either image has a ",[371,535,536],{},"Critical"," vulnerability with a published fix. On a pull request, the failure is reported on the change before it merges. Only an image from a fully passing build of ",[273,539,407],{},[273,541,411],{}," is promoted from the staging registry (ghcr.io) to Docker Hub.",[293,544,545,550],{},[308,546,547],{},[371,548,549],{},"Effect",[308,551,552],{},"An image is published only when, at build time, it has no known Critical vulnerability with an available fix.",[293,554,555,559],{},[308,556,557],{},[371,558,419],{},[308,560,561,562,565,566,569,570,572],{},"The ",[273,563,564],{},"SBOM and Vulnerability Scan"," jobs and the ",[273,567,568],{},"Build Result"," job of each workflow run. ",[273,571,568],{}," performs the promotion and records which job withheld it.",[282,574,576],{"id":575},"integrity-of-the-scanning-tools","Integrity of the scanning tools",[287,578,579,587],{},[290,580,581],{},[293,582,583,585],{},[296,584],{},[296,586],{},[303,588,589,598],{},[293,590,591,595],{},[308,592,593],{},[371,594,373],{},[308,596,597],{},"Third-party actions in the scan job are pinned to full commit SHAs rather than version tags, so a repointed tag cannot change the code that runs. The scan job has read-only access to repository contents and holds no publishing, signing or deployment credentials.",[293,599,600,605],{},[308,601,602],{},[371,603,604],{},"Maintenance",[308,606,607,608,611],{},"Dependabot proposes updates to every workflow action weekly, including the pinned SHAs (",[273,609,610],{},".github\u002Fdependabot.yml",").",[282,613,615],{"id":614},"source-code-analysis","Source code analysis",[287,617,618,626],{},[290,619,620],{},[293,621,622,624],{},[296,623],{},[296,625],{},[303,627,628,637,649],{},[293,629,630,634],{},[308,631,632],{},[371,633,373],{},[308,635,636],{},"CodeQL static analysis of the Java and TypeScript source.",[293,638,639,643],{},[308,640,641],{},[371,642,401],{},[308,644,645,646,648],{},"Every push to ",[273,647,407],{},", and weekly.",[293,650,651,655],{},[308,652,653],{},[371,654,419],{},[308,656,657,658,661],{},"GitHub code scanning alerts from the ",[273,659,660],{},"CodeQL"," workflow.",[265,663,665],{"id":664},"control-mapping","Control mapping",[287,667,668,683],{},[290,669,670],{},[293,671,672,674,677,680],{},[296,673,373],{},[296,675,676],{},"NIST SP 800-171 Rev 2",[296,678,679],{},"SOC 2",[296,681,682],{},"ISO\u002FIEC 27001:2022",[303,684,685,698,710,723,736],{},[293,686,687,689,692,695],{},[308,688,353],{},[308,690,691],{},"3.4.1",[308,693,694],{},"CC7.1",[308,696,697],{},"A.5.9, A.8.9",[293,699,700,702,705,707],{},[308,701,451],{},[308,703,704],{},"3.11.2",[308,706,694],{},[308,708,709],{},"A.8.8",[293,711,712,714,717,720],{},[308,713,512],{},[308,715,716],{},"3.11.3, 3.14.1",[308,718,719],{},"CC7.1, CC8.1",[308,721,722],{},"A.8.8, A.8.32",[293,724,725,727,730,733],{},[308,726,576],{},[308,728,729],{},"3.4.1, 3.14.1",[308,731,732],{},"CC8.1",[308,734,735],{},"A.8.25, A.8.28",[293,737,738,740,742,744],{},[308,739,615],{},[308,741,704],{},[308,743,694],{},[308,745,746],{},"A.8.28",{"title":748,"searchDepth":749,"depth":749,"links":750},"",2,[751,755,762],{"id":267,"depth":749,"text":26,"children":752},[753],{"id":284,"depth":754,"text":285},3,{"id":348,"depth":749,"text":349,"children":756},[757,758,759,760,761],{"id":352,"depth":754,"text":353},{"id":450,"depth":754,"text":451},{"id":511,"depth":754,"text":512},{"id":575,"depth":754,"text":576},{"id":614,"depth":754,"text":615},{"id":664,"depth":749,"text":665},"How Kinotic inventories, scans and gates the container images it publishes, and where the evidence for each control is kept.","md",null,{},{"icon":253},{"title":250,"description":763},"fjeOTcdWoNBlpceNYEblMvoJhkAijBWuUFpMXOKtBxo",[771,773],{"title":245,"path":246,"stem":247,"description":772,"icon":248,"children":-1},"A development environment for a few peers on one physical host, what it keeps in Azure, and how their applications move to Kinotic Cloud.",{"title":255,"path":256,"stem":257,"description":774,"icon":258,"children":-1},"Which parts of Kinotic are Enterprise Features, what running them in production requires, and how the license treats substitute implementations.",1793013820360]