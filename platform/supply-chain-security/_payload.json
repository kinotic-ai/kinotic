nsion":733,"links":734,"meta":735,"navigation":736,"path":225,"seo":737,"stem":226,"__hash__":738},"docs\u002F02.platform\u002F14.supply-chain-security.md",{"type":231,"value":232,"toc":716},"minimark",[233,237,250,255,315,319,323,417,421,478,482,542,546,581,585,631,635],[234,235,25],"h2",{"id":236},"overview",[238,239,240,241,245,246,249],"p",{},"Every Kinotic service image is inventoried and scanned for known vulnerabilities before it is published. An image with a Critical vulnerability that has a published fix is never promoted to Docker Hub. Every control on this page runs automatically in the ",[242,243,244],"code",{},"Build and Publish"," workflow (",[242,247,248],{},".github\u002Fworkflows\u002Fgradle-build.yml","), and each one leaves evidence in GitHub.",[251,252,254],"h3",{"id":253},"scope","Scope",[256,257,258,271],"table",{},[259,260,261],"thead",{},[262,263,264,268],"tr",{},[265,266,267],"th",{},"Image",[265,269,270],{},"Published as",[272,273,274,285,295,305],"tbody",{},[262,275,276,280],{},[277,278,279],"td",{},"Kinotic management server",[277,281,282],{},[242,283,284],{},"kinoticai\u002Fkinotic-server-management",[262,286,287,290],{},[277,288,289],{},"Kinotic system server",[277,291,292],{},[242,293,294],{},"kinoticai\u002Fkinotic-server-system",[262,296,297,300],{},[277,298,299],{},"Kinotic app server",[277,301,302],{},[242,303,304],{},"kinoticai\u002Fkinotic-server-app",[262,306,307,310],{},[277,308,309],{},"Kinotic migration",[277,311,312],{},[242,313,314],{},"kinoticai\u002Fkinotic-migration",[234,316,318],{"id":317},"controls","Controls",[251,320,322],{"id":321},"software-inventory-sbom","Software inventory (SBOM)",[256,324,325,333],{},[259,326,327],{},[262,328,329,331],{},[265,330],{},[265,332],{},[272,334,335,346,364,382,407],{},[262,336,337,343],{},[277,338,339],{},[340,341,342],"strong",{},"Control",[277,344,345],{},"Each build produces a software bill of materials for each image. It lists every operating-system package and application library in the image, with its version.",[262,347,348,353],{},[277,349,350],{},[340,351,352],{},"Format",[277,354,355,356,363],{},"CycloneDX JSON, generated with ",[357,358,362],"a",{"href":359,"rel":360},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fsyft",[361],"nofollow","Syft"," from the built image, not from source manifests. The inventory therefore matches what runs.",[262,365,366,371],{},[277,367,368],{},[340,369,370],{},"Frequency",[277,372,373,374,377,378,381],{},"Every build of the images: each pull request into ",[242,375,376],{},"develop"," or ",[242,379,380],{},"main",", each push to them that changes application code, and nightly.",[262,383,384,389],{},[277,385,386],{},[340,387,388],{},"Evidence",[277,390,391,392,395,396,395,399,402,403,406],{},"Workflow run artifacts named ",[242,393,394],{},"sbom-kinotic-server-management.cdx.json",", ",[242,397,398],{},"sbom-kinotic-server-system.cdx.json",[242,400,401],{},"sbom-kinotic-server-app.cdx.json"," and ",[242,404,405],{},"sbom-kinotic-migration.cdx.json",".",[262,408,409,414],{},[277,410,411],{},[340,412,413],{},"Retention",[277,415,416],{},"90 days.",[251,418,420],{"id":419},"vulnerability-scanning","Vulnerability scanning",[256,422,423,431],{},[259,424,425],{},[262,426,427,429],{},[265,428],{},[265,430],{},[272,432,433,447,456],{},[262,434,435,439],{},[277,436,437],{},[340,438,342],{},[277,440,441,446],{},[357,442,445],{"href":443,"rel":444},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fgrype",[361],"Grype"," scans each image's SBOM against current vulnerability advisories: GitHub Security Advisories, the National Vulnerability Database, and operating-system vendor feeds. The scan covers the same artifact the inventory records.",[262,448,449,453],{},[277,450,451],{},[340,452,370],{},[277,454,455],{},"Every build, including each pull request, and nightly. The nightly run checks newly published advisories against the current images.",[262,457,458,462],{},[277,459,460],{},[340,461,388],{},[277,463,464,465,395,468,395,471,402,474,477],{},"Findings of every severity are recorded as GitHub code scanning alerts in the categories ",[242,466,467],{},"image-kinotic-server-management",[242,469,470],{},"image-kinotic-server-system",[242,472,473],{},"image-kinotic-server-app",[242,475,476],{},"image-kinotic-migration",", with open and fixed history per finding. Each workflow run's summary lists the fixable findings for each image.",[251,479,481],{"id":480},"release-gate","Release gate",[256,483,484,492],{},[259,485,486],{},[262,487,488,490],{},[265,489],{},[265,491],{},[272,493,494,512,522],{},[262,495,496,500],{},[277,497,498],{},[340,499,342],{},[277,501,502,503,506,507,377,509,511],{},"A build fails when either image has a ",[340,504,505],{},"Critical"," vulnerability with a published fix. On a pull request, the failure is reported on the change before it merges. Only an image from a fully passing build of ",[242,508,376],{},[242,510,380],{}," is promoted from the staging registry (ghcr.io) to Docker Hub.",[262,513,514,519],{},[277,515,516],{},[340,517,518],{},"Effect",[277,520,521],{},"An image is published only when, at build time, it has no known Critical vulnerability with an available fix.",[262,523,524,528],{},[277,525,526],{},[340,527,388],{},[277,529,530,531,534,535,538,539,541],{},"The ",[242,532,533],{},"SBOM and Vulnerability Scan"," jobs and the ",[242,536,537],{},"Build Result"," job of each workflow run. ",[242,540,537],{}," performs the promotion and records which job withheld it.",[251,543,545],{"id":544},"integrity-of-the-scanning-tools","Integrity of the scanning tools",[256,547,548,556],{},[259,549,550],{},[262,551,552,554],{},[265,553],{},[265,555],{},[272,557,558,567],{},[262,559,560,564],{},[277,561,562],{},[340,563,342],{},[277,565,566],{},"Third-party actions in the scan job are pinned to full commit SHAs rather than version tags, so a repointed tag cannot change the code that runs. The scan job has read-only access to repository contents and holds no publishing, signing or deployment credentials.",[262,568,569,574],{},[277,570,571],{},[340,572,573],{},"Maintenance",[277,575,576,577,580],{},"Dependabot proposes updates to every workflow action weekly, including the pinned SHAs (",[242,578,579],{},".github\u002Fdependabot.yml",").",[251,582,584],{"id":583},"source-code-analysis","Source code analysis",[256,586,587,595],{},[259,588,589],{},[262,590,591,593],{},[265,592],{},[265,594],{},[272,596,597,606,618],{},[262,598,599,603],{},[277,600,601],{},[340,602,342],{},[277,604,605],{},"CodeQL static analysis of the Java and TypeScript source.",[262,607,608,612],{},[277,609,610],{},[340,611,370],{},[277,613,614,615,617],{},"Every push to ",[242,616,376],{},", and weekly.",[262,619,620,624],{},[277,621,622],{},[340,623,388],{},[277,625,626,627,630],{},"GitHub code scanning alerts from the ",[242,628,629],{},"CodeQL"," workflow.",[234,632,634],{"id":633},"control-mapping","Control mapping",[256,636,637,652],{},[259,638,639],{},[262,640,641,643,646,649],{},[265,642,342],{},[265,644,645],{},"NIST SP 800-171 Rev 2",[265,647,648],{},"SOC 2",[265,650,651],{},"ISO\u002FIEC 27001:2022",[272,653,654,667,679,692,705],{},[262,655,656,658,661,664],{},[277,657,322],{},[277,659,660],{},"3.4.1",[277,662,663],{},"CC7.1",[277,665,666],{},"A.5.9, A.8.9",[262,668,669,671,674,676],{},[277,670,420],{},[277,672,673],{},"3.11.2",[277,675,663],{},[277,677,678],{},"A.8.8",[262,680,681,683,686,689],{},[277,682,481],{},[277,684,685],{},"3.11.3, 3.14.1",[277,687,688],{},"CC7.1, CC8.1",[277,690,691],{},"A.8.8, A.8.32",[262,693,694,696,699,702],{},[277,695,545],{},[277,697,698],{},"3.4.1, 3.14.1",[277,700,701],{},"CC8.1",[277,703,704],{},"A.8.25, A.8.28",[262,706,707,709,711,713],{},[277,708,584],{},[277,710,673],{},[277,712,663],{},[277,714,715],{},"A.8.28",{"title":717,"searchDepth":718,"depth":718,"links":719},"",2,[720,724,731],{"id":236,"depth":718,"text":25,"children":721},[722],{"id":253,"depth":723,"text":254},3,{"id":317,"depth":718,"text":318,"children":725},[726,727,728,729,730],{"id":321,"depth":723,"text":322},{"id":419,"depth":723,"text":420},{"id":480,"depth":723,"text":481},{"id":544,"depth":723,"text":545},{"id":583,"depth":723,"text":584},{"id":633,"depth":718,"text":634},"How Kinotic inventories, scans and gates the container images it publishes, and where the evidence for each control is kept.","md",null,{},{"icon":227},{"title":224,"description":732},"3FixwyRonm5i0gKGY2XUeOsvjLbuw9386XMdooPBBwM",[740,734],{"title":219,"path":220,"stem":221,"description":741,"icon":222,"children":-1},"A development environment for a few peers on one physical host, what it keeps in Azure, and how their applications move to Kinotic Cloud.",1790827095079]