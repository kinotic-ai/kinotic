nsion":700,"links":701,"meta":702,"navigation":703,"path":225,"seo":704,"stem":226,"__hash__":705},"docs\u002F02.platform\u002F14.supply-chain-security.md",{"type":231,"value":232,"toc":683},"minimark",[233,237,250,255,295,299,303,390,394,445,449,509,513,548,552,598,602],[234,235,25],"h2",{"id":236},"overview",[238,239,240,241,245,246,249],"p",{},"Every Kinotic service image is inventoried and scanned for known vulnerabilities before it is published. An image with a Critical vulnerability that has a published fix is never promoted to Docker Hub. Every control on this page runs automatically in the ",[242,243,244],"code",{},"Build and Publish"," workflow (",[242,247,248],{},".github\u002Fworkflows\u002Fgradle-build.yml","), and each one leaves evidence in GitHub.",[251,252,254],"h3",{"id":253},"scope","Scope",[256,257,258,271],"table",{},[259,260,261],"thead",{},[262,263,264,268],"tr",{},[265,266,267],"th",{},"Image",[265,269,270],{},"Published as",[272,273,274,285],"tbody",{},[262,275,276,280],{},[277,278,279],"td",{},"Kinotic server",[277,281,282],{},[242,283,284],{},"kinoticai\u002Fkinotic-server",[262,286,287,290],{},[277,288,289],{},"Kinotic migration",[277,291,292],{},[242,293,294],{},"kinoticai\u002Fkinotic-migration",[234,296,298],{"id":297},"controls","Controls",[251,300,302],{"id":301},"software-inventory-sbom","Software inventory (SBOM)",[256,304,305,313],{},[259,306,307],{},[262,308,309,311],{},[265,310],{},[265,312],{},[272,314,315,326,344,362,380],{},[262,316,317,323],{},[277,318,319],{},[320,321,322],"strong",{},"Control",[277,324,325],{},"Each build produces a software bill of materials for each image. It lists every operating-system package and application library in the image, with its version.",[262,327,328,333],{},[277,329,330],{},[320,331,332],{},"Format",[277,334,335,336,343],{},"CycloneDX JSON, generated with ",[337,338,342],"a",{"href":339,"rel":340},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fsyft",[341],"nofollow","Syft"," from the built image, not from source manifests. The inventory therefore matches what runs.",[262,345,346,351],{},[277,347,348],{},[320,349,350],{},"Frequency",[277,352,353,354,357,358,361],{},"Every build of the images: each pull request into ",[242,355,356],{},"develop"," or ",[242,359,360],{},"main",", each push to them that changes application code, and nightly.",[262,363,364,369],{},[277,365,366],{},[320,367,368],{},"Evidence",[277,370,371,372,375,376,379],{},"Workflow run artifacts named ",[242,373,374],{},"sbom-kinotic-server.cdx.json"," and ",[242,377,378],{},"sbom-kinotic-migration.cdx.json",".",[262,381,382,387],{},[277,383,384],{},[320,385,386],{},"Retention",[277,388,389],{},"90 days.",[251,391,393],{"id":392},"vulnerability-scanning","Vulnerability scanning",[256,395,396,404],{},[259,397,398],{},[262,399,400,402],{},[265,401],{},[265,403],{},[272,405,406,420,429],{},[262,407,408,412],{},[277,409,410],{},[320,411,322],{},[277,413,414,419],{},[337,415,418],{"href":416,"rel":417},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fgrype",[341],"Grype"," scans each image's SBOM against current vulnerability advisories: GitHub Security Advisories, the National Vulnerability Database, and operating-system vendor feeds. The scan covers the same artifact the inventory records.",[262,421,422,426],{},[277,423,424],{},[320,425,350],{},[277,427,428],{},"Every build, including each pull request, and nightly. The nightly run checks newly published advisories against the current images.",[262,430,431,435],{},[277,432,433],{},[320,434,368],{},[277,436,437,438,375,441,444],{},"Findings of every severity are recorded as GitHub code scanning alerts in the categories ",[242,439,440],{},"image-kinotic-server",[242,442,443],{},"image-kinotic-migration",", with open and fixed history per finding. Each workflow run's summary lists the fixable findings for each image.",[251,446,448],{"id":447},"release-gate","Release gate",[256,450,451,459],{},[259,452,453],{},[262,454,455,457],{},[265,456],{},[265,458],{},[272,460,461,479,489],{},[262,462,463,467],{},[277,464,465],{},[320,466,322],{},[277,468,469,470,473,474,357,476,478],{},"A build fails when either image has a ",[320,471,472],{},"Critical"," vulnerability with a published fix. On a pull request, the failure is reported on the change before it merges. Only an image from a fully passing build of ",[242,475,356],{},[242,477,360],{}," is promoted from the staging registry (ghcr.io) to Docker Hub.",[262,480,481,486],{},[277,482,483],{},[320,484,485],{},"Effect",[277,487,488],{},"An image is published only when, at build time, it has no known Critical vulnerability with an available fix.",[262,490,491,495],{},[277,492,493],{},[320,494,368],{},[277,496,497,498,501,502,505,506,508],{},"The ",[242,499,500],{},"SBOM and Vulnerability Scan"," jobs and the ",[242,503,504],{},"Build Result"," job of each workflow run. ",[242,507,504],{}," performs the promotion and records which job withheld it.",[251,510,512],{"id":511},"integrity-of-the-scanning-tools","Integrity of the scanning tools",[256,514,515,523],{},[259,516,517],{},[262,518,519,521],{},[265,520],{},[265,522],{},[272,524,525,534],{},[262,526,527,531],{},[277,528,529],{},[320,530,322],{},[277,532,533],{},"Third-party actions in the scan job are pinned to full commit SHAs rather than version tags, so a repointed tag cannot change the code that runs. The scan job has read-only access to repository contents and holds no publishing, signing or deployment credentials.",[262,535,536,541],{},[277,537,538],{},[320,539,540],{},"Maintenance",[277,542,543,544,547],{},"Dependabot proposes updates to every workflow action weekly, including the pinned SHAs (",[242,545,546],{},".github\u002Fdependabot.yml",").",[251,549,551],{"id":550},"source-code-analysis","Source code analysis",[256,553,554,562],{},[259,555,556],{},[262,557,558,560],{},[265,559],{},[265,561],{},[272,563,564,573,585],{},[262,565,566,570],{},[277,567,568],{},[320,569,322],{},[277,571,572],{},"CodeQL static analysis of the Java and TypeScript source.",[262,574,575,579],{},[277,576,577],{},[320,578,350],{},[277,580,581,582,584],{},"Every push to ",[242,583,356],{},", and weekly.",[262,586,587,591],{},[277,588,589],{},[320,590,368],{},[277,592,593,594,597],{},"GitHub code scanning alerts from the ",[242,595,596],{},"CodeQL"," workflow.",[234,599,601],{"id":600},"control-mapping","Control mapping",[256,603,604,619],{},[259,605,606],{},[262,607,608,610,613,616],{},[265,609,322],{},[265,611,612],{},"NIST SP 800-171 Rev 2",[265,614,615],{},"SOC 2",[265,617,618],{},"ISO\u002FIEC 27001:2022",[272,620,621,634,646,659,672],{},[262,622,623,625,628,631],{},[277,624,302],{},[277,626,627],{},"3.4.1",[277,629,630],{},"CC7.1",[277,632,633],{},"A.5.9, A.8.9",[262,635,636,638,641,643],{},[277,637,393],{},[277,639,640],{},"3.11.2",[277,642,630],{},[277,644,645],{},"A.8.8",[262,647,648,650,653,656],{},[277,649,448],{},[277,651,652],{},"3.11.3, 3.14.1",[277,654,655],{},"CC7.1, CC8.1",[277,657,658],{},"A.8.8, A.8.32",[262,660,661,663,666,669],{},[277,662,512],{},[277,664,665],{},"3.4.1, 3.14.1",[277,667,668],{},"CC8.1",[277,670,671],{},"A.8.25, A.8.28",[262,673,674,676,678,680],{},[277,675,551],{},[277,677,640],{},[277,679,630],{},[277,681,682],{},"A.8.28",{"title":684,"searchDepth":685,"depth":685,"links":686},"",2,[687,691,698],{"id":236,"depth":685,"text":25,"children":688},[689],{"id":253,"depth":690,"text":254},3,{"id":297,"depth":685,"text":298,"children":692},[693,694,695,696,697],{"id":301,"depth":690,"text":302},{"id":392,"depth":690,"text":393},{"id":447,"depth":690,"text":448},{"id":511,"depth":690,"text":512},{"id":550,"depth":690,"text":551},{"id":600,"depth":685,"text":601},"How Kinotic inventories, scans and gates the container images it publishes, and where the evidence for each control is kept.","md",null,{},{"icon":227},{"title":224,"description":699},"y-EXJIzUNJjX_wh4lAQbBxXUvXMG4xwkRMq3MUXWquA",[707,701],{"title":219,"path":220,"stem":221,"description":708,"icon":222,"children":-1},"A development environment for a few peers on one physical host, what it keeps in Azure, and how their applications move to Kinotic Cloud.",1790384334046]