:36},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","03.platform\u002F12.reference\u002F04.sign-in-design",{"title":254,"path":255,"stem":256,"icon":257},"Development Server","\u002Fplatform\u002Fdevelopment-server","03.platform\u002F13.development-server","i-lucide-server-cog",{"title":259,"path":260,"stem":261,"icon":262},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","03.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":264,"path":265,"stem":266,"icon":267},"Enterprise License","\u002Fplatform\u002Fenterprise-license","03.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":269,"title":259,"body":270,"description":772,"extension":773,"links":774,"meta":775,"navigation":776,"path":260,"seo":777,"stem":261,"__hash__":778},"docs\u002F03.platform\u002F14.supply-chain-security.md",{"type":271,"value":272,"toc":756},"minimark",[273,277,290,295,355,359,363,457,461,518,522,582,586,621,625,671,675],[274,275,31],"h2",{"id":276},"overview",[278,279,280,281,285,286,289],"p",{},"Every Kinotic service image is inventoried and scanned for known vulnerabilities before it is published. An image with a Critical vulnerability that has a published fix is never promoted to Docker Hub. Every control on this page runs automatically in the ",[282,283,284],"code",{},"Build and Publish"," workflow (",[282,287,288],{},".github\u002Fworkflows\u002Fgradle-build.yml","), and each one leaves evidence in GitHub.",[291,292,294],"h3",{"id":293},"scope","Scope",[296,297,298,311],"table",{},[299,300,301],"thead",{},[302,303,304,308],"tr",{},[305,306,307],"th",{},"Image",[305,309,310],{},"Published as",[312,313,314,325,335,345],"tbody",{},[302,315,316,320],{},[317,318,319],"td",{},"Kinotic management server",[317,321,322],{},[282,323,324],{},"kinoticai\u002Fkinotic-server-management",[302,326,327,330],{},[317,328,329],{},"Kinotic system server",[317,331,332],{},[282,333,334],{},"kinoticai\u002Fkinotic-server-system",[302,336,337,340],{},[317,338,339],{},"Kinotic app server",[317,341,342],{},[282,343,344],{},"kinoticai\u002Fkinotic-server-app",[302,346,347,350],{},[317,348,349],{},"Kinotic migration",[317,351,352],{},[282,353,354],{},"kinoticai\u002Fkinotic-migration",[274,356,358],{"id":357},"controls","Controls",[291,360,362],{"id":361},"software-inventory-sbom","Software inventory (SBOM)",[296,364,365,373],{},[299,366,367],{},[302,368,369,371],{},[305,370],{},[305,372],{},[312,374,375,386,404,422,447],{},[302,376,377,383],{},[317,378,379],{},[380,381,382],"strong",{},"Control",[317,384,385],{},"Each build produces a software bill of materials for each image. It lists every operating-system package and application library in the image, with its version.",[302,387,388,393],{},[317,389,390],{},[380,391,392],{},"Format",[317,394,395,396,403],{},"CycloneDX JSON, generated with ",[397,398,402],"a",{"href":399,"rel":400},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fsyft",[401],"nofollow","Syft"," from the built image, not from source manifests. The inventory therefore matches what runs.",[302,405,406,411],{},[317,407,408],{},[380,409,410],{},"Frequency",[317,412,413,414,417,418,421],{},"Every build of the images: each pull request into ",[282,415,416],{},"develop"," or ",[282,419,420],{},"main",", each push to them that changes application code, and nightly.",[302,423,424,429],{},[317,425,426],{},[380,427,428],{},"Evidence",[317,430,431,432,435,436,435,439,442,443,446],{},"Workflow run artifacts named ",[282,433,434],{},"sbom-kinotic-server-management.cdx.json",", ",[282,437,438],{},"sbom-kinotic-server-system.cdx.json",[282,440,441],{},"sbom-kinotic-server-app.cdx.json"," and ",[282,444,445],{},"sbom-kinotic-migration.cdx.json",".",[302,448,449,454],{},[317,450,451],{},[380,452,453],{},"Retention",[317,455,456],{},"90 days.",[291,458,460],{"id":459},"vulnerability-scanning","Vulnerability scanning",[296,462,463,471],{},[299,464,465],{},[302,466,467,469],{},[305,468],{},[305,470],{},[312,472,473,487,496],{},[302,474,475,479],{},[317,476,477],{},[380,478,382],{},[317,480,481,486],{},[397,482,485],{"href":483,"rel":484},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fgrype",[401],"Grype"," scans each image's SBOM against current vulnerability advisories: GitHub Security Advisories, the National Vulnerability Database, and operating-system vendor feeds. The scan covers the same artifact the inventory records.",[302,488,489,493],{},[317,490,491],{},[380,492,410],{},[317,494,495],{},"Every build, including each pull request, and nightly. The nightly run checks newly published advisories against the current images.",[302,497,498,502],{},[317,499,500],{},[380,501,428],{},[317,503,504,505,435,508,435,511,442,514,517],{},"Findings of every severity are recorded as GitHub code scanning alerts in the categories ",[282,506,507],{},"image-kinotic-server-management",[282,509,510],{},"image-kinotic-server-system",[282,512,513],{},"image-kinotic-server-app",[282,515,516],{},"image-kinotic-migration",", with open and fixed history per finding. Each workflow run's summary lists the fixable findings for each image.",[291,519,521],{"id":520},"release-gate","Release gate",[296,523,524,532],{},[299,525,526],{},[302,527,528,530],{},[305,529],{},[305,531],{},[312,533,534,552,562],{},[302,535,536,540],{},[317,537,538],{},[380,539,382],{},[317,541,542,543,546,547,417,549,551],{},"A build fails when either image has a ",[380,544,545],{},"Critical"," vulnerability with a published fix. On a pull request, the failure is reported on the change before it merges. Only an image from a fully passing build of ",[282,548,416],{},[282,550,420],{}," is promoted from the staging registry (ghcr.io) to Docker Hub.",[302,553,554,559],{},[317,555,556],{},[380,557,558],{},"Effect",[317,560,561],{},"An image is published only when, at build time, it has no known Critical vulnerability with an available fix.",[302,563,564,568],{},[317,565,566],{},[380,567,428],{},[317,569,570,571,574,575,578,579,581],{},"The ",[282,572,573],{},"SBOM and Vulnerability Scan"," jobs and the ",[282,576,577],{},"Build Result"," job of each workflow run. ",[282,580,577],{}," performs the promotion and records which job withheld it.",[291,583,585],{"id":584},"integrity-of-the-scanning-tools","Integrity of the scanning tools",[296,587,588,596],{},[299,589,590],{},[302,591,592,594],{},[305,593],{},[305,595],{},[312,597,598,607],{},[302,599,600,604],{},[317,601,602],{},[380,603,382],{},[317,605,606],{},"Third-party actions in the scan job are pinned to full commit SHAs rather than version tags, so a repointed tag cannot change the code that runs. The scan job has read-only access to repository contents and holds no publishing, signing or deployment credentials.",[302,608,609,614],{},[317,610,611],{},[380,612,613],{},"Maintenance",[317,615,616,617,620],{},"Dependabot proposes updates to every workflow action weekly, including the pinned SHAs (",[282,618,619],{},".github\u002Fdependabot.yml",").",[291,622,624],{"id":623},"source-code-analysis","Source code analysis",[296,626,627,635],{},[299,628,629],{},[302,630,631,633],{},[305,632],{},[305,634],{},[312,636,637,646,658],{},[302,638,639,643],{},[317,640,641],{},[380,642,382],{},[317,644,645],{},"CodeQL static analysis of the Java and TypeScript source.",[302,647,648,652],{},[317,649,650],{},[380,651,410],{},[317,653,654,655,657],{},"Every push to ",[282,656,416],{},", and weekly.",[302,659,660,664],{},[317,661,662],{},[380,663,428],{},[317,665,666,667,670],{},"GitHub code scanning alerts from the ",[282,668,669],{},"CodeQL"," workflow.",[274,672,674],{"id":673},"control-mapping","Control mapping",[296,676,677,692],{},[299,678,679],{},[302,680,681,683,686,689],{},[305,682,382],{},[305,684,685],{},"NIST SP 800-171 Rev 2",[305,687,688],{},"SOC 2",[305,690,691],{},"ISO\u002FIEC 27001:2022",[312,693,694,707,719,732,745],{},[302,695,696,698,701,704],{},[317,697,362],{},[317,699,700],{},"3.4.1",[317,702,703],{},"CC7.1",[317,705,706],{},"A.5.9, A.8.9",[302,708,709,711,714,716],{},[317,710,460],{},[317,712,713],{},"3.11.2",[317,715,703],{},[317,717,718],{},"A.8.8",[302,720,721,723,726,729],{},[317,722,521],{},[317,724,725],{},"3.11.3, 3.14.1",[317,727,728],{},"CC7.1, CC8.1",[317,730,731],{},"A.8.8, A.8.32",[302,733,734,736,739,742],{},[317,735,585],{},[317,737,738],{},"3.4.1, 3.14.1",[317,740,741],{},"CC8.1",[317,743,744],{},"A.8.25, A.8.28",[302,746,747,749,751,753],{},[317,748,624],{},[317,750,713],{},[317,752,703],{},[317,754,755],{},"A.8.28",{"title":757,"searchDepth":758,"depth":758,"links":759},"",2,[760,764,771],{"id":276,"depth":758,"text":31,"children":761},[762],{"id":293,"depth":763,"text":294},3,{"id":357,"depth":758,"text":358,"children":765},[766,767,768,769,770],{"id":361,"depth":763,"text":362},{"id":459,"depth":763,"text":460},{"id":520,"depth":763,"text":521},{"id":584,"depth":763,"text":585},{"id":623,"depth":763,"text":624},{"id":673,"depth":758,"text":674},"How Kinotic inventories, scans and gates the container images it publishes, and where the evidence for each control is kept.","md",null,{},{"icon":262},{"title":259,"description":772},"U5edemqwg0bsfltfUrI_IdtNOP2kSOXLEGxV9zfmNXg",[780,782],{"title":254,"path":255,"stem":256,"description":781,"icon":257,"children":-1},"A development environment for a few peers on one physical host, what it keeps in Azure, and how their applications move to Kinotic Cloud.",{"title":264,"path":265,"stem":266,"description":783,"icon":267,"children":-1},"Which parts of Kinotic are Enterprise Features, what running them in production requires, and how the license treats substitute implementations.",1792930937326]