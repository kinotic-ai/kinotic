,"stem":234,"icon":235},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":237,"path":238,"stem":239,"icon":240},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":242,"path":243,"stem":244,"icon":179},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":246,"path":247,"stem":248,"icon":38},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":250,"path":251,"stem":252,"icon":253},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":255,"path":256,"stem":257,"icon":258},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":260,"path":261,"stem":262,"icon":263},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":265,"title":255,"body":266,"description":768,"extension":769,"links":770,"meta":771,"navigation":772,"path":256,"seo":773,"stem":257,"__hash__":774},"docs\u002F04.platform\u002F14.supply-chain-security.md",{"type":267,"value":268,"toc":752},"minimark",[269,273,286,291,351,355,359,453,457,514,518,578,582,617,621,667,671],[270,271,31],"h2",{"id":272},"overview",[274,275,276,277,281,282,285],"p",{},"Every Kinotic service image is inventoried and scanned for known vulnerabilities before it is published. An image with a Critical vulnerability that has a published fix is never promoted to Docker Hub. Every control on this page runs automatically in the ",[278,279,280],"code",{},"Build and Publish"," workflow (",[278,283,284],{},".github\u002Fworkflows\u002Fgradle-build.yml","), and each one leaves evidence in GitHub.",[287,288,290],"h3",{"id":289},"scope","Scope",[292,293,294,307],"table",{},[295,296,297],"thead",{},[298,299,300,304],"tr",{},[301,302,303],"th",{},"Image",[301,305,306],{},"Published as",[308,309,310,321,331,341],"tbody",{},[298,311,312,316],{},[313,314,315],"td",{},"Kinotic management server",[313,317,318],{},[278,319,320],{},"kinoticai\u002Fkinotic-server-management",[298,322,323,326],{},[313,324,325],{},"Kinotic system server",[313,327,328],{},[278,329,330],{},"kinoticai\u002Fkinotic-server-system",[298,332,333,336],{},[313,334,335],{},"Kinotic app server",[313,337,338],{},[278,339,340],{},"kinoticai\u002Fkinotic-server-app",[298,342,343,346],{},[313,344,345],{},"Kinotic migration",[313,347,348],{},[278,349,350],{},"kinoticai\u002Fkinotic-migration",[270,352,354],{"id":353},"controls","Controls",[287,356,358],{"id":357},"software-inventory-sbom","Software inventory (SBOM)",[292,360,361,369],{},[295,362,363],{},[298,364,365,367],{},[301,366],{},[301,368],{},[308,370,371,382,400,418,443],{},[298,372,373,379],{},[313,374,375],{},[376,377,378],"strong",{},"Control",[313,380,381],{},"Each build produces a software bill of materials for each image. It lists every operating-system package and application library in the image, with its version.",[298,383,384,389],{},[313,385,386],{},[376,387,388],{},"Format",[313,390,391,392,399],{},"CycloneDX JSON, generated with ",[393,394,398],"a",{"href":395,"rel":396},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fsyft",[397],"nofollow","Syft"," from the built image, not from source manifests. The inventory therefore matches what runs.",[298,401,402,407],{},[313,403,404],{},[376,405,406],{},"Frequency",[313,408,409,410,413,414,417],{},"Every build of the images: each pull request into ",[278,411,412],{},"develop"," or ",[278,415,416],{},"main",", each push to them that changes application code, and nightly.",[298,419,420,425],{},[313,421,422],{},[376,423,424],{},"Evidence",[313,426,427,428,431,432,431,435,438,439,442],{},"Workflow run artifacts named ",[278,429,430],{},"sbom-kinotic-server-management.cdx.json",", ",[278,433,434],{},"sbom-kinotic-server-system.cdx.json",[278,436,437],{},"sbom-kinotic-server-app.cdx.json"," and ",[278,440,441],{},"sbom-kinotic-migration.cdx.json",".",[298,444,445,450],{},[313,446,447],{},[376,448,449],{},"Retention",[313,451,452],{},"90 days.",[287,454,456],{"id":455},"vulnerability-scanning","Vulnerability scanning",[292,458,459,467],{},[295,460,461],{},[298,462,463,465],{},[301,464],{},[301,466],{},[308,468,469,483,492],{},[298,470,471,475],{},[313,472,473],{},[376,474,378],{},[313,476,477,482],{},[393,478,481],{"href":479,"rel":480},"https:\u002F\u002Fgithub.com\u002Fanchore\u002Fgrype",[397],"Grype"," scans each image's SBOM against current vulnerability advisories: GitHub Security Advisories, the National Vulnerability Database, and operating-system vendor feeds. The scan covers the same artifact the inventory records.",[298,484,485,489],{},[313,486,487],{},[376,488,406],{},[313,490,491],{},"Every build, including each pull request, and nightly. The nightly run checks newly published advisories against the current images.",[298,493,494,498],{},[313,495,496],{},[376,497,424],{},[313,499,500,501,431,504,431,507,438,510,513],{},"Findings of every severity are recorded as GitHub code scanning alerts in the categories ",[278,502,503],{},"image-kinotic-server-management",[278,505,506],{},"image-kinotic-server-system",[278,508,509],{},"image-kinotic-server-app",[278,511,512],{},"image-kinotic-migration",", with open and fixed history per finding. Each workflow run's summary lists the fixable findings for each image.",[287,515,517],{"id":516},"release-gate","Release gate",[292,519,520,528],{},[295,521,522],{},[298,523,524,526],{},[301,525],{},[301,527],{},[308,529,530,548,558],{},[298,531,532,536],{},[313,533,534],{},[376,535,378],{},[313,537,538,539,542,543,413,545,547],{},"A build fails when either image has a ",[376,540,541],{},"Critical"," vulnerability with a published fix. On a pull request, the failure is reported on the change before it merges. Only an image from a fully passing build of ",[278,544,412],{},[278,546,416],{}," is promoted from the staging registry (ghcr.io) to Docker Hub.",[298,549,550,555],{},[313,551,552],{},[376,553,554],{},"Effect",[313,556,557],{},"An image is published only when, at build time, it has no known Critical vulnerability with an available fix.",[298,559,560,564],{},[313,561,562],{},[376,563,424],{},[313,565,566,567,570,571,574,575,577],{},"The ",[278,568,569],{},"SBOM and Vulnerability Scan"," jobs and the ",[278,572,573],{},"Build Result"," job of each workflow run. ",[278,576,573],{}," performs the promotion and records which job withheld it.",[287,579,581],{"id":580},"integrity-of-the-scanning-tools","Integrity of the scanning tools",[292,583,584,592],{},[295,585,586],{},[298,587,588,590],{},[301,589],{},[301,591],{},[308,593,594,603],{},[298,595,596,600],{},[313,597,598],{},[376,599,378],{},[313,601,602],{},"Third-party actions in the scan job are pinned to full commit SHAs rather than version tags, so a repointed tag cannot change the code that runs. The scan job has read-only access to repository contents and holds no publishing, signing or deployment credentials.",[298,604,605,610],{},[313,606,607],{},[376,608,609],{},"Maintenance",[313,611,612,613,616],{},"Dependabot proposes updates to every workflow action weekly, including the pinned SHAs (",[278,614,615],{},".github\u002Fdependabot.yml",").",[287,618,620],{"id":619},"source-code-analysis","Source code analysis",[292,622,623,631],{},[295,624,625],{},[298,626,627,629],{},[301,628],{},[301,630],{},[308,632,633,642,654],{},[298,634,635,639],{},[313,636,637],{},[376,638,378],{},[313,640,641],{},"CodeQL static analysis of the Java and TypeScript source.",[298,643,644,648],{},[313,645,646],{},[376,647,406],{},[313,649,650,651,653],{},"Every push to ",[278,652,412],{},", and weekly.",[298,655,656,660],{},[313,657,658],{},[376,659,424],{},[313,661,662,663,666],{},"GitHub code scanning alerts from the ",[278,664,665],{},"CodeQL"," workflow.",[270,668,670],{"id":669},"control-mapping","Control mapping",[292,672,673,688],{},[295,674,675],{},[298,676,677,679,682,685],{},[301,678,378],{},[301,680,681],{},"NIST SP 800-171 Rev 2",[301,683,684],{},"SOC 2",[301,686,687],{},"ISO\u002FIEC 27001:2022",[308,689,690,703,715,728,741],{},[298,691,692,694,697,700],{},[313,693,358],{},[313,695,696],{},"3.4.1",[313,698,699],{},"CC7.1",[313,701,702],{},"A.5.9, A.8.9",[298,704,705,707,710,712],{},[313,706,456],{},[313,708,709],{},"3.11.2",[313,711,699],{},[313,713,714],{},"A.8.8",[298,716,717,719,722,725],{},[313,718,517],{},[313,720,721],{},"3.11.3, 3.14.1",[313,723,724],{},"CC7.1, CC8.1",[313,726,727],{},"A.8.8, A.8.32",[298,729,730,732,735,738],{},[313,731,581],{},[313,733,734],{},"3.4.1, 3.14.1",[313,736,737],{},"CC8.1",[313,739,740],{},"A.8.25, A.8.28",[298,742,743,745,747,749],{},[313,744,620],{},[313,746,709],{},[313,748,699],{},[313,750,751],{},"A.8.28",{"title":753,"searchDepth":754,"depth":754,"links":755},"",2,[756,760,767],{"id":272,"depth":754,"text":31,"children":757},[758],{"id":289,"depth":759,"text":290},3,{"id":353,"depth":754,"text":354,"children":761},[762,763,764,765,766],{"id":357,"depth":759,"text":358},{"id":455,"depth":759,"text":456},{"id":516,"depth":759,"text":517},{"id":580,"depth":759,"text":581},{"id":619,"depth":759,"text":620},{"id":669,"depth":754,"text":670},"How Kinotic inventories, scans and gates the container images it publishes, and where the evidence for each control is kept.","md",null,{},{"icon":258},{"title":255,"description":768},"fjeOTcdWoNBlpceNYEblMvoJhkAijBWuUFpMXOKtBxo",[776,778],{"title":250,"path":251,"stem":252,"description":777,"icon":253,"children":-1},"A development environment for a few peers on one physical host, what it keeps in Azure, and how their applications move to Kinotic Cloud.",{"title":260,"path":261,"stem":262,"description":779,"icon":263,"children":-1},"Which parts of Kinotic are Enterprise Features, what running them in production requires, and how the license treats substitute implementations.",1792998374115]