platform\u002Farchitecture","04.platform\u002F01.architecture","i-lucide-boxes",{"title":176,"path":177,"stem":178,"icon":6},"Deployment Guide","\u002Fplatform\u002Fdeployment-guide","04.platform\u002F02.deployment-guide",{"title":180,"path":181,"stem":182,"icon":183},"Configuration","\u002Fplatform\u002Fconfiguration","04.platform\u002F03.configuration","i-lucide-settings",{"title":185,"path":186,"stem":187,"icon":21},"Organization Management","\u002Fplatform\u002Forganization-management","04.platform\u002F04.organization-management",{"title":189,"path":190,"stem":191,"icon":192},"System Security","\u002Fplatform\u002Fsystem-security","04.platform\u002F05.system-security","i-lucide-shield",{"title":194,"path":195,"stem":196,"icon":38},"Defense in Depth","\u002Fplatform\u002Fdefense-in-depth","04.platform\u002F06.defense-in-depth",{"title":198,"path":199,"stem":200,"icon":201},"MCP Tools","\u002Fplatform\u002Fmcp-tools","04.platform\u002F07.mcp-tools","i-lucide-bot",{"title":203,"path":204,"stem":205,"icon":206},"Observability","\u002Fplatform\u002Fobservability","04.platform\u002F08.observability","i-lucide-activity",{"title":208,"path":209,"stem":210,"icon":211},"Contributing","\u002Fplatform\u002Fcontributing","04.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":213,"path":214,"stem":215,"icon":216},"System Migrations","\u002Fplatform\u002Fsystem-migrations","04.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":218,"path":219,"stem":220,"icon":221},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","04.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":151,"icon":152,"path":223,"stem":224,"children":225,"page":18},"\u002Fplatform\u002Freference","04.platform\u002F12.reference",[226,231,236,240],{"title":227,"path":228,"stem":229,"icon":230},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":232,"path":233,"stem":234,"icon":235},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":237,"path":238,"stem":239,"icon":174},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":241,"path":242,"stem":243,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":245,"path":246,"stem":247,"icon":248},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":250,"path":251,"stem":252,"icon":253},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":255,"path":256,"stem":257,"icon":258},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":260,"title":185,"body":261,"description":1974,"extension":1975,"links":1976,"meta":1977,"navigation":1978,"path":186,"seo":1979,"stem":187,"__hash__":1980},"docs\u002F04.platform\u002F04.organization-management.md",{"type":262,"value":263,"toc":1954},"minimark",[264,268,279,287,291,393,396,476,489,493,500,527,561,576,595,599,612,657,671,678,683,706,745,793,796,800,803,832,839,849,863,889,893,910,931,935,938,1015,1021,1025,1034,1061,1065,1075,1122,1132,1136,1143,1244,1266,1269,1280,1284,1324,1335,1341,1583,1588,1662,1668,1783,1788],[265,266,26],"h2",{"id":267},"overview",[269,270,271,272,275,276,278],"p",{},"A Kinotic deployment hosts many organizations. Each has its own members, its own applications and, optionally, its own SSO. This page covers how an organization is created, how people join it and sign in, and how its sign-in providers are set up. For the design behind it, see ",[273,274,189],"a",{"href":190},"; the ",[273,277,241],{"href":242}," reference draws the flows.",[269,280,281,282,286],{},"System users sign in to the system console separately; see ",[273,283,285],{"href":284},"#system-authentication","System Authentication",".",[265,288,290],{"id":289},"concepts","Concepts",[292,293,294,307],"table",{},[295,296,297],"thead",{},[298,299,300,304],"tr",{},[301,302,303],"th",{},"Concept",[301,305,306],{},"What it is",[308,309,310,319,332,344,356,373,381],"tbody",{},[298,311,312,316],{},[313,314,315],"td",{},"Organization",[313,317,318],{},"A customer of the deployment. Its id is derived from its name and is the label of its hosts.",[298,320,321,324],{},[313,322,323],{},"Organization user",[313,325,326,327,331],{},"A member of one organization (",[328,329,330],"code",{},"OrganizationParticipantIdentity","). A person in several organizations is a separate user of each, with its own sign-in methods.",[298,333,334,337],{},[313,335,336],{},"Application user",[313,338,339,340,343],{},"A user of one application (",[328,341,342],{},"ApplicationParticipantIdentity","), always in a tenant: one of its own when the system manages the application's tenants, otherwise one of the application's.",[298,345,346,349],{},[313,347,348],{},"Sign-in method",[313,350,351,352,355],{},"A user's password, or a provider identity bound to it (",[328,353,354],{},"OidcBinding",").",[298,357,358,361],{},[313,359,360],{},"Sign-in provider",[313,362,363,364,368,369,372],{},"What a login offers: ",[365,366,367],"strong",{},"Email and password"," (",[328,370,371],{},"PasswordConfiguration",") or an OIDC configuration. Each belongs to exactly one login — the organization's, an application's or a tenant's.",[298,374,375,378],{},[313,376,377],{},"Pending user",[313,379,380],{},"A user an administrator added that nobody has signed in as yet. Its first sign-in method claims it.",[298,382,383,386],{},[313,384,385],{},"Invitation",[313,387,388,389,392],{},"An emailed link (",[328,390,391],{},"PendingInvite",") that lets the invited address claim its pending user.",[269,394,395],{},"Provider configurations come in kinds, one per owner and scope:",[292,397,398,411],{},[295,399,400],{},[298,401,402,405,408],{},[301,403,404],{},"Kind",[301,406,407],{},"Offered at",[301,409,410],{},"What people see",[308,412,413,426,442,463],{},[298,414,415,420,423],{},[313,416,417],{},[328,418,419],{},"OrgSignupOidcConfiguration",[313,421,422],{},"Every organization's login and sign-up; the system's own (GitHub)",[313,424,425],{},"\"Sign in with GitHub\" \u002F \"Sign up with GitHub\"",[298,427,428,433,439],{},[313,429,430],{},[328,431,432],{},"OrganizationOidcConfiguration",[313,434,435,436],{},"The organization's own login, ",[328,437,438],{},"\u002Flogin\u002F\u003CorganizationId>",[313,440,441],{},"\"Sign in with \u003Cprovider>\"",[298,443,444,449,460],{},[313,445,446],{},[328,447,448],{},"ApplicationOidcConfiguration",[313,450,451,452,455,456,459],{},"One application's login, through the organization's own client (",[328,453,454],{},"OWN",") or Kinotic's Google or Microsoft registration (",[328,457,458],{},"MANAGED",")",[313,461,462],{},"\"Continue with \u003Cname>\" in the application's UI",[298,464,465,470,473],{},[313,466,467],{},[328,468,469],{},"TenantOidcConfiguration",[313,471,472],{},"One tenant's login, before the application's providers",[313,474,475],{},"\"Continue with \u003Cname>\" on the tenant's sites",[269,477,478,479,482,483,485,486,488],{},"Kinotic's Google and Microsoft registrations (",[328,480,481],{},"ApplicationSocialOidcConfiguration",") are never offered on their own; a ",[328,484,458],{}," application configuration signs in through them, and switching it to ",[328,487,454],{}," keeps its users.",[265,490,492],{"id":491},"creating-an-organization","Creating an organization",[269,494,495,496,499],{},"Every sign-up founds a new organization with the founder as its first user. The portal's ",[328,497,498],{},"\u002Fsignup"," page offers GitHub only, because every Kinotic project lives in a GitHub repository:",[501,502,503,510,517,520],"ol",{},[504,505,506,509],"li",{},[365,507,508],{},"Sign up with GitHub"," starts the provider round-trip; GitHub must report a verified email.",[504,511,512,513,516],{},"The portal's ",[328,514,515],{},"\u002Fregister"," page asks for the organization's name.",[504,518,519],{},"The organization and its founder are created, the founder bound to their GitHub identity, and the browser is signed in.",[504,521,522,523,526],{},"The page then offers ",[365,524,525],{},"Continue to GitHub"," to install the Kinotic GitHub App, which project creation needs.",[269,528,529,530,533,534,537,538,540,541,544,545,548,549,552,553,556,557,560],{},"Where the management server sets ",[328,531,532],{},"kinotic.managementServer.passwordSignUp",", as the ",[328,535,536],{},"demonstration"," profile does, the ",[328,539,498],{}," page offers an email and a password in place of GitHub (",[328,542,543],{},"\u002Fsignup\u002Femail","): ",[328,546,547],{},"POST \u002Fapi\u002Fauth\u002Forg\u002Fsignup"," sends a verification link to ",[328,550,551],{},"\u002Fsignup\u002Fverify",", where the founder names the organization and sets a password, and the organization takes passwords from the start. Without the property the route answers ",[328,554,555],{},"403",", and ",[328,558,559],{},"GET \u002Fapi\u002Fauth\u002Forg\u002Fsignup\u002Fmethods"," tells the portal which page to show. A pending sign-up that has expired gives way to a new one.",[269,562,563,564,567,568,571,572,575],{},"When ",[328,565,566],{},"kinotic.domain.email.enabled"," is ",[328,569,570],{},"false",", as on a demonstration server, nothing is sent: the sign-up's response carries its verification link as ",[328,573,574],{},"verificationUrl",", which the portal opens at once, so the address is never proven to be the founder's, and asking again for an address with a pending sign-up returns the same link. Each link is also logged to the management server's console.",[269,577,578,579,582,583,586,587,590,591,594],{},"A UI other than the portal can install the GitHub App itself: it calls ",[328,580,581],{},"startInstall"," with the absolute URL of one of its own pages as ",[328,584,585],{},"returnTo",", on an origin ",[328,588,589],{},"kinotic.cors.allowedOriginPattern"," names, and calls ",[328,592,593],{},"completeInstall"," when GitHub returns there.",[265,596,598],{"id":597},"members","Members",[269,600,601,602,604,605,608,609,355],{},"Administrators add people on the ",[365,603,598],{}," page with ",[365,606,607],{},"Add member",": an email, an optional name, and a switch, on by default, that emails an invitation (",[328,610,611],{},"MemberService.addOrganizationUser",[613,614,615,622,628,634,644],"ul",{},[504,616,617,618,621],{},"The person becomes a ",[365,619,620],{},"pending"," member at once.",[504,623,624,627],{},[365,625,626],{},"With an invitation",", they claim it by setting a password (while the organization takes passwords) or by signing in through one of its providers under the invited address.",[504,629,630,633],{},[365,631,632],{},"Without one",", they claim it on their first sign-in through one of the organization's own providers under that address, so the switch can only be off when the organization has such a provider.",[504,635,636,639,640,643],{},[365,637,638],{},"Send invitation"," sends a pending member their invitation again, or a first one. ",[365,641,642],{},"Remove member"," deletes the user with its sign-in methods, delegates and any unaccepted invitation.",[504,645,646,368,649,652,653,656],{},[365,647,648],{},"Where email is disabled",[328,650,651],{},"kinotic.domain.email.enabled=false",", as on a demonstration server), each invitation's accept link is the administrator's to send on: after adding a member or user with an invitation, or sending one again, the page shows the link in a dialog to copy (",[328,654,655],{},"MemberService.findInvitationLink(email, applicationId)","). Anyone holding the link can accept the invitation as the invited address.",[269,658,659,660,663,664,667,668,286],{},"An application's users are added the same way on its ",[365,661,662],{},"Users"," page (",[328,665,666],{},"MemberService.addApplicationUser","); see ",[273,669,122],{"href":670},"\u002Fapps\u002Fsecurity\u002Fauthentication#user-management",[269,672,673,674,677],{},"An organization's own provider signs in only the members its administrators added: an address that is no member's gets ",[328,675,676],{},"no_user",", and such a provider never creates users.",[679,680,682],"h3",{"id":681},"email-templates","Email templates",[269,684,685,686,689,690,693,694,697,698,701,702,705],{},"The portal's emails link to the portal. A server that embeds Kinotic's modules to serve its own UI passes an ",[328,687,688],{},"EmailTemplate"," in process instead — to ",[328,691,692],{},"MemberInvitationService.addOrganizationUser",", ",[328,695,696],{},"addApplicationUser"," and ",[328,699,700],{},"sendInvitation",", and to ",[328,703,704],{},"SignUpService.initiateLocalSignUp",". No published service accepts one.",[613,707,708,722,738],{},[504,709,710,713,714,717,718,721],{},[328,711,712],{},"uiBaseUrl"," is the UI whose ",[328,715,716],{},"\u002Finvite\u002Faccept?token="," or ",[328,719,720],{},"\u002Fsignup\u002Fverify?token="," page the link opens: an absolute http(s) URL with no path suffix, query, fragment or trailing slash.",[504,723,724,693,727,697,730,733,734,737],{},[328,725,726],{},"subject",[328,728,729],{},"htmlBody",[328,731,732],{},"textBody"," are Handlebars sources. Write URLs with triple braces, ",[328,735,736],{},"{{{acceptUrl}}}",", so they are not escaped.",[504,739,740,741,744],{},"An invalid template fails the call with ",[328,742,743],{},"IllegalArgumentException"," before anything is saved.",[292,746,747,757],{},[295,748,749],{},[298,750,751,754],{},[301,752,753],{},"Email",[301,755,756],{},"Variables",[308,758,759,781],{},[298,760,761,763],{},[313,762,385],{},[313,764,765,693,768,693,771,774,775,693,778],{},[328,766,767],{},"inviterName",[328,769,770],{},"organizationName",[328,772,773],{},"applicationName"," (application invitations only), ",[328,776,777],{},"acceptUrl",[328,779,780],{},"expiresInDays",[298,782,783,786],{},[313,784,785],{},"Email and password sign-up",[313,787,788,693,791],{},[328,789,790],{},"displayName",[328,792,574],{},[269,794,795],{},"An application with its own invitation template sends its content, still linking to the passed template's UI.",[265,797,799],{"id":798},"signing-in","Signing in",[269,801,802],{},"A login is addressed to one organization and signs in one of its users. The portal has two pages:",[613,804,805,825],{},[504,806,807,812,813,816,817,820,821,824],{},[365,808,809],{},[328,810,811],{},"\u002Flogin"," — for someone whose organization is unknown. It offers ",[365,814,815],{},"Sign in with GitHub",", a field for the organization, a ",[365,818,819],{},"Don't know your organization?"," link, and ",[365,822,823],{},"Create Organization",". A browser that signed in before is sent straight to that organization's page.",[504,826,827,831],{},[365,828,829],{},[328,830,438],{}," — offers what that organization's login offers: its providers, then an email and password form while it takes passwords.",[269,833,834,835,838],{},"No route asks about an email before a method is chosen, and a failed password login always answers a generic ",[328,836,837],{},"401",", so the pages reveal nothing about who has an account. A session acts in one organization; to use another, sign in at its page.",[269,840,841,846,847,286],{},[365,842,843,844,286],{},"GitHub from ",[328,845,811],{}," No organization is named, so the identity's bound users decide: one organization signs in directly; several show a choice of organizations, and the person signs in at the chosen one's page; none gives ",[328,848,676],{},[269,850,851,854,855,858,859,862],{},[365,852,853],{},"Starting from a link."," An organization's provider sign-in also starts from a plain ",[328,856,857],{},"GET"," of ",[328,860,861],{},"\u002Fapi\u002Fauth\u002Forg\u002Flogin\u002F\u003CorganizationId>\u002Fstart\u002F\u003CconfigId>",", so a provider's application launcher can link straight to it.",[269,864,865,868,869,872,873,697,875,878,879,882,883,556,886,286],{},[365,866,867],{},"Errors"," come back to the login page as ",[328,870,871],{},"?error=",": ",[328,874,676],{},[328,876,877],{},"email_not_verified"," (each with the provider in ",[328,880,881],{},"provider","), ",[328,884,885],{},"user_disabled",[328,887,888],{},"multiple_organizations",[679,890,892],{"id":891},"finding-ones-organizations","Finding one's organizations",[269,894,895,897,898,901,902,905,906,909],{},[365,896,819],{}," emails the address a link to each organization it is an enabled member of (",[328,899,900],{},"POST \u002Fapi\u002Fauth\u002Forg\u002Flogin\u002Ffind","). The answer is the same whether or not the address belongs to any, so nothing is revealed. Because it sends mail, it requires a Cloudflare Turnstile token, configured under ",[328,903,904],{},"kinotic.managementServer.turnstile.*","; set ",[328,907,908],{},"kinotic.managementServer.turnstile.enabled=false"," where there is no Turnstile site, as in the e2e stack or on a demonstration server.",[269,911,912,913,916,917,920,921,924,925,927,928,286],{},"Where email is disabled, nothing is sent: the ",[328,914,915],{},"POST"," answers ",[328,918,919],{},"200"," with ",[328,922,923],{},"{organizations: [{name, loginUrl}]}"," and the landing page lists them, so anyone who asks learns which organizations the address belongs to. The ",[328,926,857],{}," reports this as ",[328,929,930],{},"showLinksInUI",[679,932,934],{"id":933},"clients-outside-a-browser","Clients outside a browser",[269,936,937],{},"A browser's login sets a session cookie, which authenticates its WebSocket upgrade. Other clients authenticate at the upgrade itself:",[292,939,940,950],{},[295,941,942],{},[298,943,944,947],{},[301,945,946],{},"Client",[301,948,949],{},"Presents",[308,951,952,960,1001],{},[298,953,954,957],{},[313,955,956],{},"Browser",[313,958,959],{},"The session cookie",[298,961,962,965],{},[313,963,964],{},"Node, with credentials",[313,966,967,697,970,920,973,976,977,980,981,984,985,988,989,693,992,693,995,693,998,459],{},[328,968,969],{},"clientId",[328,971,972],{},"clientSecret",[328,974,975],{},"organizationId"," \u002F ",[328,978,979],{},"applicationId"," scope headers (",[328,982,983],{},"BasicCredentialsResolver",", or ",[328,986,987],{},"EnvCredentialsResolver"," reading ",[328,990,991],{},"KINOTIC_CLIENT_ID",[328,993,994],{},"KINOTIC_CLIENT_SECRET",[328,996,997],{},"KINOTIC_ORGANIZATION_ID",[328,999,1000],{},"KINOTIC_APPLICATION_ID",[298,1002,1003,1006],{},[313,1004,1005],{},"Node, with a token",[313,1007,1008,368,1011,1014],{},[328,1009,1010],{},"Authorization: Bearer \u003Cjwt>",[328,1012,1013],{},"BearerCredentialsResolver","). The CLI gets its token through the device-code grant and refreshes it before each connect.",[269,1016,1017,1018,286],{},"Each server admits only its own kind of user; see ",[273,1019,189],{"href":1020},"\u002Fplatform\u002Fsystem-security#authentication-methods",[265,1022,1024],{"id":1023},"password-sign-in","Password sign-in",[269,1026,1027,1029,1030,1033],{},[365,1028,367],{}," is a provider like any other: at most one per login, saved through ",[328,1031,1032],{},"OwnedPasswordConfigurationService",", and enabled or disabled from the login's provider list.",[613,1035,1036,1039,1045,1048,1051],{},[504,1037,1038],{},"An organization has none until an administrator adds it, except one founded with the email and password sign-up.",[504,1040,1041,1042,1044],{},"While an organization takes no password, its page shows no form, its password login answers ",[328,1043,837],{},", and its invitations are accepted only through a provider.",[504,1046,1047],{},"Disabling it is refused while an enabled member signs in with a password alone, and disabling an organization's own provider is refused while it is some member's only way in. The refusal names those members.",[504,1049,1050],{},"An application user's password works where their own login takes one: their tenant's, else the application's.",[504,1052,1053,1054,368,1057,1060],{},"Password ",[365,1055,1056],{},"sign-up",[328,1058,1059],{},"createUserOnSignIn",") exists only at an application's own login, while the system manages its tenants.",[265,1062,1064],{"id":1063},"configuring-sso","Configuring SSO",[269,1066,1067,1068,1071,1072,286],{},"An administrator manages the organization's providers under ",[365,1069,1070],{},"Organization settings → Authentication providers",", or through ",[328,1073,1074],{},"OwnedOidcConfigurationService",[501,1076,1077,1097,1108,1115],{},[504,1078,1079,1082,1083,1085,1086,717,1089,1092,1093,1096],{},[365,1080,1081],{},"Add provider",", then choose Google, Microsoft or Okta (or ",[365,1084,367],{},"), and enter the button's name, the organization's account at the provider (the Entra directory id, never ",[328,1087,1088],{},"common",[328,1090,1091],{},"organizations","; or the Okta domain), the client ID, and the client secret or ",[365,1094,1095],{},"Public client",". The server derives the provider's URLs from the account, so no URL is entered.",[504,1098,1099,1100,1103,1104,1107],{},"Register the ",[365,1101,1102],{},"callback URL"," the form then shows, ",[328,1105,1106],{},"\u003Ckinotic.managementApi.apiBaseUrl>\u002Fapi\u002Fauth\u002Forg\u002Flogin\u002Fsso\u002Fcallback\u002F\u003CconfigId>",", with the provider. Logins, invitations and profile connections all return to it.",[504,1109,1110,1111,1114],{},"Editing keeps the provider and its scope fixed. Leaving the secret empty keeps the one held; ",[365,1112,1113],{},"Make this a public client"," deletes it.",[504,1116,1117,1118,1121],{},"The row menu enables, disables or deletes the provider, and ",[365,1119,1120],{},"Copy to application"," creates an application configuration from it, with its own callback URL to register as well.",[269,1123,1124,1125,1128,1129,286],{},"The ",[365,1126,1127],{},"Direct sign-in link"," on each provider is the launcher URL described under ",[273,1130,799],{"href":1131},"#signing-in",[265,1133,1135],{"id":1134},"provider-quirks","Provider quirks",[269,1137,1138,1139,1142],{},"Providers differ in how they prove an email. ",[328,1140,1141],{},"OAuth2Util"," holds every difference, so no handler branches on the provider:",[292,1144,1145,1158],{},[295,1146,1147],{},[298,1148,1149,1152,1155],{},[301,1150,1151],{},"Provider",[301,1153,1154],{},"Identity",[301,1156,1157],{},"Email verified by",[308,1159,1160,1175,1195,1220,1233],{},[298,1161,1162,1165,1168],{},[313,1163,1164],{},"GitHub",[313,1166,1167],{},"OAuth 2.0 only: the user and email endpoints, called with the access token",[313,1169,1170,1171,1174],{},"GitHub's ",[328,1172,1173],{},"verified"," flag on the address",[298,1176,1177,1180,1186],{},[313,1178,1179],{},"Google",[313,1181,1182,1183],{},"id_token, issuer ",[328,1184,1185],{},"https:\u002F\u002Faccounts.google.com",[313,1187,1188,1191,1192],{},[328,1189,1190],{},"email_verified"," must be ",[328,1193,1194],{},"true",[298,1196,1197,1200,1211],{},[313,1198,1199],{},"Microsoft Entra",[313,1201,1202,1203,976,1205,1207,1208],{},"id_token; a ",[328,1204,1088],{},[328,1206,1091],{}," registration validates the issuer against the token's ",[328,1209,1210],{},"tid",[313,1212,1213,1214,717,1216,1219],{},"Presence of the email. For an application's sign-up through a registration admitting every directory, only ",[328,1215,1190],{},[328,1217,1218],{},"xms_edov"," true, or a personal account",[298,1221,1222,1225,1228],{},[313,1223,1224],{},"Okta",[313,1226,1227],{},"id_token, issuer derived from the Okta domain",[313,1229,1230,1232],{},[328,1231,1190],{}," from the userinfo endpoint",[298,1234,1235,1238,1241],{},[313,1236,1237],{},"Apple",[313,1239,1240],{},"id_token",[313,1242,1243],{},"Presence; the email arrives on the first sign-in only",[269,1245,1246,1247,1249,1250,1253,1254,1256,1257,1260,1261,697,1263,1265],{},"When an id_token has an email but no ",[328,1248,1190],{}," (other than Entra or Apple), the userinfo endpoint supplies it; its ",[328,1251,1252],{},"sub"," must match. An application's users are bound by an identifier stable across client registrations — Google's ",[328,1255,1252],{},", Entra's ",[328,1258,1259],{},"\u003Ctid>\u002F\u003Coid>"," — so switching a configuration between ",[328,1262,458],{},[328,1264,454],{}," keeps them.",[265,1267,285],{"id":1268},"system-authentication",[269,1270,1271,1272,1275,1276,1279],{},"System users sign in to the system console with an email and password (",[328,1273,1274],{},"POST \u002Fapi\u002Fauth\u002Fsystem\u002Flogin","). There is no sign-up, SSO or social path for them; they are created by migration fixtures and listed read-only under ",[365,1277,1278],{},"Members → Users",". The system login authenticates only system users, and every organization login only organization users, so the same email signs in to each with that scope's own user.",[265,1281,1283],{"id":1282},"endpoint-reference","Endpoint Reference",[269,1285,1286,1287,1290,1291,1294,1295,1298,1299,1302,1303,368,1306,693,1309,693,1312,1315,1316,1319,1320,1323],{},"Each server mounts the routes of the modules it loads, on its own gateway port (management ",[328,1288,1289],{},"58503",", system ",[328,1292,1293],{},"58504",", app ",[328,1296,1297],{},"58505"," by default). Every ",[328,1300,1301],{},"\u002Fapi\u002F*"," route shares a session cookie, ",[328,1304,1305],{},"__Host-kinotic-\u003Cserver>-session",[328,1307,1308],{},"HttpOnly",[328,1310,1311],{},"Secure",[328,1313,1314],{},"SameSite"," from ",[328,1317,1318],{},"kinotic.apiGateway.sessionCookieSameSite",", timeout ",[328,1321,1322],{},"kinotic.apiGateway.sessionTimeout",", 30 minutes by default).",[269,1325,1326,1327,1330,1331,1334],{},"The app server answers at each application's own API host, ",[328,1328,1329],{},"\u003CorganizationId>--\u003CapplicationId>"," under ",[328,1332,1333],{},"kinotic.domain.appApiBaseUrl",". Sign-ins through Kinotic's shared Google and Microsoft registrations return to that base host instead and are handed to the application's host under a single-use code that only the starting browser can redeem.",[269,1336,1337,1340],{},[365,1338,1339],{},"Organization sign-in and sign-up"," (management server)",[292,1342,1343,1356],{},[295,1344,1345],{},[298,1346,1347,1350,1353],{},[301,1348,1349],{},"Method",[301,1351,1352],{},"Path",[301,1354,1355],{},"Purpose",[308,1357,1358,1372,1394,1418,1434,1448,1462,1481,1495,1509,1523,1540,1566],{},[298,1359,1360,1364,1369],{},[313,1361,1362],{},[328,1363,857],{},[313,1365,1366],{},[328,1367,1368],{},"\u002Fapi\u002Fauth\u002Forg\u002Flogin\u002Fproviders",[313,1370,1371],{},"The system's sign-up provider keys, for the landing and sign-up buttons",[298,1373,1374,1378,1383],{},[313,1375,1376],{},[328,1377,857],{},[313,1379,1380],{},[328,1381,1382],{},"\u002Fapi\u002Fauth\u002Forg\u002Flogin\u002F:orgId\u002Fproviders",[313,1384,1385,1386,1389,1390,1393],{},"What the organization's login offers, ",[328,1387,1388],{},"[{id, type, name, provider}]","; ",[328,1391,1392],{},"404"," for an unknown organization",[298,1395,1396,1400,1405],{},[313,1397,1398],{},[328,1399,915],{},[313,1401,1402],{},[328,1403,1404],{},"\u002Fapi\u002Fauth\u002Forg\u002Flogin\u002F:orgId",[313,1406,1407,1408,1411,1412,1415,1416],{},"Email and password; ",[328,1409,1410],{},"204"," with the session cookie, ",[328,1413,1414],{},"400"," without both fields, otherwise ",[328,1417,837],{},[298,1419,1420,1426,1431],{},[313,1421,1422,693,1424],{},[328,1423,915],{},[328,1425,857],{},[313,1427,1428],{},[328,1429,1430],{},"\u002Fapi\u002Fauth\u002Forg\u002Flogin\u002F:orgId\u002Fstart\u002F:configId",[313,1432,1433],{},"Start a sign-in through a provider the organization offers",[298,1435,1436,1440,1445],{},[313,14