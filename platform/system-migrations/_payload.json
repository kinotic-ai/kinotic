ense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":128,"icon":129,"path":196,"stem":197,"children":198,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[199,204,209],{"title":200,"path":201,"stem":202,"icon":203},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"title":205,"path":206,"stem":207,"icon":208},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F11.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":210,"path":211,"stem":212,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F11.reference\u002F03.project-publishing-design",{"id":214,"title":191,"body":215,"description":831,"extension":832,"links":833,"meta":834,"navigation":835,"path":192,"seo":836,"stem":193,"__hash__":837},"docs\u002F02.platform\u002F10.system-migrations.md",{"type":216,"value":217,"toc":818},"minimark",[218,227,232,235,247,251,259,263,266,282,287,290,343,357,462,465,480,486,490,505,515,519,533,563,579,587,607,625,672,686,697,731,749,779,795,799,814],[219,220,221,222,226],"p",{},"The Kinotic platform uses the same migration SQL system as application developers to manage its own internal Elasticsearch indices. This page covers considerations specific to platform development — for general migration syntax, see ",[223,224,225],"a",{"href":89},"App Migrations",".",[228,229,231],"h2",{"id":230},"what-are-system-migrations","What Are System Migrations?",[219,233,234],{},"System migrations define and evolve the indices that the platform itself relies on — things like migration history tracking, system configuration, and other internal data stores. They run during platform startup before any application migrations and are scoped to the system project rather than a per-application project.",[219,236,237,238,242,243,246],{},"System migrations live in ",[239,240,241],"code",{},"kinotic-migration\u002Fsrc\u002Fmain\u002Fresources\u002Fmigrations\u002F"," and follow the same ",[239,244,245],{},"V\u003CN>__\u003Cdescription>.sql"," naming convention.",[228,248,250],{"id":249},"using-composite-types-in-system-indices","Using Composite Types in System Indices",[219,252,253,254,258],{},"OBJECT, NESTED, and UNION columns work the same way in system migrations as in application migrations. Refer to the ",[223,255,257],{"href":256},"\u002Fapps\u002Fpersistence\u002Fmigrations#composite-column-types","Composite Column Types"," section of the app documentation for syntax and examples.",[228,260,262],{"id":261},"deserializing-union-types","Deserializing Union Types",[219,264,265],{},"Elasticsearch stores UNION fields as a flat merged object — it has no knowledge of which variant a document contains. When reading documents back into Java, the platform needs to route deserialization to the correct subclass.",[219,267,268,269,273,274,277,278,281],{},"The standard approach is Jackson's polymorphic type handling, driven by a ",[270,271,272],"strong",{},"discriminator field"," stored in the document. This is the same ",[239,275,276],{},"kind"," (or similar) ",[239,279,280],{},"KEYWORD"," field you include in each union variant in the migration SQL.",[283,284,286],"h3",{"id":285},"example","Example",[219,288,289],{},"Given this migration:",[291,292,297],"pre",{"className":293,"code":294,"language":295,"meta":296,"style":296},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n","sql","",[239,298,299,307,313,319,325,331,337],{"__ignoreMap":296},[300,301,304],"span",{"class":302,"line":303},"line",1,[300,305,306],{},"CREATE TABLE assets (\n",[300,308,310],{"class":302,"line":309},2,[300,311,312],{},"    id KEYWORD,\n",[300,314,316],{"class":302,"line":315},3,[300,317,318],{},"    item UNION (\n",[300,320,322],{"class":302,"line":321},4,[300,323,324],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[300,326,328],{"class":302,"line":327},5,[300,329,330],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[300,332,334],{"class":302,"line":333},6,[300,335,336],{},"    )\n",[300,338,340],{"class":302,"line":339},7,[300,341,342],{},");\n",[219,344,345,346,349,350,353,354,356],{},"The corresponding Java model uses ",[239,347,348],{},"@JsonTypeInfo"," and ",[239,351,352],{},"@JsonSubTypes"," to map the ",[239,355,276],{}," field value to the correct subclass:",[291,358,362],{"className":359,"code":360,"language":361,"meta":296,"style":296},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n@JsonSubTypes({\n    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n})\npublic abstract class Item {}\n\npublic class Book extends Item {\n    public String kind;\n    public String title;\n    public String isbn;\n}\n\npublic class Video extends Item {\n    public String kind;\n    public String title;\n    public Integer duration;\n}\n","java",[239,363,364,369,374,379,384,389,394,400,406,412,418,424,430,435,441,446,451,457],{"__ignoreMap":296},[300,365,366],{"class":302,"line":303},[300,367,368],{},"@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n",[300,370,371],{"class":302,"line":309},[300,372,373],{},"@JsonSubTypes({\n",[300,375,376],{"class":302,"line":315},[300,377,378],{},"    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n",[300,380,381],{"class":302,"line":321},[300,382,383],{},"    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n",[300,385,386],{"class":302,"line":327},[300,387,388],{},"})\n",[300,390,391],{"class":302,"line":333},[300,392,393],{},"public abstract class Item {}\n",[300,395,396],{"class":302,"line":339},[300,397,399],{"emptyLinePlaceholder":398},true,"\n",[300,401,403],{"class":302,"line":402},8,[300,404,405],{},"public class Book extends Item {\n",[300,407,409],{"class":302,"line":408},9,[300,410,411],{},"    public String kind;\n",[300,413,415],{"class":302,"line":414},10,[300,416,417],{},"    public String title;\n",[300,419,421],{"class":302,"line":420},11,[300,422,423],{},"    public String isbn;\n",[300,425,427],{"class":302,"line":426},12,[300,428,429],{},"}\n",[300,431,433],{"class":302,"line":432},13,[300,434,399],{"emptyLinePlaceholder":398},[300,436,438],{"class":302,"line":437},14,[300,439,440],{},"public class Video extends Item {\n",[300,442,444],{"class":302,"line":443},15,[300,445,411],{},[300,447,449],{"class":302,"line":448},16,[300,450,417],{},[300,452,454],{"class":302,"line":453},17,[300,455,456],{},"    public Integer duration;\n",[300,458,460],{"class":302,"line":459},18,[300,461,429],{},[219,463,464],{},"When inserting documents, always write the discriminator value:",[291,466,468],{"className":293,"code":467,"language":295,"meta":296,"style":296},"INSERT INTO assets (id, item)\n    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[239,469,470,475],{"__ignoreMap":296},[300,471,472],{"class":302,"line":303},[300,473,474],{},"INSERT INTO assets (id, item)\n",[300,476,477],{"class":302,"line":309},[300,478,479],{},"    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[219,481,482,483,485],{},"If the ",[239,484,276],{}," field is absent from a stored document, Jackson will fail to deserialize it. Ensure every INSERT that targets a UNION field includes the discriminator.",[283,487,489],{"id":488},"conflict-validation","Conflict validation",[219,491,492,493,496,497,500,501,504],{},"If two variants declare the same field name with different scalar types — e.g. ",[239,494,495],{},"title TEXT"," in one variant and ",[239,498,499],{},"title KEYWORD"," in another — the migration executor will throw an ",[239,502,503],{},"IllegalArgumentException"," at mapping time. Fields shared across variants must have identical types.",[219,506,507,510,511,514],{},[270,508,509],{},"Known limitation:"," Conflict detection is shallow for composite types. If two variants share a field name with the same composite type (OBJECT, NESTED, or UNION) but different sub-fields, no exception is thrown — only the first variant's sub-field definitions are used and the second's are silently dropped. Until named type support is added to the migration DSL, avoid sharing composite-typed fields across variants. Scalar shared fields (such as a ",[239,512,513],{},"kind KEYWORD"," discriminator) are always safe.",[228,516,518],{"id":517},"data-streams","Data Streams",[219,520,521,522,525,526,532],{},"System data that is append-only and time-series — audit trails, events, telemetry — should be backed by an Elasticsearch ",[270,523,524],{},"data stream"," rather than a regular index, so old data ages out and backing indices roll over automatically. Create one from a migration with ",[223,527,529],{"href":528},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#create-data-stream",[239,530,531],{},"CREATE DATA STREAM",":",[291,534,536],{"className":293,"code":535,"language":295,"meta":296,"style":296},"CREATE DATA STREAM system_audit (\n    actor  KEYWORD,\n    action KEYWORD,\n    detail TEXT\n) WITH (DATA_RETENTION = '90d') ;\n",[239,537,538,543,548,553,558],{"__ignoreMap":296},[300,539,540],{"class":302,"line":303},[300,541,542],{},"CREATE DATA STREAM system_audit (\n",[300,544,545],{"class":302,"line":309},[300,546,547],{},"    actor  KEYWORD,\n",[300,549,550],{"class":302,"line":315},[300,551,552],{},"    action KEYWORD,\n",[300,554,555],{"class":302,"line":321},[300,556,557],{},"    detail TEXT\n",[300,559,560],{"class":302,"line":327},[300,561,562],{},") WITH (DATA_RETENTION = '90d') ;\n",[219,564,565,568,569,575,576,578],{},[239,566,567],{},"DATA_RETENTION"," is the native ",[223,570,574],{"href":571,"rel":572},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fmanage-data\u002Flifecycle\u002Fdata-stream",[573],"nofollow","data stream lifecycle"," — Elasticsearch deletes data past the period (measured per backing index from rollover, not per document). See the ",[223,577,139],{"href":528}," for the full statement and the exact retention semantics.",[283,580,582,583,586],{"id":581},"every-document-needs-a-timestamp-and-java-needs-ceremony-for-it","Every document needs a ",[239,584,585],{},"@timestamp"," — and Java needs ceremony for it",[219,588,589,590,593,594,596,597,600,601,603,604,606],{},"Elasticsearch ",[270,591,592],{},"requires"," every document written to a data stream to carry a ",[239,595,585],{}," date field, and rejects any that don't with ",[239,598,599],{},"data stream timestamp field [@timestamp] is missing",". The migration adds ",[239,602,585],{}," to the mapping automatically — you neither declare it as a column nor can you, since ",[239,605,585],{}," is not a legal column identifier.",[219,608,609,610,613,614,616,617,620,621,624],{},"The catch is on the ",[270,611,612],{},"write"," side: ",[239,615,585],{}," is also not a legal Java field name, so a system DTO cannot carry it directly. Bridge it with Jackson's ",[239,618,619],{},"@JsonProperty"," — the ",[239,622,623],{},"ElasticsearchAsyncClient"," serializes through a Jackson mapper, so the annotation is honored on both write and read:",[291,626,628],{"className":359,"code":627,"language":361,"meta":296,"style":296},"public class AuditEvent {\n    private String  id;\n\n    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n    private Instant timestamp;\n\n    private String  actor;\n    private String  action;\n}\n",[239,629,630,635,640,644,649,654,658,663,668],{"__ignoreMap":296},[300,631,632],{"class":302,"line":303},[300,633,634],{},"public class AuditEvent {\n",[300,636,637],{"class":302,"line":309},[300,638,639],{},"    private String  id;\n",[300,641,642],{"class":302,"line":315},[300,643,399],{"emptyLinePlaceholder":398},[300,645,646],{"class":302,"line":321},[300,647,648],{},"    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n",[300,650,651],{"class":302,"line":327},[300,652,653],{},"    private Instant timestamp;\n",[300,655,656],{"class":302,"line":333},[300,657,399],{"emptyLinePlaceholder":398},[300,659,660],{"class":302,"line":339},[300,661,662],{},"    private String  actor;\n",[300,664,665],{"class":302,"line":402},[300,666,667],{},"    private String  action;\n",[300,669,670],{"class":302,"line":408},[300,671,429],{},[219,673,674,675,678,679,681,682,685],{},"This ",[270,676,677],{},"renames"," the field — the stored document has only ",[239,680,585],{},", so any query or sort must use that literal name (",[239,683,684],{},"timestamp"," does not exist in the index). For most internal stream DTOs this is the simplest correct choice.",[219,687,688,689,693,694,696],{},"If you instead want a friendly, separately-queryable field name ",[690,691,692],"em",{},"alongside"," ",[239,695,585],{},", keep your own field and add a serialize-only companion:",[291,698,700],{"className":359,"code":699,"language":361,"meta":296,"style":296},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\nprivate Instant eventTime;\n\n\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\npublic Instant esTimestamp() { return eventTime; }\n",[239,701,702,707,712,716,721,726],{"__ignoreMap":296},[300,703,704],{"class":302,"line":303},[300,705,706],{},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\n",[300,708,709],{"class":302,"line":309},[300,710,711],{},"private Instant eventTime;\n",[300,713,714],{"class":302,"line":315},[300,715,399],{"emptyLinePlaceholder":398},[300,717,718],{"class":302,"line":321},[300,719,720],{},"\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n",[300,722,723],{"class":302,"line":327},[300,724,725],{},"@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\n",[300,727,728],{"class":302,"line":333},[300,729,730],{},"public Instant esTimestamp() { return eventTime; }\n",[219,732,674,733,736,737,349,740,742,743,748],{},[270,734,735],{},"duplicates"," the value (both ",[239,738,739],{},"eventTime",[239,741,585],{}," are stored). It is the same document shape that application entities get from the ",[223,744,745],{"href":73},[239,746,747],{},"@TimeReference"," decorator. When a migration creates the stream backing such an entity, declare the pairing so the stream documents which column is the natural time field:",[291,750,752],{"className":293,"code":751,"language":295,"meta":296,"style":296},"CREATE DATA STREAM sensor_readings (\n    id        KEYWORD,\n    eventTime DATE,\n    value     DOUBLE\n) WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[239,753,754,759,764,769,774],{"__ignoreMap":296},[300,755,756],{"class":302,"line":303},[300,757,758],{},"CREATE DATA STREAM sensor_readings (\n",[300,760,761],{"class":302,"line":309},[300,762,763],{},"    id        KEYWORD,\n",[300,765,766],{"class":302,"line":315},[300,767,768],{},"    eventTime DATE,\n",[300,770,771],{"class":302,"line":321},[300,772,773],{},"    value     DOUBLE\n",[300,775,776],{"class":302,"line":327},[300,777,778],{},") WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[219,780,781,784,785,788,789,791,792,794],{},[239,782,783],{},"TIME_REFERENCE"," must name a declared ",[239,786,787],{},"DATE"," column; the migration validates this and fails fast otherwise. It declares intent and pairs with the entity's ",[239,790,747],{}," — the write-time duplication into ",[239,793,585],{}," is performed by the persistence layer, not the migration.",[283,796,798],{"id":797},"writing-and-reading","Writing and reading",[219,800,801,802,805,806,809,810,813],{},"Data streams are ",[270,803,804],{},"append-only",": Elasticsearch accepts only the ",[239,807,808],{},"create"," op-type and rejects the ",[239,811,812],{},"index"," op and by-id updates\u002Fdeletes. Documents are retrieved by search\u002Fquery, not by id. System services that write to a stream must therefore use a create (append) write, and read through search rather than a find-by-id lookup.",[815,816,817],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-defa