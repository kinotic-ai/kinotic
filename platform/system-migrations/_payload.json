u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"id":224,"title":191,"body":225,"description":841,"extension":842,"links":843,"meta":844,"navigation":845,"path":192,"seo":846,"stem":193,"__hash__":847},"docs\u002F02.platform\u002F10.system-migrations.md",{"type":226,"value":227,"toc":828},"minimark",[228,237,242,245,257,261,269,273,276,292,297,300,353,367,472,475,490,496,500,515,525,529,543,573,589,597,617,635,682,696,707,741,759,789,805,809,824],[229,230,231,232,236],"p",{},"The Kinotic platform uses the same migration SQL system as application developers to manage its own internal Elasticsearch indices. This page covers considerations specific to platform development — for general migration syntax, see ",[233,234,235],"a",{"href":89},"App Migrations",".",[238,239,241],"h2",{"id":240},"what-are-system-migrations","What Are System Migrations?",[229,243,244],{},"System migrations define and evolve the indices that the platform itself relies on — things like migration history tracking, system configuration, and other internal data stores. They run during platform startup before any application migrations and are scoped to the system project rather than a per-application project.",[229,246,247,248,252,253,256],{},"System migrations live in ",[249,250,251],"code",{},"kinotic-migration\u002Fsrc\u002Fmain\u002Fresources\u002Fmigrations\u002F"," and follow the same ",[249,254,255],{},"V\u003CN>__\u003Cdescription>.sql"," naming convention.",[238,258,260],{"id":259},"using-composite-types-in-system-indices","Using Composite Types in System Indices",[229,262,263,264,268],{},"OBJECT, NESTED, and UNION columns work the same way in system migrations as in application migrations. Refer to the ",[233,265,267],{"href":266},"\u002Fapps\u002Fpersistence\u002Fmigrations#composite-column-types","Composite Column Types"," section of the app documentation for syntax and examples.",[238,270,272],{"id":271},"deserializing-union-types","Deserializing Union Types",[229,274,275],{},"Elasticsearch stores UNION fields as a flat merged object — it has no knowledge of which variant a document contains. When reading documents back into Java, the platform needs to route deserialization to the correct subclass.",[229,277,278,279,283,284,287,288,291],{},"The standard approach is Jackson's polymorphic type handling, driven by a ",[280,281,282],"strong",{},"discriminator field"," stored in the document. This is the same ",[249,285,286],{},"kind"," (or similar) ",[249,289,290],{},"KEYWORD"," field you include in each union variant in the migration SQL.",[293,294,296],"h3",{"id":295},"example","Example",[229,298,299],{},"Given this migration:",[301,302,307],"pre",{"className":303,"code":304,"language":305,"meta":306,"style":306},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n","sql","",[249,308,309,317,323,329,335,341,347],{"__ignoreMap":306},[310,311,314],"span",{"class":312,"line":313},"line",1,[310,315,316],{},"CREATE TABLE assets (\n",[310,318,320],{"class":312,"line":319},2,[310,321,322],{},"    id KEYWORD,\n",[310,324,326],{"class":312,"line":325},3,[310,327,328],{},"    item UNION (\n",[310,330,332],{"class":312,"line":331},4,[310,333,334],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[310,336,338],{"class":312,"line":337},5,[310,339,340],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[310,342,344],{"class":312,"line":343},6,[310,345,346],{},"    )\n",[310,348,350],{"class":312,"line":349},7,[310,351,352],{},");\n",[229,354,355,356,359,360,363,364,366],{},"The corresponding Java model uses ",[249,357,358],{},"@JsonTypeInfo"," and ",[249,361,362],{},"@JsonSubTypes"," to map the ",[249,365,286],{}," field value to the correct subclass:",[301,368,372],{"className":369,"code":370,"language":371,"meta":306,"style":306},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n@JsonSubTypes({\n    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n})\npublic abstract class Item {}\n\npublic class Book extends Item {\n    public String kind;\n    public String title;\n    public String isbn;\n}\n\npublic class Video extends Item {\n    public String kind;\n    public String title;\n    public Integer duration;\n}\n","java",[249,373,374,379,384,389,394,399,404,410,416,422,428,434,440,445,451,456,461,467],{"__ignoreMap":306},[310,375,376],{"class":312,"line":313},[310,377,378],{},"@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n",[310,380,381],{"class":312,"line":319},[310,382,383],{},"@JsonSubTypes({\n",[310,385,386],{"class":312,"line":325},[310,387,388],{},"    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n",[310,390,391],{"class":312,"line":331},[310,392,393],{},"    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n",[310,395,396],{"class":312,"line":337},[310,397,398],{},"})\n",[310,400,401],{"class":312,"line":343},[310,402,403],{},"public abstract class Item {}\n",[310,405,406],{"class":312,"line":349},[310,407,409],{"emptyLinePlaceholder":408},true,"\n",[310,411,413],{"class":312,"line":412},8,[310,414,415],{},"public class Book extends Item {\n",[310,417,419],{"class":312,"line":418},9,[310,420,421],{},"    public String kind;\n",[310,423,425],{"class":312,"line":424},10,[310,426,427],{},"    public String title;\n",[310,429,431],{"class":312,"line":430},11,[310,432,433],{},"    public String isbn;\n",[310,435,437],{"class":312,"line":436},12,[310,438,439],{},"}\n",[310,441,443],{"class":312,"line":442},13,[310,444,409],{"emptyLinePlaceholder":408},[310,446,448],{"class":312,"line":447},14,[310,449,450],{},"public class Video extends Item {\n",[310,452,454],{"class":312,"line":453},15,[310,455,421],{},[310,457,459],{"class":312,"line":458},16,[310,460,427],{},[310,462,464],{"class":312,"line":463},17,[310,465,466],{},"    public Integer duration;\n",[310,468,470],{"class":312,"line":469},18,[310,471,439],{},[229,473,474],{},"When inserting documents, always write the discriminator value:",[301,476,478],{"className":303,"code":477,"language":305,"meta":306,"style":306},"INSERT INTO assets (id, item)\n    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[249,479,480,485],{"__ignoreMap":306},[310,481,482],{"class":312,"line":313},[310,483,484],{},"INSERT INTO assets (id, item)\n",[310,486,487],{"class":312,"line":319},[310,488,489],{},"    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[229,491,492,493,495],{},"If the ",[249,494,286],{}," field is absent from a stored document, Jackson will fail to deserialize it. Ensure every INSERT that targets a UNION field includes the discriminator.",[293,497,499],{"id":498},"conflict-validation","Conflict validation",[229,501,502,503,506,507,510,511,514],{},"If two variants declare the same field name with different scalar types — e.g. ",[249,504,505],{},"title TEXT"," in one variant and ",[249,508,509],{},"title KEYWORD"," in another — the migration executor will throw an ",[249,512,513],{},"IllegalArgumentException"," at mapping time. Fields shared across variants must have identical types.",[229,516,517,520,521,524],{},[280,518,519],{},"Known limitation:"," Conflict detection is shallow for composite types. If two variants share a field name with the same composite type (OBJECT, NESTED, or UNION) but different sub-fields, no exception is thrown — only the first variant's sub-field definitions are used and the second's are silently dropped. Until named type support is added to the migration DSL, avoid sharing composite-typed fields across variants. Scalar shared fields (such as a ",[249,522,523],{},"kind KEYWORD"," discriminator) are always safe.",[238,526,528],{"id":527},"data-streams","Data Streams",[229,530,531,532,535,536,542],{},"System data that is append-only and time-series — audit trails, events, telemetry — should be backed by an Elasticsearch ",[280,533,534],{},"data stream"," rather than a regular index, so old data ages out and backing indices roll over automatically. Create one from a migration with ",[233,537,539],{"href":538},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#create-data-stream",[249,540,541],{},"CREATE DATA STREAM",":",[301,544,546],{"className":303,"code":545,"language":305,"meta":306,"style":306},"CREATE DATA STREAM system_audit (\n    actor  KEYWORD,\n    action KEYWORD,\n    detail TEXT\n) WITH (DATA_RETENTION = '90d') ;\n",[249,547,548,553,558,563,568],{"__ignoreMap":306},[310,549,550],{"class":312,"line":313},[310,551,552],{},"CREATE DATA STREAM system_audit (\n",[310,554,555],{"class":312,"line":319},[310,556,557],{},"    actor  KEYWORD,\n",[310,559,560],{"class":312,"line":325},[310,561,562],{},"    action KEYWORD,\n",[310,564,565],{"class":312,"line":331},[310,566,567],{},"    detail TEXT\n",[310,569,570],{"class":312,"line":337},[310,571,572],{},") WITH (DATA_RETENTION = '90d') ;\n",[229,574,575,578,579,585,586,588],{},[249,576,577],{},"DATA_RETENTION"," is the native ",[233,580,584],{"href":581,"rel":582},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fmanage-data\u002Flifecycle\u002Fdata-stream",[583],"nofollow","data stream lifecycle"," — Elasticsearch deletes data past the period (measured per backing index from rollover, not per document). See the ",[233,587,139],{"href":538}," for the full statement and the exact retention semantics.",[293,590,592,593,596],{"id":591},"every-document-needs-a-timestamp-and-java-needs-ceremony-for-it","Every document needs a ",[249,594,595],{},"@timestamp"," — and Java needs ceremony for it",[229,598,599,600,603,604,606,607,610,611,613,614,616],{},"Elasticsearch ",[280,601,602],{},"requires"," every document written to a data stream to carry a ",[249,605,595],{}," date field, and rejects any that don't with ",[249,608,609],{},"data stream timestamp field [@timestamp] is missing",". The migration adds ",[249,612,595],{}," to the mapping automatically — you neither declare it as a column nor can you, since ",[249,615,595],{}," is not a legal column identifier.",[229,618,619,620,623,624,626,627,630,631,634],{},"The catch is on the ",[280,621,622],{},"write"," side: ",[249,625,595],{}," is also not a legal Java field name, so a system DTO cannot carry it directly. Bridge it with Jackson's ",[249,628,629],{},"@JsonProperty"," — the ",[249,632,633],{},"ElasticsearchAsyncClient"," serializes through a Jackson mapper, so the annotation is honored on both write and read:",[301,636,638],{"className":369,"code":637,"language":371,"meta":306,"style":306},"public class AuditEvent {\n    private String  id;\n\n    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n    private Instant timestamp;\n\n    private String  actor;\n    private String  action;\n}\n",[249,639,640,645,650,654,659,664,668,673,678],{"__ignoreMap":306},[310,641,642],{"class":312,"line":313},[310,643,644],{},"public class AuditEvent {\n",[310,646,647],{"class":312,"line":319},[310,648,649],{},"    private String  id;\n",[310,651,652],{"class":312,"line":325},[310,653,409],{"emptyLinePlaceholder":408},[310,655,656],{"class":312,"line":331},[310,657,658],{},"    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n",[310,660,661],{"class":312,"line":337},[310,662,663],{},"    private Instant timestamp;\n",[310,665,666],{"class":312,"line":343},[310,667,409],{"emptyLinePlaceholder":408},[310,669,670],{"class":312,"line":349},[310,671,672],{},"    private String  actor;\n",[310,674,675],{"class":312,"line":412},[310,676,677],{},"    private String  action;\n",[310,679,680],{"class":312,"line":418},[310,681,439],{},[229,683,684,685,688,689,691,692,695],{},"This ",[280,686,687],{},"renames"," the field — the stored document has only ",[249,690,595],{},", so any query or sort must use that literal name (",[249,693,694],{},"timestamp"," does not exist in the index). For most internal stream DTOs this is the simplest correct choice.",[229,697,698,699,703,704,706],{},"If you instead want a friendly, separately-queryable field name ",[700,701,702],"em",{},"alongside"," ",[249,705,595],{},", keep your own field and add a serialize-only companion:",[301,708,710],{"className":369,"code":709,"language":371,"meta":306,"style":306},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\nprivate Instant eventTime;\n\n\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\npublic Instant esTimestamp() { return eventTime; }\n",[249,711,712,717,722,726,731,736],{"__ignoreMap":306},[310,713,714],{"class":312,"line":313},[310,715,716],{},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\n",[310,718,719],{"class":312,"line":319},[310,720,721],{},"private Instant eventTime;\n",[310,723,724],{"class":312,"line":325},[310,725,409],{"emptyLinePlaceholder":408},[310,727,728],{"class":312,"line":331},[310,729,730],{},"\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n",[310,732,733],{"class":312,"line":337},[310,734,735],{},"@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\n",[310,737,738],{"class":312,"line":343},[310,739,740],{},"public Instant esTimestamp() { return eventTime; }\n",[229,742,684,743,746,747,359,750,752,753,758],{},[280,744,745],{},"duplicates"," the value (both ",[249,748,749],{},"eventTime",[249,751,595],{}," are stored). It is the same document shape that application entities get from the ",[233,754,755],{"href":73},[249,756,757],{},"@TimeReference"," decorator. When a migration creates the stream backing such an entity, declare the pairing so the stream documents which column is the natural time field:",[301,760,762],{"className":303,"code":761,"language":305,"meta":306,"style":306},"CREATE DATA STREAM sensor_readings (\n    id        KEYWORD,\n    eventTime DATE,\n    value     DOUBLE\n) WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[249,763,764,769,774,779,784],{"__ignoreMap":306},[310,765,766],{"class":312,"line":313},[310,767,768],{},"CREATE DATA STREAM sensor_readings (\n",[310,770,771],{"class":312,"line":319},[310,772,773],{},"    id        KEYWORD,\n",[310,775,776],{"class":312,"line":325},[310,777,778],{},"    eventTime DATE,\n",[310,780,781],{"class":312,"line":331},[310,782,783],{},"    value     DOUBLE\n",[310,785,786],{"class":312,"line":337},[310,787,788],{},") WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[229,790,791,794,795,798,799,801,802,804],{},[249,792,793],{},"TIME_REFERENCE"," must name a declared ",[249,796,797],{},"DATE"," column; the migration validates this and fails fast otherwise. It declares intent and pairs with the entity's ",[249,800,757],{}," — the write-time duplication into ",[249,803,595],{}," is performed by the persistence layer, not the migration.",[293,806,808],{"id":807},"writing-and-reading","Writing and reading",[229,810,811,812,815,816,819,820,823],{},"Data streams are ",[280,813,814],{},"append-only",": Elasticsearch accepts only the ",[249,817,818],{},"create"," op-type and rejects the ",[249,821,822],{},"index"," op and by-id updates\u002Fdeletes. Documents are retrieved by search\u002Fquery, not by id. System services that write to a stream must therefore use a create (append) write, and read through search rather than a find-by-id lookup.",[825,826,827],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":306,"searchDepth":319,"depth":319,"links":829},[830,831,832,836],{"id":240,"depth":319,"text":241},{"id":259,"depth":319,"text":260},{"id":271,"depth":319,"text":272,"children":833},[834,835],{"id":295,"depth":325,"text":296},{"id":498,"depth":325,"text":499},{"id":527,"depth":319,"text":528,"children":837},[838,840],{"id":591,"depth":325,"text":839},"Every document needs a @timestamp — and Java needs ceremony for it",{"id":807,"depth":325,"text":808},"Writing and maintaining migration scripts for Kinotic's internal system indices.","md",null,{},{"icon":194},{"title":191,"description":841},"YBKPRIuIyPm3yUu82Q0HaD4nbPZsWLEuTPDyWjZI1Lw",[849,851],{"title":186,"path":187,"stem":188,"description":850,"icon":189,"children":-1},"How to contribute to the Kinotic OS project.",{"title":196,"path":197,"stem":198,"description":852,"icon":199,"children":-1},"How a call through a service proxy fails when the node serving it dies, instead of waiting forever — without a timeout anywhere.",1789462942885]