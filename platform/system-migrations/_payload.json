234,"icon":235},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":237,"path":238,"stem":239,"icon":240},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":242,"path":243,"stem":244,"icon":179},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":246,"path":247,"stem":248,"icon":38},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":250,"path":251,"stem":252,"icon":253},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":255,"path":256,"stem":257,"icon":258},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":260,"path":261,"stem":262,"icon":263},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":265,"title":218,"body":266,"description":882,"extension":883,"links":884,"meta":885,"navigation":886,"path":219,"seo":887,"stem":220,"__hash__":888},"docs\u002F04.platform\u002F10.system-migrations.md",{"type":267,"value":268,"toc":869},"minimark",[269,278,283,286,298,302,310,314,317,333,338,341,394,408,513,516,531,537,541,556,566,570,584,614,630,638,658,676,723,737,748,782,800,830,846,850,865],[270,271,272,273,277],"p",{},"The Kinotic platform uses the same migration SQL system as application developers to manage its own internal Elasticsearch indices. This page covers considerations specific to platform development — for general migration syntax, see ",[274,275,276],"a",{"href":119},"App Migrations",".",[279,280,282],"h2",{"id":281},"what-are-system-migrations","What Are System Migrations?",[270,284,285],{},"System migrations define and evolve the indices that the platform itself relies on — things like migration history tracking, system configuration, and other internal data stores. They run during platform startup before any application migrations and are scoped to the system project rather than a per-application project.",[270,287,288,289,293,294,297],{},"System migrations live in ",[290,291,292],"code",{},"kinotic-migration\u002Fsrc\u002Fmain\u002Fresources\u002Fmigrations\u002F"," and follow the same ",[290,295,296],{},"V\u003CN>__\u003Cdescription>.sql"," naming convention.",[279,299,301],{"id":300},"using-composite-types-in-system-indices","Using Composite Types in System Indices",[270,303,304,305,309],{},"OBJECT, NESTED, and UNION columns work the same way in system migrations as in application migrations. Refer to the ",[274,306,308],{"href":307},"\u002Fapps\u002Fpersistence\u002Fmigrations#composite-column-types","Composite Column Types"," section of the app documentation for syntax and examples.",[279,311,313],{"id":312},"deserializing-union-types","Deserializing Union Types",[270,315,316],{},"Elasticsearch stores UNION fields as a flat merged object — it has no knowledge of which variant a document contains. When reading documents back into Java, the platform needs to route deserialization to the correct subclass.",[270,318,319,320,324,325,328,329,332],{},"The standard approach is Jackson's polymorphic type handling, driven by a ",[321,322,323],"strong",{},"discriminator field"," stored in the document. This is the same ",[290,326,327],{},"kind"," (or similar) ",[290,330,331],{},"KEYWORD"," field you include in each union variant in the migration SQL.",[334,335,337],"h3",{"id":336},"example","Example",[270,339,340],{},"Given this migration:",[342,343,348],"pre",{"className":344,"code":345,"language":346,"meta":347,"style":347},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n","sql","",[290,349,350,358,364,370,376,382,388],{"__ignoreMap":347},[351,352,355],"span",{"class":353,"line":354},"line",1,[351,356,357],{},"CREATE TABLE assets (\n",[351,359,361],{"class":353,"line":360},2,[351,362,363],{},"    id KEYWORD,\n",[351,365,367],{"class":353,"line":366},3,[351,368,369],{},"    item UNION (\n",[351,371,373],{"class":353,"line":372},4,[351,374,375],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[351,377,379],{"class":353,"line":378},5,[351,380,381],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[351,383,385],{"class":353,"line":384},6,[351,386,387],{},"    )\n",[351,389,391],{"class":353,"line":390},7,[351,392,393],{},");\n",[270,395,396,397,400,401,404,405,407],{},"The corresponding Java model uses ",[290,398,399],{},"@JsonTypeInfo"," and ",[290,402,403],{},"@JsonSubTypes"," to map the ",[290,406,327],{}," field value to the correct subclass:",[342,409,413],{"className":410,"code":411,"language":412,"meta":347,"style":347},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n@JsonSubTypes({\n    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n})\npublic abstract class Item {}\n\npublic class Book extends Item {\n    public String kind;\n    public String title;\n    public String isbn;\n}\n\npublic class Video extends Item {\n    public String kind;\n    public String title;\n    public Integer duration;\n}\n","java",[290,414,415,420,425,430,435,440,445,451,457,463,469,475,481,486,492,497,502,508],{"__ignoreMap":347},[351,416,417],{"class":353,"line":354},[351,418,419],{},"@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n",[351,421,422],{"class":353,"line":360},[351,423,424],{},"@JsonSubTypes({\n",[351,426,427],{"class":353,"line":366},[351,428,429],{},"    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n",[351,431,432],{"class":353,"line":372},[351,433,434],{},"    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n",[351,436,437],{"class":353,"line":378},[351,438,439],{},"})\n",[351,441,442],{"class":353,"line":384},[351,443,444],{},"public abstract class Item {}\n",[351,446,447],{"class":353,"line":390},[351,448,450],{"emptyLinePlaceholder":449},true,"\n",[351,452,454],{"class":353,"line":453},8,[351,455,456],{},"public class Book extends Item {\n",[351,458,460],{"class":353,"line":459},9,[351,461,462],{},"    public String kind;\n",[351,464,466],{"class":353,"line":465},10,[351,467,468],{},"    public String title;\n",[351,470,472],{"class":353,"line":471},11,[351,473,474],{},"    public String isbn;\n",[351,476,478],{"class":353,"line":477},12,[351,479,480],{},"}\n",[351,482,484],{"class":353,"line":483},13,[351,485,450],{"emptyLinePlaceholder":449},[351,487,489],{"class":353,"line":488},14,[351,490,491],{},"public class Video extends Item {\n",[351,493,495],{"class":353,"line":494},15,[351,496,462],{},[351,498,500],{"class":353,"line":499},16,[351,501,468],{},[351,503,505],{"class":353,"line":504},17,[351,506,507],{},"    public Integer duration;\n",[351,509,511],{"class":353,"line":510},18,[351,512,480],{},[270,514,515],{},"When inserting documents, always write the discriminator value:",[342,517,519],{"className":344,"code":518,"language":346,"meta":347,"style":347},"INSERT INTO assets (id, item)\n    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[290,520,521,526],{"__ignoreMap":347},[351,522,523],{"class":353,"line":354},[351,524,525],{},"INSERT INTO assets (id, item)\n",[351,527,528],{"class":353,"line":360},[351,529,530],{},"    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[270,532,533,534,536],{},"If the ",[290,535,327],{}," field is absent from a stored document, Jackson will fail to deserialize it. Ensure every INSERT that targets a UNION field includes the discriminator.",[334,538,540],{"id":539},"conflict-validation","Conflict validation",[270,542,543,544,547,548,551,552,555],{},"If two variants declare the same field name with different scalar types — e.g. ",[290,545,546],{},"title TEXT"," in one variant and ",[290,549,550],{},"title KEYWORD"," in another — the migration executor will throw an ",[290,553,554],{},"IllegalArgumentException"," at mapping time. Fields shared across variants must have identical types.",[270,557,558,561,562,565],{},[321,559,560],{},"Known limitation:"," Conflict detection is shallow for composite types. If two variants share a field name with the same composite type (OBJECT, NESTED, or UNION) but different sub-fields, no exception is thrown — only the first variant's sub-field definitions are used and the second's are silently dropped. Until named type support is added to the migration DSL, avoid sharing composite-typed fields across variants. Scalar shared fields (such as a ",[290,563,564],{},"kind KEYWORD"," discriminator) are always safe.",[279,567,569],{"id":568},"data-streams","Data Streams",[270,571,572,573,576,577,583],{},"System data that is append-only and time-series — audit trails, events, telemetry — should be backed by an Elasticsearch ",[321,574,575],{},"data stream"," rather than a regular index, so old data ages out and backing indices roll over automatically. Create one from a migration with ",[274,578,580],{"href":579},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#create-data-stream",[290,581,582],{},"CREATE DATA STREAM",":",[342,585,587],{"className":344,"code":586,"language":346,"meta":347,"style":347},"CREATE DATA STREAM system_audit (\n    actor  KEYWORD,\n    action KEYWORD,\n    detail TEXT\n) WITH (DATA_RETENTION = '90d') ;\n",[290,588,589,594,599,604,609],{"__ignoreMap":347},[351,590,591],{"class":353,"line":354},[351,592,593],{},"CREATE DATA STREAM system_audit (\n",[351,595,596],{"class":353,"line":360},[351,597,598],{},"    actor  KEYWORD,\n",[351,600,601],{"class":353,"line":366},[351,602,603],{},"    action KEYWORD,\n",[351,605,606],{"class":353,"line":372},[351,607,608],{},"    detail TEXT\n",[351,610,611],{"class":353,"line":378},[351,612,613],{},") WITH (DATA_RETENTION = '90d') ;\n",[270,615,616,619,620,626,627,629],{},[290,617,618],{},"DATA_RETENTION"," is the native ",[274,621,625],{"href":622,"rel":623},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fmanage-data\u002Flifecycle\u002Fdata-stream",[624],"nofollow","data stream lifecycle"," — Elasticsearch deletes data past the period (measured per backing index from rollover, not per document). See the ",[274,628,167],{"href":579}," for the full statement and the exact retention semantics.",[334,631,633,634,637],{"id":632},"every-document-needs-a-timestamp-and-java-needs-ceremony-for-it","Every document needs a ",[290,635,636],{},"@timestamp"," — and Java needs ceremony for it",[270,639,640,641,644,645,647,648,651,652,654,655,657],{},"Elasticsearch ",[321,642,643],{},"requires"," every document written to a data stream to carry a ",[290,646,636],{}," date field, and rejects any that don't with ",[290,649,650],{},"data stream timestamp field [@timestamp] is missing",". The migration adds ",[290,653,636],{}," to the mapping automatically — you neither declare it as a column nor can you, since ",[290,656,636],{}," is not a legal column identifier.",[270,659,660,661,664,665,667,668,671,672,675],{},"The catch is on the ",[321,662,663],{},"write"," side: ",[290,666,636],{}," is also not a legal Java field name, so a system DTO cannot carry it directly. Bridge it with Jackson's ",[290,669,670],{},"@JsonProperty"," — the ",[290,673,674],{},"ElasticsearchAsyncClient"," serializes through a Jackson mapper, so the annotation is honored on both write and read:",[342,677,679],{"className":410,"code":678,"language":412,"meta":347,"style":347},"public class AuditEvent {\n    private String  id;\n\n    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n    private Instant timestamp;\n\n    private String  actor;\n    private String  action;\n}\n",[290,680,681,686,691,695,700,705,709,714,719],{"__ignoreMap":347},[351,682,683],{"class":353,"line":354},[351,684,685],{},"public class AuditEvent {\n",[351,687,688],{"class":353,"line":360},[351,689,690],{},"    private String  id;\n",[351,692,693],{"class":353,"line":366},[351,694,450],{"emptyLinePlaceholder":449},[351,696,697],{"class":353,"line":372},[351,698,699],{},"    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n",[351,701,702],{"class":353,"line":378},[351,703,704],{},"    private Instant timestamp;\n",[351,706,707],{"class":353,"line":384},[351,708,450],{"emptyLinePlaceholder":449},[351,710,711],{"class":353,"line":390},[351,712,713],{},"    private String  actor;\n",[351,715,716],{"class":353,"line":453},[351,717,718],{},"    private String  action;\n",[351,720,721],{"class":353,"line":459},[351,722,480],{},[270,724,725,726,729,730,732,733,736],{},"This ",[321,727,728],{},"renames"," the field — the stored document has only ",[290,731,636],{},", so any query or sort must use that literal name (",[290,734,735],{},"timestamp"," does not exist in the index). For most internal stream DTOs this is the simplest correct choice.",[270,738,739,740,744,745,747],{},"If you instead want a friendly, separately-queryable field name ",[741,742,743],"em",{},"alongside"," ",[290,746,636],{},", keep your own field and add a serialize-only companion:",[342,749,751],{"className":410,"code":750,"language":412,"meta":347,"style":347},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\nprivate Instant eventTime;\n\n\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\npublic Instant esTimestamp() { return eventTime; }\n",[290,752,753,758,763,767,772,777],{"__ignoreMap":347},[351,754,755],{"class":353,"line":354},[351,756,757],{},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\n",[351,759,760],{"class":353,"line":360},[351,761,762],{},"private Instant eventTime;\n",[351,764,765],{"class":353,"line":366},[351,766,450],{"emptyLinePlaceholder":449},[351,768,769],{"class":353,"line":372},[351,770,771],{},"\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n",[351,773,774],{"class":353,"line":378},[351,775,776],{},"@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\n",[351,778,779],{"class":353,"line":384},[351,780,781],{},"public Instant esTimestamp() { return eventTime; }\n",[270,783,725,784,787,788,400,791,793,794,799],{},[321,785,786],{},"duplicates"," the value (both ",[290,789,790],{},"eventTime",[290,792,636],{}," are stored). It is the same document shape that application entities get from the ",[274,795,796],{"href":103},[290,797,798],{},"@TimeReference"," decorator. When a migration creates the stream backing such an entity, declare the pairing so the stream documents which column is the natural time field:",[342,801,803],{"className":344,"code":802,"language":346,"meta":347,"style":347},"CREATE DATA STREAM sensor_readings (\n    id        KEYWORD,\n    eventTime DATE,\n    value     DOUBLE\n) WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[290,804,805,810,815,820,825],{"__ignoreMap":347},[351,806,807],{"class":353,"line":354},[351,808,809],{},"CREATE DATA STREAM sensor_readings (\n",[351,811,812],{"class":353,"line":360},[351,813,814],{},"    id        KEYWORD,\n",[351,816,817],{"class":353,"line":366},[351,818,819],{},"    eventTime DATE,\n",[351,821,822],{"class":353,"line":372},[351,823,824],{},"    value     DOUBLE\n",[351,826,827],{"class":353,"line":378},[351,828,829],{},") WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[270,831,832,835,836,839,840,842,843,845],{},[290,833,834],{},"TIME_REFERENCE"," must name a declared ",[290,837,838],{},"DATE"," column; the migration validates this and fails fast otherwise. It declares intent and pairs with the entity's ",[290,841,798],{}," — the write-time duplication into ",[290,844,636],{}," is performed by the persistence layer, not the migration.",[334,847,849],{"id":848},"writing-and-reading","Writing and reading",[270,851,852,853,856,857,860,861,864],{},"Data streams are ",[321,854,855],{},"append-only",": Elasticsearch accepts only the ",[290,858,859],{},"create"," op-type and rejects the ",[290,862,863],{},"index"," op and by-id updates\u002Fdeletes. Documents are retrieved by search\u002Fquery, not by id. System services that write to a stream must therefore use a create (append) write, and read through search rather than a find-by-id lookup.",[866,867,868],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shik