ense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":128,"icon":129,"path":196,"stem":197,"children":198,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[199,204],{"title":200,"path":201,"stem":202,"icon":203},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"title":205,"path":206,"stem":207,"icon":208},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F11.reference\u002F02.grind-jobs","i-lucide-workflow",{"id":210,"title":191,"body":211,"description":827,"extension":828,"links":829,"meta":830,"navigation":831,"path":192,"seo":832,"stem":193,"__hash__":833},"docs\u002F02.platform\u002F10.system-migrations.md",{"type":212,"value":213,"toc":814},"minimark",[214,223,228,231,243,247,255,259,262,278,283,286,339,353,458,461,476,482,486,501,511,515,529,559,575,583,603,621,668,682,693,727,745,775,791,795,810],[215,216,217,218,222],"p",{},"The Kinotic platform uses the same migration SQL system as application developers to manage its own internal Elasticsearch indices. This page covers considerations specific to platform development — for general migration syntax, see ",[219,220,221],"a",{"href":89},"App Migrations",".",[224,225,227],"h2",{"id":226},"what-are-system-migrations","What Are System Migrations?",[215,229,230],{},"System migrations define and evolve the indices that the platform itself relies on — things like migration history tracking, system configuration, and other internal data stores. They run during platform startup before any application migrations and are scoped to the system project rather than a per-application project.",[215,232,233,234,238,239,242],{},"System migrations live in ",[235,236,237],"code",{},"kinotic-migration\u002Fsrc\u002Fmain\u002Fresources\u002Fmigrations\u002F"," and follow the same ",[235,240,241],{},"V\u003CN>__\u003Cdescription>.sql"," naming convention.",[224,244,246],{"id":245},"using-composite-types-in-system-indices","Using Composite Types in System Indices",[215,248,249,250,254],{},"OBJECT, NESTED, and UNION columns work the same way in system migrations as in application migrations. Refer to the ",[219,251,253],{"href":252},"\u002Fapps\u002Fpersistence\u002Fmigrations#composite-column-types","Composite Column Types"," section of the app documentation for syntax and examples.",[224,256,258],{"id":257},"deserializing-union-types","Deserializing Union Types",[215,260,261],{},"Elasticsearch stores UNION fields as a flat merged object — it has no knowledge of which variant a document contains. When reading documents back into Java, the platform needs to route deserialization to the correct subclass.",[215,263,264,265,269,270,273,274,277],{},"The standard approach is Jackson's polymorphic type handling, driven by a ",[266,267,268],"strong",{},"discriminator field"," stored in the document. This is the same ",[235,271,272],{},"kind"," (or similar) ",[235,275,276],{},"KEYWORD"," field you include in each union variant in the migration SQL.",[279,280,282],"h3",{"id":281},"example","Example",[215,284,285],{},"Given this migration:",[287,288,293],"pre",{"className":289,"code":290,"language":291,"meta":292,"style":292},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n","sql","",[235,294,295,303,309,315,321,327,333],{"__ignoreMap":292},[296,297,300],"span",{"class":298,"line":299},"line",1,[296,301,302],{},"CREATE TABLE assets (\n",[296,304,306],{"class":298,"line":305},2,[296,307,308],{},"    id KEYWORD,\n",[296,310,312],{"class":298,"line":311},3,[296,313,314],{},"    item UNION (\n",[296,316,318],{"class":298,"line":317},4,[296,319,320],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[296,322,324],{"class":298,"line":323},5,[296,325,326],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[296,328,330],{"class":298,"line":329},6,[296,331,332],{},"    )\n",[296,334,336],{"class":298,"line":335},7,[296,337,338],{},");\n",[215,340,341,342,345,346,349,350,352],{},"The corresponding Java model uses ",[235,343,344],{},"@JsonTypeInfo"," and ",[235,347,348],{},"@JsonSubTypes"," to map the ",[235,351,272],{}," field value to the correct subclass:",[287,354,358],{"className":355,"code":356,"language":357,"meta":292,"style":292},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n@JsonSubTypes({\n    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n})\npublic abstract class Item {}\n\npublic class Book extends Item {\n    public String kind;\n    public String title;\n    public String isbn;\n}\n\npublic class Video extends Item {\n    public String kind;\n    public String title;\n    public Integer duration;\n}\n","java",[235,359,360,365,370,375,380,385,390,396,402,408,414,420,426,431,437,442,447,453],{"__ignoreMap":292},[296,361,362],{"class":298,"line":299},[296,363,364],{},"@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n",[296,366,367],{"class":298,"line":305},[296,368,369],{},"@JsonSubTypes({\n",[296,371,372],{"class":298,"line":311},[296,373,374],{},"    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n",[296,376,377],{"class":298,"line":317},[296,378,379],{},"    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n",[296,381,382],{"class":298,"line":323},[296,383,384],{},"})\n",[296,386,387],{"class":298,"line":329},[296,388,389],{},"public abstract class Item {}\n",[296,391,392],{"class":298,"line":335},[296,393,395],{"emptyLinePlaceholder":394},true,"\n",[296,397,399],{"class":298,"line":398},8,[296,400,401],{},"public class Book extends Item {\n",[296,403,405],{"class":298,"line":404},9,[296,406,407],{},"    public String kind;\n",[296,409,411],{"class":298,"line":410},10,[296,412,413],{},"    public String title;\n",[296,415,417],{"class":298,"line":416},11,[296,418,419],{},"    public String isbn;\n",[296,421,423],{"class":298,"line":422},12,[296,424,425],{},"}\n",[296,427,429],{"class":298,"line":428},13,[296,430,395],{"emptyLinePlaceholder":394},[296,432,434],{"class":298,"line":433},14,[296,435,436],{},"public class Video extends Item {\n",[296,438,440],{"class":298,"line":439},15,[296,441,407],{},[296,443,445],{"class":298,"line":444},16,[296,446,413],{},[296,448,450],{"class":298,"line":449},17,[296,451,452],{},"    public Integer duration;\n",[296,454,456],{"class":298,"line":455},18,[296,457,425],{},[215,459,460],{},"When inserting documents, always write the discriminator value:",[287,462,464],{"className":289,"code":463,"language":291,"meta":292,"style":292},"INSERT INTO assets (id, item)\n    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[235,465,466,471],{"__ignoreMap":292},[296,467,468],{"class":298,"line":299},[296,469,470],{},"INSERT INTO assets (id, item)\n",[296,472,473],{"class":298,"line":305},[296,474,475],{},"    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[215,477,478,479,481],{},"If the ",[235,480,272],{}," field is absent from a stored document, Jackson will fail to deserialize it. Ensure every INSERT that targets a UNION field includes the discriminator.",[279,483,485],{"id":484},"conflict-validation","Conflict validation",[215,487,488,489,492,493,496,497,500],{},"If two variants declare the same field name with different scalar types — e.g. ",[235,490,491],{},"title TEXT"," in one variant and ",[235,494,495],{},"title KEYWORD"," in another — the migration executor will throw an ",[235,498,499],{},"IllegalArgumentException"," at mapping time. Fields shared across variants must have identical types.",[215,502,503,506,507,510],{},[266,504,505],{},"Known limitation:"," Conflict detection is shallow for composite types. If two variants share a field name with the same composite type (OBJECT, NESTED, or UNION) but different sub-fields, no exception is thrown — only the first variant's sub-field definitions are used and the second's are silently dropped. Until named type support is added to the migration DSL, avoid sharing composite-typed fields across variants. Scalar shared fields (such as a ",[235,508,509],{},"kind KEYWORD"," discriminator) are always safe.",[224,512,514],{"id":513},"data-streams","Data Streams",[215,516,517,518,521,522,528],{},"System data that is append-only and time-series — audit trails, events, telemetry — should be backed by an Elasticsearch ",[266,519,520],{},"data stream"," rather than a regular index, so old data ages out and backing indices roll over automatically. Create one from a migration with ",[219,523,525],{"href":524},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#create-data-stream",[235,526,527],{},"CREATE DATA STREAM",":",[287,530,532],{"className":289,"code":531,"language":291,"meta":292,"style":292},"CREATE DATA STREAM system_audit (\n    actor  KEYWORD,\n    action KEYWORD,\n    detail TEXT\n) WITH (DATA_RETENTION = '90d') ;\n",[235,533,534,539,544,549,554],{"__ignoreMap":292},[296,535,536],{"class":298,"line":299},[296,537,538],{},"CREATE DATA STREAM system_audit (\n",[296,540,541],{"class":298,"line":305},[296,542,543],{},"    actor  KEYWORD,\n",[296,545,546],{"class":298,"line":311},[296,547,548],{},"    action KEYWORD,\n",[296,550,551],{"class":298,"line":317},[296,552,553],{},"    detail TEXT\n",[296,555,556],{"class":298,"line":323},[296,557,558],{},") WITH (DATA_RETENTION = '90d') ;\n",[215,560,561,564,565,571,572,574],{},[235,562,563],{},"DATA_RETENTION"," is the native ",[219,566,570],{"href":567,"rel":568},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fmanage-data\u002Flifecycle\u002Fdata-stream",[569],"nofollow","data stream lifecycle"," — Elasticsearch deletes data past the period (measured per backing index from rollover, not per document). See the ",[219,573,139],{"href":524}," for the full statement and the exact retention semantics.",[279,576,578,579,582],{"id":577},"every-document-needs-a-timestamp-and-java-needs-ceremony-for-it","Every document needs a ",[235,580,581],{},"@timestamp"," — and Java needs ceremony for it",[215,584,585,586,589,590,592,593,596,597,599,600,602],{},"Elasticsearch ",[266,587,588],{},"requires"," every document written to a data stream to carry a ",[235,591,581],{}," date field, and rejects any that don't with ",[235,594,595],{},"data stream timestamp field [@timestamp] is missing",". The migration adds ",[235,598,581],{}," to the mapping automatically — you neither declare it as a column nor can you, since ",[235,601,581],{}," is not a legal column identifier.",[215,604,605,606,609,610,612,613,616,617,620],{},"The catch is on the ",[266,607,608],{},"write"," side: ",[235,611,581],{}," is also not a legal Java field name, so a system DTO cannot carry it directly. Bridge it with Jackson's ",[235,614,615],{},"@JsonProperty"," — the ",[235,618,619],{},"ElasticsearchAsyncClient"," serializes through a Jackson mapper, so the annotation is honored on both write and read:",[287,622,624],{"className":355,"code":623,"language":357,"meta":292,"style":292},"public class AuditEvent {\n    private String  id;\n\n    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n    private Instant timestamp;\n\n    private String  actor;\n    private String  action;\n}\n",[235,625,626,631,636,640,645,650,654,659,664],{"__ignoreMap":292},[296,627,628],{"class":298,"line":299},[296,629,630],{},"public class AuditEvent {\n",[296,632,633],{"class":298,"line":305},[296,634,635],{},"    private String  id;\n",[296,637,638],{"class":298,"line":311},[296,639,395],{"emptyLinePlaceholder":394},[296,641,642],{"class":298,"line":317},[296,643,644],{},"    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n",[296,646,647],{"class":298,"line":323},[296,648,649],{},"    private Instant timestamp;\n",[296,651,652],{"class":298,"line":329},[296,653,395],{"emptyLinePlaceholder":394},[296,655,656],{"class":298,"line":335},[296,657,658],{},"    private String  actor;\n",[296,660,661],{"class":298,"line":398},[296,662,663],{},"    private String  action;\n",[296,665,666],{"class":298,"line":404},[296,667,425],{},[215,669,670,671,674,675,677,678,681],{},"This ",[266,672,673],{},"renames"," the field — the stored document has only ",[235,676,581],{},", so any query or sort must use that literal name (",[235,679,680],{},"timestamp"," does not exist in the index). For most internal stream DTOs this is the simplest correct choice.",[215,683,684,685,689,690,692],{},"If you instead want a friendly, separately-queryable field name ",[686,687,688],"em",{},"alongside"," ",[235,691,581],{},", keep your own field and add a serialize-only companion:",[287,694,696],{"className":355,"code":695,"language":357,"meta":292,"style":292},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\nprivate Instant eventTime;\n\n\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\npublic Instant esTimestamp() { return eventTime; }\n",[235,697,698,703,708,712,717,722],{"__ignoreMap":292},[296,699,700],{"class":298,"line":299},[296,701,702],{},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\n",[296,704,705],{"class":298,"line":305},[296,706,707],{},"private Instant eventTime;\n",[296,709,710],{"class":298,"line":311},[296,711,395],{"emptyLinePlaceholder":394},[296,713,714],{"class":298,"line":317},[296,715,716],{},"\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n",[296,718,719],{"class":298,"line":323},[296,720,721],{},"@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\n",[296,723,724],{"class":298,"line":329},[296,725,726],{},"public Instant esTimestamp() { return eventTime; }\n",[215,728,670,729,732,733,345,736,738,739,744],{},[266,730,731],{},"duplicates"," the value (both ",[235,734,735],{},"eventTime",[235,737,581],{}," are stored). It is the same document shape that application entities get from the ",[219,740,741],{"href":73},[235,742,743],{},"@TimeReference"," decorator. When a migration creates the stream backing such an entity, declare the pairing so the stream documents which column is the natural time field:",[287,746,748],{"className":289,"code":747,"language":291,"meta":292,"style":292},"CREATE DATA STREAM sensor_readings (\n    id        KEYWORD,\n    eventTime DATE,\n    value     DOUBLE\n) WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[235,749,750,755,760,765,770],{"__ignoreMap":292},[296,751,752],{"class":298,"line":299},[296,753,754],{},"CREATE DATA STREAM sensor_readings (\n",[296,756,757],{"class":298,"line":305},[296,758,759],{},"    id        KEYWORD,\n",[296,761,762],{"class":298,"line":311},[296,763,764],{},"    eventTime DATE,\n",[296,766,767],{"class":298,"line":317},[296,768,769],{},"    value     DOUBLE\n",[296,771,772],{"class":298,"line":323},[296,773,774],{},") WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[215,776,777,780,781,784,785,787,788,790],{},[235,778,779],{},"TIME_REFERENCE"," must name a declared ",[235,782,783],{},"DATE"," column; the migration validates this and fails fast otherwise. It declares intent and pairs with the entity's ",[235,786,743],{}," — the write-time duplication into ",[235,789,581],{}," is performed by the persistence layer, not the migration.",[279,792,794],{"id":793},"writing-and-reading","Writing and reading",[215,796,797,798,801,802,805,806,809],{},"Data streams are ",[266,799,800],{},"append-only",": Elasticsearch accepts only the ",[235,803,804],{},"create"," op-type and rejects the ",[235,807,808],{},"index"," op and by-id updates\u002Fdeletes. Documents are retrieved by search\u002Fquery, not by id. System services that write to a stream must therefore use a create (append) write, and read through search rather than a find-by-id lookup.",[811,812,813],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span