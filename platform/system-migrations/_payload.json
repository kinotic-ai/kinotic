orm\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"title":224,"path":225,"stem":226,"icon":227},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"id":229,"title":191,"body":230,"description":846,"extension":847,"links":848,"meta":849,"navigation":850,"path":192,"seo":851,"stem":193,"__hash__":852},"docs\u002F02.platform\u002F10.system-migrations.md",{"type":231,"value":232,"toc":833},"minimark",[233,242,247,250,262,266,274,278,281,297,302,305,358,372,477,480,495,501,505,520,530,534,548,578,594,602,622,640,687,701,712,746,764,794,810,814,829],[234,235,236,237,241],"p",{},"The Kinotic platform uses the same migration SQL system as application developers to manage its own internal Elasticsearch indices. This page covers considerations specific to platform development — for general migration syntax, see ",[238,239,240],"a",{"href":89},"App Migrations",".",[243,244,246],"h2",{"id":245},"what-are-system-migrations","What Are System Migrations?",[234,248,249],{},"System migrations define and evolve the indices that the platform itself relies on — things like migration history tracking, system configuration, and other internal data stores. They run during platform startup before any application migrations and are scoped to the system project rather than a per-application project.",[234,251,252,253,257,258,261],{},"System migrations live in ",[254,255,256],"code",{},"kinotic-migration\u002Fsrc\u002Fmain\u002Fresources\u002Fmigrations\u002F"," and follow the same ",[254,259,260],{},"V\u003CN>__\u003Cdescription>.sql"," naming convention.",[243,263,265],{"id":264},"using-composite-types-in-system-indices","Using Composite Types in System Indices",[234,267,268,269,273],{},"OBJECT, NESTED, and UNION columns work the same way in system migrations as in application migrations. Refer to the ",[238,270,272],{"href":271},"\u002Fapps\u002Fpersistence\u002Fmigrations#composite-column-types","Composite Column Types"," section of the app documentation for syntax and examples.",[243,275,277],{"id":276},"deserializing-union-types","Deserializing Union Types",[234,279,280],{},"Elasticsearch stores UNION fields as a flat merged object — it has no knowledge of which variant a document contains. When reading documents back into Java, the platform needs to route deserialization to the correct subclass.",[234,282,283,284,288,289,292,293,296],{},"The standard approach is Jackson's polymorphic type handling, driven by a ",[285,286,287],"strong",{},"discriminator field"," stored in the document. This is the same ",[254,290,291],{},"kind"," (or similar) ",[254,294,295],{},"KEYWORD"," field you include in each union variant in the migration SQL.",[298,299,301],"h3",{"id":300},"example","Example",[234,303,304],{},"Given this migration:",[306,307,312],"pre",{"className":308,"code":309,"language":310,"meta":311,"style":311},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n","sql","",[254,313,314,322,328,334,340,346,352],{"__ignoreMap":311},[315,316,319],"span",{"class":317,"line":318},"line",1,[315,320,321],{},"CREATE TABLE assets (\n",[315,323,325],{"class":317,"line":324},2,[315,326,327],{},"    id KEYWORD,\n",[315,329,331],{"class":317,"line":330},3,[315,332,333],{},"    item UNION (\n",[315,335,337],{"class":317,"line":336},4,[315,338,339],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[315,341,343],{"class":317,"line":342},5,[315,344,345],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[315,347,349],{"class":317,"line":348},6,[315,350,351],{},"    )\n",[315,353,355],{"class":317,"line":354},7,[315,356,357],{},");\n",[234,359,360,361,364,365,368,369,371],{},"The corresponding Java model uses ",[254,362,363],{},"@JsonTypeInfo"," and ",[254,366,367],{},"@JsonSubTypes"," to map the ",[254,370,291],{}," field value to the correct subclass:",[306,373,377],{"className":374,"code":375,"language":376,"meta":311,"style":311},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n@JsonSubTypes({\n    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n})\npublic abstract class Item {}\n\npublic class Book extends Item {\n    public String kind;\n    public String title;\n    public String isbn;\n}\n\npublic class Video extends Item {\n    public String kind;\n    public String title;\n    public Integer duration;\n}\n","java",[254,378,379,384,389,394,399,404,409,415,421,427,433,439,445,450,456,461,466,472],{"__ignoreMap":311},[315,380,381],{"class":317,"line":318},[315,382,383],{},"@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n",[315,385,386],{"class":317,"line":324},[315,387,388],{},"@JsonSubTypes({\n",[315,390,391],{"class":317,"line":330},[315,392,393],{},"    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n",[315,395,396],{"class":317,"line":336},[315,397,398],{},"    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n",[315,400,401],{"class":317,"line":342},[315,402,403],{},"})\n",[315,405,406],{"class":317,"line":348},[315,407,408],{},"public abstract class Item {}\n",[315,410,411],{"class":317,"line":354},[315,412,414],{"emptyLinePlaceholder":413},true,"\n",[315,416,418],{"class":317,"line":417},8,[315,419,420],{},"public class Book extends Item {\n",[315,422,424],{"class":317,"line":423},9,[315,425,426],{},"    public String kind;\n",[315,428,430],{"class":317,"line":429},10,[315,431,432],{},"    public String title;\n",[315,434,436],{"class":317,"line":435},11,[315,437,438],{},"    public String isbn;\n",[315,440,442],{"class":317,"line":441},12,[315,443,444],{},"}\n",[315,446,448],{"class":317,"line":447},13,[315,449,414],{"emptyLinePlaceholder":413},[315,451,453],{"class":317,"line":452},14,[315,454,455],{},"public class Video extends Item {\n",[315,457,459],{"class":317,"line":458},15,[315,460,426],{},[315,462,464],{"class":317,"line":463},16,[315,465,432],{},[315,467,469],{"class":317,"line":468},17,[315,470,471],{},"    public Integer duration;\n",[315,473,475],{"class":317,"line":474},18,[315,476,444],{},[234,478,479],{},"When inserting documents, always write the discriminator value:",[306,481,483],{"className":308,"code":482,"language":310,"meta":311,"style":311},"INSERT INTO assets (id, item)\n    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[254,484,485,490],{"__ignoreMap":311},[315,486,487],{"class":317,"line":318},[315,488,489],{},"INSERT INTO assets (id, item)\n",[315,491,492],{"class":317,"line":324},[315,493,494],{},"    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[234,496,497,498,500],{},"If the ",[254,499,291],{}," field is absent from a stored document, Jackson will fail to deserialize it. Ensure every INSERT that targets a UNION field includes the discriminator.",[298,502,504],{"id":503},"conflict-validation","Conflict validation",[234,506,507,508,511,512,515,516,519],{},"If two variants declare the same field name with different scalar types — e.g. ",[254,509,510],{},"title TEXT"," in one variant and ",[254,513,514],{},"title KEYWORD"," in another — the migration executor will throw an ",[254,517,518],{},"IllegalArgumentException"," at mapping time. Fields shared across variants must have identical types.",[234,521,522,525,526,529],{},[285,523,524],{},"Known limitation:"," Conflict detection is shallow for composite types. If two variants share a field name with the same composite type (OBJECT, NESTED, or UNION) but different sub-fields, no exception is thrown — only the first variant's sub-field definitions are used and the second's are silently dropped. Until named type support is added to the migration DSL, avoid sharing composite-typed fields across variants. Scalar shared fields (such as a ",[254,527,528],{},"kind KEYWORD"," discriminator) are always safe.",[243,531,533],{"id":532},"data-streams","Data Streams",[234,535,536,537,540,541,547],{},"System data that is append-only and time-series — audit trails, events, telemetry — should be backed by an Elasticsearch ",[285,538,539],{},"data stream"," rather than a regular index, so old data ages out and backing indices roll over automatically. Create one from a migration with ",[238,542,544],{"href":543},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#create-data-stream",[254,545,546],{},"CREATE DATA STREAM",":",[306,549,551],{"className":308,"code":550,"language":310,"meta":311,"style":311},"CREATE DATA STREAM system_audit (\n    actor  KEYWORD,\n    action KEYWORD,\n    detail TEXT\n) WITH (DATA_RETENTION = '90d') ;\n",[254,552,553,558,563,568,573],{"__ignoreMap":311},[315,554,555],{"class":317,"line":318},[315,556,557],{},"CREATE DATA STREAM system_audit (\n",[315,559,560],{"class":317,"line":324},[315,561,562],{},"    actor  KEYWORD,\n",[315,564,565],{"class":317,"line":330},[315,566,567],{},"    action KEYWORD,\n",[315,569,570],{"class":317,"line":336},[315,571,572],{},"    detail TEXT\n",[315,574,575],{"class":317,"line":342},[315,576,577],{},") WITH (DATA_RETENTION = '90d') ;\n",[234,579,580,583,584,590,591,593],{},[254,581,582],{},"DATA_RETENTION"," is the native ",[238,585,589],{"href":586,"rel":587},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fmanage-data\u002Flifecycle\u002Fdata-stream",[588],"nofollow","data stream lifecycle"," — Elasticsearch deletes data past the period (measured per backing index from rollover, not per document). See the ",[238,592,139],{"href":543}," for the full statement and the exact retention semantics.",[298,595,597,598,601],{"id":596},"every-document-needs-a-timestamp-and-java-needs-ceremony-for-it","Every document needs a ",[254,599,600],{},"@timestamp"," — and Java needs ceremony for it",[234,603,604,605,608,609,611,612,615,616,618,619,621],{},"Elasticsearch ",[285,606,607],{},"requires"," every document written to a data stream to carry a ",[254,610,600],{}," date field, and rejects any that don't with ",[254,613,614],{},"data stream timestamp field [@timestamp] is missing",". The migration adds ",[254,617,600],{}," to the mapping automatically — you neither declare it as a column nor can you, since ",[254,620,600],{}," is not a legal column identifier.",[234,623,624,625,628,629,631,632,635,636,639],{},"The catch is on the ",[285,626,627],{},"write"," side: ",[254,630,600],{}," is also not a legal Java field name, so a system DTO cannot carry it directly. Bridge it with Jackson's ",[254,633,634],{},"@JsonProperty"," — the ",[254,637,638],{},"ElasticsearchAsyncClient"," serializes through a Jackson mapper, so the annotation is honored on both write and read:",[306,641,643],{"className":374,"code":642,"language":376,"meta":311,"style":311},"public class AuditEvent {\n    private String  id;\n\n    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n    private Instant timestamp;\n\n    private String  actor;\n    private String  action;\n}\n",[254,644,645,650,655,659,664,669,673,678,683],{"__ignoreMap":311},[315,646,647],{"class":317,"line":318},[315,648,649],{},"public class AuditEvent {\n",[315,651,652],{"class":317,"line":324},[315,653,654],{},"    private String  id;\n",[315,656,657],{"class":317,"line":330},[315,658,414],{"emptyLinePlaceholder":413},[315,660,661],{"class":317,"line":336},[315,662,663],{},"    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n",[315,665,666],{"class":317,"line":342},[315,667,668],{},"    private Instant timestamp;\n",[315,670,671],{"class":317,"line":348},[315,672,414],{"emptyLinePlaceholder":413},[315,674,675],{"class":317,"line":354},[315,676,677],{},"    private String  actor;\n",[315,679,680],{"class":317,"line":417},[315,681,682],{},"    private String  action;\n",[315,684,685],{"class":317,"line":423},[315,686,444],{},[234,688,689,690,693,694,696,697,700],{},"This ",[285,691,692],{},"renames"," the field — the stored document has only ",[254,695,600],{},", so any query or sort must use that literal name (",[254,698,699],{},"timestamp"," does not exist in the index). For most internal stream DTOs this is the simplest correct choice.",[234,702,703,704,708,709,711],{},"If you instead want a friendly, separately-queryable field name ",[705,706,707],"em",{},"alongside"," ",[254,710,600],{},", keep your own field and add a serialize-only companion:",[306,713,715],{"className":374,"code":714,"language":376,"meta":311,"style":311},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\nprivate Instant eventTime;\n\n\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\npublic Instant esTimestamp() { return eventTime; }\n",[254,716,717,722,727,731,736,741],{"__ignoreMap":311},[315,718,719],{"class":317,"line":318},[315,720,721],{},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\n",[315,723,724],{"class":317,"line":324},[315,725,726],{},"private Instant eventTime;\n",[315,728,729],{"class":317,"line":330},[315,730,414],{"emptyLinePlaceholder":413},[315,732,733],{"class":317,"line":336},[315,734,735],{},"\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n",[315,737,738],{"class":317,"line":342},[315,739,740],{},"@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\n",[315,742,743],{"class":317,"line":348},[315,744,745],{},"public Instant esTimestamp() { return eventTime; }\n",[234,747,689,748,751,752,364,755,757,758,763],{},[285,749,750],{},"duplicates"," the value (both ",[254,753,754],{},"eventTime",[254,756,600],{}," are stored). It is the same document shape that application entities get from the ",[238,759,760],{"href":73},[254,761,762],{},"@TimeReference"," decorator. When a migration creates the stream backing such an entity, declare the pairing so the stream documents which column is the natural time field:",[306,765,767],{"className":308,"code":766,"language":310,"meta":311,"style":311},"CREATE DATA STREAM sensor_readings (\n    id        KEYWORD,\n    eventTime DATE,\n    value     DOUBLE\n) WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[254,768,769,774,779,784,789],{"__ignoreMap":311},[315,770,771],{"class":317,"line":318},[315,772,773],{},"CREATE DATA STREAM sensor_readings (\n",[315,775,776],{"class":317,"line":324},[315,777,778],{},"    id        KEYWORD,\n",[315,780,781],{"class":317,"line":330},[315,782,783],{},"    eventTime DATE,\n",[315,785,786],{"class":317,"line":336},[315,787,788],{},"    value     DOUBLE\n",[315,790,791],{"class":317,"line":342},[315,792,793],{},") WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[234,795,796,799,800,803,804,806,807,809],{},[254,797,798],{},"TIME_REFERENCE"," must name a declared ",[254,801,802],{},"DATE"," column; the migration validates this and fails fast otherwise. It declares intent and pairs with the entity's ",[254,805,762],{}," — the write-time duplication into ",[254,808,600],{}," is performed by the persistence layer, not the migration.",[298,811,813],{"id":812},"writing-and-reading","Writing and reading",[234,815,816,817,820,821,824,825,828],{},"Data streams are ",[285,818,819],{},"append-only",": Elasticsearch accepts only the ",[254,822,823],{},"create"," op-type and rejects the ",[254,826,827],{},"index"," op and by-id updates\u002Fdeletes. Documents are retrieved by search\u002Fquery, not by id. System services that write to a stream must therefore use a create (append) write, and read through search rather than a find-by-id lookup.",[830,831,832],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);tex