latform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214,218],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":101},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","02.platform\u002F12.reference\u002F04.sign-in-design",{"title":223,"path":224,"stem":225,"icon":226},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"title":228,"path":229,"stem":230,"icon":231},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":233,"path":234,"stem":235,"icon":236},"Enterprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":238,"title":191,"body":239,"description":855,"extension":856,"links":857,"meta":858,"navigation":859,"path":192,"seo":860,"stem":193,"__hash__":861},"docs\u002F02.platform\u002F10.system-migrations.md",{"type":240,"value":241,"toc":842},"minimark",[242,251,256,259,271,275,283,287,290,306,311,314,367,381,486,489,504,510,514,529,539,543,557,587,603,611,631,649,696,710,721,755,773,803,819,823,838],[243,244,245,246,250],"p",{},"The Kinotic platform uses the same migration SQL system as application developers to manage its own internal Elasticsearch indices. This page covers considerations specific to platform development — for general migration syntax, see ",[247,248,249],"a",{"href":89},"App Migrations",".",[252,253,255],"h2",{"id":254},"what-are-system-migrations","What Are System Migrations?",[243,257,258],{},"System migrations define and evolve the indices that the platform itself relies on — things like migration history tracking, system configuration, and other internal data stores. They run during platform startup before any application migrations and are scoped to the system project rather than a per-application project.",[243,260,261,262,266,267,270],{},"System migrations live in ",[263,264,265],"code",{},"kinotic-migration\u002Fsrc\u002Fmain\u002Fresources\u002Fmigrations\u002F"," and follow the same ",[263,268,269],{},"V\u003CN>__\u003Cdescription>.sql"," naming convention.",[252,272,274],{"id":273},"using-composite-types-in-system-indices","Using Composite Types in System Indices",[243,276,277,278,282],{},"OBJECT, NESTED, and UNION columns work the same way in system migrations as in application migrations. Refer to the ",[247,279,281],{"href":280},"\u002Fapps\u002Fpersistence\u002Fmigrations#composite-column-types","Composite Column Types"," section of the app documentation for syntax and examples.",[252,284,286],{"id":285},"deserializing-union-types","Deserializing Union Types",[243,288,289],{},"Elasticsearch stores UNION fields as a flat merged object — it has no knowledge of which variant a document contains. When reading documents back into Java, the platform needs to route deserialization to the correct subclass.",[243,291,292,293,297,298,301,302,305],{},"The standard approach is Jackson's polymorphic type handling, driven by a ",[294,295,296],"strong",{},"discriminator field"," stored in the document. This is the same ",[263,299,300],{},"kind"," (or similar) ",[263,303,304],{},"KEYWORD"," field you include in each union variant in the migration SQL.",[307,308,310],"h3",{"id":309},"example","Example",[243,312,313],{},"Given this migration:",[315,316,321],"pre",{"className":317,"code":318,"language":319,"meta":320,"style":320},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n","sql","",[263,322,323,331,337,343,349,355,361],{"__ignoreMap":320},[324,325,328],"span",{"class":326,"line":327},"line",1,[324,329,330],{},"CREATE TABLE assets (\n",[324,332,334],{"class":326,"line":333},2,[324,335,336],{},"    id KEYWORD,\n",[324,338,340],{"class":326,"line":339},3,[324,341,342],{},"    item UNION (\n",[324,344,346],{"class":326,"line":345},4,[324,347,348],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[324,350,352],{"class":326,"line":351},5,[324,353,354],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[324,356,358],{"class":326,"line":357},6,[324,359,360],{},"    )\n",[324,362,364],{"class":326,"line":363},7,[324,365,366],{},");\n",[243,368,369,370,373,374,377,378,380],{},"The corresponding Java model uses ",[263,371,372],{},"@JsonTypeInfo"," and ",[263,375,376],{},"@JsonSubTypes"," to map the ",[263,379,300],{}," field value to the correct subclass:",[315,382,386],{"className":383,"code":384,"language":385,"meta":320,"style":320},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n@JsonSubTypes({\n    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n})\npublic abstract class Item {}\n\npublic class Book extends Item {\n    public String kind;\n    public String title;\n    public String isbn;\n}\n\npublic class Video extends Item {\n    public String kind;\n    public String title;\n    public Integer duration;\n}\n","java",[263,387,388,393,398,403,408,413,418,424,430,436,442,448,454,459,465,470,475,481],{"__ignoreMap":320},[324,389,390],{"class":326,"line":327},[324,391,392],{},"@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n",[324,394,395],{"class":326,"line":333},[324,396,397],{},"@JsonSubTypes({\n",[324,399,400],{"class":326,"line":339},[324,401,402],{},"    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n",[324,404,405],{"class":326,"line":345},[324,406,407],{},"    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n",[324,409,410],{"class":326,"line":351},[324,411,412],{},"})\n",[324,414,415],{"class":326,"line":357},[324,416,417],{},"public abstract class Item {}\n",[324,419,420],{"class":326,"line":363},[324,421,423],{"emptyLinePlaceholder":422},true,"\n",[324,425,427],{"class":326,"line":426},8,[324,428,429],{},"public class Book extends Item {\n",[324,431,433],{"class":326,"line":432},9,[324,434,435],{},"    public String kind;\n",[324,437,439],{"class":326,"line":438},10,[324,440,441],{},"    public String title;\n",[324,443,445],{"class":326,"line":444},11,[324,446,447],{},"    public String isbn;\n",[324,449,451],{"class":326,"line":450},12,[324,452,453],{},"}\n",[324,455,457],{"class":326,"line":456},13,[324,458,423],{"emptyLinePlaceholder":422},[324,460,462],{"class":326,"line":461},14,[324,463,464],{},"public class Video extends Item {\n",[324,466,468],{"class":326,"line":467},15,[324,469,435],{},[324,471,473],{"class":326,"line":472},16,[324,474,441],{},[324,476,478],{"class":326,"line":477},17,[324,479,480],{},"    public Integer duration;\n",[324,482,484],{"class":326,"line":483},18,[324,485,453],{},[243,487,488],{},"When inserting documents, always write the discriminator value:",[315,490,492],{"className":317,"code":491,"language":319,"meta":320,"style":320},"INSERT INTO assets (id, item)\n    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[263,493,494,499],{"__ignoreMap":320},[324,495,496],{"class":326,"line":327},[324,497,498],{},"INSERT INTO assets (id, item)\n",[324,500,501],{"class":326,"line":333},[324,502,503],{},"    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[243,505,506,507,509],{},"If the ",[263,508,300],{}," field is absent from a stored document, Jackson will fail to deserialize it. Ensure every INSERT that targets a UNION field includes the discriminator.",[307,511,513],{"id":512},"conflict-validation","Conflict validation",[243,515,516,517,520,521,524,525,528],{},"If two variants declare the same field name with different scalar types — e.g. ",[263,518,519],{},"title TEXT"," in one variant and ",[263,522,523],{},"title KEYWORD"," in another — the migration executor will throw an ",[263,526,527],{},"IllegalArgumentException"," at mapping time. Fields shared across variants must have identical types.",[243,530,531,534,535,538],{},[294,532,533],{},"Known limitation:"," Conflict detection is shallow for composite types. If two variants share a field name with the same composite type (OBJECT, NESTED, or UNION) but different sub-fields, no exception is thrown — only the first variant's sub-field definitions are used and the second's are silently dropped. Until named type support is added to the migration DSL, avoid sharing composite-typed fields across variants. Scalar shared fields (such as a ",[263,536,537],{},"kind KEYWORD"," discriminator) are always safe.",[252,540,542],{"id":541},"data-streams","Data Streams",[243,544,545,546,549,550,556],{},"System data that is append-only and time-series — audit trails, events, telemetry — should be backed by an Elasticsearch ",[294,547,548],{},"data stream"," rather than a regular index, so old data ages out and backing indices roll over automatically. Create one from a migration with ",[247,551,553],{"href":552},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#create-data-stream",[263,554,555],{},"CREATE DATA STREAM",":",[315,558,560],{"className":317,"code":559,"language":319,"meta":320,"style":320},"CREATE DATA STREAM system_audit (\n    actor  KEYWORD,\n    action KEYWORD,\n    detail TEXT\n) WITH (DATA_RETENTION = '90d') ;\n",[263,561,562,567,572,577,582],{"__ignoreMap":320},[324,563,564],{"class":326,"line":327},[324,565,566],{},"CREATE DATA STREAM system_audit (\n",[324,568,569],{"class":326,"line":333},[324,570,571],{},"    actor  KEYWORD,\n",[324,573,574],{"class":326,"line":339},[324,575,576],{},"    action KEYWORD,\n",[324,578,579],{"class":326,"line":345},[324,580,581],{},"    detail TEXT\n",[324,583,584],{"class":326,"line":351},[324,585,586],{},") WITH (DATA_RETENTION = '90d') ;\n",[243,588,589,592,593,599,600,602],{},[263,590,591],{},"DATA_RETENTION"," is the native ",[247,594,598],{"href":595,"rel":596},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fmanage-data\u002Flifecycle\u002Fdata-stream",[597],"nofollow","data stream lifecycle"," — Elasticsearch deletes data past the period (measured per backing index from rollover, not per document). See the ",[247,601,139],{"href":552}," for the full statement and the exact retention semantics.",[307,604,606,607,610],{"id":605},"every-document-needs-a-timestamp-and-java-needs-ceremony-for-it","Every document needs a ",[263,608,609],{},"@timestamp"," — and Java needs ceremony for it",[243,612,613,614,617,618,620,621,624,625,627,628,630],{},"Elasticsearch ",[294,615,616],{},"requires"," every document written to a data stream to carry a ",[263,619,609],{}," date field, and rejects any that don't with ",[263,622,623],{},"data stream timestamp field [@timestamp] is missing",". The migration adds ",[263,626,609],{}," to the mapping automatically — you neither declare it as a column nor can you, since ",[263,629,609],{}," is not a legal column identifier.",[243,632,633,634,637,638,640,641,644,645,648],{},"The catch is on the ",[294,635,636],{},"write"," side: ",[263,639,609],{}," is also not a legal Java field name, so a system DTO cannot carry it directly. Bridge it with Jackson's ",[263,642,643],{},"@JsonProperty"," — the ",[263,646,647],{},"ElasticsearchAsyncClient"," serializes through a Jackson mapper, so the annotation is honored on both write and read:",[315,650,652],{"className":383,"code":651,"language":385,"meta":320,"style":320},"public class AuditEvent {\n    private String  id;\n\n    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n    private Instant timestamp;\n\n    private String  actor;\n    private String  action;\n}\n",[263,653,654,659,664,668,673,678,682,687,692],{"__ignoreMap":320},[324,655,656],{"class":326,"line":327},[324,657,658],{},"public class AuditEvent {\n",[324,660,661],{"class":326,"line":333},[324,662,663],{},"    private String  id;\n",[324,665,666],{"class":326,"line":339},[324,667,423],{"emptyLinePlaceholder":422},[324,669,670],{"class":326,"line":345},[324,671,672],{},"    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n",[324,674,675],{"class":326,"line":351},[324,676,677],{},"    private Instant timestamp;\n",[324,679,680],{"class":326,"line":357},[324,681,423],{"emptyLinePlaceholder":422},[324,683,684],{"class":326,"line":363},[324,685,686],{},"    private String  actor;\n",[324,688,689],{"class":326,"line":426},[324,690,691],{},"    private String  action;\n",[324,693,694],{"class":326,"line":432},[324,695,453],{},[243,697,698,699,702,703,705,706,709],{},"This ",[294,700,701],{},"renames"," the field — the stored document has only ",[263,704,609],{},", so any query or sort must use that literal name (",[263,707,708],{},"timestamp"," does not exist in the index). For most internal stream DTOs this is the simplest correct choice.",[243,711,712,713,717,718,720],{},"If you instead want a friendly, separately-queryable field name ",[714,715,716],"em",{},"alongside"," ",[263,719,609],{},", keep your own field and add a serialize-only companion:",[315,722,724],{"className":383,"code":723,"language":385,"meta":320,"style":320},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\nprivate Instant eventTime;\n\n\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\npublic Instant esTimestamp() { return eventTime; }\n",[263,725,726,731,736,740,745,750],{"__ignoreMap":320},[324,727,728],{"class":326,"line":327},[324,729,730],{},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\n",[324,732,733],{"class":326,"line":333},[324,734,735],{},"private Instant eventTime;\n",[324,737,738],{"class":326,"line":339},[324,739,423],{"emptyLinePlaceholder":422},[324,741,742],{"class":326,"line":345},[324,743,744],{},"\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n",[324,746,747],{"class":326,"line":351},[324,748,749],{},"@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\n",[324,751,752],{"class":326,"line":357},[324,753,754],{},"public Instant esTimestamp() { return eventTime; }\n",[243,756,698,757,760,761,373,764,766,767,772],{},[294,758,759],{},"duplicates"," the value (both ",[263,762,763],{},"eventTime",[263,765,609],{}," are stored). It is the same document shape that application entities get from the ",[247,768,769],{"href":73},[263,770,771],{},"@TimeReference"," decorator. When a migration creates the stream backing such an entity, declare the pairing so the stream documents which column is the natural time field:",[315,774,776],{"className":317,"code":775,"language":319,"meta":320,"style":320},"CREATE DATA STREAM sensor_readings (\n    id        KEYWORD,\n    eventTime DATE,\n    value     DOUBLE\n) WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[263,777,778,783,788,793,798],{"__ignoreMap":320},[324,779,780],{"class":326,"line":327},[324,781,782],{},"CREATE DATA STREAM sensor_readings (\n",[324,784,785],{"class":326,"line":333},[324,786,787],{},"    id        KEYWORD,\n",[324,789,790],{"class":326,"line":339},[324,791,792],{},"    eventTime DATE,\n",[324,794,795],{"class":326,"line":345},[324,796,797],{},"    value     DOUBLE\n",[324,799,800],{"class":326,"line":351},[324,801,802],{},") WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[243,804,805,808,809,812,813,815,816,818],{},[263,806,807],{},"TIME_REFERENCE"," must name a declared ",[263,810,811],{},"DATE"," column; the migration validates this and fails fast otherwise. It declares intent and pairs with the entity's ",[263,814,771],{}," — the write-time duplication into ",[263,817,609],{}," is performed by the persistence layer, not the migration.",[307,820,822],{"id":821},"writing-and-reading","Writing and reading",[243,824,825,826,829,830,833,834,837],{},"Data streams are ",[294,827,828],{},"append-only",": Elasticsearch accepts only the ",[263,831,832],{},"create"," op-type and rejects the ",[263,835,836],{},"index"," op and by-id updates\u002Fdeletes. Documents are retrieved by search\u002Fquery, not by id. System services that write to a stream must therefore use a create (append) write, and read through search rather than a find-by-id lookup.",[839,840,841],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":320,"searchDepth":333,"depth":333,"links":843},[844,845,846,850],{"id":254,"depth":333,"text":255},{"id":273,"depth":333,"text":274},{"id":285,"depth":333,"text":286,"children":847},[848,849],{"id":309,"depth":339,"text":310},{"id":512,"depth":339,"text":513},{"id":541,"depth":333,"text":542,"children":851},[852,854],{"id":605,"depth":339,"text":853},"Every document needs a @timestamp — and Java needs ceremony for it",{"id":821,"depth":339,"text":822},"Writing and maintaining migration scripts for Kinotic's internal system indices.","md",null,{},{"icon":194},{"title":191,"description":855},"YBKPRIuIyPm3yUu82Q0HaD4nbPZsWLEuTPDyWjZI1Lw",[863,865],{"title":186,"path":187,"stem":188,"description":864,"icon":189,"children":-1},"How to contribute to the Kinotic OS project.",{"title":196,"path":197,"stem":198,"description":866,"icon":199,"children":-1},"How a call through a service proxy fails when the node serving it dies, instead of waiting forever — without a timeout anywhere.",1792919064442]