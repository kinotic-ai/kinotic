efense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"title":224,"path":225,"stem":226,"icon":227},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"id":229,"title":148,"body":230,"description":495,"extension":496,"links":497,"meta":498,"navigation":499,"path":149,"seo":500,"stem":150,"__hash__":501},"docs\u002F02.platform\u002F01.architecture.md",{"type":231,"value":232,"toc":487},"minimark",[233,237,241,245,309,317,321,397,401,404,414,420,425,447,480,483],[234,235,25],"h2",{"id":236},"overview",[238,239,240],"p",{},"Kinotic OS is a full-stack application platform that handles service communication, persistence, authentication, authorization, deployment, and observability. The system is composed of several core components that work together to provide a seamless development and runtime experience.",[234,242,244],{"id":243},"core-components","Core Components",[246,247,248,265,278,291,297,303],"ul",{},[249,250,251,255,256,260,261,264],"li",{},[252,253,254],"strong",{},"Management server"," (",[257,258,259],"code",{},"kinotic-server-management",") — The API the portal, the Kinotic CLI and organization members' MCP hosts call: sign-up, logins and invitations, the ",[257,262,263],{},"management-api"," services, and the GitHub App's webhook.",[249,266,267,255,270,273,274,277],{},[252,268,269],{},"System server",[257,271,272],{},"kinotic-server-system",") — The API the system console and the vm-managers call: the ",[257,275,276],{},"system-api"," services, project deployments, and the cluster singletons that reconcile deployments and delete old workload runs.",[249,279,280,255,283,286,287,290],{},[252,281,282],{},"App server",[257,284,285],{},"kinotic-server-app",") — The API every application's users, UIs and microservices call: the ",[257,288,289],{},"app-api"," persistence services and the services applications publish in their own zones, each application at its own API host.",[249,292,293,296],{},[252,294,295],{},"RPC Gateway"," — Each server's gateway routes remote procedure calls between its clients and published services over STOMP\u002FWebSocket, and serves the server's REST and MCP endpoints.",[249,298,299,302],{},[252,300,301],{},"Persistence Layer"," — Provides automatic CRUD operations for entities backed by Elasticsearch.",[249,304,305,308],{},[252,306,307],{},"Auth System"," — Handles authentication (email\u002Fpassword and OIDC) across three authorization hierarchies: System, Organization, and Application. Each server admits only the participants it serves.",[238,310,311,312,316],{},"The three servers are Spring Boot applications that form one Ignite cluster, in which each hosts only its own zones. ",[313,314,172],"a",{"href":315},"\u002Fplatform\u002Fdefense-in-depth#network-architecture"," shows which participants each admits and which zones each hosts.",[234,318,320],{"id":319},"tech-stack","Tech Stack",[322,323,324,337],"table",{},[325,326,327],"thead",{},[328,329,330,334],"tr",{},[331,332,333],"th",{},"Component",[331,335,336],{},"Technology",[338,339,340,349,357,365,373,381,389],"tbody",{},[328,341,342,346],{},[343,344,345],"td",{},"Orchestration",[343,347,348],{},"Kubernetes",[328,350,351,354],{},[343,352,353],{},"Build Isolation",[343,355,356],{},"Firecracker VMs",[328,358,359,362],{},[343,360,361],{},"Runtime",[343,363,364],{},"Bun",[328,366,367,370],{},[343,368,369],{},"Database",[343,371,372],{},"Postgres (Hibernate Reactive)",[328,374,375,378],{},[343,376,377],{},"Search\u002FPersistence",[343,379,380],{},"Elasticsearch",[328,382,383,386],{},[343,384,385],{},"Logging",[343,387,388],{},"Grafana Loki",[328,390,391,394],{},[343,392,393],{},"Payments",[343,395,396],{},"Stripe Connect",[234,398,400],{"id":399},"communication","Communication",[238,402,403],{},"Services communicate via STOMP over WebSocket, with messages routed by CRI (Kinotic Resource Identifier). Each service, method, and event stream is addressable through a CRI, which follows the format:",[405,406,411],"pre",{"className":407,"code":409,"language":410},[408],"language-text","scheme:\u002F\u002F[scope@]resourceName[\u002Fpath][#version]\n","text",[257,412,409],{"__ignoreMap":413},"",[238,415,416,417,419],{},"The RPC gateway uses CRIs to route requests to the correct service instance, apply versioning, and enforce scope-based multi-tenancy. See the ",[313,418,205],{"href":206}," reference for details.",[421,422,424],"h3",{"id":423},"never-block-the-event-loop","Never block the event loop",[238,426,427,428,431,432,435,436,435,439,442,443,446],{},"A Java service published with ",[257,429,430],{},"@Publish"," is invoked on a Vert.x event loop it shares with the other services on the node, the same rule Vert.x sets for its own handlers. A method returns a ",[257,433,434],{},"Future",", ",[257,437,438],{},"CompletableFuture",[257,440,441],{},"Mono"," or ",[257,444,445],{},"Flux"," and lets the work complete off the loop; a method that is slow, because it blocks on a synchronous client, a lock or a sleep, or because it does heavy CPU work, hands that work off inside itself:",[405,448,452],{"className":449,"code":450,"language":451,"meta":413,"style":413},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@Override\npublic Future\u003CReport> render(String id) {\n    return vertx.executeBlocking(() -> renderer.render(id));   \u002F\u002F the loop is free while the worker runs\n}\n","java",[257,453,454,462,468,474],{"__ignoreMap":413},[455,456,459],"span",{"class":457,"line":458},"line",1,[455,460,461],{},"@Override\n",[455,463,465],{"class":457,"line":464},2,[455,466,467],{},"public Future\u003CReport> render(String id) {\n",[455,469,471],{"class":457,"line":470},3,[455,472,473],{},"    return vertx.executeBlocking(() -> renderer.render(id));   \u002F\u002F the loop is free while the worker runs\n",[455,475,477],{"class":457,"line":476},4,[455,478,479],{},"}\n",[238,481,482],{},"The platform never hands off on a service's behalf. A method that blocks stalls every service sharing its loop, and Vert.x's blocked-thread checker reports it in the log.",[484,485,486],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":413,"searchDepth":464,"depth":464,"links":488},[489,490,491,492],{"id":236,"depth":464,"text":25},{"id":243,"depth":464,"text":244},{"id":319,"depth":464,"text":320},{"id":399,"depth":464,"text":400,"children":493},[494],{"id":423,"depth":470,"text":424},"High-level architecture of the Kinotic OS platform.","md",null,{},{"icon":151},{"title":148,"description":495},"b0GpTdnzBAST5TsTgxo97sM5hbCYvwshJBVh9qNavZw",[503,505],{"title":139,"path":140,"stem":141,"description":504,"icon":60,"children":-1},"Complete SQL grammar reference for migration scripts.",{"title":153,"path":154,"stem":155,"description":506,"icon":6,"children":-1},"Deploying and operating Kinotic OS in various environments.",1790838913794]