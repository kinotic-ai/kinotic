233,"icon":234},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":236,"path":237,"stem":238,"icon":239},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":241,"path":242,"stem":243,"icon":178},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":245,"path":246,"stem":247,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":249,"path":250,"stem":251,"icon":252},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":254,"path":255,"stem":256,"icon":257},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":259,"path":260,"stem":261,"icon":262},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":264,"title":175,"body":265,"description":609,"extension":610,"links":611,"meta":612,"navigation":613,"path":176,"seo":614,"stem":177,"__hash__":615},"docs\u002F04.platform\u002F01.architecture.md",{"type":266,"value":267,"toc":600},"minimark",[268,272,276,280,344,352,356,424,428,431,441,447,452,463,508,514,534,538,560,593,596],[269,270,26],"h2",{"id":271},"overview",[273,274,275],"p",{},"Kinotic OS is a full-stack application platform that handles service communication, persistence, authentication, authorization, deployment, and observability. The system is composed of several core components that work together to provide a seamless development and runtime experience.",[269,277,279],{"id":278},"core-components","Core Components",[281,282,283,300,313,326,332,338],"ul",{},[284,285,286,290,291,295,296,299],"li",{},[287,288,289],"strong",{},"Management server"," (",[292,293,294],"code",{},"kinotic-server-management",") — The API the portal, the Kinotic CLI and organization members' MCP hosts call: sign-up, logins and invitations, the ",[292,297,298],{},"management-api"," services, and the GitHub App's webhook.",[284,301,302,290,305,308,309,312],{},[287,303,304],{},"System server",[292,306,307],{},"kinotic-server-system",") — The API the system console and the vm-managers call: the ",[292,310,311],{},"system-api"," services, project deployments, and the cluster singletons that reconcile deployments and delete old workload runs.",[284,314,315,290,318,321,322,325],{},[287,316,317],{},"App server",[292,319,320],{},"kinotic-server-app",") — The API every application's users, UIs and microservices call: the ",[292,323,324],{},"app-api"," persistence services and the services applications publish in their own zones, each application at its own API host.",[284,327,328,331],{},[287,329,330],{},"RPC Gateway"," — Each server's gateway routes remote procedure calls between its clients and published services over STOMP\u002FWebSocket, and serves the server's REST and MCP endpoints.",[284,333,334,337],{},[287,335,336],{},"Persistence Layer"," — Provides automatic CRUD operations for entities backed by Elasticsearch.",[284,339,340,343],{},[287,341,342],{},"Auth System"," — Handles authentication (email\u002Fpassword and OIDC) across three authorization hierarchies: System, Organization, and Application. Each server admits only the participants it serves.",[273,345,346,347,351],{},"The three servers are Spring Boot applications that form one Ignite cluster, in which each hosts only its own zones. ",[348,349,198],"a",{"href":350},"\u002Fplatform\u002Fdefense-in-depth#network-architecture"," shows which participants each admits and which zones each hosts.",[269,353,355],{"id":354},"tech-stack","Tech Stack",[357,358,359,372],"table",{},[360,361,362],"thead",{},[363,364,365,369],"tr",{},[366,367,368],"th",{},"Component",[366,370,371],{},"Technology",[373,374,375,384,392,400,408,416],"tbody",{},[363,376,377,381],{},[378,379,380],"td",{},"Orchestration",[378,382,383],{},"Kubernetes",[363,385,386,389],{},[378,387,388],{},"Build Isolation",[378,390,391],{},"Firecracker VMs",[363,393,394,397],{},[378,395,396],{},"Runtime",[378,398,399],{},"Bun",[363,401,402,405],{},[378,403,404],{},"Search\u002FPersistence",[378,406,407],{},"Elasticsearch",[363,409,410,413],{},[378,411,412],{},"Logging",[378,414,415],{},"Grafana Loki",[363,417,418,421],{},[378,419,420],{},"Payments",[378,422,423],{},"Stripe Connect",[269,425,427],{"id":426},"communication","Communication",[273,429,430],{},"Services communicate via STOMP over WebSocket, with messages routed by CRI (Kinotic Resource Identifier). Each service, method, and event stream is addressable through a CRI, which follows the format:",[432,433,438],"pre",{"className":434,"code":436,"language":437},[435],"language-text","scheme:\u002F\u002F[scope@]resourceName[\u002Fpath][#version]\n","text",[292,439,436],{"__ignoreMap":440},"",[273,442,443,444,446],{},"The RPC gateway uses CRIs to route requests to the correct service instance, apply versioning, and enforce scope-based multi-tenancy. See the ",[348,445,231],{"href":232}," reference for details.",[448,449,451],"h3",{"id":450},"kinotic-rpc-on-its-own","Kinotic RPC on its own",[273,453,454,455,458,459,462],{},"Kinotic RPC, the service and event layer in ",[292,456,457],{},"kinotic-core"," and ",[292,460,461],{},"kinotic-api-gateway",", runs without the rest of\nKinotic OS. A server built on it alone supplies two beans the gateway authenticates and authorizes every\nconnection with:",[357,464,465,475],{},[360,466,467],{},[363,468,469,472],{},[366,470,471],{},"Bean",[366,473,474],{},"What it decides",[373,476,477,490],{},[363,478,479,484],{},[378,480,481],{},[292,482,483],{},"SecurityService",[378,485,486,487],{},"Who a connection is: it authenticates the headers of the WebSocket upgrade request and returns the connection's ",[292,488,489],{},"Participant",[363,491,492,497],{},[378,493,494],{},[292,495,496],{},"ZoneRulesResolver",[378,498,499,500,503,504,507],{},"What that participant may address: the ",[292,501,502],{},"ZoneRules"," of zones it may send to and subscribe in, which the gateway narrows to the zones the server's ",[292,505,506],{},"ZonePartitioningService"," serves",[273,509,510,511,513],{},"Kinotic OS's servers supply each from their own module: the ",[292,512,483],{}," of the server, and kinotic-domain's\nresolver, which gives system, organization and application participants their zones.",[273,515,516,517,520,521,524,525,527,528,530,531,533],{},"Two clients call a gateway from outside its cluster over the same STOMP-over-WebSocket protocol: ",[292,518,519],{},"@kinotic-ai\u002Fcore","\nfor TypeScript, and ",[292,522,523],{},"kinotic-client"," for Java, which hands out the typed service proxies of ",[292,526,457],{}," over a\ngateway connection instead of the cluster's event bus (see\n",[348,529,84],{"href":85},"). Both authenticate with the headers of\nthe WebSocket upgrade, which the gateway's ",[292,532,483],{}," reads.",[448,535,537],{"id":536},"never-block-the-event-loop","Never block the event loop",[273,539,540,541,544,545,548,549,548,552,555,556,559],{},"A Java service published with ",[292,542,543],{},"@Publish"," is invoked on a Vert.x event loop it shares with the other services on the node, the same rule Vert.x sets for its own handlers. A method returns a ",[292,546,547],{},"Future",", ",[292,550,551],{},"CompletableFuture",[292,553,554],{},"Mono"," or ",[292,557,558],{},"Flux"," and lets the work complete off the loop; a method that is slow, because it blocks on a synchronous client, a lock or a sleep, or because it does heavy CPU work, hands that work off inside itself:",[432,561,565],{"className":562,"code":563,"language":564,"meta":440,"style":440},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@Override\npublic Future\u003CReport> render(String id) {\n    return vertx.executeBlocking(() -> renderer.render(id));   \u002F\u002F the loop is free while the worker runs\n}\n","java",[292,566,567,575,581,587],{"__ignoreMap":440},[568,569,572],"span",{"class":570,"line":571},"line",1,[568,573,574],{},"@Override\n",[568,576,578],{"class":570,"line":577},2,[568,579,580],{},"public Future\u003CReport> render(String id) {\n",[568,582,584],{"class":570,"line":583},3,[568,585,586],{},"    return vertx.executeBlocking(() -> renderer.render(id));   \u002F\u002F the loop is free while the worker runs\n",[568,588,590],{"class":570,"line":589},4,[568,591,592],{},"}\n",[273,594,595],{},"The platform never hands off on a service's behalf. A method that blocks stalls every service sharing its loop, and Vert.x's blocked-thread checker reports it in the log.",[597,598,599],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":440,"searchDepth":577,"depth":577,"links":601},[602,603,604,605],{"id":271,"depth":577,"text":26},{"id":278,"depth":577,"text":279},{"id":354,"depth":577,"text":355},{"id":426,"depth":577,"text":427,"children":606},[607,608],{"id":450,"depth":583,"text":451},{"id":536,"depth":583,"text":537},"High-level architecture of the Kinotic OS platform.","md",null,{},{"icon":178},{"title":175,"description":609},"Bn-4vO3cqO5OwJ_OQh9mA61yzC_oGdYzW0m7LmW9oKI",[617,619],{"title":166,"path":167,"stem":168,"description":618,"icon":89,"children":-1},"Complete SQL grammar reference for migration scripts.",{"title":180,"path":181,"stem":182,"description":620,"icon":6,"children":-1},"Deploying and operating Kinotic OS in various environments.",1794214582121]