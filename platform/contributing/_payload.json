uild\n",[336,363,365],{"id":364},"typescript-sdk","TypeScript SDK",[341,367,369],{"className":343,"code":368,"language":345,"meta":346,"style":346},"cd kinotic-js\nbun install\nbun run build\n",[255,370,371,380,389],{"__ignoreMap":346},[350,372,373,377],{"class":352,"line":353},[350,374,376],{"class":375},"s2Zo4","cd",[350,378,379],{"class":360}," kinotic-js\n",[350,381,383,386],{"class":352,"line":382},2,[350,384,385],{"class":356},"bun",[350,387,388],{"class":360}," install\n",[350,390,392,394,397],{"class":352,"line":391},3,[350,393,385],{"class":356},[350,395,396],{"class":360}," run",[350,398,361],{"class":360},[336,400,402],{"id":401},"website","Website",[341,404,406],{"className":343,"code":405,"language":345,"meta":346,"style":346},"cd website\nbun install\nbun run dev\n",[255,407,408,415,421],{"__ignoreMap":346},[350,409,410,412],{"class":352,"line":353},[350,411,376],{"class":375},[350,413,414],{"class":360}," website\n",[350,416,417,419],{"class":352,"line":382},[350,418,385],{"class":356},[350,420,388],{"class":360},[350,422,423,425,427],{"class":352,"line":391},[350,424,385],{"class":356},[350,426,396],{"class":360},[350,428,429],{"class":360}," dev\n",[219,431,433],{"id":432},"testing","Testing",[336,435,437],{"id":436},"javakotlin","Java\u002FKotlin",[341,439,441],{"className":343,"code":440,"language":345,"meta":346,"style":346},".\u002Fgradlew test\n",[255,442,443],{"__ignoreMap":346},[350,444,445,447],{"class":352,"line":353},[350,446,357],{"class":356},[350,448,449],{"class":360}," test\n",[336,451,453],{"id":452},"typescript-vitest","TypeScript (Vitest)",[341,455,457],{"className":343,"code":456,"language":345,"meta":346,"style":346},"cd kinotic-js\nbun test\n",[255,458,459,465],{"__ignoreMap":346},[350,460,461,463],{"class":352,"line":353},[350,462,376],{"class":375},[350,464,379],{"class":360},[350,466,467,469],{"class":352,"line":382},[350,468,385],{"class":356},[350,470,449],{"class":360},[336,472,474],{"id":473},"publishing-uis-against-azure","Publishing UIs against Azure",[223,476,477],{},"The development profile publishes UIs to a local Azurite and marks every site ready without\nFront Door. To exercise the real path — a storage account per organization, sites served\nthrough Front Door — point the server at a subscription of your own.",[223,479,480],{},"Create what the server cannot create itself, once:",[341,482,484],{"className":343,"code":483,"language":345,"meta":346,"style":346},"az login\ncd deployment\u002Fterraform\u002Fazure\u002Fdev\nterraform init\nterraform apply   # environment = \"local\" in terraform.tfvars; pick a name of your own\nterraform output -raw application_local_yml > ..\u002F..\u002F..\u002F..\u002Fkinotic-server\u002Fsrc\u002Fmain\u002Fresources\u002Fapplication-local.yml\n",[255,485,486,494,501,509,521],{"__ignoreMap":346},[350,487,488,491],{"class":352,"line":353},[350,489,490],{"class":356},"az",[350,492,493],{"class":360}," login\n",[350,495,496,498],{"class":352,"line":382},[350,497,376],{"class":375},[350,499,500],{"class":360}," deployment\u002Fterraform\u002Fazure\u002Fdev\n",[350,502,503,506],{"class":352,"line":391},[350,504,505],{"class":356},"terraform",[350,507,508],{"class":360}," init\n",[350,510,512,514,517],{"class":352,"line":511},4,[350,513,505],{"class":356},[350,515,516],{"class":360}," apply",[350,518,520],{"class":519},"sHwdD","   # environment = \"local\" in terraform.tfvars; pick a name of your own\n",[350,522,524,526,529,532,535,539],{"class":352,"line":523},5,[350,525,505],{"class":356},[350,527,528],{"class":360}," output",[350,530,531],{"class":360}," -raw",[350,533,534],{"class":360}," application_local_yml",[350,536,538],{"class":537},"sMK4o"," >",[350,540,541],{"class":360}," ..\u002F..\u002F..\u002F..\u002Fkinotic-server\u002Fsrc\u002Fmain\u002Fresources\u002Fapplication-local.yml\n",[223,543,544,545,548,549,552,553,556,557,560],{},"That is a resource group, a Front Door Standard profile with an endpoint, and the\n",[255,546,547],{},"apps-\u003Cenvironment>.\u003Czone>"," sites domain in the platform's DNS zone. The written file is the\ngit-ignored ",[255,550,551],{},"local"," profile: it turns both provisioners on and names those resources. The\nidentity ",[255,554,555],{},"az login"," signed in is the one the server provisions with; Contributor on the\nsubscription covers the storage accounts, the Front Door resources and the DNS records it\nwrites. The ",[255,558,559],{},"environment"," is yours alone: a site hostname can be bound to one Front Door\nprofile in all of Azure, so two developers sharing a sites domain would collide.",[223,562,563],{},"Run the server with both profiles:",[341,565,567],{"className":343,"code":566,"language":345,"meta":346,"style":346},"SPRING_PROFILES_ACTIVE=development,local\n",[255,568,569],{"__ignoreMap":346},[350,570,571,575,578],{"class":352,"line":353},[350,572,574],{"class":573},"sTEyZ","SPRING_PROFILES_ACTIVE",[350,576,577],{"class":537},"=",[350,579,580],{"class":360},"development,local\n",[223,582,583,584,586],{},"The ",[255,585,551],{}," profile overrides the development one, which already disables private endpoints:\na developer machine is outside any platform VNet, so the server and the publish workload reach\neach storage account over its public endpoint, and the workload's egress allowlist names that\nhost.",[223,588,589,590,594,595,598,599,602],{},"Then sign up an organization, or open an existing one in the system console and choose\n",[591,592,593],"strong",{},"Provision again",": the ",[255,596,597],{},"provision-organization-\u003Cid>"," job creates its storage account and\nprepares its Front Door origin group and rule set, and the organization's overview shows the\noutcome. Deploy a project that contains a UI; the deployment publishes it and provisions its\nsite, served at ",[255,600,601],{},"https:\u002F\u002F\u003Clabel>.apps-\u003Cenvironment>.\u003Czone>"," once Front Door has validated the\ndomain and issued its certificate, which takes a few minutes and shows as the deployment\nturning from provisioning to ready.",[223,604,605,608,609,612],{},[255,606,607],{},"terraform destroy"," removes the resource group with every storage account and Front Door\nresource the server created in it. The CNAME and validation TXT records of sites live in the\nplatform's DNS zone, outside the group; removing a deployment removes them, so remove your\ndeployments first, or delete the records under ",[255,610,611],{},"apps-\u003Cenvironment>"," by hand.",[219,614,616],{"id":615},"submitting-changes","Submitting Changes",[618,619,620,627,630,633],"ol",{},[621,622,623,624],"li",{},"Fork the repository and create a feature branch from ",[255,625,626],{},"develop",[621,628,629],{},"Make your changes with clear, descriptive commit messages",[621,631,632],{},"Ensure all tests pass before submitting",[621,634,635,636,638],{},"Submit a pull request against the ",[255,637,626],{}," branch",[640,641,642],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-s