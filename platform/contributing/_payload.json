cture",[231,232,233,246],"table",{},[234,235,236],"thead",{},[237,238,239,243],"tr",{},[240,241,242],"th",{},"Directory",[240,244,245],{},"Description",[247,248,249,261,271,289,311,321],"tbody",{},[237,250,251,258],{},[252,253,254],"td",{},[255,256,257],"code",{},"kinotic-core\u002F",[252,259,260],{},"Java\u002FKotlin backend (Spring Boot) — RPC gateway, service registry, authentication",[237,262,263,268],{},[252,264,265],{},[255,266,267],{},"kinotic-management-api\u002F",[252,269,270],{},"Domain model and management API services — application, project, and cluster management",[237,272,273,278],{},[252,274,275],{},[255,276,277],{},"kinotic-js\u002F",[252,279,280,281,284,285,288],{},"TypeScript SDK workspace (Bun) — ",[255,282,283],{},"@kinotic-ai\u002Fcore",", ",[255,286,287],{},"@kinotic-ai\u002Fpersistence",", and related packages",[237,290,291,296],{},[252,292,293],{},[255,294,295],{},"kinotic-frontend\u002F",[252,297,298,299,302,303,306,307,310],{},"Vue.js UI workspace (pnpm) — ",[255,300,301],{},"apps\u002Fportal"," (the Kinotic OS dashboard), ",[255,304,305],{},"apps\u002Fsystem"," (the platform-operator console), ",[255,308,309],{},"packages\u002Fcommon"," (shared UI code)",[237,312,313,318],{},[252,314,315],{},[255,316,317],{},"website\u002F",[252,319,320],{},"Documentation site (Docus\u002FNuxt)",[237,322,323,328],{},[252,324,325],{},[255,326,327],{},"deployment\u002F",[252,329,330],{},"Helm charts, Docker Compose, Terraform configurations",[219,332,334],{"id":333},"building","Building",[336,337,339],"h3",{"id":338},"javakotlin-backend","Java\u002FKotlin Backend",[341,342,347],"pre",{"className":343,"code":344,"language":345,"meta":346,"style":346},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight",".\u002Fgradlew build\n","bash","",[255,348,349],{"__ignoreMap":346},[350,351,354,358],"span",{"class":352,"line":353},"line",1,[350,355,357],{"class":356},"sBMFI",".\u002Fgradlew",[350,359,361],{"class":360},"sfazB"," build\n",[336,363,365],{"id":364},"typescript-sdk","TypeScript SDK",[341,367,369],{"className":343,"code":368,"language":345,"meta":346,"style":346},"cd kinotic-js\nbun install\nbun run build\n",[255,370,371,380,389],{"__ignoreMap":346},[350,372,373,377],{"class":352,"line":353},[350,374,376],{"class":375},"s2Zo4","cd",[350,378,379],{"class":360}," kinotic-js\n",[350,381,383,386],{"class":352,"line":382},2,[350,384,385],{"class":356},"bun",[350,387,388],{"class":360}," install\n",[350,390,392,394,397],{"class":352,"line":391},3,[350,393,385],{"class":356},[350,395,396],{"class":360}," run",[350,398,361],{"class":360},[336,400,402],{"id":401},"website","Website",[341,404,406],{"className":343,"code":405,"language":345,"meta":346,"style":346},"cd website\nbun install\nbun run dev\n",[255,407,408,415,421],{"__ignoreMap":346},[350,409,410,412],{"class":352,"line":353},[350,411,376],{"class":375},[350,413,414],{"class":360}," website\n",[350,416,417,419],{"class":352,"line":382},[350,418,385],{"class":356},[350,420,388],{"class":360},[350,422,423,425,427],{"class":352,"line":391},[350,424,385],{"class":356},[350,426,396],{"class":360},[350,428,429],{"class":360}," dev\n",[219,431,433],{"id":432},"testing","Testing",[336,435,437],{"id":436},"javakotlin","Java\u002FKotlin",[341,439,441],{"className":343,"code":440,"language":345,"meta":346,"style":346},".\u002Fgradlew test\n",[255,442,443],{"__ignoreMap":346},[350,444,445,447],{"class":352,"line":353},[350,446,357],{"class":356},[350,448,449],{"class":360}," test\n",[336,451,453],{"id":452},"typescript-vitest","TypeScript (Vitest)",[341,455,457],{"className":343,"code":456,"language":345,"meta":346,"style":346},"cd kinotic-js\nbun test\n",[255,458,459,465],{"__ignoreMap":346},[350,460,461,463],{"class":352,"line":353},[350,462,376],{"class":375},[350,464,379],{"class":360},[350,466,467,469],{"class":352,"line":382},[350,468,385],{"class":356},[350,470,449],{"class":360},[336,472,474],{"id":473},"publishing-uis-against-azure","Publishing UIs against Azure",[223,476,477],{},"The development profile publishes UIs to a local Azurite and marks every site ready without\nFront Door. To exercise the real path — a storage account per organization, sites served\nthrough Front Door — point the server at a subscription of your own.",[223,479,480],{},"Create what the server cannot create itself, once:",[341,482,484],{"className":343,"code":483,"language":345,"meta":346,"style":346},"az login\ncd deployment\u002Fterraform\u002Fazure\u002Fdev\nterraform init\nterraform apply   # environment = \"local\" in terraform.tfvars; pick a name of your own\nterraform output -raw application_local_yml > ..\u002F..\u002F..\u002F..\u002Fkinotic-server\u002Fsrc\u002Fmain\u002Fresources\u002Fapplication-local.yml\n",[255,485,486,494,501,509,521],{"__ignoreMap":346},[350,487,488,491],{"class":352,"line":353},[350,489,490],{"class":356},"az",[350,492,493],{"class":360}," login\n",[350,495,496,498],{"class":352,"line":382},[350,497,376],{"class":375},[350,499,500],{"class":360}," deployment\u002Fterraform\u002Fazure\u002Fdev\n",[350,502,503,506],{"class":352,"line":391},[350,504,505],{"class":356},"terraform",[350,507,508],{"class":360}," init\n",[350,510,512,514,517],{"class":352,"line":511},4,[350,513,505],{"class":356},[350,515,516],{"class":360}," apply",[350,518,520],{"class":519},"sHwdD","   # environment = \"local\" in terraform.tfvars; pick a name of your own\n",[350,522,524,526,529,532,535,539],{"class":352,"line":523},5,[350,525,505],{"class":356},[350,527,528],{"class":360}," output",[350,530,531],{"class":360}," -raw",[350,533,534],{"class":360}," application_local_yml",[350,536,538],{"class":537},"sMK4o"," >",[350,540,541],{"class":360}," ..\u002F..\u002F..\u002F..\u002Fkinotic-server\u002Fsrc\u002Fmain\u002Fresources\u002Fapplication-local.yml\n",[223,543,544,545,548,549,552,553,556],{},"That is a resource group, a Front Door Standard profile with an endpoint, the\n",[255,546,547],{},"apps-\u003Cenvironment>.\u003Czone>"," sites domain in the platform's DNS zone, and a service principal\nfor the server with the roles it needs: Contributor and Storage Blob Data Contributor on the\ngroup, DNS Zone Contributor on the zone, and Contributor on the email service, so it sends\nmail too. The written file is the git-ignored ",[255,550,551],{},"local"," profile: it turns both provisioners on\nand names those resources. The ",[255,554,555],{},"environment"," is yours alone: a site hostname can be bound to\none Front Door profile in all of Azure, so two developers sharing a sites domain would\ncollide.",[223,558,559,560,284,563,566,567,570,571,574,575,578,579,582,583,586,587,591],{},"The principal's ",[255,561,562],{},"AZURE_CLIENT_ID",[255,564,565],{},"AZURE_CLIENT_SECRET"," and ",[255,568,569],{},"AZURE_TENANT_ID"," are written to\n",[255,572,573],{},".env.local"," at the repository root, which git ignores, as a commented block after a blank\nline. When the file exists its other lines are kept and the block a previous apply wrote is\nreplaced, or appended if absent. Run the server with that file\nin its environment; ",[255,576,577],{},"DefaultAzureCredential"," takes those variables before anything else, so\nthe server provisions as the principal whatever ",[255,580,581],{},"az login"," is signed in as. A role\nassignment takes a minute or two to become visible; an organization provisioned before that\nfails with ",[255,584,585],{},"AuthorizationFailed",", and ",[588,589,590],"strong",{},"Provision again"," finishes it once the roles have\npropagated.",[223,593,594],{},"Run the server with both profiles:",[341,596,598],{"className":343,"code":597,"language":345,"meta":346,"style":346},"SPRING_PROFILES_ACTIVE=development,local\n",[255,599,600],{"__ignoreMap":346},[350,601,602,606,609],{"class":352,"line":353},[350,603,605],{"class":604},"sTEyZ","SPRING_PROFILES_ACTIVE",[350,607,608],{"class":537},"=",[350,610,611],{"class":360},"development,local\n",[223,613,614,615,617],{},"The ",[255,616,551],{}," profile overrides the development one, which already disables private endpoints:\na developer machine is outside any platform VNet, so the server and the publish workload reach\neach storage account over its public endpoint, and the workload's egress allowlist names that\nhost.",[223,619,620,621,623,624,627,628,631],{},"Then sign up an organization, or open an existing one in the system console and choose\n",[588,622,590],{},": the ",[255,625,626],{},"provision-organization-\u003Cid>"," job creates its storage account and\nprepares its Front Door origin group and rule set, and the organization's overview shows the\noutcome. Deploy a project that contains a UI; the deployment publishes it and provisions its\nsite, served at ",[255,629,630],{},"https:\u002F\u002F\u003Clabel>.apps-\u003Cenvironment>.\u003Czone>"," once Front Door has validated the\ndomain and issued its certificate, which takes a few minutes and shows as the deployment\nturning from provisioning to ready.",[223,633,634,637,638,641],{},[255,635,636],{},"terraform destroy"," removes the resource group with every storage account and Front Door\nresource the server created in it. The CNAME and validation TXT records of sites live in the\nplatform's DNS zone, outside the group; removing a deployment removes them, so remove your\ndeployments first, or delete the records under ",[255,639,640],{},"apps-\u003Cenvironment>"," by hand.",[219,643,645],{"id":644},"submitting-changes","Submitting Changes",[647,648,649,656,659,662],"ol",{},[650,651,652,653],"li",{},"Fork the repository and create a feature branch from ",[255,654,655],{},"develop",[650,657,658],{},"Make your changes with clear, descriptive commit messages",[650,660,661],{},"Ensure all tests pass before submitting",[650,663,664,665,667],{},"Submit a pull request against the ",[255,666,655],{}," branch",[669,670,671],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B