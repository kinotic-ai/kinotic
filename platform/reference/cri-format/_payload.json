ension":1123,"links":1124,"meta":1125,"navigation":1126,"path":206,"seo":1127,"stem":207,"__hash__":1128},"docs\u002F02.platform\u002F12.reference\u002F01.cri-format.md",{"type":231,"value":232,"toc":1105},"minimark",[233,237,241,245,256,263,267,277,283,287,292,295,334,338,345,352,358,362,369,424,434,447,511,515,518,524,528,531,537,541,544,550,554,561,801,805,811,1012,1016,1101],[234,235,25],"h2",{"id":236},"overview",[238,239,240],"p",{},"A CRI (Kinotic Resource Identifier) is used by Kinotic to route requests to the appropriate service, method, or event stream. It is a URI-like format with parts named for clarity within the Kinotic platform.",[234,242,244],{"id":243},"format","Format",[246,247,252],"pre",{"className":248,"code":250,"language":251},[249],"language-text","scheme:\u002F\u002F[scope@][zone~]resourceName[\u002Fpath][#version]\n","text",[253,254,250],"code",{"__ignoreMap":255},"",[238,257,258,259,262],{},"Everything in brackets (",[253,260,261],{},"[]",") is optional.",[234,264,266],{"id":265},"case","Case",[238,268,269,270,273,274,276],{},"Every part keeps the case it was written with, and addresses match by exact string comparison — ",[253,271,272],{},"OrderService"," and ",[253,275,272],{}," are two different addresses. Service names carry the case of the class that published them, so a typical address looks like:",[246,278,281],{"className":279,"code":280,"language":251},[249],"srv:\u002F\u002Fmanagement-api~org.kinotic.management.api.services.ProjectService\u002FfindByRepoFullName\n",[253,282,280],{"__ignoreMap":255},[234,284,286],{"id":285},"components","Components",[288,289,291],"h3",{"id":290},"scheme","Scheme",[238,293,294],{},"Identifies the type of resource being addressed.",[296,297,298,310],"table",{},[299,300,301],"thead",{},[302,303,304,307],"tr",{},[305,306,291],"th",{},[305,308,309],{},"Description",[311,312,313,324],"tbody",{},[302,314,315,321],{},[316,317,318],"td",{},[253,319,320],{},"srv",[316,322,323],{},"Published services and their methods",[302,325,326,331],{},[316,327,328],{},[253,329,330],{},"stream",[316,332,333],{},"Event streams (not yet routable through the gateway)",[288,335,337],{"id":336},"scope","Scope",[238,339,340,341,344],{},"An optional qualifier that narrows the CRI to a specific context, such as a tenant ID, user ID, or device ID. When present, it appears before the ",[253,342,343],{},"@"," symbol.",[238,346,347,348,351],{},"If a scope needs sub-scopes, use the format ",[253,349,350],{},"scope:sub-scope",".",[246,353,356],{"className":354,"code":355,"language":251},[249],"srv:\u002F\u002Ftenant-123@app.acme-org.orders-app~OrderService\nstream:\u002F\u002Fdevice-42@app.acme-org.orders-app~temperature\u002Fsensor-1\n",[253,357,355],{"__ignoreMap":255},[288,359,361],{"id":360},"zone","Zone",[238,363,364,365,368],{},"The optional zone places the resource in the isolation boundary the gateway validates on every send and subscribe. It precedes the resourceName, separated by ",[253,366,367],{},"~",". A zone is one or more dot-separated labels of lowercase letters, digits, and interior dashes.",[296,370,371,379],{},[299,372,373],{},[302,374,375,377],{},[305,376,361],{},[305,378,309],{},[311,380,381,394,404,414],{},[302,382,383,388],{},[316,384,385],{},[253,386,387],{},"app.\u003CorganizationId>.\u003CapplicationId>",[316,389,390,391,351],{},"One application's services. Only that application (and system participants) can call them; they are hosted by the owning organization's runtime, which authenticates as an organization participant. Applications may nest their own sub-zones, e.g. ",[253,392,393],{},"app.acme-org.orders-app.billing",[302,395,396,401],{},[316,397,398],{},[253,399,400],{},"app-api",[316,402,403],{},"The platform's data plane for applications, such as entity persistence and named query execution. Hosted in-process by the platform only.",[302,405,406,411],{},[316,407,408],{},[253,409,410],{},"management-api",[316,412,413],{},"The platform services organizations manage the system through, such as member, application, and entity definition management. Hosted in-process by the platform only.",[302,415,416,421],{},[316,417,418],{},[253,419,420],{},"system-api",[316,422,423],{},"Platform-internal services. Only system participants can call or host them.",[238,425,426,427,430,431,433],{},"Organization and application ids become zone labels, but only ever after the ",[253,428,429],{},"app"," prefix, so they cannot collide with the platform's own zones. The one exception is guarded explicitly: creating an organization or application whose name slugifies to ",[253,432,420],{}," is rejected.",[238,435,436,437,439,440,443,444,446],{},"Which zones a connection may address is determined by the authenticated participant. A participant may also address any sub-zone of a zone it is allowed, so ",[253,438,393],{}," is reachable by whoever may reach ",[253,441,442],{},"app.acme-org.orders-app",". An address without a ",[253,445,367],{}," carries no zone at all and is only reachable by system participants.",[296,448,449,462],{},[299,450,451],{},[302,452,453,456,459],{},[305,454,455],{},"Participant",[305,457,458],{},"May send to",[305,460,461],{},"May subscribe to",[311,463,464,480,499],{},[302,465,466,469,477],{},[316,467,468],{},"APPLICATION (org, app)",[316,470,471,473,474],{},[253,472,400],{},", ",[253,475,476],{},"app.\u003Corg>.\u003Capp>",[316,478,479],{},"reply destinations only",[302,481,482,485,494],{},[316,483,484],{},"ORGANIZATION (org)",[316,486,487,473,489,473,491],{},[253,488,410],{},[253,490,400],{},[253,492,493],{},"app.\u003Corg>.*",[316,495,496,498],{},[253,497,493],{}," — its applications' zones",[302,500,501,504,507],{},[316,502,503],{},"SYSTEM",[316,505,506],{},"everything",[316,508,509],{},[253,510,420],{},[288,512,514],{"id":513},"resource-name","Resource Name",[238,516,517],{},"The name of the resource being addressed, excluding the zone. For services, this is the fully qualified service name. For streams, this is the event type name.",[246,519,522],{"className":520,"code":521,"language":251},[249],"srv:\u002F\u002Fmanagement-api~com.example.UserService\nstream:\u002F\u002Fapp.acme-org.orders-app~temperature\n",[253,523,521],{"__ignoreMap":255},[288,525,527],{"id":526},"path","Path",[238,529,530],{},"An optional path that identifies a specific part of the resource, such as a method name on a service. The path's case is preserved.",[246,532,535],{"className":533,"code":534,"language":251},[249],"srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById\nstream:\u002F\u002Fapp.acme-org.orders-app~temperature\u002Fsensor-1\n",[253,536,534],{"__ignoreMap":255},[288,538,540],{"id":539},"version","Version",[238,542,543],{},"An optional semantic version for the resource. Enables versioned service routing so multiple versions of a service can coexist.",[246,545,548],{"className":546,"code":547,"language":251},[249],"srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById#1.0.0\nsrv:\u002F\u002Fmanagement-api~com.example.UserService#2.0.0\n",[253,549,547],{"__ignoreMap":255},[234,551,553],{"id":552},"factory-function","Factory Function",[238,555,556,557,560],{},"The ",[253,558,559],{},"createCRI"," function provides several overloads for constructing CRI instances:",[246,562,566],{"className":563,"code":564,"language":565,"meta":255,"style":255},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { createCRI } from '@kinotic-ai\u002Fcore'\n\n\u002F\u002F From a raw string\nconst cri1 = createCRI('srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById#1.0.0')\n\n\u002F\u002F From scheme and resource name (which may carry a zone)\nconst cri2 = createCRI('srv', 'management-api~com.example.UserService')\n\n\u002F\u002F From scheme, scope, and resource name\nconst cri3 = createCRI('stream', 'tenant-123', 'app.acme-org.orders-app~orders')\n\n\u002F\u002F From all components\nconst cri4 = createCRI('srv