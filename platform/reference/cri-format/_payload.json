[230],"language-text","scheme:\u002F\u002F[scope@][zone~]resourceName[\u002Fpath][#version]\n","text",[234,235,231],"code",{"__ignoreMap":236},"",[219,238,239,240,243],{},"Everything in brackets (",[234,241,242],{},"[]",") is optional.",[215,245,247],{"id":246},"case","Case",[219,249,250,251,254,255,257],{},"Every part keeps the case it was written with, and addresses match by exact string comparison — ",[234,252,253],{},"OrderService"," and ",[234,256,253],{}," are two different addresses. Service names carry the case of the class that published them, so a typical address looks like:",[227,259,262],{"className":260,"code":261,"language":232},[230],"srv:\u002F\u002Fmanagement-api~org.kinotic.management.api.services.ProjectService\u002FfindByRepoFullName\n",[234,263,261],{"__ignoreMap":236},[215,265,267],{"id":266},"components","Components",[269,270,272],"h3",{"id":271},"scheme","Scheme",[219,274,275],{},"Identifies the type of resource being addressed.",[277,278,279,291],"table",{},[280,281,282],"thead",{},[283,284,285,288],"tr",{},[286,287,272],"th",{},[286,289,290],{},"Description",[292,293,294,305],"tbody",{},[283,295,296,302],{},[297,298,299],"td",{},[234,300,301],{},"srv",[297,303,304],{},"Published services and their methods",[283,306,307,312],{},[297,308,309],{},[234,310,311],{},"stream",[297,313,314],{},"Event streams (not yet routable through the gateway)",[269,316,318],{"id":317},"scope","Scope",[219,320,321,322,325],{},"An optional qualifier that narrows the CRI to a specific context, such as a tenant ID, user ID, or device ID. When present, it appears before the ",[234,323,324],{},"@"," symbol.",[219,327,328,329,332],{},"If a scope needs sub-scopes, use the format ",[234,330,331],{},"scope:sub-scope",".",[227,334,337],{"className":335,"code":336,"language":232},[230],"srv:\u002F\u002Ftenant-123@app.acme-org.orders-app~OrderService\nstream:\u002F\u002Fdevice-42@app.acme-org.orders-app~temperature\u002Fsensor-1\n",[234,338,336],{"__ignoreMap":236},[269,340,342],{"id":341},"zone","Zone",[219,344,345,346,349],{},"The optional zone places the resource in the isolation boundary the gateway validates on every send and subscribe. It precedes the resourceName, separated by ",[234,347,348],{},"~",". A zone is one or more dot-separated labels of lowercase letters, digits, and interior dashes.",[277,351,352,360],{},[280,353,354],{},[283,355,356,358],{},[286,357,342],{},[286,359,290],{},[292,361,362,375,385,395],{},[283,363,364,369],{},[297,365,366],{},[234,367,368],{},"app.\u003CorganizationId>.\u003CapplicationId>",[297,370,371,372,332],{},"One application's services. Only that application (and system participants) can call them; they are hosted by the owning organization's runtime, which authenticates as an organization participant. Applications may nest their own sub-zones, e.g. ",[234,373,374],{},"app.acme-org.orders-app.billing",[283,376,377,382],{},[297,378,379],{},[234,380,381],{},"app-api",[297,383,384],{},"The platform's data plane for applications, such as entity persistence and named query execution. Hosted in-process by the platform only.",[283,386,387,392],{},[297,388,389],{},[234,390,391],{},"management-api",[297,393,394],{},"The platform services organizations manage the system through, such as member, application, and entity definition management. Hosted in-process by the platform only.",[283,396,397,402],{},[297,398,399],{},[234,400,401],{},"system-api",[297,403,404],{},"Platform-internal services. Only system participants can call or host them.",[219,406,407,408,411,412,414],{},"Organization and application ids become zone labels, but only ever after the ",[234,409,410],{},"app"," prefix, so they cannot collide with the platform's own zones. The one exception is guarded explicitly: creating an organization or application whose name slugifies to ",[234,413,401],{}," is rejected.",[219,416,417,418,420,421,424,425,427],{},"Which zones a connection may address is determined by the authenticated participant. A participant may also address any sub-zone of a zone it is allowed, so ",[234,419,374],{}," is reachable by whoever may reach ",[234,422,423],{},"app.acme-org.orders-app",". An address without a ",[234,426,348],{}," carries no zone at all and is only reachable by system participants.",[277,429,430,443],{},[280,431,432],{},[283,433,434,437,440],{},[286,435,436],{},"Participant",[286,438,439],{},"May send to",[286,441,442],{},"May subscribe to",[292,444,445,461,480],{},[283,446,447,450,458],{},[297,448,449],{},"APPLICATION (org, app)",[297,451,452,454,455],{},[234,453,381],{},", ",[234,456,457],{},"app.\u003Corg>.\u003Capp>",[297,459,460],{},"reply destinations only",[283,462,463,466,475],{},[297,464,465],{},"ORGANIZATION (org)",[297,467,468,454,470,454,472],{},[234,469,391],{},[234,471,381],{},[234,473,474],{},"app.\u003Corg>.*",[297,476,477,479],{},[234,478,474],{}," — its applications' zones",[283,481,482,485,488],{},[297,483,484],{},"SYSTEM",[297,486,487],{},"everything",[297,489,490],{},[234,491,401],{},[269,493,495],{"id":494},"resource-name","Resource Name",[219,497,498],{},"The name of the resource being addressed, excluding the zone. For services, this is the fully qualified service name. For streams, this is the event type name.",[227,500,503],{"className":501,"code":502,"language":232},[230],"srv:\u002F\u002Fmanagement-api~com.example.UserService\nstream:\u002F\u002Fapp.acme-org.orders-app~temperature\n",[234,504,502],{"__ignoreMap":236},[269,506,508],{"id":507},"path","Path",[219,510,511],{},"An optional path that identifies a specific part of the resource, such as a method name on a service. The path's case is preserved.",[227,513,516],{"className":514,"code":515,"language":232},[230],"srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById\nstream:\u002F\u002Fapp.acme-org.orders-app~temperature\u002Fsensor-1\n",[234,517,515],{"__ignoreMap":236},[269,519,521],{"id":520},"version","Version",[219,523,524],{},"An optional semantic version for the resource. Enables versioned service routing so multiple versions of a service can coexist.",[227,526,529],{"className":527,"code":528,"language":232},[230],"srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById#1.0.0\nsrv:\u002F\u002Fmanagement-api~com.example.UserService#2.0.0\n",[234,530,528],{"__ignoreMap":236},[215,532,534],{"id":533},"factory-function","Factory Function",[219,536,537,538,541],{},"The ",[234,539,540],{},"createCRI"," function provides several overloads for constructing CRI instances:",[227,543,547],{"className":544,"code":545,"language":546,"meta":236,"style":236},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { createCRI } from '@kinotic-ai\u002Fcore'\n\n\u002F\u002F From a raw string\nconst cri1 = createCRI('srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById#1.0.0')\n\n\u002F\u002F From scheme and resource name (which may carry a zone)\nconst cri2 = createCRI('srv', 'management-api~com.example.UserService')\n\n\u002F\u002F From scheme, scope, and resource name\nconst cri3 = createCRI('stream', 'tenant-123', 'app.acme-org.orders-app~orders')\n\n\u002F\u002F From all components\nconst cri4 = createCRI('srv', null, 'management-api~com.example.UserService', 'findById', '1.0.0')\n","typescript",[234,548,549,582,589,596,626,631,637,669,674,680,720,725,731],{"__ignoreMap":236},[550,551,554,558,562,566,569,572,575,579],"span",{"class":552,"line":553},"line",1,[550,555,557],{"class":556},"s7zQu","import",[550,559,561],{"class":560},"sMK4o"," {",[550,563,565],{"class":564},"sTEyZ"," createCRI",[550,567,568],{"class":560}," }",[550,570,571],{"class":556}," from",[550,573,574],{"class":560}," '",[550,576,578],{"class":577},"sfazB","@kinotic-ai\u002Fcore",[550,580,581],{"class":560},"'\n",[550,583,585],{"class":552,"line":584},2,[550,586,588],{"emptyLinePlaceholder":587},true,"\n",[550,590,592],{"class":552,"line":591},3,[550,593,595],{"class":594},"sHwdD","\u00