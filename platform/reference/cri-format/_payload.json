":227,"toc":1100},"minimark",[228,232,236,240,251,258,262,272,278,282,287,290,329,333,340,347,353,357,364,419,429,442,506,510,513,519,523,526,532,536,539,545,549,556,796,800,806,1007,1011,1096],[229,230,25],"h2",{"id":231},"overview",[233,234,235],"p",{},"A CRI (Kinotic Resource Identifier) is used by Kinotic to route requests to the appropriate service, method, or event stream. It is a URI-like format with parts named for clarity within the Kinotic platform.",[229,237,239],{"id":238},"format","Format",[241,242,247],"pre",{"className":243,"code":245,"language":246},[244],"language-text","scheme:\u002F\u002F[scope@][zone~]resourceName[\u002Fpath][#version]\n","text",[248,249,245],"code",{"__ignoreMap":250},"",[233,252,253,254,257],{},"Everything in brackets (",[248,255,256],{},"[]",") is optional.",[229,259,261],{"id":260},"case","Case",[233,263,264,265,268,269,271],{},"Every part keeps the case it was written with, and addresses match by exact string comparison — ",[248,266,267],{},"OrderService"," and ",[248,270,267],{}," are two different addresses. Service names carry the case of the class that published them, so a typical address looks like:",[241,273,276],{"className":274,"code":275,"language":246},[244],"srv:\u002F\u002Fmanagement-api~org.kinotic.management.api.services.ProjectService\u002FfindByRepoFullName\n",[248,277,275],{"__ignoreMap":250},[229,279,281],{"id":280},"components","Components",[283,284,286],"h3",{"id":285},"scheme","Scheme",[233,288,289],{},"Identifies the type of resource being addressed.",[291,292,293,305],"table",{},[294,295,296],"thead",{},[297,298,299,302],"tr",{},[300,301,286],"th",{},[300,303,304],{},"Description",[306,307,308,319],"tbody",{},[297,309,310,316],{},[311,312,313],"td",{},[248,314,315],{},"srv",[311,317,318],{},"Published services and their methods",[297,320,321,326],{},[311,322,323],{},[248,324,325],{},"stream",[311,327,328],{},"Event streams (not yet routable through the gateway)",[283,330,332],{"id":331},"scope","Scope",[233,334,335,336,339],{},"An optional qualifier that narrows the CRI to a specific context, such as a tenant ID, user ID, or device ID. When present, it appears before the ",[248,337,338],{},"@"," symbol.",[233,341,342,343,346],{},"If a scope needs sub-scopes, use the format ",[248,344,345],{},"scope:sub-scope",".",[241,348,351],{"className":349,"code":350,"language":246},[244],"srv:\u002F\u002Ftenant-123@app.acme-org.orders-app~OrderService\nstream:\u002F\u002Fdevice-42@app.acme-org.orders-app~temperature\u002Fsensor-1\n",[248,352,350],{"__ignoreMap":250},[283,354,356],{"id":355},"zone","Zone",[233,358,359,360,363],{},"The optional zone places the resource in the isolation boundary the gateway validates on every send and subscribe. It precedes the resourceName, separated by ",[248,361,362],{},"~",". A zone is one or more dot-separated labels of lowercase letters, digits, and interior dashes.",[291,365,366,374],{},[294,367,368],{},[297,369,370,372],{},[300,371,356],{},[300,373,304],{},[306,375,376,389,399,409],{},[297,377,378,383],{},[311,379,380],{},[248,381,382],{},"app.\u003CorganizationId>.\u003CapplicationId>",[311,384,385,386,346],{},"One application's services. Only that application (and system participants) can call them; they are hosted by the owning organization's runtime, which authenticates as an organization participant. Applications may nest their own sub-zones, e.g. ",[248,387,388],{},"app.acme-org.orders-app.billing",[297,390,391,396],{},[311,392,393],{},[248,394,395],{},"app-api",[311,397,398],{},"The platform's data plane for applications, such as entity persistence and named query execution. Hosted in-process by the platform only.",[297,400,401,406],{},[311,402,403],{},[248,404,405],{},"management-api",[311,407,408],{},"The platform services organizations manage the system through, such as member, application, and entity definition management. Hosted in-process by the platform only.",[297,410,411,416],{},[311,412,413],{},[248,414,415],{},"system-api",[311,417,418],{},"Platform-internal services. Only system participants can call or host them.",[233,420,421,422,425,426,428],{},"Organization and application ids become zone labels, but only ever after the ",[248,423,424],{},"app"," prefix, so they cannot collide with the platform's own zones. The one exception is guarded explicitly: creating an organization or application whose name slugifies to ",[248,427,415],{}," is rejected.",[233,430,431,432,434,435,438,439,441],{},"Which zones a connection may address is determined by the authenticated participant. A participant may also address any sub-zone of a zone it is allowed, so ",[248,433,388],{}," is reachable by whoever may reach ",[248,436,437],{},"app.acme-org.orders-app",". An address without a ",[248,440,362],{}," carries no zone at all and is only reachable by system participants.",[291,443,444,457],{},[294,445,446],{},[297,447,448,451,454],{},[300,449,450],{},"Participant",[300,452,453],{},"May send to",[300,455,456],{},"May subscribe to",[306,458,459,475,494],{},[297,460,461,464,472],{},[311,462,463],{},"APPLICATION (org, app)",[311,465,466,468,469],{},[248,467,395],{},", ",[248,470,471],{},"app.\u003Corg>.\u003Capp>",[311,473,474],{},"reply destinations only",[297,476,477,480,489],{},[311,478,479],{},"ORGANIZATION (org)",[311,481,482,468,484,468,486],{},[248,483,405],{},[248,485,395],{},[248,487,488],{},"app.\u003Corg>.*",[311,490,491,493],{},[248,492,488],{}," — its applications' zones",[297,495,496,499,502],{},[311,497,498],{},"SYSTEM",[311,500,501],{},"everything",[311,503,504],{},[248,505,415],{},[283,507,509],{"id":508},"resource-name","Resource Name",[233,511,512],{},"The name of the resource being addressed, excluding the zone. For services, this is the fully qualified service name. For streams, this is the event type name.",[241,514,517],{"className":515,"code":516,"language":246},[244],"srv:\u002F\u002Fmanagement-api~com.example.UserService\nstream:\u002F\u002Fapp.acme-org.orders-app~temperature\n",[248,518,516],{"__ignoreMap":250},[283,520,522],{"id":521},"path","Path",[233,524,525],{},"An optional path that identifies a specific part of the resource, such as a method name on a service. The path's case is preserved.",[241,527,530],{"className":528,"code":529,"language":246},[244],"srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById\nstream:\u002F\u002Fapp.acme-org.orders-app~temperature\u002Fsensor-1\n",[248,531,529],{"__ignoreMap":250},[283,533,535],{"id":534},"version","Version",[233,537,538],{},"An optional semantic version for the resource. Enables versioned service routing so multiple versions of a service can coexist.",[241,540,543],{"className":541,"code":542,"language":246},[244],"srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById#1.0.0\nsrv:\u002F\u002Fmanagement-api~com.example.UserService#2.0.0\n",[248,544,542],{"__ignoreMap":250},[229,546,548],{"id":547},"factory-function","Factory Function",[233,550,551,552,555],{},"The ",[248,553,554],{},"createCRI"," function provides several overloads for constructing CRI instances:",[241,557,561],{"className":558,"code":559,"language":560,"meta":250,"style":250},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { createCRI } from '@kinotic-ai\u002Fcore'\n\n\u002F\u002F From a raw string\nconst cri1 = createCRI('srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById#1.0.0')\n\n\u002F\u002F From scheme and resource name (which may carry a zone)\nconst cri2 = createCRI('srv', 'management-api~com.example.UserService')\n\n\u002F\u002F From scheme, scope, and resource name\nconst cri3 = createCRI('stream', 'tenant-123', 'app.acme-org.orders-app~orders')\n\n\u002F\u002F From all components\nconst cri4 = createCRI('srv', null, 'management-api~com.example.UserService', 'findById', '1.0.0')\n","typescript",[248,562,563,596,603,610,640,645,651,683,688,694,734,739,745],{"__ignoreMap":250},[564,565,568,572,5