# Interpolation values for the demonstration stack (compose.yml). `demonstration` applies the seed rows a
# demonstration signs in with, V2__kinotic_test_users.demonstration.test.e2e.sql, and `fixtures`
# applies V4__system_console.fixtures.sql: applications, projects, members and invites in the test-org
# organization, and worker nodes and workloads for the system console.
KINOTIC_MIGRATION_PROFILES=demonstration,fixtures
