# The cluster: the portal is served by the sites Worker at portal.kinotic.ai, the API by the management server at api.kinotic.ai
VITE_KINOTIC_PORT=443
VITE_KINOTIC_HOST=api.kinotic.ai
VITE_KINOTIC_USE_SSL=true

# The sign-up funnel's Google Analytics: the measurement ID of the portal's web data stream in the property the
# kinotic.ai website reports to, a stream with Enhanced Measurement off (ENV_SETUP.md). Empty records nothing.
VITE_GA_MEASUREMENT_ID=G-DE3DWNE73C
