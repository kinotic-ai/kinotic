{
  "name": "@kinotic-ai/frontend-common",
  "version": "5.0.0-beta.1",
  "type": "module",
  "description": "The shared UI of the Kinotic consoles: the PrimeVue theme preset, app bootstrap, session state and components.",
  "homepage": "https://github.com/kinotic-ai/kinotic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinotic-ai/kinotic.git",
    "directory": "kinotic-frontend/packages/common"
  },
  "license": "Elastic License 2.0",
  "files": [
    "dist"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./management": "./src/management.ts",
    "./src/styles/*": "./src/styles/*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./management": {
        "types": "./dist/management.d.ts",
        "default": "./dist/management.js"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build:lib": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@types/debug": "^4.1.13",
    "@vueuse/core": "^14.4.0",
    "debug": "^4.4.3"
  },
  "peerDependencies": {
    "@kinotic-ai/core": "catalog:",
    "@kinotic-ai/management-api": "catalog:",
    "@primeuix/themes": "^2.0.3",
    "echarts": "catalog:",
    "primevue": "^4.5.5",
    "vue": "^3.5.41",
    "vue-echarts": "catalog:",
    "vue-router": "^5.2.0"
  },
  "peerDependenciesMeta": {
    "@kinotic-ai/management-api": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "vue-echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kinotic-ai/core": "catalog:",
    "@kinotic-ai/management-api": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "^0.9.1",
    "echarts": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-echarts": "catalog:",
    "vue-tsc": "catalog:"
  }
}
