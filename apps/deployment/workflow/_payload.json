":235},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":237,"path":238,"stem":239,"icon":174},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":241,"path":242,"stem":243,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":245,"path":246,"stem":247,"icon":248},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":250,"path":251,"stem":252,"icon":253},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":255,"path":256,"stem":257,"icon":258},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":260,"title":132,"body":261,"description":390,"extension":391,"links":392,"meta":393,"navigation":394,"path":133,"seo":395,"stem":134,"__hash__":396},"docs\u002F03.apps\u002F07.deployment\u002F01.workflow.md",{"type":262,"value":263,"toc":378},"minimark",[264,268,272,279,283,286,308,312,315,320,323,337,341,344,358,362,365],[265,266,26],"h2",{"id":267},"overview",[269,270,271],"p",{},"Kinotic provides a built-in deployment pipeline that takes your application from development through staging to production. The pipeline is designed around feature-based development with isolated environments and security-first build processes.",[269,273,274,278],{},[275,276,277],"strong",{},"Pipeline stages:"," Development -> Staging -> Production",[265,280,282],{"id":281},"development","Development",[269,284,285],{},"The development stage is optimized for rapid iteration:",[287,288,289,296,302],"ul",{},[290,291,292,295],"li",{},[275,293,294],{},"Feature isolation"," — Each feature branch gets its own development pod, so developers can test changes without affecting others.",[290,297,298,301],{},[275,299,300],{},"Automatic deployment"," — Changes deploy as code is saved, providing immediate feedback during development.",[290,303,304,307],{},[275,305,306],{},"Firecracker VM isolation"," — Builds execute in isolated Firecracker VMs for both speed and security. Each build runs in its own lightweight VM, preventing untrusted code from affecting the host or other builds.",[265,309,311],{"id":310},"staging","Staging",[269,313,314],{},"The staging environment acts as a gate between development and production. It operates in two phases:",[316,317,319],"h3",{"id":318},"pre-merge-checks","Pre-Merge Checks",[269,321,322],{},"Before a feature branch is merged, the staging environment runs:",[287,324,325,331],{},[290,326,327,330],{},[275,328,329],{},"Vulnerability scanning"," — Automated security checks on dependencies and application code.",[290,332,333,336],{},[275,334,335],{},"Migration execution tests"," — Migration scripts are executed against a staging data store to verify they run correctly before reaching production.",[316,338,340],{"id":339},"post-merge","Post-Merge",[269,342,343],{},"After a feature branch is merged:",[287,345,346,352],{},[290,347,348,351],{},[275,349,350],{},"Full application build"," — The complete application is built and deployed to the staging environment.",[290,353,354,357],{},[275,355,356],{},"Human-in-the-loop approval"," — A team member reviews the staging deployment and explicitly approves promotion to production. No automatic promotion occurs.",[265,359,361],{"id":360},"production","Production",[269,363,364],{},"Production deployment happens only after staging approval:",[287,366,367,372],{},[290,368,369,371],{},[275,370,350],{}," — All projects within the application are built and deployed together.",[290,373,374,377],{},[275,375,376],{},"Deployed after approval"," — The production environment is updated only when a team member has reviewed and approved the staging deployment.",{"title":379,"searchDepth":380,"depth":380,"links":381},"",2,[382,383,384,389],{"id":267,"depth":380,"text":26},{"id":281,"depth":380,"text":282},{"id":310,"depth":380,"text":311,"children":385},[386,388],{"id":318,"depth":387,"text":319},3,{"id":339,"depth":387,"text":340},{"id":360,"depth":380,"text":361},"The Kinotic deployment pipeline from development to production.","md",null,{},{"icon":135},{"title":132,"description":390},"Oo9agCCoWh9xKL2Yg3Rra491_6CMN3r4P8R1H6N_zRU",[398,400],{"title":122,"path":123,"stem":124,"description":399,"icon":33,"children":-1},"Authentication methods and identity management in Kinotic.",{"title":137,"path":138,"stem":139,"description":401,"icon":140,"children":-1},"Development, staging, and production environment configuration.",1793087371560]