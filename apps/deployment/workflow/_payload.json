rk",[228,232,236,243,247,250,272,276,279,284,287,301,305,308,322,326,329],[229,230,25],"h2",{"id":231},"overview",[233,234,235],"p",{},"Kinotic provides a built-in deployment pipeline that takes your application from development through staging to production. The pipeline is designed around feature-based development with isolated environments and security-first build processes.",[233,237,238,242],{},[239,240,241],"strong",{},"Pipeline stages:"," Development -> Staging -> Production",[229,244,246],{"id":245},"development","Development",[233,248,249],{},"The development stage is optimized for rapid iteration:",[251,252,253,260,266],"ul",{},[254,255,256,259],"li",{},[239,257,258],{},"Feature isolation"," — Each feature branch gets its own development pod, so developers can test changes without affecting others.",[254,261,262,265],{},[239,263,264],{},"Automatic deployment"," — Changes deploy as code is saved, providing immediate feedback during development.",[254,267,268,271],{},[239,269,270],{},"Firecracker VM isolation"," — Builds execute in isolated Firecracker VMs for both speed and security. Each build runs in its own lightweight VM, preventing untrusted code from affecting the host or other builds.",[229,273,275],{"id":274},"staging","Staging",[233,277,278],{},"The staging environment acts as a gate between development and production. It operates in two phases:",[280,281,283],"h3",{"id":282},"pre-merge-checks","Pre-Merge Checks",[233,285,286],{},"Before a feature branch is merged, the staging environment runs:",[251,288,289,295],{},[254,290,291,294],{},[239,292,293],{},"Vulnerability scanning"," — Automated security checks on dependencies and application code.",[254,296,297,300],{},[239,298,299],{},"Migration execution tests"," — Migration scripts are executed against a staging data store to verify they run correctly before reaching production.",[280,302,304],{"id":303},"post-merge","Post-Merge",[233,306,307],{},"After a feature branch is merged:",[251,309,310,316],{},[254,311,312,315],{},[239,313,314],{},"Full application build"," — The complete application is built and deployed to the staging environment.",[254,317,318,321],{},[239,319,320],{},"Human-in-the-loop approval"," — A team member reviews the staging deployment and explicitly approves promotion to production. No automatic promotion occurs.",[229,323,325],{"id":324},"production","Production",[233,327,328],{},"Production deployment happens only after staging approval:",[251,330,331,336],{},[254,332,333,335],{},[239,334,314],{}," — All projects within the application are built and deployed together.",[254,337,338,341],{},[239,339,340],{},"Deployed after approval"," — The production environment is updated only when a team member has reviewed and approved the staging deployment.",{"title":343,"searchDepth":344,"depth":344,"links":345},"",2,[346,347,348,353],{"id":231,"depth":344,"text":25},{"id":245,"depth":344,"text":246},{"id":274,"depth":344,"text":275,"children":349},[350,352],{"id":282,"depth":351,"text":283},3,{"id":303,"depth":351,"text":304},{"id":324,"depth":344,"text":325},"The Kinotic deployment pipeline from development to production.","md",null,{},{"icon":112},{"title":109,"description":354},"QQdrGOGz3p1ztU4a8q4zERwPnIyoSBhyvWzo5owcojI",[362,364],{"title":98,"path":99,"stem":100,"description":363,"icon":101,"children":-1},"Authentication methods and identity management in Kinotic.",{"title":114,"path":115,"stem":116,"description":365,"icon":117,"children":-1},"Development, staging, and production environment configuration.",1789442558018]