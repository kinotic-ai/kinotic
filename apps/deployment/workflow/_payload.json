ools","i-lucide-bot",{"title":177,"path":178,"stem":179,"icon":180},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":182,"path":183,"stem":184,"icon":185},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":187,"path":188,"stem":189,"icon":190},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":124,"icon":125,"path":192,"stem":193,"children":194,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[195],{"title":196,"path":197,"stem":198,"icon":199},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"id":201,"title":109,"body":202,"description":331,"extension":332,"links":333,"meta":334,"navigation":335,"path":110,"seo":336,"stem":111,"__hash__":337},"docs\u002F01.apps\u002F07.deployment\u002F01.workflow.md",{"type":203,"value":204,"toc":319},"minimark",[205,209,213,220,224,227,249,253,256,261,264,278,282,285,299,303,306],[206,207,25],"h2",{"id":208},"overview",[210,211,212],"p",{},"Kinotic provides a built-in deployment pipeline that takes your application from development through staging to production. The pipeline is designed around feature-based development with isolated environments and security-first build processes.",[210,214,215,219],{},[216,217,218],"strong",{},"Pipeline stages:"," Development -> Staging -> Production",[206,221,223],{"id":222},"development","Development",[210,225,226],{},"The development stage is optimized for rapid iteration:",[228,229,230,237,243],"ul",{},[231,232,233,236],"li",{},[216,234,235],{},"Feature isolation"," — Each feature branch gets its own development pod, so developers can test changes without affecting others.",[231,238,239,242],{},[216,240,241],{},"Automatic deployment"," — Changes deploy as code is saved, providing immediate feedback during development.",[231,244,245,248],{},[216,246,247],{},"Firecracker VM isolation"," — Builds execute in isolated Firecracker VMs for both speed and security. Each build runs in its own lightweight VM, preventing untrusted code from affecting the host or other builds.",[206,250,252],{"id":251},"staging","Staging",[210,254,255],{},"The staging environment acts as a gate between development and production. It operates in two phases:",[257,258,260],"h3",{"id":259},"pre-merge-checks","Pre-Merge Checks",[210,262,263],{},"Before a feature branch is merged, the staging environment runs:",[228,265,266,272],{},[231,267,268,271],{},[216,269,270],{},"Vulnerability scanning"," — Automated security checks on dependencies and application code.",[231,273,274,277],{},[216,275,276],{},"Migration execution tests"," — Migration scripts are executed against a staging data store to verify they run correctly before reaching production.",[257,279,281],{"id":280},"post-merge","Post-Merge",[210,283,284],{},"After a feature branch is merged:",[228,286,287,293],{},[231,288,289,292],{},[216,290,291],{},"Full application build"," — The complete application is built and deployed to the staging environment.",[231,294,295,298],{},[216,296,297],{},"Human-in-the-loop approval"," — A team member reviews the staging deployment and explicitly approves promotion to production. No automatic promotion occurs.",[206,300,302],{"id":301},"production","Production",[210,304,305],{},"Production deployment happens only after staging approval:",[228,307,308,313],{},[231,309,310,312],{},[216,311,291],{}," — All projects within the application are built and deployed together.",[231,314,315,318],{},[216,316,317],{},"Deployed after approval"," — The production environment is updated only when a team member has reviewed and approved the staging deployment.",{"title":320,"searchDepth":321,"depth":321,"links":322},"",2,[323,324,325,330],{"id":208,"depth":321,"text":25},{"id":222,"depth":321,"text":223},{"id":251,"depth":321,"text":252,"children":326},[327,329],{"id":259,"depth":328,"text":260},3,{"id":280,"depth":328,"text":281},{"id":301,"depth":321,"text":302},"The Kinotic deployment pipeline from development to production.","md",null,{},{"icon":112},{"title":109,"description":331},"QQdrGOGz3p1ztU4a8q4zERwPnIyoSBhyvWzo5owcojI",[339,341],{"title":98,"path":99,"stem":100,"description":340,"icon":101,"children":-1},"Authentication methods and identity management in Kinotic.",{"title":114,"path":115,"stem":116,"description":342,"icon":117,"children":-1},"Development, staging, and production environment configuration.",1787819965141]