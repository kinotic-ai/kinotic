"icon":235},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":237,"path":238,"stem":239,"icon":240},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":242,"path":243,"stem":244,"icon":179},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":246,"path":247,"stem":248,"icon":38},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":250,"path":251,"stem":252,"icon":253},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":255,"path":256,"stem":257,"icon":258},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":260,"path":261,"stem":262,"icon":263},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":265,"title":137,"body":266,"description":395,"extension":396,"links":397,"meta":398,"navigation":399,"path":138,"seo":400,"stem":139,"__hash__":401},"docs\u002F03.apps\u002F07.deployment\u002F01.workflow.md",{"type":267,"value":268,"toc":383},"minimark",[269,273,277,284,288,291,313,317,320,325,328,342,346,349,363,367,370],[270,271,31],"h2",{"id":272},"overview",[274,275,276],"p",{},"Kinotic provides a built-in deployment pipeline that takes your application from development through staging to production. The pipeline is designed around feature-based development with isolated environments and security-first build processes.",[274,278,279,283],{},[280,281,282],"strong",{},"Pipeline stages:"," Development -> Staging -> Production",[270,285,287],{"id":286},"development","Development",[274,289,290],{},"The development stage is optimized for rapid iteration:",[292,293,294,301,307],"ul",{},[295,296,297,300],"li",{},[280,298,299],{},"Feature isolation"," — Each feature branch gets its own development pod, so developers can test changes without affecting others.",[295,302,303,306],{},[280,304,305],{},"Automatic deployment"," — Changes deploy as code is saved, providing immediate feedback during development.",[295,308,309,312],{},[280,310,311],{},"Firecracker VM isolation"," — Builds execute in isolated Firecracker VMs for both speed and security. Each build runs in its own lightweight VM, preventing untrusted code from affecting the host or other builds.",[270,314,316],{"id":315},"staging","Staging",[274,318,319],{},"The staging environment acts as a gate between development and production. It operates in two phases:",[321,322,324],"h3",{"id":323},"pre-merge-checks","Pre-Merge Checks",[274,326,327],{},"Before a feature branch is merged, the staging environment runs:",[292,329,330,336],{},[295,331,332,335],{},[280,333,334],{},"Vulnerability scanning"," — Automated security checks on dependencies and application code.",[295,337,338,341],{},[280,339,340],{},"Migration execution tests"," — Migration scripts are executed against a staging data store to verify they run correctly before reaching production.",[321,343,345],{"id":344},"post-merge","Post-Merge",[274,347,348],{},"After a feature branch is merged:",[292,350,351,357],{},[295,352,353,356],{},[280,354,355],{},"Full application build"," — The complete application is built and deployed to the staging environment.",[295,358,359,362],{},[280,360,361],{},"Human-in-the-loop approval"," — A team member reviews the staging deployment and explicitly approves promotion to production. No automatic promotion occurs.",[270,364,366],{"id":365},"production","Production",[274,368,369],{},"Production deployment happens only after staging approval:",[292,371,372,377],{},[295,373,374,376],{},[280,375,355],{}," — All projects within the application are built and deployed together.",[295,378,379,382],{},[280,380,381],{},"Deployed after approval"," — The production environment is updated only when a team member has reviewed and approved the staging deployment.",{"title":384,"searchDepth":385,"depth":385,"links":386},"",2,[387,388,389,394],{"id":272,"depth":385,"text":31},{"id":286,"depth":385,"text":287},{"id":315,"depth":385,"text":316,"children":390},[391,393],{"id":323,"depth":392,"text":324},3,{"id":344,"depth":392,"text":345},{"id":365,"depth":385,"text":366},"The Kinotic deployment pipeline from development to production.","md",null,{},{"icon":140},{"title":137,"description":395},"Oo9agCCoWh9xKL2Yg3Rra491_6CMN3r4P8R1H6N_zRU",[403,405],{"title":127,"path":128,"stem":129,"description":404,"icon":38,"children":-1},"Authentication methods and identity management in Kinotic.",{"title":142,"path":143,"stem":144,"description":406,"icon":145,"children":-1},"Development, staging, and production environment configuration.",1792998375718]