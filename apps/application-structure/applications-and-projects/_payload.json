],{"class":378},"      repositoryPath",[309,452,363],{"class":322},[309,454,384],{"class":322},[309,456,457],{"class":339},"packages\u002Fdomain\u002Frepositories",[309,459,390],{"class":322},[309,461,393],{"class":322},[309,463,465,468,470],{"class":311,"line":464},10,[309,466,467],{"class":378},"      mirrorFolderStructure",[309,469,363],{"class":322},[309,471,473],{"class":472},"sfNiH"," true\n",[309,475,477],{"class":311,"line":476},11,[309,478,479],{"class":322},"    }\n",[309,481,483,486],{"class":311,"line":482},12,[309,484,485],{"class":326},"  ]",[309,487,393],{"class":322},[309,489,491,494,496,498,501,503],{"class":311,"line":490},13,[309,492,493],{"class":378},"  fileExtensionForImports",[309,495,363],{"class":322},[309,497,384],{"class":322},[309,499,500],{"class":339},".js",[309,502,390],{"class":322},[309,504,393],{"class":322},[309,506,508,511,513],{"class":311,"line":507},14,[309,509,510],{"class":378},"  validate",[309,512,363],{"class":322},[309,514,515],{"class":472}," false\n",[309,517,519],{"class":311,"line":518},15,[309,520,521],{"class":322},"}\n",[309,523,525],{"class":311,"line":524},16,[309,526,350],{"emptyLinePlaceholder":349},[309,528,530,533,536],{"class":311,"line":529},17,[309,531,532],{"class":315},"export",[309,534,535],{"class":315}," default",[309,537,538],{"class":326}," config\n",[215,540,541,542,545,546,549,550,552,553,556],{},"The CLI reads the first ",[238,543,544],{},"kinotic.config.*"," file it finds in ",[238,547,548],{},".config",", so a ",[238,551,500],{}," or ",[238,554,555],{},".json"," config\nis loaded the same way.",[558,559,561],"h4",{"id":560},"fields","Fields",[563,564,565,577],"table",{},[566,567,568],"thead",{},[569,570,571,575],"tr",{},[572,573,574],"th",{},"Field",[572,576,261],{},[578,579,580,594,606,622,636,671,686,698],"tbody",{},[569,581,582,588],{},[583,584,585],"td",{},[238,586,587],{},"organizationId",[583,589,590,593],{},[233,591,592],{},"Required."," The id of the Kinotic organization this project belongs to.",[569,595,596,601],{},[583,597,598],{},[238,599,600],{},"applicationId",[583,602,603,605],{},[233,604,592],{}," The application id this project belongs to. Must match the application id registered with Kinotic OS: lowercase letters, digits, and interior dashes.",[569,607,608,613],{},[583,609,610],{},[238,611,612],{},"name",[583,614,615,616,618,619,621],{},"Optional project name. When omitted, the ",[238,617,612],{}," from the project's ",[238,620,275],{}," is used.",[569,623,624,629],{},[583,625,626],{},[238,627,628],{},"description",[583,630,631,632,618,634,621],{},"Optional project description. When omitted, the ",[238,633,628],{},[238,635,275],{},[569,637,638,643],{},[583,639,640],{},[238,641,642],{},"entitiesPaths",[583,644,645,647,648,651,652,655,656,659,660,663,664,667,668,256],{},[233,646,592],{}," An array whose entries are either a plain path string or an ",[238,649,650],{},"EntitiesPathConfig"," object with ",[238,653,654],{},"path"," (the directory containing entity definitions), ",[238,657,658],{},"repositoryPath"," (where the CLI writes generated repository classes), and ",[238,661,662],{},"mirrorFolderStructure"," (whether to replicate the entity directory structure in the output, default ",[238,665,666],{},"true","). The CLI scans these paths when you run ",[238,669,670],{},"kinotic sync",[569,672,673,678],{},[583,674,675],{},[238,676,677],{},"generatedPath",[583,679,680,681,683,684,256],{},"The default output path for generated files, used for ",[238,682,642],{}," entries that are plain strings. Ignored for entries that use ",[238,685,650],{},[569,687,688,693],{},[583,689,690],{},[238,691,692],{},"fileExtensionForImports",[583,694,695,696,256],{},"The extension the CLI writes on import paths in generated code. Defaults to ",[238,697,500],{},[569,699,700,705],{},[583,701,702],{},[238,703,704],{},"validate",[583,706,707],{},"When true, generated repository classes validate data before sending it to the server.",[282,709,711],{"id":710},"project-dependencies","Project Dependencies",[215,713,714,715,717],{},"Projects within the same application can depend on each other. For example, a microservice project might import entity types defined in a persistence project. These dependencies are managed through standard ",[238,716,275],{}," -- you add the dependency just like any other Bun package.",[300,719,723],{"className":720,"code":721,"language":722,"meta":305,"style":305},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n    \"dependencies\": {\n        \"@my-org\u002Fdata\": \"workspace:*\"\n    }\n}\n","json",[238,724,725,730,744,764,768],{"__ignoreMap":305},[309,726,727],{"class":311,"line":312},[309,728,729],{"class":322},"{\n",[309,731,732,735,738,740,742],{"class":311,"line":346},[309,733,734],{"class":322},"    \"",[309,736,737],{"class":356},"dependencies",[309,739,390],{"class":322},[309,741,363],{"class":322},[309,743,372],{"class":322},[309,745,746,749,752,754,756,758,761],{"class":311,"line":353},[309,747,748],{"class":322},"        \"",[309,750,751],{"class":366},"@my-org\u002Fdata",[309,753,390],{"class":322},[309,755,363],{"class":322},[309,757,384],{"class":322},[309,759,760],{"class":339},"workspace:*",[309,762,763],{"class":322},"\"\n",[309,765,766],{"class":311,"line":375},[309,767,479],{"class":322},[309,769,770],{"class":311,"line":396},[309,771,521],{"class":322},[215,773,774],{},"When the application is deployed, the platform resolves these internal dependencies and ensures all projects are available to each other through the Service Directory.",[219,776,778],{"id":777},"typical-setup","Typical Setup",[215,780,781,782,785,786,789,790,793,794,796],{},"Most applications start with a single project created through Kinotic OS, which provisions a GitHub repository scaffolded as a Bun workspace mono repo: ",[238,783,784],{},"packages\u002Fdomain"," (entity model and generated repositories), ",[238,787,788],{},"packages\u002Fmicroservices",", ",[238,791,792],{},"packages\u002Fui",", and a ",[238,795,279],{}," wired to the owning organization and application. Clone the provisioned repository and start building.",[215,798,799,800,802],{},"As the application grows, you can add additional projects for microservices, batch jobs, or frontends -- each with its own ",[238,801,279],{}," pointing to the same application identifier.",[804,805,806],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font