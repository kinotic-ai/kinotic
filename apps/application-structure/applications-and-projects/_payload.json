":543},15,[328,545,546],{"class":397},"  validate",[328,548,382],{"class":341},[328,550,551],{"class":508}," false\n",[328,553,555],{"class":330,"line":554},16,[328,556,557],{"class":341},"}\n",[328,559,561],{"class":330,"line":560},17,[328,562,369],{"emptyLinePlaceholder":368},[328,564,566,569,572],{"class":330,"line":565},18,[328,567,568],{"class":334},"export",[328,570,571],{"class":334}," default",[328,573,574],{"class":345}," config\n",[234,576,577,578,581,582,585,586,588,589,592],{},"The CLI reads the first ",[257,579,580],{},"kinotic.config.*"," file it finds in ",[257,583,584],{},".config",", so a ",[257,587,536],{}," or ",[257,590,591],{},".json"," config\nis loaded the same way.",[594,595,597],"h4",{"id":596},"fields","Fields",[599,600,601,613],"table",{},[602,603,604],"thead",{},[605,606,607,611],"tr",{},[608,609,610],"th",{},"Field",[608,612,280],{},[614,615,616,630,642,658,674,688,722,737,749],"tbody",{},[605,617,618,624],{},[619,620,621],"td",{},[257,622,623],{},"organizationId",[619,625,626,629],{},[252,627,628],{},"Required."," The id of the Kinotic organization this project belongs to.",[605,631,632,637],{},[619,633,634],{},[257,635,636],{},"applicationId",[619,638,639,641],{},[252,640,628],{}," The application id this project belongs to. Must match the application id registered with Kinotic OS: lowercase letters, digits, and interior dashes.",[605,643,644,649],{},[619,645,646],{},[257,647,648],{},"projectId",[619,650,651,653,654,657],{},[252,652,628],{}," The id of this project in Kinotic OS. Provisioned repositories carry the id of the project that created them; ",[257,655,656],{},"kinotic sync"," addresses this project and fails when it does not exist.",[605,659,660,665],{},[619,661,662],{},[257,663,664],{},"name",[619,666,667,668,670,671,673],{},"Optional project name. When omitted, the ",[257,669,664],{}," from the project's ",[257,672,294],{}," is used.",[605,675,676,681],{},[619,677,678],{},[257,679,680],{},"description",[619,682,683,684,670,686,673],{},"Optional project description. When omitted, the ",[257,685,680],{},[257,687,294],{},[605,689,690,695],{},[619,691,692],{},[257,693,694],{},"entitiesPaths",[619,696,697,699,700,703,704,707,708,711,712,715,716,719,720,275],{},[252,698,628],{}," An array whose entries are either a plain path string or an ",[257,701,702],{},"EntitiesPathConfig"," object with ",[257,705,706],{},"path"," (the directory containing entity definitions), ",[257,709,710],{},"repositoryPath"," (where the CLI writes generated repository classes), and ",[257,713,714],{},"mirrorFolderStructure"," (whether to replicate the entity directory structure in the output, default ",[257,717,718],{},"true","). The CLI scans these paths when you run ",[257,721,656],{},[605,723,724,729],{},[619,725,726],{},[257,727,728],{},"generatedPath",[619,730,731,732,734,735,275],{},"The default output path for generated files, used for ",[257,733,694],{}," entries that are plain strings. Ignored for entries that use ",[257,736,702],{},[605,738,739,744],{},[619,740,741],{},[257,742,743],{},"fileExtensionForImports",[619,745,746,747,275],{},"The extension the CLI writes on import paths in generated code. Defaults to ",[257,748,536],{},[605,750,751,756],{},[619,752,753],{},[257,754,755],{},"validate",[619,757,758],{},"When true, generated repository classes validate data before sending it to the server.",[301,760,762],{"id":761},"project-dependencies","Project Dependencies",[234,764,765,766,768],{},"Projects within the same application can depend on each other. For example, a microservice project might import entity types defined in a persistence project. These dependencies are managed through standard ",[257,767,294],{}," -- you add the dependency just like any other Bun package.",[319,770,774],{"className":771,"code":772,"language":773,"meta":324,"style":324},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n    \"dependencies\": {\n        \"@my-org\u002Fdata\": \"workspace:*\"\n    }\n}\n","json",[257,775,776,781,795,815,819],{"__ignoreMap":324},[328,777,778],{"class":330,"line":331},[328,779,780],{"class":341},"{\n",[328,782,783,786,789,791,793],{"class":330,"line":365},[328,784,785],{"class":341},"    \"",[328,787,788],{"class":375},"dependencies",[328,790,409],{"class":341},[328,792,382],{"class":341},[328,794,391],{"class":341},[328,796,797,800,803,805,807,809,812],{"class":330,"line":372},[328,798,799],{"class":341},"        \"",[328,801,802],{"class":385},"@my-org\u002Fdata",[328,804,409],{"class":341},[328,806,382],{"class":341},[328,808,403],{"class":341},[328,810,811],{"class":358},"workspace:*",[328,813,814],{"class":341},"\"\n",[328,816,817],{"class":330,"line":394},[328,818,515],{"class":341},[328,820,821],{"class":330,"line":415},[328,822,557],{"class":341},[234,824,825],{},"When the application is deployed, the platform resolves these internal dependencies and ensures all projects are available to each other through the Service Directory.",[238,827,829],{"id":828},"deployable-packages","Deployable packages",[234,831,832,833,835],{},"When a push deploys a project (see ",[272,834,119],{"href":120},"), the\nplatform finds the packages it deploys by where they sit in the workspace:",[246,837,838,859],{},[249,839,840,843,844,847,848,850,851,854,855,858],{},[252,841,842],{},"Microservices"," live directly under ",[257,845,846],{},"packages\u002Fmicroservices",", one package each. A\nmicroservice runs in a VM of its own from its ",[257,849,294],{}," ",[257,852,853],{},"main",", or ",[257,856,857],{},"src\u002Fmain.ts"," when\nit declares none.",[249,860,861,843,864,867,868,871,872,875,876,878,879,881],{},[252,862,863],{},"UIs",[257,865,866],{},"packages\u002Fui",", one package each, and declare a ",[257,869,870],{},"build"," script\nthat writes ",[257,873,874],{},"dist\u002Findex.html",". A package under ",[257,877,866],{}," without a ",[257,880,870],{}," script is a\nlibrary and is left alone.",[234,883,884,885,850,887,889,890,893,894,897],{},"A package's identity is the unscoped part of its ",[257,886,294],{},[257,888,664],{}," (",[257,891,892],{},"@acme\u002Fadmin"," is\n",[257,895,896],{},"admin","), which must be lowercase letters, digits, and interior dashes and unique among the\npackages of its kind. The directory name never matters.",[301,899,901],{"id":900},"the-ui-build-contract","The UI build contract",[234,903,904,905,908,909,912],{},"Every UI is built during the deployment with ",[257,906,907],{},"bun run build",", and the build is handed the\nplatform's address as three variables. Vite exposes ",[257,910,911],{},"VITE_*"," variables to the page on its\nown, so a Vite project reads them with no configuration; a UI with another build tool must\npass them through itself:",[599,914,915,928],{},[602,916,917],{},[605,918,919,922,925],{},[608,920,921],{},"Variable",[608,923,924],{},"Value",[608,926,927],{},"What the UI does with it",[614,929,930,946,961],{},[605,931,932,937,943],{},[619,933,934],{},[257,935,936],{},"VITE_KINOTIC_HOST",[619,938,939,940],{},"e.g. ",[257,941,942],{},"api.kinotic.ai",[619,944,945],{},"The host the UI connects to Kinotic on from a browser",[605,947,948,953,958],{},[619,949,950],{},[257,951,952],{},"VITE_KINOTIC_PORT",[619,954,939,955],{},[257,956,957],{},"443",[619,959,960],{},"Its port",[605,962,963,968,975],{},[619,964,965],{},[257,966,967],{},"VITE_KINOTIC_USE_SSL",[619,969,970,588,972],{},[257,971,718],{},[257,973,974],{},"false",[619,976,977],{},"Whether to connect over TLS",[319,979,981],{"className":321,"code":980,"language":323,"meta":324,"style":324},"await Kinotic.connect({\n    server: {\n        host: import.meta.env.VITE_KINOTIC_HOST,\n        port: parseInt(import.meta.env.VITE_KINOTIC_PORT),\n        useSSL: import.meta.env.VITE_KINOTIC_USE_SSL === 'true',\n    },\n})\n",[257,982,983,1002,1011,1037,1066,1100,1105],{"__ignoreMap":324},[328,984,985,988,991,993,997,1000],{"class":330,"line":331},[328,986,987],{"class":334},"await",[328,989,990],{"class":345}," Kinotic",[328,992,275],{"class":341},[328,994,996],{"class":995},"s2Zo4","connect",[328,998,999],{"class":345},"(",[328,1001,780],{"class":341},[328,1003,1004,1007,1009],{"class":330,"line":365},[328,1005,1006],{"class":397},"    server",[328,1008,382],{"class":341},[328,1010,391],{"class":341},[328,1012,1013,1016,1018,1021,1023,1026,1028,1031,1033,1035],{"class":330,"line":372},[328,1014,1015],{"class":397},"        host",[328,1017,382],{"class":341},[328,1019,1020],{"class":334}," import",[328,1022,275],{"class":341},[328,1024,1025],{"class":345},"meta",[328,1027,275],{"class":341},[328,1029,1030],{"class":345},"env",[328,1032,275],{"class":341},[328,1034,936],{"class":345},[328,1036,412],{"class":341},[328,1038,1039,1042,1044,1047,1049,1051,1053,1055,1057,1059,1061,1064],{"class":330,"line":394},[328,1040,1041],{"class":397},"        port",[328,1043,382],{"class":341},[328,1045,1046],{"class":995}," parseInt",[328,1048,999],{"class":345},[328,1050,335],{"class":334},[328,1052,275],{"class":341},[328,1054,1025],{"class":345},[328,1056,275],{"class":341},[328,1058,1030],{"class":345},[328,1060,275],{"class":341},[328,1062,1063],{"class":345},"VITE_KINOTIC_PORT)",[328,1065,412],{"class":341},[328,1067,1068,1071,1073,1075,1077,1079,1081,1083,1085,1088,1091,1093,1095,1098],{"class":330,"line":415},[328,1069,1070],{"class":397},"        useSSL",[328,1072,382],{"class":341},[328,1074,1020],{"class":334},[328,1076,275],{"class":341},[328,1078,1025],{"class":345},[328,1080,275],{"class":341},[328,1082,1030],{"class":345},[328,1084,275],{"class":341},[328,1086,1087],{"class":345},"VITE_KINOTIC_USE_SSL ",[328,1089,1090],{"class":341},"===",[328,1092,355],{"class":341},[328,1094,718],{"class":358},[328,1096,1097],{"class":341},"'",[328,1099,412],{"class":341},[328,1101,1102],{"class":330,"line":432},[328,1103,1104],{"class":341},"    },\n",[328,1106,1107,1110],{"class":330,"line":449},[328,1108,1109],{"class":341},"}",[328,1111,1112],{"class":345},")\n",[234,1114,1115,1116,1118],{},"A build that does not write ",[257,1117,874],{}," fails the deployment naming the UI.",[234,1120,1121,1124,1125,1128,1129,1132,1133,1136,1137,1140],{},[257,1122,1123],{},"dist"," is published as it is, from the site's root: files under ",[257,1126,1127],{},"assets\u002F"," carry a content\nhash in their name and are cached for a year, everything else is never cached. Each site\nalso publishes the commit it serves as ",[257,1130,1131],{},"version.json"," next to its ",[257,1134,1135],{},"index.html",", never\ncached, as ",[257,1138,1139],{},"{ \"commitSha\": \"\u003Ccommit>\" }",". A publish replaces the previous commit's files;\na tab left open on the previous commit loads the new commit when it next reloads.",[238,1142,1144],{"id":1143},"typical-setup","Typical Setup",[234,1146,1147,1148,1151,1152,1154,1155,1157,1158,1160],{},"Most applications start with a single project created through Kinotic OS, which provisions a GitHub repository scaffolded as a Bun workspace mono repo: ",[257,1149,1150],{},"packages\u002Fdomain"," (entity model and generated repositories), ",[257,1153,846],{},", ",[257,1156,866],{},", and a ",[257,1159,298],{}," wired to the owning organization and application. Clone the provisioned repository and start building.",[234,1162,1163,1164,1166],{},"As the application grows, you can add additional projects for microservices, batch jobs, or frontends -- each with its own ",[257,1165,298],{}," pointing to the same application identifier.",[1168,1169,1170],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark: