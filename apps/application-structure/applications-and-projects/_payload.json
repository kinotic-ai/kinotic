"title":29,"body":230,"description":1183,"extension":1184,"links":1185,"meta":1186,"navigation":368,"path":30,"seo":1187,"stem":31,"__hash__":1188},"docs\u002F01.apps\u002F03.application-structure\u002F02.applications-and-projects.md",{"type":231,"value":232,"toc":1171},"minimark",[233,237,242,245,282,285,289,300,308,318,575,593,598,759,763,769,823,826,830,836,882,898,902,913,978,1113,1119,1141,1145,1161,1167],[234,235,236],"p",{},"An application is the deployable unit in Kinotic. Projects are the building blocks that make up an application. This page explains how to configure both.",[238,239,241],"h2",{"id":240},"applications","Applications",[234,243,244],{},"Every application has:",[246,247,248,261,276],"ul",{},[249,250,251,255,256,260],"li",{},[252,253,254],"strong",{},"Name"," -- A human-readable name (e.g., ",[257,258,259],"code",{},"Inventory App",").",[249,262,263,266,267,270,271,275],{},[252,264,265],{},"Id"," -- Derived from the name at creation: the slugified name, made of lowercase letters, digits, and interior dashes (e.g., ",[257,268,269],{},"inventory-app","). The id forms the final label of the application's ",[272,273,274],"a",{"href":206},"zone",".",[249,277,278,281],{},[252,279,280],{},"Description"," -- A human-readable summary of what the application does.",[234,283,284],{},"Applications are created and managed through the Kinotic CLI and the Kinotic OS dashboard.",[238,286,288],{"id":287},"projects","Projects",[234,290,291,292,295,296,299],{},"A project is a directory with its own ",[257,293,294],{},"package.json"," and a ",[257,297,298],{},".config\u002Fkinotic.config.ts"," configuration file. The CLI uses that config to understand how the project fits into the broader application.",[301,302,304,305,307],"h3",{"id":303},"the-configkinoticconfigts-file","The ",[257,306,298],{}," File",[234,309,310,311,313,314,317],{},"Every project carries a ",[257,312,298],{},", created when Kinotic OS provisions\nthe project repository. It is a TypeScript module exporting a ",[257,315,316],{},"KinoticProjectConfig",", so\nyour editor type-checks it:",[319,320,325],"pre",{"className":321,"code":322,"language":323,"meta":324,"style":324},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import type { KinoticProjectConfig } from '@kinotic-ai\u002Fmanagement-api'\n\nconst config: KinoticProjectConfig = {\n  organizationId: \"my-org\",\n  applicationId: \"my-app\",\n  projectId: \"my-app-main\",\n  entitiesPaths: [\n    {\n      path: \"packages\u002Fdomain\u002Fmodel\",\n      repositoryPath: \"packages\u002Fdomain\u002Frepositories\",\n      mirrorFolderStructure: true\n    }\n  ],\n  fileExtensionForImports: \".js\",\n  validate: false\n}\n\nexport default config\n","ts","",[257,326,327,363,370,392,413,430,447,458,464,481,498,510,516,524,541,552,558,563],{"__ignoreMap":324},[328,329,332,336,339,343,347,350,353,356,360],"span",{"class":330,"line":331},"line",1,[328,333,335],{"class":334},"s7zQu","import",[328,337,338],{"class":334}," type",[328,340,342],{"class":341},"sMK4o"," {",[328,344,346],{"class":345},"sTEyZ"," KinoticProjectConfig",[328,348,349],{"class":341}," }",[328,351,352],{"class":334}," from",[328,354,355],{"class":341}," '",[328,357,359],{"class":358},"sfazB","@kinotic-ai\u002Fmanagement-api",[328,361,362],{"class":341},"'\n",[328,364,366],{"class":330,"line":365},2,[328,367,369],{"emptyLinePlaceholder":368},true,"\n",[328,371,373,377,380,383,386,389],{"class":330,"line":372},3,[328,374,376],{"class":375},"spNyl","const",[328,378,379],{"class":345}," config",[328,381,382],{"class":341},":",[328,384,346],{"class":385},"sBMFI",[328,387,388],{"class":341}," =",[328,390,391],{"class":341}," {\n",[328,393,395,399,401,404,407,410],{"class":330,"line":394},4,[328,396,398],{"class":397},"swJcz","  organizationId",[328,400,382],{"class":341},[328,402,403],{"class":341}," \"",[328,405,406],{"class":358},"my-org",[328,408,409],{"class":341},"\"",[328,411,412],{"class":341},