is page explains how to configure both.",[223,224,226],"h2",{"id":225},"applications","Applications",[219,228,229],{},"Every application has:",[231,232,233,246,261],"ul",{},[234,235,236,240,241,245],"li",{},[237,238,239],"strong",{},"Name"," -- A human-readable name (e.g., ",[242,243,244],"code",{},"Inventory App",").",[234,247,248,251,252,255,256,260],{},[237,249,250],{},"Id"," -- Derived from the name at creation: the slugified name, made of lowercase letters, digits, and interior dashes (e.g., ",[242,253,254],{},"inventory-app","). The id forms the final label of the application's ",[257,258,259],"a",{"href":201},"zone",".",[234,262,263,266],{},[237,264,265],{},"Description"," -- A human-readable summary of what the application does.",[219,268,269],{},"Applications are created and managed through the Kinotic CLI and the Kinotic OS dashboard.",[223,271,273],{"id":272},"projects","Projects",[219,275,276,277,280,281,284],{},"A project is a directory with its own ",[242,278,279],{},"package.json"," and a ",[242,282,283],{},".config\u002Fkinotic.config.ts"," configuration file. The CLI uses that config to understand how the project fits into the broader application.",[286,287,289,290,292],"h3",{"id":288},"the-configkinoticconfigts-file","The ",[242,291,283],{}," File",[219,294,295,296,298,299,302],{},"Every project carries a ",[242,297,283],{},", created when Kinotic OS provisions\nthe project repository. It is a TypeScript module exporting a ",[242,300,301],{},"KinoticProjectConfig",", so\nyour editor type-checks it:",[304,305,310],"pre",{"className":306,"code":307,"language":308,"meta":309,"style":309},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import type { KinoticProjectConfig } from '@kinotic-ai\u002Fmanagement-api'\n\nconst config: KinoticProjectConfig = {\n  organizationId: \"my-org\",\n  applicationId: \"my-app\",\n  projectId: \"my-app-main\",\n  entitiesPaths: [\n    {\n      path: \"packages\u002Fdomain\u002Fmodel\",\n      repositoryPath: \"packages\u002Fdomain\u002Frepositories\",\n      mirrorFolderStructure: true\n    }\n  ],\n  fileExtensionForImports: \".js\",\n  validate: false\n}\n\nexport default config\n","ts","",[242,311,312,348,355,377,398,415,432,443,449,466,483,495,501,509,526,537,543,548],{"__ignoreMap":309},[313,314,317,321,324,328,332,335,338,341,345],"span",{"class":315,"line":316},"line",1,[313,318,320],{"class":319},"s7zQu","import",[313,322,323],{"class":319}," type",[313,325,327],{"class":326},"sMK4o"," {",[313,329,331],{"class":330},"sTEyZ"," KinoticProjectConfig",[313,333,334],{"class":326}," }",[313,336,337],{"class":319}," from",[313,339,340],{"class":326}," '",[313,342,344],{"class":343},"sfazB","@kinotic-ai\u002Fmanagement-api",[313,346,347],{"class":326},"'\n",[313,349,351],{"class":315,"line":350},2,[313,352,354],{"emptyLinePlaceholder":353},true,"\n",[313,356,358,362,365,368,371,374],{"class":315,"line":357},3,[313,359,361],{"class":360},"spNyl","const",[313,363,364],{"class":330}," config",[313,366,367],{"class":326},":",[313,369,331],{"class":370},"sBMFI",[313,372,373],{"class":326}," =",[313,375,376],{"class":326}," {\n",[313,378,380,384,386,389,392,395],{"class":315,"line":379},4,[313,381,383],{"class":382},"swJcz","  organizationId",[313,385,367],{"class":326},[313,387,388],{"class":326}," \"",[313,390,391],{"class":343},"my-org",[313,393,394],{"class":326},"\"",[313,396,397],{"class":326},",\n",[313,399,401,404,406,408,411,413],{"class":315,"line":400},5,[313,402,403],{"class":382},"  applicationId",[313,405,367],{"class":326},[313,407,388],{"class":326},[313,409,410],{"class":343},"my-app",[313,412,394],{"class":326},[313,414,397],{"class":326},[313,416,418,421,423,425,428,430],{"class":315,"line":417},6,[313,419,420],{"class":382},"  projectId",[313,422,367],{"class":326},[313,424,388],{"class":326},[313,426,427],{"class":343},"my-app-main",[313,429,394],{"class":326},[313,431,397],{"class":326},[313,433,435,438,440],{"class":315,"line":434},7,[313,436,437],{"class":382},"  entitiesPaths",[313,439,367],{"class":326},[313,441,442],{"class":330}," [\n",[313,444,446],{"class":315,"line":445},8,[313,447,448],{"class":326},"    {\n",[313,450,452,455,457,459,462,464],{"class":315,"line":451},9,[313,453,454],{"class":382},"      path",[313,456,367],{"class":326},[313,458,388],{"class":326},[313,460,461],{"class":343},"packages\u002Fdomain\u002Fmodel",[313,463,394],{"class":326},[313,465,397],{"class":326},[313,467,469,472,474,476,479,481],{"class":315,"line":468},10,[313,470,471],{"class":382},"      repositoryPath",[313,473,367],{"class":326},[313,475,388],{"class":326},[313,477,478],{"class":343},"packages\u002Fdomain\u002Frepositories",[313,480,394],{"class":326},[313,482,397],{"class":326},[313,484,486,489,491],{"class":315,"line":485},11,[313,487,488],{"class":382},"      mirrorFolderStructure",[313,490,367],{"class":326},[313,492,494],{"class":493},"sfNiH"," true\n",[313,496,498],{"class":315,"line":497},12,[313,499,500],{"class":326},"    }\n",[313,502,504,507],{"class":315,"line":503},13,[313,505,506],{"class":330},"  ]",[313,508,397],{"class":326},[313,510,512,515,517,519,522,524],{"class":315,"line":511},14,[313,513,514],{"class":382},"  fileExtensionForImports",[313,516,367],{"class":326},[313,518,388],{"class":326},[313,520,521],{"class":343},".js",[313,523,394],{"class":326},[313,525,397],{"class":326},[313,527,529,532,534],{"class":315,"line":528},15,[313,530,531],{"class":382},"  validate",[313,533,367],{"class":326},[313,535,536],{"class":493}," false\n",[313,538,540],{"class":315,"line":539},16,[313,541,542],{"class":326},"}\n",[313,544,546],{"class":315,"line":545},17,[313,547,354],{"emptyLinePlaceholder":353},[313,549,551,554,557],{"class":315,"line":550},18,[313,552,553],{"class":319},"export",[313,555,556],{"class":319}," default",[313,558,559],{"class":330}," config\n",[219,561,562,563,566,567,570,571,573,574,577],{},"The CLI reads the first ",[242,564,565],{},"kinotic.config.*"," file it finds in ",[242,568,569],{},".config",", so a ",[242,572,521],{}," or ",[242,575,576],{},".json"," config\nis loaded the same way.",[579,580,582],"h4",{"id":581},"fields","Fields",[584,585,586,598],"table",{},[587,588,589],"thead",{},[590,591,592,596],"tr",{},[593,594,595],"th",{},"Field",[593,597,265],{},[599,600,601,615,627,643,659,673,707,722,734],"tbody",{},[590,602,603,609],{},[604,605,606],"td",{},[242,607,608],{},"organizationId",[604,610,611,614],{},[237,612,613],{},"Required."," The id of the Kinotic organization this project belongs to.",[590,616,617,622],{},[604,618,619],{},[242,620,621],{},"applicationId",[604,623,624,626],{},[237,625,613],{}," The application id this project belongs to. Must match the application id registered with Kinotic OS: lowercase letters, digits, and interior dashes.",[590,628,629,634],{},[604,630,631],{},[242,632,633],{},"projectId",[604,635,636,638,639,642],{},[237,637,613],{}," The id of this project in Kinotic OS. Provisioned repositories carry the id of the project that created them; ",[242,640,641],{},"kinotic sync"," addresses this project and fails when it does not exist.",[590,644,645,650],{},[604,646,647],{},[242,648,649],{},"name",[604,651,652,653,655,656,658],{},"Optional project name. When omitted, the ",[242,654,649],{}," from the project's ",[242,657,279],{}," is used.",[590,660,661,666],{},[604,662,663],{},[242,664,665],{},"description",[604,667,668,669,655,671,658],{},"Optional project description. When omitted, the ",[242,670,665],{},[242,672,279],{},[590,674,675,680],{},[604,676,677],{},[242,678,679],{},"entitiesPaths",[604,681,682,684,685,688,689,692,693,696,697,700,701,704,705,260],{},[237,683,613],{}," An array whose entries are either a plain path string or an ",[242,686,687],{},"EntitiesPathConfig"," object with ",[242,690,691],{},"path"," (the directory containing entity definitions), ",[242,694,695],{},"repositoryPath"," (where the CLI writes generated repository classes), and ",[242,698,699],{},"mirrorFolderStructure"," (whether to replicate the entity directory structure in the output, default ",[242,702,703],{},"true","). The CLI scans these paths when you run ",[242,706,641],{},[590,708,709,714],{},[604,710,711],{},[242,712,713],{},"generatedPath",[604,715,716,717,719,720,260],{},"The default output path for generated files, used for ",[242,718,679],{}," entries that are plain strings. Ignored for entries that use ",[242,721,687],{},[590,723,724,729],{},[604,725,726],{},[242,727,728],{},"fileExtensionForImports",[604,730,731,732,260],{},"The extension the CLI writes on import paths in generated code. Defaults to ",[242,733,521],{},[590,735,736,741],{},[604,737,738],{},[242,739,740],{},"validate",[604,742,743],{},"When true, generated repository classes validate data before sending it to the server.",[286,745,747],{"id":746},"project-dependencies","Project Dependencies",[219,749,750,751,753],{},"Projects within the same application can depend on each other. For example, a microservice project might import entity types defined in a persistence project. These dependencies are managed through standard ",[242,752,279],{}," -- you add the dependency just like any other Bun package.",[304,755,759],{"className":756,"code":757,"language":758,"meta":309,"style":309},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n    \"dependencies\": {\n        \"@my-org\u002Fdata\": \"workspace:*\"\n    }\n}\n","json",[242,760,761,766,780,800,804],{"__ignoreMap":309},[313,762,763],{"class":315,"line":316},[313,764,765],{"class":326},"{\n",[313,767,768,771,774,776,778],{"class":315,"line":350},[313,769,770],{"class":326},"    \"",[313,772,773],{"class":360},"dependencies",[313,775,394],{"class":326},[313,777,367],{"class":326},[313,779,376],{"class":326},[313,781,782,785,788,790,792,794,797],{"class":315,"line":357},[313,783,784],{"class":326},"        \"",[313,786,787],{"class":370},"@my-org\u002Fdata",[313,789,394],{"class":326},[313,791,367],{"class":326},[313,793,388],{"class":326},[313,795,796],{"class":343},"workspace:*",[313,798,799],{"class":326},"\"\n",[313,801,802],{"class":315,"line":379},[313,803,500],{"class":326},[313,805,806],{"class":315,"line":400},[313,807,542],{"class":326},[219,809,810],{},"When the application is deployed, the platform resolves these internal dependencies and ensures all projects are available to each other through the Service Directory.",[223,812,814],{"id":813},"deployable-packages","Deployable packages",[219,816,817,818,820],{},"When a push deploys a project (see ",[257,819,119],{"href":120},"), the\nplatform finds the packages it deploys by where they sit in the workspace:",[231,822,823,844],{},[234,824,825,828,829,832,833,835,836,839,840,843],{},[237,826,827],{},"Microservices"," live directly under ",[242,830,831],{},"packages\u002Fmicroservices",", one package each. A\nmicroservice runs in a VM of its own from its ",[242,834,279],{}," ",[242,837,838],{},"main",", or ",[242,841,842],{},"src\u002Fmain.ts"," when\nit declares none.",[234,845,846,828,849,852,853,856,857,860,861,863,864,866],{},[237,847,848],{},"UIs",[242,850,851],{},"packages\u002Fui",", one package each, and declare a ",[242,854,855],{},"build"," script\nthat writes ",[242,858,859],{},"dist\u002Findex.html",". A package under ",[242,862,851],{}," without a ",[242,865,855],{}," script is a\nlibrary and is left alone.",[219,868,869,870,835,872,874,875,878,879,882],{},"A package's identity is the unscoped part of its ",[242,871,279],{},[242,873,649],{}," (",[242,876,877],{},"@acme\u002Fadmin"," is\n",[242,880,881],{},"admin","), which must be lowercase letters, digits, and interior dashes and unique among the\npackages of its kind. The directory name never matters.",[286,884,886],{"id":885},"the-ui-build-contract","The UI build contract",[219,888,889,890,893,894,897],{},"Every UI is built during the deployment with ",[242,891,892],{},"bun run build",", and the build is handed the\nplatform's address as three variables. Vite exposes ",[242,895,896],{},"VITE_*"," variables to the page on its\nown, so a Vite project reads them with no configuration; a UI with another build tool must\npass them through itself:",[584,899,900,913],{},[587,901,902],{},[590,903,904,907,910],{},[593,905,906],{},"Variable",[593,908,909],{},"Value",[593,911,912],{},"What the UI does with it",[599,914,915,931,946],{},[590,916,917,922,928],{},[604,918,919],{},[242,920,921],{},"VITE_KINOTIC_HOST",[604,923,924,925],{},"e.g. ",[242,926,927],{},"api.kinotic.ai",[604,929,930],{},"The host the UI connects to Kinotic on from a browser",[590,932,933,938,943],{},[604,934,935],{},[242,936,937],{},"VITE_KINOTIC_PORT",[604,939,924,940],{},[242,941,942],{},"443",[604,944,945],{},"Its port",[590,947,948,953,960],{},[604,949,950],{},[242,951,952],{},"VITE_KINOTIC_USE_SSL",[604,954,955,573,957],{},[242,956,703],{},[242,958,959],{},"false",[604,961,962],{},"Whether to connect over TLS",[304,964,966],{"className":306,"code":965,"language":308,"meta":309,"style":309},"await Kinotic.connect({\n    server: {\n        host: import.meta.env.VITE_KINOTIC_HOST,\n        port: parseInt(import.meta.env.VITE_KINOTIC_PORT),\n        useSSL: import.meta.env.VITE_KINOTIC_USE_SSL === 'true',\n    },\n})\n",[242,967,968,987,996,1022,1051,1085,1090],{"__ignoreMap":309},[313,969,970,973,976,978,982,985],{"class":315,"line":316},[313,971,972],{"class":319},"await",[313,974,975],{"class":330}," Kinotic",[313,977,260],{"class":326},[313,979,981],{"class":980},"s2Zo4","connect",[313,983,984],{"class":330},"(",[313,986,765],{"class":326},[313,988,989,992,994],{"class":315,"line":350},[313,990,991],{"class":382},"    server",[313,993,367],{"class":326},[313,995,376],{"class":326},[313,997,998,1001,1003,1006,1008,1011,1013,1016,1018,1020],{"class":315,"line":357},[313,999,1000],{"class":382},"        host",[313,1002,367],{"class":326},[313,1004,1005],{"class":319}," import",[313,1007,260],{"class":326},[313,1009,1010],{"class":330},"meta",[313,1012,260],{"class":326},[313,1014,1015],{"class":330},"env",[313,1017,260],{"class":326},[313,1019,921],{"class":330},[313,1021,397],{"class":326},[313,1023,1024,1027,1029,1032,1034,1036,1038,1040,1042,1044,1046,1049],{"class":315,"line":379},[313,1025,1026],{"class":382},"        port",[313,1028,367],{"class":326},[313,1030,1031],{"class":980}," parseInt",[313,1033,984],{"class":330},[313,1035,320],{"class":319},[313,1037,260],{"class":326},[313,1039,1010],{"class":330},[313,1041,260],{"class":326},[313,1043,1015],{"class":330},[313,1045,260],{"class":326},[313,1047,1048],{"class":330},"VITE_KINOTIC_PORT)",[313,1050,397],{"class":326},[313,1052,1053,1056,1058,1060,1062,1064,1066,1068,1070,1073,1076,1078,1080,1083],{"class":315,"line":400},[313,1054,1055],{"class":382},"        useSSL",[313,1057,367],{"class":326},[313,1059,1005],{"class":319},[313,1061,260],{"class":326},[313,1063,1010],{"class":330},[313,1065,260],{"class":326},[313,1067,1015],{"class":330},[313,1069,260],{"class":326},[313,1071,1072],{"class":330},"VITE_KINOTIC_USE_SSL ",[313,1074,1075],{"class":326},"===",[313,1077,340],{"class":326},[313,1079,703],{"class":343},[313,1081,1082],{"class":326},"'",[313,1084,397],{"class":326},[313,1086,1087],{"class":315,"line":417},[313,1088,1089],{"class":326},"    },\n",[313,1091,1092,1095],{"class":315,"line":434},[313,1093,1094],{"class":326},"}",[313,1096,1097],{"class":330},")\n",[219,1099,1100,1101,1103],{},"A build that does not write ",[242,1102,859],{}," fails the deployment naming the UI.",[219,1105,1106,1109,1110,1113,1114,1117,1118,1121,1122,1125],{},[242,1107,1108],{},"dist"," is published as it is, from the site's root: files under ",[242,1111,1112],{},"assets\u002F"," carry a content\nhash in their name and are cached for a year, everything else is never cached. Each site\nalso publishes the commit it serves as ",[242,1115,1116],{},"version.json"," next to its ",[242,1119,1120],{},"index.html",", never\ncached, as ",[242,1123,1124],{},"{ \"commitSha\": \"\u003Ccommit>\" }",". A publish replaces the previous commit's files;\na tab left open on the previous commit loads the new commit when it next reloads.",[223,1127,1129],{"id":1128},"typical-setup","Typical Setup",[219,1131,1132,1133,1136,1137,1139,1140,1142,1143,1145],{},"Most applications start with a single project created through Kinotic OS, which provisions a GitHub repository scaffolded as a Bun workspace mono repo: ",[242,1134,1135],{},"packages\u002Fdomain"," (entity model and generated repositories), ",[242,1138,831],{},", ",[242,1141,851],{},", and a ",[242,1144,283],{}," wired to the owning organization and application. Clone the provisioned repository and start building.",[219,1147,1148,1149,1151],{},"As the application grows, you can add additional projects for microservices, batch jobs, or frontends -- each with its own ",[242,1150,283],{}," pointing to the same application identifier.",[1153,1154,1155],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-defa