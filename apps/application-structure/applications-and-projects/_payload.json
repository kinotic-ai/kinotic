64],{"class":463},"sfNiH"," true\n",[300,466,468],{"class":302,"line":467},11,[300,469,470],{"class":313},"    }\n",[300,472,474,477],{"class":302,"line":473},12,[300,475,476],{"class":317},"  ]",[300,478,384],{"class":313},[300,480,482,485,487,489,492,494],{"class":302,"line":481},13,[300,483,484],{"class":369},"  fileExtensionForImports",[300,486,354],{"class":313},[300,488,375],{"class":313},[300,490,491],{"class":330},".js",[300,493,381],{"class":313},[300,495,384],{"class":313},[300,497,499,502,504],{"class":302,"line":498},14,[300,500,501],{"class":369},"  validate",[300,503,354],{"class":313},[300,505,506],{"class":463}," false\n",[300,508,510],{"class":302,"line":509},15,[300,511,512],{"class":313},"}\n",[300,514,516],{"class":302,"line":515},16,[300,517,341],{"emptyLinePlaceholder":340},[300,519,521,524,527],{"class":302,"line":520},17,[300,522,523],{"class":306},"export",[300,525,526],{"class":306}," default",[300,528,529],{"class":317}," config\n",[206,531,532,533,536,537,540,541,543,544,547],{},"The CLI reads the first ",[229,534,535],{},"kinotic.config.*"," file it finds in ",[229,538,539],{},".config",", so a ",[229,542,491],{}," or ",[229,545,546],{},".json"," config\nis loaded the same way.",[549,550,552],"h4",{"id":551},"fields","Fields",[554,555,556,568],"table",{},[557,558,559],"thead",{},[560,561,562,566],"tr",{},[563,564,565],"th",{},"Field",[563,567,252],{},[569,570,571,585,597,613,627,662,677,689],"tbody",{},[560,572,573,579],{},[574,575,576],"td",{},[229,577,578],{},"organizationId",[574,580,581,584],{},[224,582,583],{},"Required."," The id of the Kinotic organization this project belongs to.",[560,586,587,592],{},[574,588,589],{},[229,590,591],{},"applicationId",[574,593,594,596],{},[224,595,583],{}," The application id this project belongs to. Must match the application id registered with Kinotic OS: lowercase letters, digits, and interior dashes.",[560,598,599,604],{},[574,600,601],{},[229,602,603],{},"name",[574,605,606,607,609,610,612],{},"Optional project name. When omitted, the ",[229,608,603],{}," from the project's ",[229,611,266],{}," is used.",[560,614,615,620],{},[574,616,617],{},[229,618,619],{},"description",[574,621,622,623,609,625,612],{},"Optional project description. When omitted, the ",[229,624,619],{},[229,626,266],{},[560,628,629,634],{},[574,630,631],{},[229,632,633],{},"entitiesPaths",[574,635,636,638,639,642,643,646,647,650,651,654,655,658,659,247],{},[224,637,583],{}," An array whose entries are either a plain path string or an ",[229,640,641],{},"EntitiesPathConfig"," object with ",[229,644,645],{},"path"," (the directory containing entity definitions), ",[229,648,649],{},"repositoryPath"," (where the CLI writes generated repository classes), and ",[229,652,653],{},"mirrorFolderStructure"," (whether to replicate the entity directory structure in the output, default ",[229,656,657],{},"true","). The CLI scans these paths when you run ",[229,660,661],{},"kinotic sync",[560,663,664,669],{},[574,665,666],{},[229,667,668],{},"generatedPath",[574,670,671,672,674,675,247],{},"The default output path for generated files, used for ",[229,673,633],{}," entries that are plain strings. Ignored for entries that use ",[229,676,641],{},[560,678,679,684],{},[574,680,681],{},[229,682,683],{},"fileExtensionForImports",[574,685,686,687,247],{},"The extension the CLI writes on import paths in generated code. Defaults to ",[229,688,491],{},[560,690,691,696],{},[574,692,693],{},[229,694,695],{},"validate",[574,697,698],{},"When true, generated repository classes validate data before sending it to the server.",[273,700,702],{"id":701},"project-dependencies","Project Dependencies",[206,704,705,706,708],{},"Projects within the same application can depend on each other. For example, a microservice project might import entity types defined in a persistence project. These dependencies are managed through standard ",[229,707,266],{}," -- you add the dependency just like any other Bun package.",[291,710,714],{"className":711,"code":712,"language":713,"meta":296,"style":296},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n    \"dependencies\": {\n        \"@my-org\u002Fdata\": \"workspace:*\"\n    }\n}\n","json",[229,715,716,721,735,755,759],{"__ignoreMap":296},[300,717,718],{"class":302,"line":303},[300,719,720],{"class":313},"{\n",[300,722,723,726,729,731,733],{"class":302,"line":337},[300,724,725],{"class":313},"    \"",[300,727,728],{"class":347},"dependencies",[300,730,381],{"class":313},[300,732,354],{"class":313},[300,734,363],{"class":313},[300,736,737,740,743,745,747,749,752],{"class":302,"line":344},[300,738,739],{"class":313},"        \"",[300,741,742],{"class":357},"@my-org\u002Fdata",[300,744,381],{"class":313},[300,746,354],{"class":313},[300,748,375],{"class":313},[300,750,751],{"class":330},"workspace:*",[300,753,754],{"class":313},"\"\n",[300,756,757],{"class":302,"line":366},[300,758,470],{"class":313},[300,760,761],{"class":302,"line":387},[300,762,512],{"class":313},[206,764,765],{},"When the application is deployed, the platform resolves these internal dependencies and ensures all projects are available to each other through the Service Directory.",[210,767,769],{"id":768},"typical-setup","Typical Setup",[206,771,772,773,776,777,780,781,784,785,787],{},"Most applications start with a single project created through Kinotic OS, which provisions a GitHub repository scaffolded as a Bun workspace mono repo: ",[229,774,775],{},"packages\u002Fdomain"," (entity model and generated repositories), ",[229,778,779],{},"packages\u002Fmicroservices",", ",[229,782,783],{},"packages\u002Fui",", and a ",[229,786,270],{}," wired to the owning organization and application. Clone the provisioned repository and start building.",[206,789,790,791,793],{},"As the application grows, you can add additional projects for microservices, batch jobs, or frontends -- each with its own ",[229,792,270],{}," pointing to the same 