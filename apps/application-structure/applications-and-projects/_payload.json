w to configure both.",[223,224,226],"h2",{"id":225},"applications","Applications",[219,228,229],{},"Every application has:",[231,232,233,246,261],"ul",{},[234,235,236,240,241,245],"li",{},[237,238,239],"strong",{},"Name"," -- A human-readable name (e.g., ",[242,243,244],"code",{},"Inventory App",").",[234,247,248,251,252,255,256,260],{},[237,249,250],{},"Id"," -- Derived from the name at creation: the slugified name, made of lowercase letters, digits, and interior dashes (e.g., ",[242,253,254],{},"inventory-app","). The id forms the final label of the application's ",[257,258,259],"a",{"href":201},"zone",".",[234,262,263,266],{},[237,264,265],{},"Description"," -- A human-readable summary of what the application does.",[219,268,269],{},"Applications are created and managed through the Kinotic CLI and the Kinotic OS dashboard.",[223,271,273],{"id":272},"projects","Projects",[219,275,276,277,280,281,284],{},"A project is a directory with its own ",[242,278,279],{},"package.json"," and a ",[242,282,283],{},".config\u002Fkinotic.config.ts"," configuration file. The CLI uses that config to understand how the project fits into the broader application.",[286,287,289,290,292],"h3",{"id":288},"the-configkinoticconfigts-file","The ",[242,291,283],{}," File",[219,294,295,296,298,299,302],{},"Every project carries a ",[242,297,283],{},", created when Kinotic OS provisions\nthe project repository. It is a TypeScript module exporting a ",[242,300,301],{},"KinoticProjectConfig",", so\nyour editor type-checks it:",[304,305,310],"pre",{"className":306,"code":307,"language":308,"meta":309,"style":309},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import type { KinoticProjectConfig } from '@kinotic-ai\u002Fmanagement-api'\n\nconst config: KinoticProjectConfig = {\n  organizationId: \"my-org\",\n  applicationId: \"my-app\",\n  entitiesPaths: [\n    {\n      path: \"packages\u002Fdomain\u002Fmodel\",\n      repositoryPath: \"packages\u002Fdomain\u002Frepositories\",\n      mirrorFolderStructure: true\n    }\n  ],\n  fileExtensionForImports: \".js\",\n  validate: false\n}\n\nexport default config\n","ts","",[242,311,312,348,355,377,398,415,426,432,449,466,478,484,492,509,520,526,531],{"__ignoreMap":309},[313,314,317,321,324,328,332,335,338,341,345],"span",{"class":315,"line":316},"line",1,[313,318,320],{"class":319},"s7zQu","import",[313,322,323],{"class":319}," type",[313,325,327],{"class":326},"sMK4o"," {",[313,329,331],{"class":330},"sTEyZ"," KinoticProjectConfig",[313,333,334],{"class":326}," }",[313,336,337],{"class":319}," from",[313,339,340],{"class":326}," '",[313,342,344],{"class":343},"sfazB","@kinotic-ai\u002Fmanagement-api",[313,346,347],{"class":326},"'\n",[313,349,351],{"class":315,"line":350},2,[313,352,354],{"emptyLinePlaceholder":353},true,"\n",[313,356,358,362,365,368,371,374],{"class":315,"line":357},3,[313,359,361],{"class":360},"spNyl","const",[313,363,364],{"class":330}," config",[313,366,367],{"class":326},":",[313,369,331],{"class":370},"sBMFI",[313,372,373],{"class":326}," =",[313,375,376],{"class":326}," {\n",[313,378,380,384,386,389,392,395],{"class":315,"line":379},4,[313,381,383],{"class":382},"swJcz","  organizationId",[313,385,367],{"class":326},[313,387,388],{"class":326}," \"",[313,390,391],{"class":343},"my-org",[313,393,394],{"class":326},"\"",[313,396,397],{"class":326},",\n",[313,399,401,404,406,408,411,413],{"class":315,"line":400},5,[313,402,403],{"class":382},"  applicationId",[313,405,367],{"class":326},[313,407,388],{"class":326},[313,409,410],{"class":343},"my-app",[313,412,394],{"class":326},[313,414,397],{"class":326},[313,416,418,421,423],{"class":315,"line":417},6,[313,419,420],{"class":382},"  entitiesPaths",[313,422,367],{"class":326},[313,424,425],{"class":330}," [\n",[313,427,429],{"class":315,"line":428},7,[313,430,431],{"class":326},"    {\n",[313,433,435,438,440,442,445,447],{"class":315,"line":434},8,[313,436,437],{"class":382},"      path",[313,439,367],{"class":326},[313,441,388],{"class":326},[313,443,444],{"class":343},"packages\u002Fdomain\u002Fmodel",[313,446,394],{"class":326},[313,448,397],{"class":326},[313,450,452,455,457,459,462,464],{"class":315,"line":451},9,[313,453,454],{"class":382},"      repositoryPath",[313,456,367],{"class":326},[313,458,388],{"class":326},[313,460,461],{"class":343},"packages\u002Fdomain\u002Frepositories",[313,463,394],{"class":326},[313,465,397],{"class":326},[313,467,469,472,474],{"class":315,"line":468},10,[313,470,471],{"class":382},"      mirrorFolderStructure",[313,473,367],{"class":326},[313,475,477],{"class":476},"sfNiH"," true\n",[313,479,481],{"class":315,"line":480},11,[313,482,483],{"class":326},"    }\n",[313,485,487,490],{"class":315,"line":486},12,[313,488,489],{"class":330},"  ]",[313,491,397],{"class":326},[313,493,495,498,500,502,505,507],{"class":315,"line":494},13,[313,496,497],{"class":382},"  fileExtensionForImports",[313,499,367],{"class":326},[313,501,388],{"class":326},[313,503,504],{"class":343},".js",[313,506,394],{"class":326},[313,508,397],{"class":326},[313,510,512,515,517],{"class":315,"line":511},14,[313,513,514],{"class":382},"  validate",[313,516,367],{"class":326},[313,518,519],{"class":476}," false\n",[313,521,523],{"class":315,"line":522},15,[313,524,525],{"class":326},"}\n",[313,527,529],{"class":315,"line":528},16,[313,530,354],{"emptyLinePlaceholder":353},[313,532,534,537,540],{"class":315,"line":533},17,[313,535,536],{"class":319},"export",[313,538,539],{"class":319}," default",[313,541,542],{"class":330}," config\n",[219,544,545,546,549,550,553,554,556,557,560],{},"The CLI reads the first ",[242,547,548],{},"kinotic.config.*"," file it finds in ",[242,551,552],{},".config",", so a ",[242,555,504],{}," or ",[242,558,559],{},".json"," config\nis loaded the same way.",[562,563,565],"h4",{"id":564},"fields","Fields",[567,568,569,581],"table",{},[570,571,572],"thead",{},[573,574,575,579],"tr",{},[576,577,578],"th",{},"Field",[576,580,265],{},[582,583,584,598,610,626,640,675,690,702],"tbody",{},[573,585,586,592],{},[587,588,589],"td",{},[242,590,591],{},"organizationId",[587,593,594,597],{},[237,595,596],{},"Required."," The id of the Kinotic organization this project belongs to.",[573,599,600,605],{},[587,601,602],{},[242,603,604],{},"applicationId",[587,606,607,609],{},[237,608,596],{}," The application id this project belongs to. Must match the application id registered with Kinotic OS: lowercase letters, digits, and interior dashes.",[573,611,612,617],{},[587,613,614],{},[242,615,616],{},"name",[587,618,619,620,622,623,625],{},"Optional project name. When omitted, the ",[242,621,616],{}," from the project's ",[242,624,279],{}," is used.",[573,627,628,633],{},[587,629,630],{},[242,631,632],{},"description",[587,634,635,636,622,638,625],{},"Optional project description. When omitted, the ",[242,637,632],{},[242,639,279],{},[573,641,642,647],{},[587,643,644],{},[242,645,646],{},"entitiesPaths",[587,648,649,651,652,655,656,659,660,663,664,667,668,671,672,260],{},[237,650,596],{}," An array whose entries are either a plain path string or an ",[242,653,654],{},"EntitiesPathConfig"," object with ",[242,657,658],{},"path"," (the directory containing entity definitions), ",[242,661,662],{},"repositoryPath"," (where the CLI writes generated repository classes), and ",[242,665,666],{},"mirrorFolderStructure"," (whether to replicate the entity directory structure in the output, default ",[242,669,670],{},"true","). The CLI scans these paths when you run ",[242,673,674],{},"kinotic sync",[573,676,677,682],{},[587,678,679],{},[242,680,681],{},"generatedPath",[587,683,684,685,687,688,260],{},"The default output path for generated files, used for ",[242,686,646],{}," entries that are plain strings. Ignored for entries that use ",[242,689,654],{},[573,691,692,697],{},[587,693,694],{},[242,695,696],{},"fileExtensionForImports",[587,698,699,700,260],{},"The extension the CLI writes on import paths in generated code. Defaults to ",[242,701,504],{},[573,703,704,709],{},[587,705,706],{},[242,707,708],{},"validate",[587,710,711],{},"When true, generated repository classes validate data before sending it to the server.",[286,713,715],{"id":714},"project-dependencies","Project Dependencies",[219,717,718,719,721],{},"Projects within the same application can depend on each other. For example, a microservice project might import entity types defined in a persistence project. These dependencies are managed through standard ",[242,720,279],{}," -- you add the dependency just like any other Bun package.",[304,723,727],{"className":724,"code":725,"language":726,"meta":309,"style":309},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n    \"dependencies\": {\n        \"@my-org\u002Fdata\": \"workspace:*\"\n    }\n}\n","json",[242,728,729,734,748,768,772],{"__ignoreMap":309},[313,730,731],{"class":315,"line":316},[313,732,733],{"class":326},"{\n",[313,735,736,739,742,744,746],{"class":315,"line":350},[313,737,738],{"class":326},"    \"",[313,740,741],{"class":360},"dependencies",[313,743,394],{"class":326},[313,745,367],{"class":326},[313,747,376],{"class":326},[313,749,750,753,756,758,760,762,765],{"class":315,"line":357},[313,751,752],{"class":326},"        \"",[313,754,755],{"class":370},"@my-org\u002Fdata",[313,757,394],{"class":326},[313,759,367],{"class":326},[313,761,388],{"class":326},[313,763,764],{"class":343},"workspace:*",[313,766,767],{"class":326},"\"\n",[313,769,770],{"class":315,"line":379},[313,771,483],{"class":326},[313,773,774],{"class":315,"line":400},[313,775,525],{"class":326},[219,777,778],{},"When the application is deployed, the platform resolves these internal dependencies and ensures all projects are available to each other through the Service Directory.",[223,780,782],{"id":781},"deployable-packages","Deployable packages",[219,784,785,786,788],{},"When a push deploys a project (see ",[257,787,119],{"href":120},"), the\nplatform finds the packages it deploys by where they sit in the workspace:",[231,790,791,812],{},[234,792,793,796,797,800,801,803,804,807,808,811],{},[237,794,795],{},"Microservices"," live directly under ",[242,798,799],{},"packages\u002Fmicroservices",", one package each. A\nmicroservice runs in a VM of its own from its ",[242,802,279],{}," ",[242,805,806],{},"main",", or ",[242,809,810],{},"src\u002Fmain.ts"," when\nit declares none.",[234,813,814,796,817,820,821,824,825,828,829,831,832,834],{},[237,815,816],{},"UIs",[242,818,819],{},"packages\u002Fui",", one package each, and declare a ",[242,822,823],{},"build"," script\nthat writes ",[242,826,827],{},"dist\u002Findex.html",". A package under ",[242,830,819],{}," without a ",[242,833,823],{}," script is a\nlibrary and is left alone.",[219,836,837,838,803,840,842,843,846,847,850],{},"A package's identity is the unscoped part of its ",[242,839,279],{},[242,841,616],{}," (",[242,844,845],{},"@acme\u002Fadmin"," is\n",[242,848,849],{},"admin","), which must be lowercase letters, digits, and interior dashes and unique among the\npackages of its kind. The directory name never matters.",[286,852,854],{"id":853},"the-ui-build-contract","The UI build contract",[219,856,857,858,861],{},"Every UI is built during the deployment with ",[242,859,860],{},"bun run build",", and the build is handed one\nvariable. A UI built from the platform template honors it through its Vite config; a UI\nwith its own build must too:",[567,863,864,877],{},[570,865,866],{},[573,867,868,871,874],{},[576,869,870],{},"Variable",[576,872,873],{},"Value",[576,875,876],{},"What the build does with it",[582,878,879],{},[573,880,881,886,889],{},[587,882,883],{},[242,884,885],{},"KINOTIC_UI_SERVER_URL",[587,887,888],{},"the platform's public API address",[587,890,891],{},"The address the UI connects to Kinotic on from a browser",[219,893,894,895,897],{},"A build that does not write ",[242,896,827],{}," fails the deployment naming the UI.",[219,899,900,903,904,907,908,911,912,915,916,919],{},[242,901,902],{},"dist"," is published as it is, from the site's root: files under ",[242,905,906],{},"assets\u002F"," carry a content\nhash in their name and are cached for a year, everything else is never cached. Each site\nalso publishes the commit it serves as ",[242,909,910],{},"version.json"," next to its ",[242,913,914],{},"index.html",", never\ncached, as ",[242,917,918],{},"{ \"commitSha\": \"\u003Ccommit>\" }",". A publish replaces the previous commit's files;\na tab left open on the previous commit loads the new commit when it next reloads.",[223,921,923],{"id":922},"typical-setup","Typical Setup",[219,925,926,927,930,931,933,934,936,937,939],{},"Most applications start with a single project created through Kinotic OS, which provisions a GitHub repository scaffolded as a Bun workspace mono repo: ",[242,928,929],{},"packages\u002Fdomain"," (entity model and generated repositories), ",[242,932,799],{},", ",[242,935,819],{},", and a ",[242,938,283],{}," wired to the owning organization and application. Clone the provisioned repository and start building.",[219,941,942,943,945],{},"As the application grows, you can add additional projects for microservices, batch jobs, or frontends -- each with its own ",[242,944,283],{}," pointing to the same application identifier.",[947,948,949],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{-