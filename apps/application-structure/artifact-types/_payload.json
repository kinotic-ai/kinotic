epth","\u002Fplatform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":128,"icon":129,"path":196,"stem":197,"children":198,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[199,204],{"title":200,"path":201,"stem":202,"icon":203},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"title":205,"path":206,"stem":207,"icon":208},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F11.reference\u002F02.grind-jobs","i-lucide-workflow",{"id":210,"title":33,"body":211,"description":498,"extension":499,"links":500,"meta":501,"navigation":502,"path":34,"seo":503,"stem":35,"__hash__":504},"docs\u002F01.apps\u002F03.application-structure\u002F03.artifact-types.md",{"type":212,"value":213,"toc":488},"minimark",[214,223,227,230,235,259,264,275,278,282,289,293,301,305,320,323,327,330,334,342,346,354,358,361,365,370,374,379,383,386,390,395,399,407,411,414,485],[215,216,217,218,222],"p",{},"Every project in a Kinotic application contributes one or more ",[219,220,221],"strong",{},"artifacts",". An artifact is a typed output that the platform knows how to build, deploy, and manage. This page describes each artifact type and when to use it.",[224,225,59],"h2",{"id":226},"persistence",[215,228,229],{},"The most common starting point. A persistence artifact defines your domain models (entities) and gets auto-generated CRUD services in return.",[215,231,232],{},[219,233,234],{},"What you provide:",[236,237,238],"ul",{},[239,240,241,242,246,247,250,251,254,255,258],"li",{},"Entity classes decorated with ",[243,244,245],"code",{},"@Entity"," and field-level annotations like ",[243,248,249],{},"@NotNull",", ",[243,252,253],{},"@Precision",", and ",[243,256,257],{},"@AutoGeneratedId",".",[215,260,261],{},[219,262,263],{},"What the platform provides:",[236,265,266,269,272],{},[239,267,268],{},"Full CRUD operations (save, find, delete) with pagination and sorting.",[239,270,271],{},"Named queries derived from method naming conventions.",[239,273,274],{},"Automatic storage provisioning and indexing.",[215,276,277],{},"Persistence is typically the first artifact you create because it establishes the data model that the rest of the application builds on.",[224,279,281],{"id":280},"microservice","Microservice",[215,283,284,285,258],{},"A microservice artifact is long-running code that executes in a pod or VM. It publishes services that other parts of the application can discover and call through ",[286,287,288],"a",{"href":52},"service proxies",[215,290,291],{},[219,292,234],{},[236,294,295,298],{},[239,296,297],{},"TypeScript classes that implement your business logic.",[239,299,300],{},"Service interfaces that you want to expose to the rest of the application.",[215,302,303],{},[219,304,263],{},[236,306,307,310,317],{},[239,308,309],{},"Automatic service registration in the Service Directory.",[239,311,312,313,316],{},"Service discovery and zone-based routing so other projects can call your service through a ",[286,314,315],{"href":52},"service proxy"," with a simple function call.",[239,318,319],{},"Lifecycle management, scaling, and health monitoring.",[215,321,322],{},"Use a microservice when your logic goes beyond simple CRUD -- orchestrating across multiple entities, calling external APIs, or running long-lived workflows.",[224,324,326],{"id":325},"batch-job","Batch Job",[215,328,329],{},"A batch job artifact is code that runs on a schedule. It is ideal for periodic tasks like data aggregation, report generation, cleanup routines, or syncing with external systems.",[215,331,332],{},[219,333,234],{},[236,335,336,339],{},[239,337,338],{},"TypeScript code that performs the job.",[239,340,341],{},"A schedule definition (cron expression or interval).",[215,343,344],{},[219,345,263],{},[236,347,348,351],{},[239,349,350],{},"Scheduled execution with retry and failure handling.",[239,352,353],{},"Logging and observability for each run.",[224,355,357],{"id":356},"ui-component","UI Component",[215,359,360],{},"A UI component artifact produces reusable building blocks that can be shared across multiple frontends within the application. Think of it as an internal component library.",[215,362,363],{},[219,364,234],{},[236,366,367],{},[239,368,369],{},"Reusable UI components packaged for consumption by frontend projects.",[215,371,372],{},[219,373,263],{},[236,375,376],{},[239,377,378],{},"Versioning and distribution within the application.",[224,380,382],{"id":381},"frontend","Frontend",[215,384,385],{},"A frontend artifact is a complete user interface that gets deployed as a static site. It consumes services published by other projects in the application.",[215,387,388],{},[219,389,234],{},[236,391,392],{},[239,393,394],{},"A web application (built with any framework) that compiles to static assets.",[215,396,397],{},[219,398,263],{},[236,400,401,404],{},[239,402,403],{},"Static hosting with CDN distribution.",[239,405,406],{},"Automatic connection to the application's services through the Kinotic client libraries.",[224,408,410],{"id":409},"combining-artifact-types","Combining Artifact Types",[215,412,413],{},"Most real-world applications combine several artifact types. A typical setup might look like this:",[415,416,417,433],"table",{},[418,419,420],"thead",{},[421,422,423,427,430],"tr",{},[424,425,426],"th",{},"Project",[424,428,429],{},"Artifact Type",[424,431,432],{},"Role",[434,435,436,449,461,473],"tbody",{},[421,437,438,444,446],{},[439,440,441],"td",{},[243,442,443],{},"data",[439,445,59],{},[439,447,448],{},"Defines entities and provides auto-generated CRUD services",[421,450,451,456,458],{},[439,452,453],{},[243,454,455],{},"services",[439,457,281],{},[439,459,460],{},"Implements business rules that orchestrate across entities",[421,462,463,468,470],{},[439,464,465],{},[243,466,467],{},"jobs",[439,469,326],{},[439,471,472],{},"Runs nightly data aggregation",[421,474,475,480,482],{},[439,476,477],{},[243,478,479],{},"web",[439,481,382],{},[439,483,484],{},"The main user interface",[215,486,487],{},"Each project is independently developed and versioned, but they all deploy as part of the same application and communicate through the Service Directory.",{"title":489,"searchDepth":490,"depth":490,"links":491},"",2,[492,493,494,495,496,497],{"id":226,"depth":490,"text":59},{"id":280,"depth":490,"text":281},{"id":325,"depth":490,"text":326},{"id":356,"depth":490,"text":357},{"id":381,"depth":490,"text":382},{"id":409,"depth":490,"text":410},"Learn about the different artifact types a Kinotic project can contribute -- from persistence and microservices to frontends.","md",null,{},true,{"title":33,"description":498},"ks4mH_HWM4uaDA9Vwx-yIdl366mKkKWDw9PgfC_UDoU",[506,508],{"title":29,"path":30,"stem":31,"description":507,"children":-1},"Learn how to configure Kinotic applications and the projects that compose them.",{"title":25,"path":44,"stem":45,"description":509,"children":-1},"How services work in Kinotic and the communication patterns they support.",1787992844479]