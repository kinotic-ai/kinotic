epth","\u002Fplatform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":128,"icon":129,"path":196,"stem":197,"children":198,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[199,204,209],{"title":200,"path":201,"stem":202,"icon":203},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"title":205,"path":206,"stem":207,"icon":208},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F11.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":210,"path":211,"stem":212,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F11.reference\u002F03.project-publishing-design",{"id":214,"title":33,"body":215,"description":502,"extension":503,"links":504,"meta":505,"navigation":506,"path":34,"seo":507,"stem":35,"__hash__":508},"docs\u002F01.apps\u002F03.application-structure\u002F03.artifact-types.md",{"type":216,"value":217,"toc":492},"minimark",[218,227,231,234,239,263,268,279,282,286,293,297,305,309,324,327,331,334,338,346,350,358,362,365,369,374,378,383,387,390,394,399,403,411,415,418,489],[219,220,221,222,226],"p",{},"Every project in a Kinotic application contributes one or more ",[223,224,225],"strong",{},"artifacts",". An artifact is a typed output that the platform knows how to build, deploy, and manage. This page describes each artifact type and when to use it.",[228,229,59],"h2",{"id":230},"persistence",[219,232,233],{},"The most common starting point. A persistence artifact defines your domain models (entities) and gets auto-generated CRUD services in return.",[219,235,236],{},[223,237,238],{},"What you provide:",[240,241,242],"ul",{},[243,244,245,246,250,251,254,255,258,259,262],"li",{},"Entity classes decorated with ",[247,248,249],"code",{},"@Entity"," and field-level annotations like ",[247,252,253],{},"@NotNull",", ",[247,256,257],{},"@Precision",", and ",[247,260,261],{},"@AutoGeneratedId",".",[219,264,265],{},[223,266,267],{},"What the platform provides:",[240,269,270,273,276],{},[243,271,272],{},"Full CRUD operations (save, find, delete) with pagination and sorting.",[243,274,275],{},"Named queries derived from method naming conventions.",[243,277,278],{},"Automatic storage provisioning and indexing.",[219,280,281],{},"Persistence is typically the first artifact you create because it establishes the data model that the rest of the application builds on.",[228,283,285],{"id":284},"microservice","Microservice",[219,287,288,289,262],{},"A microservice artifact is long-running code that executes in a pod or VM. It publishes services that other parts of the application can discover and call through ",[290,291,292],"a",{"href":52},"service proxies",[219,294,295],{},[223,296,238],{},[240,298,299,302],{},[243,300,301],{},"TypeScript classes that implement your business logic.",[243,303,304],{},"Service interfaces that you want to expose to the rest of the application.",[219,306,307],{},[223,308,267],{},[240,310,311,314,321],{},[243,312,313],{},"Automatic service registration in the Service Directory.",[243,315,316,317,320],{},"Service discovery and zone-based routing so other projects can call your service through a ",[290,318,319],{"href":52},"service proxy"," with a simple function call.",[243,322,323],{},"Lifecycle management, scaling, and health monitoring.",[219,325,326],{},"Use a microservice when your logic goes beyond simple CRUD -- orchestrating across multiple entities, calling external APIs, or running long-lived workflows.",[228,328,330],{"id":329},"batch-job","Batch Job",[219,332,333],{},"A batch job artifact is code that runs on a schedule. It is ideal for periodic tasks like data aggregation, report generation, cleanup routines, or syncing with external systems.",[219,335,336],{},[223,337,238],{},[240,339,340,343],{},[243,341,342],{},"TypeScript code that performs the job.",[243,344,345],{},"A schedule definition (cron expression or interval).",[219,347,348],{},[223,349,267],{},[240,351,352,355],{},[243,353,354],{},"Scheduled execution with retry and failure handling.",[243,356,357],{},"Logging and observability for each run.",[228,359,361],{"id":360},"ui-component","UI Component",[219,363,364],{},"A UI component artifact produces reusable building blocks that can be shared across multiple frontends within the application. Think of it as an internal component library.",[219,366,367],{},[223,368,238],{},[240,370,371],{},[243,372,373],{},"Reusable UI components packaged for consumption by frontend projects.",[219,375,376],{},[223,377,267],{},[240,379,380],{},[243,381,382],{},"Versioning and distribution within the application.",[228,384,386],{"id":385},"frontend","Frontend",[219,388,389],{},"A frontend artifact is a complete user interface that gets deployed as a static site. It consumes services published by other projects in the application.",[219,391,392],{},[223,393,238],{},[240,395,396],{},[243,397,398],{},"A web application (built with any framework) that compiles to static assets.",[219,400,401],{},[223,402,267],{},[240,404,405,408],{},[243,406,407],{},"Static hosting with CDN distribution.",[243,409,410],{},"Automatic connection to the application's services through the Kinotic client libraries.",[228,412,414],{"id":413},"combining-artifact-types","Combining Artifact Types",[219,416,417],{},"Most real-world applications combine several artifact types. A typical setup might look like this:",[419,420,421,437],"table",{},[422,423,424],"thead",{},[425,426,427,431,434],"tr",{},[428,429,430],"th",{},"Project",[428,432,433],{},"Artifact Type",[428,435,436],{},"Role",[438,439,440,453,465,477],"tbody",{},[425,441,442,448,450],{},[443,444,445],"td",{},[247,446,447],{},"data",[443,449,59],{},[443,451,452],{},"Defines entities and provides auto-generated CRUD services",[425,454,455,460,462],{},[443,456,457],{},[247,458,459],{},"services",[443,461,285],{},[443,463,464],{},"Implements business rules that orchestrate across entities",[425,466,467,472,474],{},[443,468,469],{},[247,470,471],{},"jobs",[443,473,330],{},[443,475,476],{},"Runs nightly data aggregation",[425,478,479,484,486],{},[443,480,481],{},[247,482,483],{},"web",[443,485,386],{},[443,487,488],{},"The main user interface",[219,490,491],{},"Each project is independently developed and versioned, but they all deploy as part of the same application and communicate through the Service Directory.",{"title":493,"searchDepth":494,"depth":494,"links":495},"",2,[496,497,498,499,500,501],{"id":230,"depth":494,"text":59},{"id":284,"depth":494,"text":285},{"id":329,"depth":494,"text":330},{"id":360,"depth":494,"text":361},{"id":385,"depth":494,"text":386},{"id":413,"depth":494,"text":414},"Learn about the different artifact types a Kinotic project can contribute -- from persistence and microservices to frontends.","md",null,{},true,{"title":33,"description":502},"ks4mH_HWM4uaDA9Vwx-yIdl366mKkKWDw9PgfC_UDoU",[510,512],{"title":29,"path":30,"stem":31,"description":511,"children":-1},"Learn how to configure Kinotic applications and the projects that compose them.",{"title":25,"path":44,"stem":45,"description":513,"children":-1},"How services work in Kinotic and the communication patterns they support.",1788509747965]