240,244],{"title":231,"path":232,"stem":233,"icon":234},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":236,"path":237,"stem":238,"icon":239},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":241,"path":242,"stem":243,"icon":178},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":245,"path":246,"stem":247,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":249,"path":250,"stem":251,"icon":252},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":254,"path":255,"stem":256,"icon":257},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":259,"path":260,"stem":261,"icon":262},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":264,"title":59,"body":265,"description":552,"extension":553,"links":554,"meta":555,"navigation":556,"path":60,"seo":557,"stem":61,"__hash__":558},"docs\u002F03.apps\u002F03.application-structure\u002F03.artifact-types.md",{"type":266,"value":267,"toc":542},"minimark",[268,277,281,284,289,313,318,329,332,336,343,347,355,359,374,377,381,384,388,396,400,408,412,415,419,424,428,433,437,440,444,449,453,461,465,468,539],[269,270,271,272,276],"p",{},"Every project in a Kinotic application contributes one or more ",[273,274,275],"strong",{},"artifacts",". An artifact is a typed output that the platform knows how to build, deploy, and manage. This page describes each artifact type and when to use it.",[278,279,88],"h2",{"id":280},"persistence",[269,282,283],{},"The most common starting point. A persistence artifact defines your domain models (entities) and gets auto-generated CRUD services in return.",[269,285,286],{},[273,287,288],{},"What you provide:",[290,291,292],"ul",{},[293,294,295,296,300,301,304,305,308,309,312],"li",{},"Entity classes decorated with ",[297,298,299],"code",{},"@Entity"," and field-level annotations like ",[297,302,303],{},"@NotNull",", ",[297,306,307],{},"@Precision",", and ",[297,310,311],{},"@AutoGeneratedId",".",[269,314,315],{},[273,316,317],{},"What the platform provides:",[290,319,320,323,326],{},[293,321,322],{},"Full CRUD operations (save, find, delete) with pagination and sorting.",[293,324,325],{},"Named queries derived from method naming conventions.",[293,327,328],{},"Automatic storage provisioning and indexing.",[269,330,331],{},"Persistence is typically the first artifact you create because it establishes the data model that the rest of the application builds on.",[278,333,335],{"id":334},"microservice","Microservice",[269,337,338,339,312],{},"A microservice artifact is long-running code that executes in a pod or VM. It publishes services that other parts of the application can discover and call through ",[340,341,342],"a",{"href":77},"service proxies",[269,344,345],{},[273,346,288],{},[290,348,349,352],{},[293,350,351],{},"TypeScript classes that implement your business logic.",[293,353,354],{},"Service interfaces that you want to expose to the rest of the application.",[269,356,357],{},[273,358,317],{},[290,360,361,364,371],{},[293,362,363],{},"Automatic service registration in the Service Directory.",[293,365,366,367,370],{},"Service discovery and zone-based routing so other projects can call your service through a ",[340,368,369],{"href":77},"service proxy"," with a simple function call.",[293,372,373],{},"Lifecycle management, scaling, and health monitoring.",[269,375,376],{},"Use a microservice when your logic goes beyond simple CRUD -- orchestrating across multiple entities, calling external APIs, or running long-lived workflows.",[278,378,380],{"id":379},"batch-job","Batch Job",[269,382,383],{},"A batch job artifact is code that runs on a schedule. It is ideal for periodic tasks like data aggregation, report generation, cleanup routines, or syncing with external systems.",[269,385,386],{},[273,387,288],{},[290,389,390,393],{},[293,391,392],{},"TypeScript code that performs the job.",[293,394,395],{},"A schedule definition (cron expression or interval).",[269,397,398],{},[273,399,317],{},[290,401,402,405],{},[293,403,404],{},"Scheduled execution with retry and failure handling.",[293,406,407],{},"Logging and observability for each run.",[278,409,411],{"id":410},"ui-component","UI Component",[269,413,414],{},"A UI component artifact produces reusable building blocks that can be shared across multiple frontends within the application. Think of it as an internal component library.",[269,416,417],{},[273,418,288],{},[290,420,421],{},[293,422,423],{},"Reusable UI components packaged for consumption by frontend projects.",[269,425,426],{},[273,427,317],{},[290,429,430],{},[293,431,432],{},"Versioning and distribution within the application.",[278,434,436],{"id":435},"frontend","Frontend",[269,438,439],{},"A frontend artifact is a complete user interface that gets deployed as a static site. It consumes services published by other projects in the application.",[269,441,442],{},[273,443,288],{},[290,445,446],{},[293,447,448],{},"A web application (built with any framework) that compiles to static assets.",[269,450,451],{},[273,452,317],{},[290,454,455,458],{},[293,456,457],{},"Static hosting with CDN distribution.",[293,459,460],{},"Automatic connection to the application's services through the Kinotic client libraries.",[278,462,464],{"id":463},"combining-artifact-types","Combining Artifact Types",[269,466,467],{},"Most real-world applications combine several artifact types. A typical setup might look like this:",[469,470,471,487],"table",{},[472,473,474],"thead",{},[475,476,477,481,484],"tr",{},[478,479,480],"th",{},"Project",[478,482,483],{},"Artifact Type",[478,485,486],{},"Role",[488,489,490,503,515,527],"tbody",{},[475,491,492,498,500],{},[493,494,495],"td",{},[297,496,497],{},"data",[493,499,88],{},[493,501,502],{},"Defines entities and provides auto-generated CRUD services",[475,504,505,510,512],{},[493,506,507],{},[297,508,509],{},"services",[493,511,335],{},[493,513,514],{},"Implements business rules that orchestrate across entities",[475,516,517,522,524],{},[493,518,519],{},[297,520,521],{},"jobs",[493,523,380],{},[493,525,526],{},"Runs nightly data aggregation",[475,528,529,534,536],{},[493,530,531],{},[297,532,533],{},"web",[493,535,436],{},[493,537,538],{},"The main user interface",[269,540,541],{},"Each project is independently developed and versioned, but they all deploy as part of the same application and communicate through the Service Directory.",{"title":543,"searchDepth":544,"depth":544,"links":545},"",2,[546,547,548,549,550,551],{"id":280,"depth":544,"text":88},{"id":334,"depth":544,"text":335},{"id":379,"depth":544,"text":380},{"id":410,"depth":544,"text":411},{"id":435,"depth":544,"text":436},{"id":463,"depth":544,"text":464},"Learn about the different artifact types a Kinotic project can contribute -- from persistence and microservices to frontends.","md",null,{},true,{"title":59,"description":552},"1BaBm8041RP9SKrZbDluR-X4vi3Hvd-ND6RsIAx_opg",[560,562],{"title":55,"path":56,"stem":57,"description":561,"children":-1},"Learn how to configure Kinotic applications and the projects that compose them.",{"title":26,"path":69,"stem":70,"description":563,"children":-1},"How services work in Kinotic and the communication patterns they support.",1794107313805]