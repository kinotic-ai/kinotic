-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":177,"path":178,"stem":179,"icon":180},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":182,"path":183,"stem":184,"icon":185},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":187,"path":188,"stem":189,"icon":190},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":124,"icon":125,"path":192,"stem":193,"children":194,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[195],{"title":196,"path":197,"stem":198,"icon":199},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"id":201,"title":33,"body":202,"description":489,"extension":490,"links":491,"meta":492,"navigation":493,"path":34,"seo":494,"stem":35,"__hash__":495},"docs\u002F01.apps\u002F03.application-structure\u002F03.artifact-types.md",{"type":203,"value":204,"toc":479},"minimark",[205,214,218,221,226,250,255,266,269,273,280,284,292,296,311,314,318,321,325,333,337,345,349,352,356,361,365,370,374,377,381,386,390,398,402,405,476],[206,207,208,209,213],"p",{},"Every project in a Kinotic application contributes one or more ",[210,211,212],"strong",{},"artifacts",". An artifact is a typed output that the platform knows how to build, deploy, and manage. This page describes each artifact type and when to use it.",[215,216,59],"h2",{"id":217},"persistence",[206,219,220],{},"The most common starting point. A persistence artifact defines your domain models (entities) and gets auto-generated CRUD services in return.",[206,222,223],{},[210,224,225],{},"What you provide:",[227,228,229],"ul",{},[230,231,232,233,237,238,241,242,245,246,249],"li",{},"Entity classes decorated with ",[234,235,236],"code",{},"@Entity"," and field-level annotations like ",[234,239,240],{},"@NotNull",", ",[234,243,244],{},"@Precision",", and ",[234,247,248],{},"@AutoGeneratedId",".",[206,251,252],{},[210,253,254],{},"What the platform provides:",[227,256,257,260,263],{},[230,258,259],{},"Full CRUD operations (save, find, delete) with pagination and sorting.",[230,261,262],{},"Named queries derived from method naming conventions.",[230,264,265],{},"Automatic storage provisioning and indexing.",[206,267,268],{},"Persistence is typically the first artifact you create because it establishes the data model that the rest of the application builds on.",[215,270,272],{"id":271},"microservice","Microservice",[206,274,275,276,249],{},"A microservice artifact is long-running code that executes in a pod or VM. It publishes services that other parts of the application can discover and call through ",[277,278,279],"a",{"href":52},"service proxies",[206,281,282],{},[210,283,225],{},[227,285,286,289],{},[230,287,288],{},"TypeScript classes that implement your business logic.",[230,290,291],{},"Service interfaces that you want to expose to the rest of the application.",[206,293,294],{},[210,295,254],{},[227,297,298,301,308],{},[230,299,300],{},"Automatic service registration in the Service Directory.",[230,302,303,304,307],{},"Service discovery and zone-based routing so other projects can call your service through a ",[277,305,306],{"href":52},"service proxy"," with a simple function call.",[230,309,310],{},"Lifecycle management, scaling, and health monitoring.",[206,312,313],{},"Use a microservice when your logic goes beyond simple CRUD -- orchestrating across multiple entities, calling external APIs, or running long-lived workflows.",[215,315,317],{"id":316},"batch-job","Batch Job",[206,319,320],{},"A batch job artifact is code that runs on a schedule. It is ideal for periodic tasks like data aggregation, report generation, cleanup routines, or syncing with external systems.",[206,322,323],{},[210,324,225],{},[227,326,327,330],{},[230,328,329],{},"TypeScript code that performs the job.",[230,331,332],{},"A schedule definition (cron expression or interval).",[206,334,335],{},[210,336,254],{},[227,338,339,342],{},[230,340,341],{},"Scheduled execution with retry and failure handling.",[230,343,344],{},"Logging and observability for each run.",[215,346,348],{"id":347},"ui-component","UI Component",[206,350,351],{},"A UI component artifact produces reusable building blocks that can be shared across multiple frontends within the application. Think of it as an internal component library.",[206,353,354],{},[210,355,225],{},[227,357,358],{},[230,359,360],{},"Reusable UI components packaged for consumption by frontend projects.",[206,362,363],{},[210,364,254],{},[227,366,367],{},[230,368,369],{},"Versioning and distribution within the application.",[215,371,373],{"id":372},"frontend","Frontend",[206,375,376],{},"A frontend artifact is a complete user interface that gets deployed as a static site. It consumes services published by other projects in the application.",[206,378,379],{},[210,380,225],{},[227,382,383],{},[230,384,385],{},"A web application (built with any framework) that compiles to static assets.",[206,387,388],{},[210,389,254],{},[227,391,392,395],{},[230,393,394],{},"Static hosting with CDN distribution.",[230,396,397],{},"Automatic connection to the application's services through the Kinotic client libraries.",[215,399,401],{"id":400},"combining-artifact-types","Combining Artifact Types",[206,403,404],{},"Most real-world applications combine several artifact types. A typical setup might look like this:",[406,407,408,424],"table",{},[409,410,411],"thead",{},[412,413,414,418,421],"tr",{},[415,416,417],"th",{},"Project",[415,419,420],{},"Artifact Type",[415,422,423],{},"Role",[425,426,427,440,452,464],"tbody",{},[412,428,429,435,437],{},[430,431,432],"td",{},[234,433,434],{},"data",[430,436,59],{},[430,438,439],{},"Defines entities and provides auto-generated CRUD services",[412,441,442,447,449],{},[430,443,444],{},[234,445,446],{},"services",[430,448,272],{},[430,450,451],{},"Implements business rules that orchestrate across entities",[412,453,454,459,461],{},[430,455,456],{},[234,457,458],{},"jobs",[430,460,317],{},[430,462,463],{},"Runs nightly data aggregation",[412,465,466,471,473],{},[430,467,468],{},[234,469,470],{},"web",[430,472,373],{},[430,474,475],{},"The main user interface",[206,477,478],{},"Each project is independently developed and versioned, but they all deploy as part of the same application and communicate through the Service Directory.",{"title":480,"searchDepth":481,"depth":481,"links":482},"",2,[483,484,485,486,487,488],{"id":217,"depth":481,"text":59},{"id":271,"depth":481,"text":272},{"id":316,"depth":481,"text":317},{"id":347,"depth":481,"text":348},{"id":372,"depth":481,"text":373},{"id":400,"depth":481,"text":401},"Learn about the different artifact types a Kinotic project can contribute -- from persistence and microservices to frontends.","md",null,{},true,{"title":33,"description":489},"ks4mH_HWM4uaDA9Vwx-yIdl366mKkKWDw9PgfC_UDoU",[497,499],{"title":29,"path":30,"stem":31,"description":498,"children":-1},"Learn how to configure Kinotic applications and the projects that compose them.",{"title":25,"path":44,"stem":45,"description":500,"children":-1},"How services work in Kinotic and the communication patterns they support.",1787815542699]