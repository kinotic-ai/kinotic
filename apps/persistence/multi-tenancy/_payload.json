,226],"h2",{"id":225},"defining-a-multi-tenant-entity","Defining a Multi-Tenant Entity",[219,228,229,230,234,235,238],{},"Add ",[231,232,233],"code",{},"@TenantId"," to a field and set the entity to ",[231,236,237],{},"MultiTenancyType.SHARED",".",[240,241,246],"pre",{"className":242,"code":243,"language":244,"meta":245,"style":245},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[231,247,248,297,304,322,339,348,373,378,386,401,406,420,434],{"__ignoreMap":245},[249,250,253,257,261,265,268,271,273,276,278,281,284,287,290,294],"span",{"class":251,"line":252},"line",1,[249,254,256],{"class":255},"s7zQu","import",[249,258,260],{"class":259},"sMK4o"," {",[249,262,264],{"class":263},"sTEyZ"," Entity",[249,266,267],{"class":259},",",[249,269,270],{"class":263}," AutoGeneratedId",[249,272,267],{"class":259},[249,274,275],{"class":263}," TenantId",[249,277,267],{"class":259},[249,279,280],{"class":263}," MultiTenancyType",[249,282,283],{"class":259}," }",[249,285,286],{"class":255}," from",[249,288,289],{"class":259}," '",[249,291,293],{"class":292},"sfazB","@kinotic-ai\u002Fpersistence",[249,295,296],{"class":259},"'\n",[249,298,300],{"class":251,"line":299},2,[249,301,303],{"emptyLinePlaceholder":302},true,"\n",[249,305,307,310,314,317,319],{"class":251,"line":306},3,[249,308,309],{"class":259},"@",[249,311,313],{"class":312},"s2Zo4","Entity",[249,315,316],{"class":263},"(MultiTenancyType",[249,318,238],{"class":259},[249,320,321],{"class":263},"SHARED)\n",[249,323,325,328,332,336],{"class":251,"line":324},4,[249,326,327],{"class":255},"export",[249,329,331],{"class":330},"spNyl"," class",[249,333,335],{"class":334},"sBMFI"," Person",[249,337,338],{"class":259}," {\n",[249,340,342,345],{"class":251,"line":341},5,[249,343,344],{"class":259},"    @",[249,346,347],{"class":263},"AutoGeneratedId\n",[249,349,351,355,358,361,364,367,370],{"class":251,"line":350},6,[249,352,354],{"class":353},"swJcz","    id",[249,356,357],{"class":259},":",[249,359,360],{"class":334}," string",[249,362,363],{"class":259}," |",[249,365,366],{"class":334}," null",[249,368,369],{"class":259}," =",[249,371,372],{"class":259}," null\n",[249,374,376],{"class":251,"line":375},7,[249,377,303],{"emptyLinePlaceholder":302},[249,379,381,383],{"class":251,"line":380},8,[249,382,344],{"class":259},[249,384,385],{"class":263},"TenantId\n",[249,387,389,392,394,396,398],{"class":251,"line":388},9,[249,390,391],{"class":353},"    tenantId",[249,393,357],{"class":259},[249,395,360],{"class":334},[249,397,369],{"class":259},[249,399,400],{"class":259}," ''\n",[249,402,404],{"class":251,"line":403},10,[249,405,303],{"emptyLinePlaceholder":302},[249,407,409,412,414,416,418],{"class":251,"line":408},11,[249,410,411],{"class":353},"    firstName",[249,413,357],{"class":259},[249,415,360],{"class":334},[249,417,369],{"class":259},[249,419,400],{"class":259},[249,421,423,426,428,430,432],{"class":251,"line":422},12,[249,424,425],{"class":353},"    lastName",[249,427,357],{"class":259},[249,429,360],{"class":334},[249,431,369],{"class":259},[249,433,400],{"class":259},[249,435,437],{"class":251,"line":436},13,[249,438,439],{"class":259},"}\n",[219,441,442,443,445],{},"The ",[231,444,233],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[223,447,449],{"id":448},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[219,451,452,453,456],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and only when the owning application has ",[231,454,455],{},"tenantPerUser"," enabled — the setting that decides whether each user of the application is isolated or everyone shares one set of data.",[458,459,460,477],"table",{},[461,462,463],"thead",{},[464,465,466,472,474],"tr",{},[467,468,469,470],"th",{},"Application ",[231,471,455],{},[467,473,313],{},[467,475,476],{},"Result",[478,479,480,496,510,530],"tbody",{},[464,481,482,488,493],{},[483,484,485],"td",{},[231,486,487],{},"false",[483,489,490],{},[231,491,492],{},"MultiTenancyType.NONE",[483,494,495],{},"One shared dataset — every user sees every other user's rows",[464,497,498,503,507],{},[483,499,500],{},[231,501,502],{},"true",[483,504,505],{},[231,506,492],{},[483,508,509],{},"Still one shared dataset; the setting has nothing to act on",[464,511,512,516,524],{},[483,513,514],{},[231,515,487],{},[483,517,518,521,522],{},[231,519,520],{},"SHARED"," + ",[231,523,233],{},[483,525,526,527],{},"Users have no tenant, and writes fail with ",[231,528,529],{},"tenantId cannot be null or blank for shared multi tenancy",[464,531,532,536,542],{},[483,533,534],{},[231,535,502],{},[483,537,538,521,540],{},[231,539,520],{},[231,541,233],{},[483,543,544],{},"Each user isolated in their own tenant",[219,546,547,548,551,552,238],{},"Choose it when the application is created — ",[231,549,550],{},"createApplicationIfNotExist"," takes it as an argument — and change it afterwards only from the portal, under ",[553,554,555],"strong",{},"Application → Settings → Tenant per user",[219,557,558,559,561],{},"It applies to users created while it is enabled. Existing users are never backfilled, so enabling it on an application that already has users leaves those users without a tenant, and every write they make to a ",[231,560,520],{}," entity fails. Settle it before the application has users.",[223,563,565],{"id":564},"tenants-and-services","Tenants and services",[219,567,568,569,571],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[231,570,520],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[223,573,575],{"id":574},"tenant-isolated-repository","Tenant-Isolated Repository",[219,577,578,579,582],{},"The standard generated ",[231,580,581],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[240,584,586],{"className":242,"code":585,"language":244,"meta":245,"style":245},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[231,587,588,608,612,618],{"__ignoreMap":245},[249,589,590,593,596,599,602,605],{"class":251,"line":252},[249,591,592],{"class":330},"const",[249,594,595],{"class":263}," service ",[249,597,598],{"class":259},"=",[249,600,601],{"class":259}," new",[249,603,604],{"class":312}," PersonRepository",[249,606,607],{"class":263},"()\n",[249,609,610],{"class":251,"line":299},[249,611,303],{"emptyLinePlaceholder":302},[249,613,614],{"class":251,"line":306},[249,615,617],{"class":616},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[249,619,620,622,625,627,630,633,635,638,641,644,647,649,653,655,658,660,663,665],{"class":251,"line":324},[249,621,592],{"class":330},[249,623,624],{"class":263}," people ",[249,626,598],{"class":259},[249,628,629],{"class":255}," await",[249,631,632],{"class":263}," service",[249,634,238],{"class":259},[249,636,637],{"class":312},"findAll",[249,639,640],{"class":263},"(",[249,642,643],{"class":259},"{",[249,645,646],{"class":353}," page",[249,648,357],{"class":259},[249,650,652],{"class":651},"sbssI"," 0",[249,654,267],{"class":259},[249,656,657],{"class":353}," size",[249,659,357],{"class":259},[249,661,662],{"class":651}," 10",[249,664,283],{"class":259},[249,666,667],{"class":263},")\n",[219,669,670],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[223,672,674],{"id":673},"admin-repository","Admin Repository",[219,676,677,678,681,682,684,685,688,689,692],{},"When you run ",[231,679,680],{},"kinotic sync"," on an entity with a ",[231,683,233],{}," field, the CLI generates both a tenant-scoped repository (",[231,686,687],{},"PersonRepository",") and an admin repository (",[231,690,691],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[240,694,696],{"className":242,"code":695,"language":244,"meta":245,"style":245},"const adminService = new PersonAdminRepository()\n",[231,697,698],{"__ignoreMap":245},[249,699,700,702,705,707,709,712],{"class":251,"line":252},[249,701,592],{"class":330},[249,703,704],{"class":263}," adminService ",[249,706,598],{"class":259},[249,708,601],{"class":259},[249,710,711],{"class":312}," PersonAdminRepository",[249,713,607],{"class":263},[715,716,718],"h3",{"id":717},"access-all-tenants","Access All Tenants",[240,720,722],{"className":242,"code":721,"language":244,"meta":245,"style":245},"const allPeople = await adminService.findAll(['*'], { page: 0, size: 10 })\n",[231,723,724],{"__ignoreMap":245},[249,725,726,728,731,733,735,738,740,742,745,748,751,753,756,758,760,762,764,766,768,770,772,774,776],{"class":251,"line":252},[249,727,592],{"class":330},[249,729,730],{"class":263}," allPeople ",[249,732,598],{"class":259},[249,734,629],{"class":255},[249,736,737],{"class":263}," adminService",[249,739,238],{"class":259},[249,741,637],{"class":312},[249,743,744],{"class":263},"([",[249,746,747],{"class":259},"'",[249,749,750],{"class":292},"*",[249,752,747],{"class":259},[249,754,755],{"class":263},"]",[249,757,267],{"class":259},[249