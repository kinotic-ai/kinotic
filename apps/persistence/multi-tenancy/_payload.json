8],{},"Add ",[281,282,283],"code",{},"@TenantId"," to a field and set the entity to ",[281,286,287],{},"MultiTenancyType.SHARED",".",[290,291,296],"pre",{"className":292,"code":293,"language":294,"meta":295,"style":295},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[281,297,298,347,354,372,389,398,423,428,436,451,456,470,484],{"__ignoreMap":295},[299,300,303,307,311,315,318,321,323,326,328,331,334,337,340,344],"span",{"class":301,"line":302},"line",1,[299,304,306],{"class":305},"s7zQu","import",[299,308,310],{"class":309},"sMK4o"," {",[299,312,314],{"class":313},"sTEyZ"," Entity",[299,316,317],{"class":309},",",[299,319,320],{"class":313}," AutoGeneratedId",[299,322,317],{"class":309},[299,324,325],{"class":313}," TenantId",[299,327,317],{"class":309},[299,329,330],{"class":313}," MultiTenancyType",[299,332,333],{"class":309}," }",[299,335,336],{"class":305}," from",[299,338,339],{"class":309}," '",[299,341,343],{"class":342},"sfazB","@kinotic-ai\u002Fpersistence",[299,345,346],{"class":309},"'\n",[299,348,350],{"class":301,"line":349},2,[299,351,353],{"emptyLinePlaceholder":352},true,"\n",[299,355,357,360,364,367,369],{"class":301,"line":356},3,[299,358,359],{"class":309},"@",[299,361,363],{"class":362},"s2Zo4","Entity",[299,365,366],{"class":313},"(MultiTenancyType",[299,368,288],{"class":309},[299,370,371],{"class":313},"SHARED)\n",[299,373,375,378,382,386],{"class":301,"line":374},4,[299,376,377],{"class":305},"export",[299,379,381],{"class":380},"spNyl"," class",[299,383,385],{"class":384},"sBMFI"," Person",[299,387,388],{"class":309}," {\n",[299,390,392,395],{"class":301,"line":391},5,[299,393,394],{"class":309},"    @",[299,396,397],{"class":313},"AutoGeneratedId\n",[299,399,401,405,408,411,414,417,420],{"class":301,"line":400},6,[299,402,404],{"class":403},"swJcz","    id",[299,406,407],{"class":309},":",[299,409,410],{"class":384}," string",[299,412,413],{"class":309}," |",[299,415,416],{"class":384}," null",[299,418,419],{"class":309}," =",[299,421,422],{"class":309}," null\n",[299,424,426],{"class":301,"line":425},7,[299,427,353],{"emptyLinePlaceholder":352},[299,429,431,433],{"class":301,"line":430},8,[299,432,394],{"class":309},[299,434,435],{"class":313},"TenantId\n",[299,437,439,442,444,446,448],{"class":301,"line":438},9,[299,440,441],{"class":403},"    tenantId",[299,443,407],{"class":309},[299,445,410],{"class":384},[299,447,419],{"class":309},[299,449,450],{"class":309}," ''\n",[299,452,454],{"class":301,"line":453},10,[299,455,353],{"emptyLinePlaceholder":352},[299,457,459,462,464,466,468],{"class":301,"line":458},11,[299,460,461],{"class":403},"    firstName",[299,463,407],{"class":309},[299,465,410],{"class":384},[299,467,419],{"class":309},[299,469,450],{"class":309},[299,471,473,476,478,480,482],{"class":301,"line":472},12,[299,474,475],{"class":403},"    lastName",[299,477,407],{"class":309},[299,479,410],{"class":384},[299,481,419],{"class":309},[299,483,450],{"class":309},[299,485,487],{"class":301,"line":486},13,[299,488,489],{"class":309},"}\n",[269,491,492,493,495],{},"The ",[281,494,283],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[273,497,499],{"id":498},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[269,501,502,503,506,507,510,511,514],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and who assigns it is the application's ",[281,504,505],{},"tenantManagement"," setting: ",[281,508,509],{},"SYSTEM"," gives every user a tenant of their own at creation, ",[281,512,513],{},"TENANT_ADMINISTRATORS"," leaves tenants to the people who create them — a customer signing up, or the organization in the portal — whose administrators decide who joins.",[516,517,518,535],"table",{},[519,520,521],"thead",{},[522,523,524,530,532],"tr",{},[525,526,527,528],"th",{},"Application ",[281,529,505],{},[525,531,363],{},[525,533,534],{},"Result",[536,537,538,553,566,583],"tbody",{},[522,539,540,545,550],{},[541,542,543],"td",{},[281,544,513],{},[541,546,547],{},[281,548,549],{},"MultiTenancyType.NONE",[541,551,552],{},"One shared dataset — every user sees every other user's rows",[522,554,555,559,563],{},[541,556,557],{},[281,558,509],{},[541,560,561],{},[281,562,549],{},[541,564,565],{},"Still one shared dataset; the setting has nothing to act on",[522,567,568,572,580],{},[541,569,570],{},[281,571,513],{},[541,573,574,577,578],{},[281,575,576],{},"SHARED"," + ",[281,579,283],{},[541,581,582],{},"Each user isolated in the tenant it was added to; a user is never created without one",[522,584,585,589,595],{},[541,586,587],{},[281,588,509],{},[541,590,591,577,593],{},[281,592,576],{},[281,594,283],{},[541,596,597],{},"Each user isolated in their own tenant",[269,599,600,601,604,605,607,608,288],{},"Choose it when the application is created — ",[281,602,603],{},"createApplicationIfNotExist"," takes it as an argument, defaulting to ",[281,606,513],{}," — and change it afterwards only from the portal, under ",[609,610,611],"strong",{},"Application → Settings → Tenants",[269,613,614,616],{},[281,615,509],{}," applies to users created while it is in force. Existing users are never moved, so choosing it for an application that already has users leaves them in the tenants they were added to, beside the new users' tenants of their own. Settle it before the application has users.",[273,618,620],{"id":619},"tenants-and-their-sites","Tenants and their sites",[269,622,623,624,626,627,630,631,634,635,638,639,642,643,646,647,650,651,654,655,659,660,662,663,665],{},"Under ",[281,625,513],{}," a tenant is a ",[281,628,629],{},"Tenant"," of the application, created by your organization in the portal or through ",[281,632,633],{},"TenantService"," (",[281,636,637],{},"createTenantIfNotExist(applicationId, name, description)","), whose id is its slugified name: lowercase letters, digits and single dashes, at most 24 characters so it leads a hostname label, and unique within the application, so two of your applications may each have a tenant of the same id. The tenant's users carry that id as their ",[281,640,641],{},"tenantId",". Each of the application's published UIs is also served for the tenant at ",[281,644,645],{},"\u003CtenantId>--\u003CapplicationId>--\u003CuiName>"," under your organization's subdomain of the sites domain, and a sign-in from that site is to the tenant: it admits the tenant's users only, and offers the tenant's own identity providers (",[281,648,649],{},"TenantOidcConfiguration",", added for the tenant on the application's ",[609,652,653],{},"Settings → Sign-in providers"," tab in the portal) before the application's — see ",[656,657,126],"a",{"href":658},"\u002Fapps\u002Fsecurity\u002Fauthentication#signing-in-to-a-tenant",". A tenant whose users were created with a ",[281,661,641],{}," no ",[281,664,629],{}," row names has no login of its own until the row is created.",[269,667,623,668,670,671,675,676,678,679,683],{},[281,669,509],{}," tenants are minted per user and have no rows or sites; the user signs in at the application's own sites. It is the one under which new people may ",[656,672,674],{"href":673},"\u002Fapps\u002Fsecurity\u002Fauthentication#signing-up","sign up"," at the application's own login, since each new user gets a tenant of their own; under ",[281,677,513],{}," a person joins a tenant by being ",[656,680,682],{"href":681},"\u002Fapps\u002Fsecurity\u002Fauthentication#user-management","added to it"," or through one of the tenant's own providers that signs people up.",[273,685,687],{"id":686},"tenants-and-services","Tenants and services",[269,689,690,691,693],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[281,692,576],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[273,695,697],{"id":696},"tenant-isolated-repository","Tenant-Isolated Repository",[269,699,700,701,704],{},"The standard generated ",[281,702,703],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[290,706,708],{"className":292,"code":707,"language":294,"meta":295,"style":295},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[281,709,710,730,734,740],{"__ignoreMap":295},[299,711,712,715,718,721,724,727],{"class":301,"line":302},[299,713,714],{"class":380},"const",[299,716,717],{"class":313}," service ",[299,719,720],{"class":309},"=",[299,722,723],{"class":309}," new",[299,725,726],{"class":362}," PersonRepository",[299,728,729],{"class":313},"()\n",[299,731,732],{"class":301,"line":349},[299,733,353],{"emptyLinePlaceholder":352},[299,735,736],{"class":301,"line":356},[299,737,739],{"class":738},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[299,741,742,744,747,749,752,755,757,760,763,766,769,771,775,777,780,782,785,787],{"class":301,"line":374},[299,743,714],{"class":380},[299,745,746],{"class":313}," people ",[299,748,720],{"class":309},[299,750,751],{"class":305}," await",[299,753,754],{"class":313}," service",[299,756,288],{"class":309},[299,758,759],{"class":362},"findAll",[299,761,762],{"class":313},"(",[299,764,765],{"class":309},"{",[299,767,768],{"class":403}," page",[299,770,407],{"class":309},[299,772,774],{"class":773},"sbssI"," 0",[299,776,317],{"class":309},[299,778,779],{"class":403}," size",[299,781,407],{"class":309},[299,783,784],{"class":773}," 10",[299,786,333],{"class":309},[299,788,789],{"class":313},")\n",[269,791,792],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[273,794,796],{"id":795},"admin-repository","Admin Repository",[269,798,799,800,803,804,806,807,810,811,814],{},"When you run ",[281,801,802],{},"kinotic sync"," on an entity with a ",[281,805,283],{}," field, the CLI generates both a tenant-scoped repository (",[281,808,809],{},"PersonRepository",") and an admin repository (",[281,812,813],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[290,816,818],{"className":292,"code":817,"language":294,"meta":295,"style":295},"const adminService = new PersonAdminRepository()\n",[281,819,820],{"__ignoreMap":295},[299,821,822,824,827,829,831,834],{"class":301,"line":302},[299,823,714],{"class":380},[299,825,826],{"class":313}," adminService ",[299,828,720],{"class":309},[299,830,723],{"class":309},[299,832,833],{"class":362}," PersonAdminRepository",[299,835,729],{"class":313},[837,838,840],"h3",{"id":839},"access-all-tenants","Access All Tenants",[290,842,844],{"className":292,"code":843,"language":294,"meta":295,"style":295},"const allPeople = await adminService.findAll(['*'], { page: 0, size: 10 })\n",[281,845,846],{"__ignoreMap":295},[299,847,848,850,853,855,857,860,862,864,867,870,873,875,878,880,882,884,886,888,890,892,894,896,898],{"class":301,"line":302},[299,849,714],{"class":380},[299,851,852],{"class":313}," allPeople ",[299,854,720],{"class":309},[299,856,751],{"class":305},[299,858,859],{"class":313}," adminService",[299,861,288],{"class":309},[299,863,759],{"class":362},[299,865,866],{"class":313},"([",[299,868,869],{"class":309},"'",[299,871,872],{"class":342},"*",[299,874,869],{"class":309},[299,876,877],{"class":313},"]",[299,879,317],{"class":309},[299,881,310],{"class":309},[299,883,768],{"class":403},[299,885,407],{"class":309},[299,887,774],{"class":773},[299,889,317],{"class":309},[299,891,779],{"class":403},[299,893,407],{"class":309},[299,895,784],{"class":773},[299,897,333],{"class":309},[299,899,789],{"class":313},[837,901,903],{"id":902},"access-a-specific-tenant","Access a Specific Tenant",[290,905,907],{"className":292,"code":906,"language":294,"meta":295,"style":295},"const tenantPeople = await adminService.findAll(['tenant-123'], { page: 0, size: 10 })\n",[281,908,909],{"__ignoreMap":295},[299,910,911,913,916,918,920,922,924,926,928,930,933,935,937,939,941,943,945,947,949,951,953,955,957],{"class":301,"line":302},[299,912,714],{"class":380},[299,914,915],{"class":313}," tenantPeople ",[299,917,720],{"class":309},[299,919,751],{"class":305},[299,921,859],{"class":313},[299,923,288],{"class":309},[299,925,759],{"class":362},[299,927,866],{"class":313},[299,929,869],{"class":309},[299,931,932],{"class":342},"tenant-123",[299,934,869],{"class":309},[299,936,877],{"class":313},[299,938,317],{"class":309},[299,940,310],{"class":309},[299,942,768],{"class":403},[299,944,407],{"class":309},[299,946,774],{"class":773},[299,948,317],{"class":309},[299,950,779],{"class":403},[299,952,407],{"class":309},[299,954,784],{"class":773},[299,956,333],{"class":309},[299,958,789],{"class":313},[837,960,962],{"id":961},"access-multiple-tenants","Access Multiple Tenants",[290,964,966],{"className":292,"code":965,"language":294,"meta":295,"style":295},"const multiPeople = await adminService.findAll(['tenant-123', 'tenant-456'], { page: 0, size: 10 })\n",[281,967,968],{"__ignoreMap":295},[299,969,970,972,975,977,979,981,983,985,987,989,991,993,995,997,1000,1002,1004,1006,1008,1010,1012,1014,1016,1018,1020,1022,1024],{"class":301,"line":302},[299,971,714],{"class":380},[299,973,974],{"class":313}," multiPeople ",[299,976,720],{"class":309},[299,978,751],{"class":305},[299,980,859],{"class":313},[299,982,288],{"class":309},[299,984,759],{"class":362},[299,986,866],{"class":313},[299,988,869],{"class":309},[299,990,932],{"class":342},[299,992,869],{"class":309},[299,994,317],{"class":309},[299,996,339],{"class":309},[299,998,999],{"class":342},"tenant-456",[299,1001,869],{"class":309},[299,1003,877],{"class":313},[299,1005,317],{"class":309},[299,1007,310],{"class":309},[299,1009,768],{"class":403},[299,1011,407],{"class":309},[299,1013,774],{"class":773},[299,1015,317],{"class":309},[299,1017,779],{"class":403},[299,1019,407],{"class":309},[299,1021,784],{"class":773},[299,1023,333],{"class":309},[299,1025,789],{"class":313},[273,1027,1029],{"id":1028},"tenant-selection","Tenant Selection",[269,1031,1032],{},"Admin repository methods accept a tenant selection array as the first argument:",[516,1034,1035,1045],{},[519,1036,1037],{},[522,1038,1039,1042],{},[525,1040,1041],{},"Selection",[525,1043,1044],{},"Behavior",[536,1046,1047,1057,1067],{},[522,1048,1049,1054],{},[541,1050,1051],{},[281,1052,1053],{},"['*']",[541,1055,1056],{},"Access data from all tenants",[522,1058,1059,1064],{},[541,1060,1061],{},[281,1062,1063],{},"['tenant-123']",[541,1065,1066],{},"Access data from a single tenant",[522,1068,1069,1074],{},[541,1070,1071],{},[281,1072,1073],{},"['tenant-123', 'tenant-456']",[541,1075,1076],{},"Access data from multiple tenants",[273,1078,1080],{"id":1079},"security-considerations","Security Considerations",[269,1082,1083,1084,1088,1089,1091,1092,1094],{},"A participant that belongs to a tenant is confined to it. Through the admin repository, including its ",[656,1085,1087],{"href":1086},"\u002Fapps\u002Fpersistence\u002Fnamed-queries#admin-repository-queries","named queries",", it may select only its own tenant; naming another tenant, or ",[281,1090,1053],{},", is refused with an authorization error. On save, a blank ",[281,1093,283],{}," is filled with the participant's tenant and any other value is rejected. Selecting other tenants is possible only for a participant without a tenant, which is how a microservice in a project's deployment connects (organization scope), and such a participant must name the tenant of every entity it saves.",[269,1096,1097],{},"The standard tenant-isolated repository is the default and should be used for regular application logic.",[1099,1100,1101],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-