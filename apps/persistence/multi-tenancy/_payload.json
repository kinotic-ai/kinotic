 ",[282,283,284],"code",{},"@TenantId"," to a field and set the entity to ",[282,287,288],{},"MultiTenancyType.SHARED",".",[291,292,297],"pre",{"className":293,"code":294,"language":295,"meta":296,"style":296},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[282,298,299,348,355,373,390,399,424,429,437,452,457,471,485],{"__ignoreMap":296},[300,301,304,308,312,316,319,322,324,327,329,332,335,338,341,345],"span",{"class":302,"line":303},"line",1,[300,305,307],{"class":306},"s7zQu","import",[300,309,311],{"class":310},"sMK4o"," {",[300,313,315],{"class":314},"sTEyZ"," Entity",[300,317,318],{"class":310},",",[300,320,321],{"class":314}," AutoGeneratedId",[300,323,318],{"class":310},[300,325,326],{"class":314}," TenantId",[300,328,318],{"class":310},[300,330,331],{"class":314}," MultiTenancyType",[300,333,334],{"class":310}," }",[300,336,337],{"class":306}," from",[300,339,340],{"class":310}," '",[300,342,344],{"class":343},"sfazB","@kinotic-ai\u002Fpersistence",[300,346,347],{"class":310},"'\n",[300,349,351],{"class":302,"line":350},2,[300,352,354],{"emptyLinePlaceholder":353},true,"\n",[300,356,358,361,365,368,370],{"class":302,"line":357},3,[300,359,360],{"class":310},"@",[300,362,364],{"class":363},"s2Zo4","Entity",[300,366,367],{"class":314},"(MultiTenancyType",[300,369,289],{"class":310},[300,371,372],{"class":314},"SHARED)\n",[300,374,376,379,383,387],{"class":302,"line":375},4,[300,377,378],{"class":306},"export",[300,380,382],{"class":381},"spNyl"," class",[300,384,386],{"class":385},"sBMFI"," Person",[300,388,389],{"class":310}," {\n",[300,391,393,396],{"class":302,"line":392},5,[300,394,395],{"class":310},"    @",[300,397,398],{"class":314},"AutoGeneratedId\n",[300,400,402,406,409,412,415,418,421],{"class":302,"line":401},6,[300,403,405],{"class":404},"swJcz","    id",[300,407,408],{"class":310},":",[300,410,411],{"class":385}," string",[300,413,414],{"class":310}," |",[300,416,417],{"class":385}," null",[300,419,420],{"class":310}," =",[300,422,423],{"class":310}," null\n",[300,425,427],{"class":302,"line":426},7,[300,428,354],{"emptyLinePlaceholder":353},[300,430,432,434],{"class":302,"line":431},8,[300,433,395],{"class":310},[300,435,436],{"class":314},"TenantId\n",[300,438,440,443,445,447,449],{"class":302,"line":439},9,[300,441,442],{"class":404},"    tenantId",[300,444,408],{"class":310},[300,446,411],{"class":385},[300,448,420],{"class":310},[300,450,451],{"class":310}," ''\n",[300,453,455],{"class":302,"line":454},10,[300,456,354],{"emptyLinePlaceholder":353},[300,458,460,463,465,467,469],{"class":302,"line":459},11,[300,461,462],{"class":404},"    firstName",[300,464,408],{"class":310},[300,466,411],{"class":385},[300,468,420],{"class":310},[300,470,451],{"class":310},[300,472,474,477,479,481,483],{"class":302,"line":473},12,[300,475,476],{"class":404},"    lastName",[300,478,408],{"class":310},[300,480,411],{"class":385},[300,482,420],{"class":310},[300,484,451],{"class":310},[300,486,488],{"class":302,"line":487},13,[300,489,490],{"class":310},"}\n",[270,492,493,494,496],{},"The ",[282,495,284],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[274,498,500],{"id":499},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[270,502,503,504,507,508,511,512,515],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and who assigns it is the application's ",[282,505,506],{},"tenantManagement"," setting: ",[282,509,510],{},"SYSTEM"," gives every user a tenant of their own at creation, ",[282,513,514],{},"TENANT_ADMINISTRATORS"," leaves tenants to the people who create them — a customer signing up, or the organization in the portal — whose administrators decide who joins.",[517,518,519,536],"table",{},[520,521,522],"thead",{},[523,524,525,531,533],"tr",{},[526,527,528,529],"th",{},"Application ",[282,530,506],{},[526,532,364],{},[526,534,535],{},"Result",[537,538,539,554,567,587],"tbody",{},[523,540,541,546,551],{},[542,543,544],"td",{},[282,545,514],{},[542,547,548],{},[282,549,550],{},"MultiTenancyType.NONE",[542,552,553],{},"One shared dataset — every user sees every other user's rows",[523,555,556,560,564],{},[542,557,558],{},[282,559,510],{},[542,561,562],{},[282,563,550],{},[542,565,566],{},"Still one shared dataset; the setting has nothing to act on",[523,568,569,573,581],{},[542,570,571],{},[282,572,514],{},[542,574,575,578,579],{},[282,576,577],{},"SHARED"," + ",[282,580,284],{},[542,582,583,584],{},"A user created into no tenant has none, and its writes fail with ",[282,585,586],{},"tenantId cannot be null or blank for shared multi tenancy",[523,588,589,593,599],{},[542,590,591],{},[282,592,510],{},[542,594,595,578,597],{},[282,596,577],{},[282,598,284],{},[542,600,601],{},"Each user isolated in their own tenant",[270,603,604,605,608,609,611,612,289],{},"Choose it when the application is created — ",[282,606,607],{},"createApplicationIfNotExist"," takes it as an argument, defaulting to ",[282,610,514],{}," — and change it afterwards only from the portal, under ",[613,614,615],"strong",{},"Application → Settings → Tenants",[270,617,618,620,621,623],{},[282,619,510],{}," applies to users created while it is in force. Existing users are never backfilled, so choosing it for an application that already has users leaves those users without a tenant, and every write they make to a ",[282,622,577],{}," entity fails. Settle it before the application has users.",[274,625,627],{"id":626},"tenants-and-their-sites","Tenants and their sites",[270,629,630,631,633,634,637,638,641,642,645,646,649,650,653,654,657,658,661,662,666,667,669,670,672],{},"Under ",[282,632,514],{}," a tenant is a ",[282,635,636],{},"Tenant"," of the application, created by your organization in the portal or through ",[282,639,640],{},"TenantService"," (",[282,643,644],{},"createTenantIfNotExist(applicationId, name, description)","), whose id is its slugified name: lowercase letters, digits and single dashes, at most 24 characters so it leads a hostname label, and unique within your organization, so a name whose slug a tenant of another of your applications already holds is refused. The tenant's users carry that id as their ",[282,647,648],{},"tenantId",". Each of the application's published UIs is also served for the tenant at ",[282,651,652],{},"\u003CtenantId>--\u003CapplicationId>--\u003CuiName>"," under your organization's subdomain of the sites domain, and a sign-in from that site is to the tenant: it admits the tenant's users only, and offers the tenant's own identity providers (",[282,655,656],{},"TenantOidcConfiguration",", added for the tenant on the application's ",[613,659,660],{},"Settings → Sign-in providers"," tab in the portal) before the application's — see ",[663,664,127],"a",{"href":665},"\u002Fapps\u002Fsecurity\u002Fauthentication#signing-in-to-a-tenant",". A tenant whose users were created with a ",[282,668,648],{}," no ",[282,671,636],{}," row names has no login of its own until the row is created.",[270,674,630,675,677,678,682,683,685],{},[282,676,510],{}," tenants are minted per user and have no rows or sites; the user signs in at the application's own sites. It is the one under which new people may ",[663,679,681],{"href":680},"\u002Fapps\u002Fsecurity\u002Fauthentication#signing-up","sign up"," at the application's own login, since each new user gets a tenant of their own; under ",[282,684,514],{}," a person joins a tenant by invitation or through one of the tenant's own providers that signs people up.",[274,687,689],{"id":688},"tenants-and-services","Tenants and services",[270,691,692,693,695],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[282,694,577],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[274,697,699],{"id":698},"tenant-isolated-repository","Tenant-Isolated Repository",[270,701,702,703,706],{},"The standard generated ",[282,704,705],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[291,708,710],{"className":293,"code":709,"language":295,"meta":296,"style":296},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[282,711,712,732,736,742],{"__ignoreMap":296},[300,713,714,717,720,723,726,729],{"class":302,"line":303},[300,715,716],{"class":381},"const",[300,718,719],{"class":314}," service ",[300,721,722],{"class":310},"=",[300,724,725],{"class":310}," new",[300,727,728],{"class":363}," PersonRepository",[300,730,731],{"class":314},"()\n",[300,733,734],{"class":302,"line":350},[300,735,354],{"emptyLinePlaceholder":353},[300,737,738],{"class":302,"line":357},[300,739,741],{"class":740},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[300,743,744,746,749,751,754,757,759,762,765,768,771,773,777,779,782,784,787,789],{"class":302,"line":375},[300,745,716],{"class":381},[300,747,748],{"class":314}," people ",[300,750,722],{"class":310},[300,752,753],{"class":306}," await",[300,755,756],{"class":314}," service",[300,758,289],{"class":310},[300,760,761],{"class":363},"findAll",[300,763,764],{"class":314},"(",[300,766,767],{"class":310},"{",[300,769,770],{"class":404}," page",[300,772,408],{"class":310},[300,774,776],{"class":775},"sbssI"," 0",[300,778,318],{"class":310},[300,780,781],{"class":404}," size",[300,783,408],{"class":310},[300,785,786],{"class":775}," 10",[300,788,334],{"class":310},[300,790,791],{"class":314},")\n",[270,793,794],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[274,796,798],{"id":797},"admin-repository","Admin Repository",[270,800,801,802,805,806,808,809,812,813,816],{},"When you run ",[282,803,804],{},"kinotic sync"," on an entity with a ",[282,807,284],{}," field, the CLI generates both a tenant-scoped repository (",[282,810,811],{},"PersonRepository",") and an admin repository (",[282,814,815],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[291,818,820],{"className":293,"code":819,"language":295,"meta":296,"style":296},"const adminService = new PersonAdminRepository()\n",[282,821,822],{"__ignoreMap":296},[300,823,824,826,829,831,833,836],{"class":302,"line":303},[300,825,716],{"class":381},[300,827,828],{"class":314}," adminService ",[300,830,722],{"class":310},[300,832,725],{"class":310},[300,834,835],{"class":363}," PersonAdminRepository",[300,837,731],{"class":314},[839,840,842],"h3",{"id":841},"access-all-tenants","Access All Tenants",[291,844,846],{"className":293,"code":845,"language":295,"meta":296,"style":296},"const allPeople = await adminService.findAll(['*'], { page: 0, size: 10 })\n",[282,847,848],{"__ignoreMap":296},[300,849,850,852,855,857,859,862,864,866,869,872,875,877,880,882,884,886,888,890,892,894,896,898,900],{"class":302,"line":303},[300,851,716],{"class":381},[300,853,854],{"class":314}," allPeople ",[300,856,722],{"class":310},[300,858,753],{"class":306},[300,860,861],{"class":314}," adminService",[300,863,289],{"class":310},[300,865,761],{"class":363},[300,867,868],{"class":314},"([",[300,870,871],{"class":310},"'",[300,873,874],{"class":343},"*",[300,876,871],{"class":310},[300,878,879],{"class":314},"]",[300,881,318],{"class":310},[300,883,311],{"class":310},[300,885,770],{"class":404},[300,887,408],{"class":310},[300,889,776],{"class":775},[300,891,318],{"class":310},[300,893,781],{"class":404},[300,895,408],{"class":310},[300,897,786],{"class":775},[300,899,334],{"class":310},[300,901,791],{"class":314},[839,903,905],{"id":904},"access-a-specific-tenant","Access a Specific Tenant",[291,907,909],{"className":293,"code":908,"language":295,"meta":296,"style":296},"const tenantPeople = await adminService.findAll(['tenant-123'], { page: 0, size: 10 })\n",[282,910,911],{"__ignoreMap":296},[300,912,913,915,918,920,922,924,926,928,930,932,935,937,939,941,943,945,947,949,951,953,955,957,959],{"class":302,"line":303},[300,914,716],{"class":381},[300,916,917],{"class":314}," tenantPeople ",[300,919,722],{"class":310},[300,921,753],{"class":306},[300,923,861],{"class":314},[300,925,289],{"class":310},[300,927,761],{"class":363},[300,929,868],{"class":314},[300,931,871],{"class":310},[300,933,934],{"class":343},"tenant-123",[300,936,871],{"class":310},[300,938,879],{"class":314},[300,940,318],{"class":310},[300,942,311],{"class":310},[300,944,770],{"class":404},[300,946,408],{"class":310},[300,948,776],{"class":775},[300,950,318],{"class":310},[300,952,781],{"class":404},[300,954,408],{"class":310},[300,956,786],{"class":775},[300,958,334],{"class":310},[300,960,791],{"class":314},[839,962,964],{"id":963},"access-multiple-tenants","Access Multiple Tenants",[291,966,968],{"className":293,"code":967,"language":295,"meta":296,"style":296},"const multiPeople = await adminService.findAll(['tenant-123', 'tenant-456'], { page: 0, size: 10 })\n",[282,969,970],{"__ignoreMap":296},[300,971,972,974,977,979,981,983,985,987,989,991,993,995,997,999,1002,1004,1006,1008,1010,1012,1014,1016,1018,1020,1022,1024,1026],{"class":302,"line":303},[300,973,716],{"class":381},[300,975,976],{"class":314}," multiPeople ",[300,978,722],{"class":310},[300,980,753],{"class":306},[300,982,861],{"class":314},[300,984,289],{"class":310},[300,986,761],{"class":363},[300,988,868],{"class":314},[300,990,871],{"class":310},[300,992,934],{"class":343},[300,994,871],{"class":310},[300,996,318],{"class":310},[300,998,340],{"class":310},[300,1000,1001],{"class":343},"tenant-456",[300,1003,871],{"class":310},[300,1005,879],{"class":314},[300,1007,318],{"class":310},[300,1009,311],{"class":310},[300,1011,770],{"class":404},[300,1013,408],{"class":310},[300,1015,776],{"class":775},[300,1017,318],{"class":310},[300,1019,781],{"class":404},[300,1021,408],{"class":310},[300,1023,786],{"class":775},[300,1025,334],{"class":310},[300,1027,791],{"class":314},[274,1029,1031],{"id":1030},"tenant-selection","Tenant Selection",[270,1033,1034],{},"Admin repository methods accept a tenant selection array as the first argument:",[517,1036,1037,1047],{},[520,1038,1039],{},[523,1040,1041,1044],{},[526,1042,1043],{},"Selection",[526,1045,1046],{},"Behavior",[537,1048,1049,1059,1069],{},[523,1050,1051,1056],{},[542,1052,1053],{},[282,1054,1055],{},"['*']",[542,1057,1058],{},"Access data from all tenants",[523,1060,1061,1066],{},[542,1062,1063],{},[282,1064,1065],{},"['tenant-123']",[542,1067,1068],{},"Access data from a single tenant",[523,1070,1071,1076],{},[542,1072,1073],{},[282,1074,1075],{},"['tenant-123', 'tenant-456']",[542,1077,1078],{},"Access data from multiple tenants",[274,1080,1082],{"id":1081},"security-considerations","Security Considerations",[270,1084,1085,1086,1090,1091,1093,1094,1096],{},"A participant that belongs to a tenant is confined to it. Through the admin repository, including its ",[663,1087,1089],{"href":1088},"\u002Fapps\u002Fpersistence\u002Fnamed-queries#admin-repository-queries","named queries",", it may select only its own tenant; naming another tenant, or ",[282,1092,1055],{},", is refused with an authorization error. On save, a blank ",[282,1095,284],{}," is filled with the participant's tenant and any other value is rejected. Selecting other tenants is possible only for a participant without a tenant, which is how a microservice in a project's deployment connects (organization scope), and such a participant must name the tenant of every entity it saves.",[270,1098,1099],{},"The standard tenant-isolated repository is the default and should be used for regular application logic.",[1101,1102,1103],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration