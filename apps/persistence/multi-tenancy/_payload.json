n Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":233,"path":234,"stem":235,"icon":236},"Enterprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":238,"title":84,"body":239,"description":1091,"extension":1092,"links":1093,"meta":1094,"navigation":326,"path":85,"seo":1095,"stem":86,"__hash__":1096},"docs\u002F01.apps\u002F05.persistence\u002F06.multi-tenancy.md",{"type":240,"value":241,"toc":1077},"minimark",[242,246,251,263,464,470,474,489,575,589,597,601,646,659,663,669,673,680,765,768,772,790,811,816,875,879,934,938,1001,1005,1008,1052,1056,1070,1073],[243,244,245],"p",{},"Kinotic supports multi-tenant data isolation at the persistence layer. Data from different tenants is stored together but automatically filtered so each tenant only sees their own data.",[247,248,250],"h2",{"id":249},"defining-a-multi-tenant-entity","Defining a Multi-Tenant Entity",[243,252,253,254,258,259,262],{},"Add ",[255,256,257],"code",{},"@TenantId"," to a field and set the entity to ",[255,260,261],{},"MultiTenancyType.SHARED",".",[264,265,270],"pre",{"className":266,"code":267,"language":268,"meta":269,"style":269},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[255,271,272,321,328,346,363,372,397,402,410,425,430,444,458],{"__ignoreMap":269},[273,274,277,281,285,289,292,295,297,300,302,305,308,311,314,318],"span",{"class":275,"line":276},"line",1,[273,278,280],{"class":279},"s7zQu","import",[273,282,284],{"class":283},"sMK4o"," {",[273,286,288],{"class":287},"sTEyZ"," Entity",[273,290,291],{"class":283},",",[273,293,294],{"class":287}," AutoGeneratedId",[273,296,291],{"class":283},[273,298,299],{"class":287}," TenantId",[273,301,291],{"class":283},[273,303,304],{"class":287}," MultiTenancyType",[273,306,307],{"class":283}," }",[273,309,310],{"class":279}," from",[273,312,313],{"class":283}," '",[273,315,317],{"class":316},"sfazB","@kinotic-ai\u002Fpersistence",[273,319,320],{"class":283},"'\n",[273,322,324],{"class":275,"line":323},2,[273,325,327],{"emptyLinePlaceholder":326},true,"\n",[273,329,331,334,338,341,343],{"class":275,"line":330},3,[273,332,333],{"class":283},"@",[273,335,337],{"class":336},"s2Zo4","Entity",[273,339,340],{"class":287},"(MultiTenancyType",[273,342,262],{"class":283},[273,344,345],{"class":287},"SHARED)\n",[273,347,349,352,356,360],{"class":275,"line":348},4,[273,350,351],{"class":279},"export",[273,353,355],{"class":354},"spNyl"," class",[273,357,359],{"class":358},"sBMFI"," Person",[273,361,362],{"class":283}," {\n",[273,364,366,369],{"class":275,"line":365},5,[273,367,368],{"class":283},"    @",[273,370,371],{"class":287},"AutoGeneratedId\n",[273,373,375,379,382,385,388,391,394],{"class":275,"line":374},6,[273,376,378],{"class":377},"swJcz","    id",[273,380,381],{"class":283},":",[273,383,384],{"class":358}," string",[273,386,387],{"class":283}," |",[273,389,390],{"class":358}," null",[273,392,393],{"class":283}," =",[273,395,396],{"class":283}," null\n",[273,398,400],{"class":275,"line":399},7,[273,401,327],{"emptyLinePlaceholder":326},[273,403,405,407],{"class":275,"line":404},8,[273,406,368],{"class":283},[273,408,409],{"class":287},"TenantId\n",[273,411,413,416,418,420,422],{"class":275,"line":412},9,[273,414,415],{"class":377},"    tenantId",[273,417,381],{"class":283},[273,419,384],{"class":358},[273,421,393],{"class":283},[273,423,424],{"class":283}," ''\n",[273,426,428],{"class":275,"line":427},10,[273,429,327],{"emptyLinePlaceholder":326},[273,431,433,436,438,440,442],{"class":275,"line":432},11,[273,434,435],{"class":377},"    firstName",[273,437,381],{"class":283},[273,439,384],{"class":358},[273,441,393],{"class":283},[273,443,424],{"class":283},[273,445,447,450,452,454,456],{"class":275,"line":446},12,[273,448,449],{"class":377},"    lastName",[273,451,381],{"class":283},[273,453,384],{"class":358},[273,455,393],{"class":283},[273,457,424],{"class":283},[273,459,461],{"class":275,"line":460},13,[273,462,463],{"class":283},"}\n",[243,465,466,467,469],{},"The ",[255,468,257],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[247,471,473],{"id":472},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[243,475,476,477,480,481,484,485,488],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and who assigns it is the application's ",[255,478,479],{},"tenantManagement"," setting: ",[255,482,483],{},"SYSTEM"," gives every user a tenant of their own at creation, ",[255,486,487],{},"TENANT_ADMINISTRATORS"," leaves tenants to the people who create them — a customer signing up, or the organization in the portal — whose administrators decide who joins.",[490,491,492,509],"table",{},[493,494,495],"thead",{},[496,497,498,504,506],"tr",{},[499,500,501,502],"th",{},"Application ",[255,503,479],{},[499,505,337],{},[499,507,508],{},"Result",[510,511,512,527,540,560],"tbody",{},[496,513,514,519,524],{},[515,516,517],"td",{},[255,518,487],{},[515,520,521],{},[255,522,523],{},"MultiTenancyType.NONE",[515,525,526],{},"One shared dataset — every user sees every other user's rows",[496,528,529,533,537],{},[515,530,531],{},[255,532,483],{},[515,534,535],{},[255,536,523],{},[515,538,539],{},"Still one shared dataset; the setting has nothing to act on",[496,541,542,546,554],{},[515,543,544],{},[255,545,487],{},[515,547,548,551,552],{},[255,549,550],{},"SHARED"," + ",[255,553,257],{},[515,555,556,557],{},"A user created into no tenant has none, and its writes fail with ",[255,558,559],{},"tenantId cannot be null or blank for shared multi tenancy",[496,561,562,566,572],{},[515,563,564],{},[255,565,483],{},[515,567,568,551,570],{},[255,569,550],{},[255,571,257],{},[515,573,574],{},"Each user isolated in their own tenant",[243,576,577,578,581,582,584,585,262],{},"Choose it when the application is created — ",[255,579,580],{},"createApplicationIfNotExist"," takes it as an argument, defaulting to ",[255,583,487],{}," — and change it afterwards only from the portal, under ",[586,587,588],"strong",{},"Application → Settings → Tenants",[243,590,591,593,594,596],{},[255,592,483],{}," applies to users created while it is in force. Existing users are never backfilled, so choosing it for an application that already has users leaves those users without a tenant, and every write they make to a ",[255,595,550],{}," entity fails. Settle it before the application has users.",[247,598,600],{"id":599},"tenants-and-their-sites","Tenants and their sites",[243,602,603,604,606,607,610,611,614,615,618,619,622,623,626,627,630,631,634,635,639,640,642,643,645],{},"Under ",[255,605,487],{}," a tenant is a ",[255,608,609],{},"Tenant"," of the application, created by your organization in the portal or through ",[255,612,613],{},"TenantService"," (",[255,616,617],{},"createTenantIfNotExist(applicationId, name, description)","), whose id is its slugified name: lowercase letters, digits and single dashes, at most 24 characters so it leads a hostname label, and unique within your organization, so a name whose slug a tenant of another of your applications already holds is refused. The tenant's users carry that id as their ",[255,620,621],{},"tenantId",". Each of the application's published UIs is also served for the tenant at ",[255,624,625],{},"\u003CtenantId>--\u003CapplicationId>--\u003CuiName>"," under your organization's subdomain of the sites domain, and a sign-in from that site is to the tenant: it admits the tenant's users only, and offers the tenant's own identity providers (",[255,628,629],{},"TenantOidcConfiguration",", added for the tenant on the application's ",[586,632,633],{},"Settings → Sign-in providers"," tab in the portal) before the application's — see ",[636,637,98],"a",{"href":638},"\u002Fapps\u002Fsecurity\u002Fauthentication#signing-in-to-a-tenant",". A tenant whose users were created with a ",[255,641,621],{}," no ",[255,644,609],{}," row names has no login of its own until the row is created.",[243,647,603,648,650,651,655,656,658],{},[255,649,483],{}," tenants are minted per user and have no rows or sites; the user signs in at the application's own sites. It is the one under which new people may ",[636,652,654],{"href":653},"\u002Fapps\u002Fsecurity\u002Fauthentication#signing-up","sign up"," at the application's own login, since each new user gets a tenant of their own; under ",[255,657,487],{}," a person joins a tenant by invitation or through one of the tenant's own providers that signs people up.",[247,660,662],{"id":661},"tenants-and-services","Tenants and services",[243,664,665,666,668],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[255,667,550],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[247,670,672],{"id":671},"tenant-isolated-repository","Tenant-Isolated Repository",[243,674,675,676,679],{},"The standard generated ",[255,677,678],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[264,681,683],{"className":266,"code":682,"language":268,"meta":269,"style":269},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[255,684,685,705,709,715],{"__ignoreMap":269},[273,686,687,690,693,696,699,702],{"class":275,"line":276},[273,688,689],{"class":354},"const",[273,691,692],{"class":287}," service ",[273,694,695],{"class":283},"=",[273,697,698],{"class":283}," new",[273,700,701],{"class":336}," PersonRepository",[273,703,704],{"class":287},"()\n",[273,706,707],{"class":275,"line":323},[273,708,327],{"emptyLinePlaceholder":326},[273,710,711],{"class":275,"line":330},[273,712,714],{"class":713},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[273,716,717,719,722,724,727,730,732,735,738,741,744,746,750,752,755,757,760,762],{"class":275,"line":348},[273,718,689],{"class":354},[273,720,721],{"class":287}," people ",[273,723,695],{"class":283},[273,725,726],{"class":279}," await",[273,728,729],{"class":287}," service",[273,731,262],{"class":283},[273,733,734],{"class":336},"findAll",[273,736,737],{"class":287},"(",[273,739,740],{"class":283},"{",[273,742,743],{"class":377}," page",[273,745,381],{"class":283},[273,747,749],{"class":748},"sbssI"," 0",[273,751,291],{"class":283},[273,753,754],{"class":377}," size",[273,756,381],{"class":283},[273,758,759],{"class":748}," 10",[273,761,307],{"class":283},[273,763,764],{"class":287},")\n",[243,766,767],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[247,769,771],{"id":770},"admin-repository","Admin Repository",[243,773,774,775,778,779,781,782,785,786,789],{},"When you run ",[255,776,777],{},"kinotic sync"," on an entity with a ",[255,780,257],{}," field, the CLI generates both a tenant-scoped repository (",[255,783,784],{},"PersonRepository",") and an admin repository (",[255,787,788],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[264,791,793],{"className":266,"code":792,"language":268,"meta":269,"style":269},"const adminService = new PersonAdminRepository()\n",[255,794,795],{"__ignoreMap":269},[273,796,797,799,802,804,806,809],{"class":275,"line":276},[273,798,689],{"class":354},[273,800,801],{"class":287}," adminService ",[273,803,695],{"class":283},[273,805,698],{"class":283},[273,807,808],{"class":336}," PersonAdminRepository",[273,810,704],{"class":287},[812,813,815],"h3",{"id":814},"access-all-tenants","Access All Tenants",[264,817,819],{"className":266,"code":818,"language":268,"meta":269,"style":269},"const allPeople = await adminService.findAll(['*'], { page: 0, size: 10 })\n",[255,820,821],{"__ignoreMap":269},[273,822,823,825,828,830,832,835,837,839,842,845,848,850,853,855,857,859,861,863,865,867,869,871,873],{"class":275,"line":276},[273,824,689],{"class":354},[273,826,827],{"class":287}," allPeople ",[273,829,695],{"class":283},[273,831,726],{"class":279},[273,833,834],{"class":287}," adminService",[273,836,262],{"class":283},[273,838,734],{"class":336},[273,840,841],{"class":287},"([",[273,843,844],{"class":283},"'",[273,846,847],{"class":316},"*",[273,849,844],{"class":283},[273,851,852],{"class":287},"]",[273,854,291],{"class":283},[273,856,284],{"class":283},[273,858,743],{"class":377},[273,860,381],{"class":283},[273,862,749],{"class":748},[273,864,291],{"class":283},[273,866,754],{"class":377},[273,868,381],{"class":283},[273,870,759],{"class":748},[273,872,307],{"class":283},[273,874,764],{"class":287},[812,876,878],{"id":877},"access-a-specific-tenant","Access a Specific Tenant",[264,880,882],{"className":266,"code":881,"language":268,"meta":269,"style":269},"const tenantPeople = await adminService.findAll(['tenant-123'], { page: 0, size: 10 })\n",[255,883,884],{"__ignoreMap":269},[273,885,886,888,891,893,895,897,899,901,903,905,908,910,912,914,916,918,920,922,924,926,928,930,932],{"class":275,"line":276},[273,887,689],{"class":354},[273,889,890],{"class":287}," te