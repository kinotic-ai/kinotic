oc":976},"minimark",[228,232,237,249,450,456,460,467,555,566,572,576,582,586,593,678,681,685,703,724,729,788,792,847,851,914,918,921,965,969,972],[229,230,231],"p",{},"Kinotic supports multi-tenant data isolation at the persistence layer. Data from different tenants is stored together but automatically filtered so each tenant only sees their own data.",[233,234,236],"h2",{"id":235},"defining-a-multi-tenant-entity","Defining a Multi-Tenant Entity",[229,238,239,240,244,245,248],{},"Add ",[241,242,243],"code",{},"@TenantId"," to a field and set the entity to ",[241,246,247],{},"MultiTenancyType.SHARED",".",[250,251,256],"pre",{"className":252,"code":253,"language":254,"meta":255,"style":255},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[241,257,258,307,314,332,349,358,383,388,396,411,416,430,444],{"__ignoreMap":255},[259,260,263,267,271,275,278,281,283,286,288,291,294,297,300,304],"span",{"class":261,"line":262},"line",1,[259,264,266],{"class":265},"s7zQu","import",[259,268,270],{"class":269},"sMK4o"," {",[259,272,274],{"class":273},"sTEyZ"," Entity",[259,276,277],{"class":269},",",[259,279,280],{"class":273}," AutoGeneratedId",[259,282,277],{"class":269},[259,284,285],{"class":273}," TenantId",[259,287,277],{"class":269},[259,289,290],{"class":273}," MultiTenancyType",[259,292,293],{"class":269}," }",[259,295,296],{"class":265}," from",[259,298,299],{"class":269}," '",[259,301,303],{"class":302},"sfazB","@kinotic-ai\u002Fpersistence",[259,305,306],{"class":269},"'\n",[259,308,310],{"class":261,"line":309},2,[259,311,313],{"emptyLinePlaceholder":312},true,"\n",[259,315,317,320,324,327,329],{"class":261,"line":316},3,[259,318,319],{"class":269},"@",[259,321,323],{"class":322},"s2Zo4","Entity",[259,325,326],{"class":273},"(MultiTenancyType",[259,328,248],{"class":269},[259,330,331],{"class":273},"SHARED)\n",[259,333,335,338,342,346],{"class":261,"line":334},4,[259,336,337],{"class":265},"export",[259,339,341],{"class":340},"spNyl"," class",[259,343,345],{"class":344},"sBMFI"," Person",[259,347,348],{"class":269}," {\n",[259,350,352,355],{"class":261,"line":351},5,[259,353,354],{"class":269},"    @",[259,356,357],{"class":273},"AutoGeneratedId\n",[259,359,361,365,368,371,374,377,380],{"class":261,"line":360},6,[259,362,364],{"class":363},"swJcz","    id",[259,366,367],{"class":269},":",[259,369,370],{"class":344}," string",[259,372,373],{"class":269}," |",[259,375,376],{"class":344}," null",[259,378,379],{"class":269}," =",[259,381,382],{"class":269}," null\n",[259,384,386],{"class":261,"line":385},7,[259,387,313],{"emptyLinePlaceholder":312},[259,389,391,393],{"class":261,"line":390},8,[259,392,354],{"class":269},[259,394,395],{"class":273},"TenantId\n",[259,397,399,402,404,406,408],{"class":261,"line":398},9,[259,400,401],{"class":363},"    tenantId",[259,403,367],{"class":269},[259,405,370],{"class":344},[259,407,379],{"class":269},[259,409,410],{"class":269}," ''\n",[259,412,414],{"class":261,"line":413},10,[259,415,313],{"emptyLinePlaceholder":312},[259,417,419,422,424,426,428],{"class":261,"line":418},11,[259,420,421],{"class":363},"    firstName",[259,423,367],{"class":269},[259,425,370],{"class":344},[259,427,379],{"class":269},[259,429,410],{"class":269},[259,431,433,436,438,440,442],{"class":261,"line":432},12,[259,434,435],{"class":363},"    lastName",[259,437,367],{"class":269},[259,439,370],{"class":344},[259,441,379],{"class":269},[259,443,410],{"class":269},[259,445,447],{"class":261,"line":446},13,[259,448,449],{"class":269},"}\n",[229,451,452,453,455],{},"The ",[241,454,243],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[233,457,459],{"id":458},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[229,461,462,463,466],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and only when the owning application has ",[241,464,465],{},"tenantPerUser"," enabled — the setting that decides whether each user of the application is isolated or everyone shares one set of data.",[468,469,470,487],"table",{},[471,472,473],"thead",{},[474,475,476,482,484],"tr",{},[477,478,479,480],"th",{},"Application ",[241,481,465],{},[477,483,323],{},[477,485,486],{},"Result",[488,489,490,506,520,540],"tbody",{},[474,491,492,498,503],{},[493,494,495],"td",{},[241,496,497],{},"false",[493,499,500],{},[241,501,502],{},"MultiTenancyType.NONE",[493,504,505],{},"One shared dataset — every user sees every other user's rows",[474,507,508,513,517],{},[493,509,510],{},[241,511,512],{},"true",[493,514,515],{},[241,516,502],{},[493,518,519],{},"Still one shared dataset; the setting has nothing to act on",[474,521,522,526,534],{},[493,523,524],{},[241,525,497],{},[493,527,528,531,532],{},[241,529,530],{},"SHARED"," + ",[241,533,243],{},[493,535,536,537],{},"Users have no tenant, and writes fail with ",[241,538,539],{},"tenantId cannot be null or blank for shared multi tenancy",[474,541,542,546,552],{},[493,543,544],{},[241,545,512],{},[493,547,548,531,550],{},[241,549,530],{},[241,551,243],{},[493,553,554],{},"Each user isolated in their own tenant",[229,556,557,558,561,562,248],{},"Choose it when the application is created — ",[241,559,560],{},"createApplicationIfNotExist"," takes it as an argument — and change it afterwards only from the portal, under ",[563,564,565],"strong",{},"Application → Settings → Tenant per user",[229,567,568,569,571],{},"It applies to users created while it is enabled. Existing users are never backfilled, so enabling it on an application that already has users leaves those users without a tenant, and every write they make to a ",[241,570,530],{}," entity fails. Settle it before the application has users.",[233,573,575],{"id":574},"tenants-and-services","Tenants and services",[229,577,578,579,581],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[241,580,530],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[233,583,585],{"id":584},"tenant-isolated-repository","Tenant-Isolated Repository",[229,587,588,589,592],{},"The standard generated ",[241,590,591],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[250,594,596],{"className":252,"code":595,"language":254,"meta":255,"style":255},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[241,597,598,618,622,628],{"__ignoreMap":255},[259,599,600,603,606,609,612,615],{"class":261,"line":262},[259,601,602],{"class":340},"const",[259,604,605],{"class":273}," service ",[259,607,608],{"class":269},"=",[259,610,611],{"class":269}," new",[259,613,614],{"class":322}," PersonRepository",[259,616,617],{"class":273},"()\n",[259,619,620],{"class":261,"line":309},[259,621,313],{"emptyLinePlaceholder":312},[259,623,624],{"class":261,"line":316},[259,625,627],{"class":626},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[259,629,630,632,635,637,640,643,645,648,651,654,657,659,663,665,668,670,673,675],{"class":261,"line":334},[259,631,602],{"class":340},[259,633,634],{"class":273}," people ",[259,636,608],{"class":269},[259,638,639],{"class":26