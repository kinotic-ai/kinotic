tension":1010,"links":1011,"meta":1012,"navigation":317,"path":85,"seo":1013,"stem":86,"__hash__":1014},"docs\u002F01.apps\u002F05.persistence\u002F06.multi-tenancy.md",{"type":231,"value":232,"toc":996},"minimark",[233,237,242,254,455,461,465,472,560,571,577,581,587,591,598,683,686,690,708,729,734,793,797,852,856,919,923,926,970,974,989,992],[234,235,236],"p",{},"Kinotic supports multi-tenant data isolation at the persistence layer. Data from different tenants is stored together but automatically filtered so each tenant only sees their own data.",[238,239,241],"h2",{"id":240},"defining-a-multi-tenant-entity","Defining a Multi-Tenant Entity",[234,243,244,245,249,250,253],{},"Add ",[246,247,248],"code",{},"@TenantId"," to a field and set the entity to ",[246,251,252],{},"MultiTenancyType.SHARED",".",[255,256,261],"pre",{"className":257,"code":258,"language":259,"meta":260,"style":260},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[246,262,263,312,319,337,354,363,388,393,401,416,421,435,449],{"__ignoreMap":260},[264,265,268,272,276,280,283,286,288,291,293,296,299,302,305,309],"span",{"class":266,"line":267},"line",1,[264,269,271],{"class":270},"s7zQu","import",[264,273,275],{"class":274},"sMK4o"," {",[264,277,279],{"class":278},"sTEyZ"," Entity",[264,281,282],{"class":274},",",[264,284,285],{"class":278}," AutoGeneratedId",[264,287,282],{"class":274},[264,289,290],{"class":278}," TenantId",[264,292,282],{"class":274},[264,294,295],{"class":278}," MultiTenancyType",[264,297,298],{"class":274}," }",[264,300,301],{"class":270}," from",[264,303,304],{"class":274}," '",[264,306,308],{"class":307},"sfazB","@kinotic-ai\u002Fpersistence",[264,310,311],{"class":274},"'\n",[264,313,315],{"class":266,"line":314},2,[264,316,318],{"emptyLinePlaceholder":317},true,"\n",[264,320,322,325,329,332,334],{"class":266,"line":321},3,[264,323,324],{"class":274},"@",[264,326,328],{"class":327},"s2Zo4","Entity",[264,330,331],{"class":278},"(MultiTenancyType",[264,333,253],{"class":274},[264,335,336],{"class":278},"SHARED)\n",[264,338,340,343,347,351],{"class":266,"line":339},4,[264,341,342],{"class":270},"export",[264,344,346],{"class":345},"spNyl"," class",[264,348,350],{"class":349},"sBMFI"," Person",[264,352,353],{"class":274}," {\n",[264,355,357,360],{"class":266,"line":356},5,[264,358,359],{"class":274},"    @",[264,361,362],{"class":278},"AutoGeneratedId\n",[264,364,366,370,373,376,379,382,385],{"class":266,"line":365},6,[264,367,369],{"class":368},"swJcz","    id",[264,371,372],{"class":274},":",[264,374,375],{"class":349}," string",[264,377,378],{"class":274}," |",[264,380,381],{"class":349}," null",[264,383,384],{"class":274}," =",[264,386,387],{"class":274}," null\n",[264,389,391],{"class":266,"line":390},7,[264,392,318],{"emptyLinePlaceholder":317},[264,394,396,398],{"class":266,"line":395},8,[264,397,359],{"class":274},[264,399,400],{"class":278},"TenantId\n",[264,402,404,407,409,411,413],{"class":266,"line":403},9,[264,405,406],{"class":368},"    tenantId",[264,408,372],{"class":274},[264,410,375],{"class":349},[264,412,384],{"class":274},[264,414,415],{"class":274}," ''\n",[264,417,419],{"class":266,"line":418},10,[264,420,318],{"emptyLinePlaceholder":317},[264,422,424,427,429,431,433],{"class":266,"line":423},11,[264,425,426],{"class":368},"    firstName",[264,428,372],{"class":274},[264,430,375],{"class":349},[264,432,384],{"class":274},[264,434,415],{"class":274},[264,436,438,441,443,445,447],{"class":266,"line":437},12,[264,439,440],{"class":368},"    lastName",[264,442,372],{"class":274},[264,444,375],{"class":349},[264,446,384],{"class":274},[264,448,415],{"class":274},[264,450,452],{"class":266,"line":451},13,[264,453,454],{"class":274},"}\n",[234,456,457,458,460],{},"The ",[246,459,248],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[238,462,464],{"id":463},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[234,466,467,468,471],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and only when the owning application has ",[246,469,470],{},"tenantPerUser"," enabled — the setting that decides whether each user of the application is isolated or everyone shares one set of data.",[473,474,475,492],"table",{},[476,477,478],"thead",{},[479,480,481,487,489],"tr",{},[482,483,484,485],"th",{},"Application ",[246,486,470],{},[482,488,328],{},[482,490,491],{},"Result",[493,494,495,511,525,545],"tbody",{},[479,496,497,503,508],{},[498,499,500],"td",{},[246,501,502],{},"false",[498,504,505],{},[246,506,507],{},"MultiTenancyType.NONE",[498,509,510],{},"One shared dataset — every user sees every other user's rows",[479,512,513,518,522],{},[498,514,515],{},[246,516,517],{},"true",[498,519,520],{},[246,521,507],{},[498,523,524],{},"Still one shared dataset; the setting has nothing to act on",[479,526,527,531,539],{},[498,528,529],{},[246,530,502],{},[498,532,533,536,537],{},[246,534,535],{},"SHARED"," + ",[246,538,248],{},[498,540,541,542],{},"Users have no tenant, and writes fail with ",[246,543,544],{},"tenantId cannot be null or blank for shared multi tenancy",[479,546,547,551,557],{},[498,548,549],{},[246,550,517],{},[498,552,553,536,555],{},[246,554,535],{},[246,556,248],{},[498,558,559],{},"Each user isolated in their own tenant",[234,561,562,563,566,567,253],{},"Choose it when the application is created — ",[246,564,565],{},"createApplicationIfNotExist"," takes it as an argument — and change it afterwards only from the portal, under ",[568,569,570],"strong",{},"Application → Settings → Tenant per user",[234,572,573,574,576],{},"It applies to users created while it is enabled. Existing users are never backfilled, so enabling it on an application that already has users leaves those users without a tenant, and every write they make to a ",[246,575,535],{}," entity fails. Settle it before the application has users.",[238,578,580],{"id":579},"tenants-and-services","Tenants and services",[234,582,583,584,586],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[246,585,535],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[238,588,590],{"id":589},"tenant-isolated-repository","Tenant-Isolated Repository",[234,592,593,594,597],{},"The standard generated ",[246,595,596],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[255,599,601],{"className":257,"code":600,"language":259,"meta":260,"style":260},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[246,602,603,623,627,633],{"__ignoreMap":260},[264,604,605,608,611,614,617,620],{"class":266,"line":267},[264,606,607],{"class":345},"const",[264,609,610],{"class":278}," service ",[264,612,613],{"class":274},"=",[264,615,616],{"class":274}," new",[264,618,619],{"class":327}," PersonRepository",[264,621,622],{"class":278},"()\n",[264,624,625],{"class":266,"line":314},[264,626,318],{"emptyLinePlaceholder":317},[264,628,629],{"class":266,"line":321},[264,630,632],{"class":631},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[264,634,635,637,640,642,645,648,650,653,656,659,662,664,668,670,673,675,678,680],{"class":266,"line":339},[264,636,607],{"class":345},[264,638,639],{"class":278}," people ",[264,641,613],{"class":274},[264,643,644],{"class":270}," await",[264,646,647],{"class":278}," service",[264,649,253],{"class":274},[264,651,652],{"class":327},"findAll",[264,654,655],{"class":278},"(",[264,657,658],{"class":274},"{",[264,660,661],{"class":368}," page",[264,663,372],{"class":274},[264,665,667],{"class":666},"sbssI"," 0",[264,669,282],{"class":274},[264,671,672],{"class":368}," size",[264,674,372],{"class":274},[264,676,677],{"class":666}," 10",[264,679,298],{"class":274},[264,681,682],{"class":278},")\n",[234,684,685],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[238,687,689],{"id":688},"admin-repository","Admin Repository",[234,691,692,693,696,697,699,700,703,704,707],{},"When you run ",[246,694,695],{},"kinotic sync"," on an entity with a ",[246,698,248],{}," field, the CLI generates both a tenant-scoped repository (",[246,701,702],{},"PersonRepository",") and an admin repository (",[246,705,706],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[255,709,711],{"className":257,"code":710,"language":259,"meta":260,"style":260},"const adminService = new PersonAdminRepository()\n",[246,712,713],{"__ignoreMap":260},[264,714,715,717,720,722,724,727],{"class":266,"line":267},[264,716,607],{"class":345},[264,718,719],{"class":278}," adminService ",[264,721,613],{"class":274},[264,723,616],{"class":274},[264,725,726],{"class":327}," PersonAdminRepository",[264,728,622],{"class":278},[730,731,733],"h3",{"id":732},"access-all-tenants","Access All Tenants",[255,735,737],{"className":257,"code":736,"language":259,"meta":260,"style":260},"const allPeople = await adminService.findAll(['*'], { page: 0, size: 10 })\n",[246,738,739],