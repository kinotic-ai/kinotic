efense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":128,"icon":129,"path":196,"stem":197,"children":198,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[199,204,209],{"title":200,"path":201,"stem":202,"icon":203},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"title":205,"path":206,"stem":207,"icon":208},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F11.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":210,"path":211,"stem":212,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F11.reference\u002F03.project-publishing-design",{"id":214,"title":88,"body":215,"description":771,"extension":772,"links":773,"meta":774,"navigation":775,"path":89,"seo":776,"stem":90,"__hash__":777},"docs\u002F01.apps\u002F05.persistence\u002F07.migrations.md",{"type":216,"value":217,"toc":754},"minimark",[218,227,232,235,245,248,267,274,278,295,298,302,323,327,332,335,343,347,350,359,363,366,375,379,382,397,401,404,411,438,444,467,477,518,525,533,537,540,549,553,556,565,568,598,618,622,625,634,637,652,659,679,683,686,695,699,745,750],[219,220,221,222,226],"p",{},"Migrations let you evolve your data schema in a controlled, versioned way. They are written in a SQL-like syntax and executed automatically during ",[223,224,225],"code",{},"kinotic sync",".",[228,229,231],"h2",{"id":230},"file-naming","File Naming",[219,233,234],{},"Migration files follow a strict naming convention:",[236,237,242],"pre",{"className":238,"code":240,"language":241},[239],"language-text","V\u003Cnumber>__\u003Cdescription>.sql\n","text",[223,243,240],{"__ignoreMap":244},"",[219,246,247],{},"Examples:",[249,250,251,257,262],"ul",{},[252,253,254],"li",{},[223,255,256],{},"V1__initial_schema.sql",[252,258,259],{},[223,260,261],{},"V2__add_email_field.sql",[252,263,264],{},[223,265,266],{},"V3__create_sensor_readings.sql",[219,268,269,270,273],{},"The version number determines execution order. The double underscore (",[223,271,272],{},"__",") separates the version from the description.",[228,275,277],{"id":276},"how-it-works","How It Works",[279,280,281,284,287,290],"ol",{},[252,282,283],{},"Migration files are discovered and sorted by version number",[252,285,286],{},"Only unapplied migrations are parsed and executed",[252,288,289],{},"Each migration is recorded after successful execution to prevent re-runs",[252,291,292,293],{},"Migrations run during ",[223,294,225],{},[219,296,297],{},"A migration file containing a syntax error fails the entire migration run — nothing from that file is applied and the file is not recorded. The error names the file, line, and offending token.",[228,299,301],{"id":300},"example-migration","Example Migration",[236,303,307],{"className":304,"code":305,"language":306,"meta":244,"style":244},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- V1__initial_schema.sql\nCREATE TABLE users (name TEXT, age INTEGER, active BOOLEAN);\n","sql",[223,308,309,317],{"__ignoreMap":244},[310,311,314],"span",{"class":312,"line":313},"line",1,[310,315,316],{},"-- V1__initial_schema.sql\n",[310,318,320],{"class":312,"line":319},2,[310,321,322],{},"CREATE TABLE users (name TEXT, age INTEGER, active BOOLEAN);\n",[228,324,326],{"id":325},"supported-statements","Supported Statements",[328,329,331],"h3",{"id":330},"create-table","CREATE TABLE",[219,333,334],{},"Create a new table with field mappings.",[236,336,337],{"className":304,"code":322,"language":306,"meta":244,"style":244},[223,338,339],{"__ignoreMap":244},[310,340,341],{"class":312,"line":313},[310,342,322],{},[328,344,346],{"id":345},"create-component-template","CREATE COMPONENT TEMPLATE",[219,348,349],{},"Define reusable templates with settings that can be applied to multiple tables.",[236,351,353],{"className":304,"code":352,"language":306,"meta":244,"style":244},"CREATE COMPONENT TEMPLATE my_settings (NUMBER_OF_SHARDS = 1, NUMBER_OF_REPLICAS = 0);\n",[223,354,355],{"__ignoreMap":244},[310,356,357],{"class":312,"line":313},[310,358,352],{},[328,360,362],{"id":361},"create-index-template","CREATE INDEX TEMPLATE",[219,364,365],{},"Create templates that automatically apply to tables matching a name pattern.",[236,367,369],{"className":304,"code":368,"language":306,"meta":244,"style":244},"CREATE INDEX TEMPLATE my_template FOR 'logs-*' USING 'my_settings';\n",[223,370,371],{"__ignoreMap":244},[310,372,373],{"class":312,"line":313},[310,374,368],{},[328,376,378],{"id":377},"alter-table-add-column","ALTER TABLE ADD COLUMN",[219,380,381],{},"Add new fields to an existing table. Composite types are supported — you can add an OBJECT, NESTED, or UNION column just like any other type.",[236,383,385],{"className":304,"code":384,"language":306,"meta":244,"style":244},"ALTER TABLE users ADD COLUMN email TEXT;\nALTER TABLE users ADD COLUMN address OBJECT (street TEXT, city KEYWORD, zip KEYWORD);\n",[223,386,387,392],{"__ignoreMap":244},[310,388,389],{"class":312,"line":313},[310,390,391],{},"ALTER TABLE users ADD COLUMN email TEXT;\n",[310,393,394],{"class":312,"line":319},[310,395,396],{},"ALTER TABLE users ADD COLUMN address OBJECT (street TEXT, city KEYWORD, zip KEYWORD);\n",[328,398,400],{"id":399},"composite-column-types","Composite Column Types",[219,402,403],{},"In addition to scalar types, columns can be structured objects.",[219,405,406,410],{},[407,408,409],"strong",{},"OBJECT"," — a single embedded sub-document:",[236,412,414],{"className":304,"code":413,"language":306,"meta":244,"style":244},"CREATE TABLE persons (\n    id KEYWORD,\n    address OBJECT (street TEXT, city KEYWORD, state KEYWORD, zip KEYWORD)\n);\n",[223,415,416,421,426,432],{"__ignoreMap":244},[310,417,418],{"class":312,"line":313},[310,419,420],{},"CREATE TABLE persons (\n",[310,422,423],{"class":312,"line":319},[310,424,425],{},"    id KEYWORD,\n",[310,427,429],{"class":312,"line":428},3,[310,430,431],{},"    address OBJECT (street TEXT, city KEYWORD, state KEYWORD, zip KEYWORD)\n",[310,433,435],{"class":312,"line":434},4,[310,436,437],{},");\n",[219,439,440,443],{},[407,441,442],{},"NESTED"," — an array of independently-queryable sub-documents. Use this when a field holds a list of items and you need to filter on individual list entries without cross-element matching:",[236,445,447],{"className":304,"code":446,"language":306,"meta":244,"style":244},"CREATE TABLE articles (\n    id KEYWORD,\n    tags NESTED (label TEXT, value KEYWORD)\n);\n",[223,448,449,454,458,463],{"__ignoreMap":244},[310,450,451],{"class":312,"line":313},[310,452,453],{},"CREATE TABLE articles (\n",[310,455,456],{"class":312,"line":319},[310,457,425],{},[310,459,460],{"class":312,"line":428},[310,461,462],{},"    tags NESTED (label TEXT, value KEYWORD)\n",[310,464,465],{"class":312,"line":434},[310,466,437],{},[219,468,469,472,473,476],{},[407,470,471],{},"UNION"," — a field that can hold one of several named object variants. All variant fields are merged into a single object. Include a shared field (e.g. ",[223,474,475],{},"kind KEYWORD",") in each variant so your application can identify which variant it received at runtime:",[236,478,480],{"className":304,"code":479,"language":306,"meta":244,"style":244},"CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n",[223,481,482,487,491,496,501,507,513],{"__ignoreMap":244},[310,483,484],{"class":312,"line":313},[310,485,486],{},"CREATE TABLE assets (\n",[310,488,489],{"class":312,"line":319},[310,490,425],{},[310,492,493],{"class":312,"line":428},[310,494,495],{},"    item UNION (\n",[310,497,498],{"class":312,"line":434},[310,499,500],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[310,502,504],{"class":312,"line":503},5,[310,505,506],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[310,508,510],{"class":312,"line":509},6,[310,511,512],{},"    )\n",[310,514,516],{"class":312,"line":515},7,[310,517,437],{},[219,519,520,521,524],{},"All composite types support ",[223,522,523],{},"NOT INDEXED"," (except NESTED) to store data without making it searchable. They also support recursive nesting — an OBJECT inside a NESTED, for example, is valid.",[219,526,527,528,226],{},"For the complete syntax and options, see the ",[529,530,532],"a",{"href":531},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#composite-types","Migration SQL Grammar Reference",[328,534,536],{"id":535},"reindex","REINDEX",[219,538,539],{},"Migrate data between tables with advanced options.",[236,541,543],{"className":304,"code":542,"language":306,"meta":244,"style":244},"REINDEX old_index INTO new_index WITH (SKIP_IF_NO_SOURCE = TRUE);\n",[223,544,545],{"__ignoreMap":244},[310,546,547],{"class":312,"line":313},[310,548,542],{},[328,550,552],{"id":551},"insert-into","INSERT INTO",[219,554,555],{},"Add records to a table.",[236,557,559],{"className":304,"code":558,"language":306,"meta":244,"style":244},"INSERT INTO users (name, age, active) VALUES ('Jane', 28, true) WITH REFRESH;\n",[223,560,561],{"__ignoreMap":244},[310,562,563],{"class":312,"line":313},[310,564,558],{},[219,566,567],{},"Composite columns take an object literal, and a NESTED column an array of them:",[236,569,571],{"className":304,"code":570,"language":306,"meta":244,"style":244},"INSERT INTO persons (id, address, tags) VALUES (\n    'p-1',\n    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n) WITH REFRESH;\n",[223,572,573,578,583,588,593],{"__ignoreMap":244},[310,574,575],{"class":312,"line":313},[310,576,577],{},"INSERT INTO persons (id, address, tags) VALUES (\n",[310,579,580],{"class":312,"line":319},[310,581,582],{},"    'p-1',\n",[310,584,585],{"class":312,"line":428},[310,586,587],{},"    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n",[310,589,590],{"class":312,"line":434},[310,591,592],{},"    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n",[310,594,595],{"class":312,"line":503},[310,596,597],{},") WITH REFRESH;\n",[599,600,602,603,606,607,609,610,612,613,617],"callout",{"type":601},"warning","If your table has a logical ",[223,604,605],{},"id"," field, always include the ",[223,608,605],{}," column in the INSERT. The value becomes the document's storage identifier, which is how find-by-id lookups resolve the document. An INSERT that omits ",[223,611,605],{}," stores the row with a random identifier and it can only be located via search — not via a direct id lookup. See the ",[529,614,616],{"href":615},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#the-id-column","Migration SQL Grammar reference"," for details.",[328,619,621],{"id":620},"update-set-where","UPDATE ... SET ... WHERE",[219,623,624],{},"Modify existing records.",[236,626,628],{"className":304,"code":627,"language":306,"meta":244,"style":244},"UPDATE users SET active = false WHERE age \u003C 18 WITH REFRESH;\n",[223,629,630],{"__ignoreMap":244},[310,631,632],{"class":312,"line":313},[310,633,627],{},[219,635,636],{},"A composite column is set from the same literals INSERT uses. An object literal merges into the\nstored object — recursively, and leaving sub-fields it does not mention alone — so you can change\none sub-field by naming only that one. Arrays and scalars are replaced outright:",[236,638,640],{"className":304,"code":639,"language":306,"meta":244,"style":244},"-- street keeps its stored value; only city changes\nUPDATE persons SET address = { city: 'Shelbyville' } WHERE id == 'p-1' WITH REFRESH;\n",[223,641,642,647],{"__ignoreMap":244},[310,643,644],{"class":312,"line":313},[310,645,646],{},"-- street keeps its stored value; only city changes\n",[310,648,649],{"class":312,"line":319},[310,650,651],{},"UPDATE persons SET address = { city: 'Shelbyville' } WHERE id == 'p-1' WITH REFRESH;\n",[219,653,654,655,658],{},"Since omitting a sub-field keeps it, ",[223,656,657],{},"null"," is what clears one. The literal's nesting addresses the\nfield, so any depth is reachable:",[236,660,662],{"className":304,"code":661,"language":306,"meta":244,"style":244},"UPDATE persons SET address = { street: null } WHERE id == 'p-1' WITH REFRESH;          -- address.street\nUPDATE persons SET address = { coords: { lat: null } } WHERE id == 'p-1' WITH REFRESH; -- address.coords.lat\nUPDATE persons SET nickname = null WHERE id == 'p-1' WITH REFRESH;                     -- the whole column\n",[223,663,664,669,674],{"__ignoreMap":244},[310,665,666],{"class":312,"line":313},[310,667,668],{},"UPDATE persons SET address = { street: null } WHERE id == 'p-1' WITH REFRESH;          -- address.street\n",[310,670,671],{"class":312,"line":319},[310,672,673],{},"UPDATE persons SET address = { coords: { lat: null } } WHERE id == 'p-1' WITH REFRESH; -- address.coords.lat\n",[310,675,676],{"class":312,"line":428},[310,677,678],{},"UPDATE persons SET nickname = null WHERE id == 'p-1' WITH REFRESH;                     -- the whole column\n",[328,680,682],{"id":681},"delete-from-where","DELETE FROM ... WHERE",[219,684,685],{},"Remove records matching a condition.",[236,687,689],{"className":304,"code":688,"language":306,"meta":244,"style":244},"DELETE FROM users WHERE active == false WITH REFRESH;\n",[223,690,691],{"__ignoreMap":244},[310,692,693],{"class":312,"line":313},[310,694,688],{},[228,696,698],{"id":697},"best-practices","Best Practices",[249,700,701,707,717,725,733,739],{},[252,702,703,706],{},[407,704,705],{},"Increment version numbers sequentially"," - Gaps are allowed but order must be maintained",[252,708,709,716],{},[407,710,711,712,715],{},"Use ",[223,713,714],{},"IF NOT EXISTS"," where available"," - Makes migrations safe to re-run if the tracking state is reset",[252,718,719,724],{},[407,720,711,721],{},[223,722,723],{},"WITH REFRESH"," on INSERT, UPDATE, and DELETE when subsequent migrations depend on the changed data being immediately visible",[252,726,727,732],{},[407,728,711,729],{},[223,730,731],{},"SKIP_IF_NO_SOURCE = TRUE"," on REINDEX operations for idempotent data migrations",[252,734,735,738],{},[407,736,737],{},"Keep migrations small and focused"," - One logical change per migration file",[252,740,741,744],{},[407,742,743],{},"Never modify a migration after it has been applied"," - Create a new migration instead",[219,746,747,748,226],{},"For the complete SQL grammar reference, see the ",[529,749,532],{"href":140},[751,752,753],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-dec