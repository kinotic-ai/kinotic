tform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"title":224,"path":225,"stem":226,"icon":227},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"id":229,"title":88,"body":230,"description":786,"extension":787,"links":788,"meta":789,"navigation":790,"path":89,"seo":791,"stem":90,"__hash__":792},"docs\u002F01.apps\u002F05.persistence\u002F07.migrations.md",{"type":231,"value":232,"toc":769},"minimark",[233,242,247,250,260,263,282,289,293,310,313,317,338,342,347,350,358,362,365,374,378,381,390,394,397,412,416,419,426,453,459,482,492,533,540,548,552,555,564,568,571,580,583,613,633,637,640,649,652,667,674,694,698,701,710,714,760,765],[234,235,236,237,241],"p",{},"Migrations let you evolve your data schema in a controlled, versioned way. They are written in a SQL-like syntax and executed automatically during ",[238,239,240],"code",{},"kinotic sync",".",[243,244,246],"h2",{"id":245},"file-naming","File Naming",[234,248,249],{},"Migration files follow a strict naming convention:",[251,252,257],"pre",{"className":253,"code":255,"language":256},[254],"language-text","V\u003Cnumber>__\u003Cdescription>.sql\n","text",[238,258,255],{"__ignoreMap":259},"",[234,261,262],{},"Examples:",[264,265,266,272,277],"ul",{},[267,268,269],"li",{},[238,270,271],{},"V1__initial_schema.sql",[267,273,274],{},[238,275,276],{},"V2__add_email_field.sql",[267,278,279],{},[238,280,281],{},"V3__create_sensor_readings.sql",[234,283,284,285,288],{},"The version number determines execution order. The double underscore (",[238,286,287],{},"__",") separates the version from the description.",[243,290,292],{"id":291},"how-it-works","How It Works",[294,295,296,299,302,305],"ol",{},[267,297,298],{},"Migration files are discovered and sorted by version number",[267,300,301],{},"Only unapplied migrations are parsed and executed",[267,303,304],{},"Each migration is recorded after successful execution to prevent re-runs",[267,306,307,308],{},"Migrations run during ",[238,309,240],{},[234,311,312],{},"A migration file containing a syntax error fails the entire migration run — nothing from that file is applied and the file is not recorded. The error names the file, line, and offending token.",[243,314,316],{"id":315},"example-migration","Example Migration",[251,318,322],{"className":319,"code":320,"language":321,"meta":259,"style":259},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- V1__initial_schema.sql\nCREATE TABLE users (name TEXT, age INTEGER, active BOOLEAN);\n","sql",[238,323,324,332],{"__ignoreMap":259},[325,326,329],"span",{"class":327,"line":328},"line",1,[325,330,331],{},"-- V1__initial_schema.sql\n",[325,333,335],{"class":327,"line":334},2,[325,336,337],{},"CREATE TABLE users (name TEXT, age INTEGER, active BOOLEAN);\n",[243,339,341],{"id":340},"supported-statements","Supported Statements",[343,344,346],"h3",{"id":345},"create-table","CREATE TABLE",[234,348,349],{},"Create a new table with field mappings.",[251,351,352],{"className":319,"code":337,"language":321,"meta":259,"style":259},[238,353,354],{"__ignoreMap":259},[325,355,356],{"class":327,"line":328},[325,357,337],{},[343,359,361],{"id":360},"create-component-template","CREATE COMPONENT TEMPLATE",[234,363,364],{},"Define reusable templates with settings that can be applied to multiple tables.",[251,366,368],{"className":319,"code":367,"language":321,"meta":259,"style":259},"CREATE COMPONENT TEMPLATE my_settings (NUMBER_OF_SHARDS = 1, NUMBER_OF_REPLICAS = 0);\n",[238,369,370],{"__ignoreMap":259},[325,371,372],{"class":327,"line":328},[325,373,367],{},[343,375,377],{"id":376},"create-index-template","CREATE INDEX TEMPLATE",[234,379,380],{},"Create templates that automatically apply to tables matching a name pattern.",[251,382,384],{"className":319,"code":383,"language":321,"meta":259,"style":259},"CREATE INDEX TEMPLATE my_template FOR 'logs-*' USING 'my_settings';\n",[238,385,386],{"__ignoreMap":259},[325,387,388],{"class":327,"line":328},[325,389,383],{},[343,391,393],{"id":392},"alter-table-add-column","ALTER TABLE ADD COLUMN",[234,395,396],{},"Add new fields to an existing table. Composite types are supported — you can add an OBJECT, NESTED, or UNION column just like any other type.",[251,398,400],{"className":319,"code":399,"language":321,"meta":259,"style":259},"ALTER TABLE users ADD COLUMN email TEXT;\nALTER TABLE users ADD COLUMN address OBJECT (street TEXT, city KEYWORD, zip KEYWORD);\n",[238,401,402,407],{"__ignoreMap":259},[325,403,404],{"class":327,"line":328},[325,405,406],{},"ALTER TABLE users ADD COLUMN email TEXT;\n",[325,408,409],{"class":327,"line":334},[325,410,411],{},"ALTER TABLE users ADD COLUMN address OBJECT (street TEXT, city KEYWORD, zip KEYWORD);\n",[343,413,415],{"id":414},"composite-column-types","Composite Column Types",[234,417,418],{},"In addition to scalar types, columns can be structured objects.",[234,420,421,425],{},[422,423,424],"strong",{},"OBJECT"," — a single embedded sub-document:",[251,427,429],{"className":319,"code":428,"language":321,"meta":259,"style":259},"CREATE TABLE persons (\n    id KEYWORD,\n    address OBJECT (street TEXT, city KEYWORD, state KEYWORD, zip KEYWORD)\n);\n",[238,430,431,436,441,447],{"__ignoreMap":259},[325,432,433],{"class":327,"line":328},[325,434,435],{},"CREATE TABLE persons (\n",[325,437,438],{"class":327,"line":334},[325,439,440],{},"    id KEYWORD,\n",[325,442,444],{"class":327,"line":443},3,[325,445,446],{},"    address OBJECT (street TEXT, city KEYWORD, state KEYWORD, zip KEYWORD)\n",[325,448,450],{"class":327,"line":449},4,[325,451,452],{},");\n",[234,454,455,458],{},[422,456,457],{},"NESTED"," — an array of independently-queryable sub-documents. Use this when a field holds a list of items and you need to filter on individual list entries without cross-element matching:",[251,460,462],{"className":319,"code":461,"language":321,"meta":259,"style":259},"CREATE TABLE articles (\n    id KEYWORD,\n    tags NESTED (label TEXT, value KEYWORD)\n);\n",[238,463,464,469,473,478],{"__ignoreMap":259},[325,465,466],{"class":327,"line":328},[325,467,468],{},"CREATE TABLE articles (\n",[325,470,471],{"class":327,"line":334},[325,472,440],{},[325,474,475],{"class":327,"line":443},[325,476,477],{},"    tags NESTED (label TEXT, value KEYWORD)\n",[325,479,480],{"class":327,"line":449},[325,481,452],{},[234,483,484,487,488,491],{},[422,485,486],{},"UNION"," — a field that can hold one of several named object variants. All variant fields are merged into a single object. Include a shared field (e.g. ",[238,489,490],{},"kind KEYWORD",") in each variant so your application can identify which variant it received at runtime:",[251,493,495],{"className":319,"code":494,"language":321,"meta":259,"style":259},"CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n",[238,496,497,502,506,511,516,522,528],{"__ignoreMap":259},[325,498,499],{"class":327,"line":328},[325,500,501],{},"CREATE TABLE assets (\n",[325,503,504],{"class":327,"line":334},[325,505,440],{},[325,507,508],{"class":327,"line":443},[325,509,510],{},"    item UNION (\n",[325,512,513],{"class":327,"line":449},[325,514,515],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[325,517,519],{"class":327,"line":518},5,[325,520,521],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[325,523,525],{"class":327,"line":524},6,[325,526,527],{},"    )\n",[325,529,531],{"class":327,"line":530},7,[325,532,452],{},[234,534,535,536,539],{},"All composite types support ",[238,537,538],{},"NOT INDEXED"," (except NESTED) to store data without making it searchable. They also support recursive nesting — an OBJECT inside a NESTED, for example, is valid.",[234,541,542,543,241],{},"For the complete syntax and options, see the ",[544,545,547],"a",{"href":546},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#composite-types","Migration SQL Grammar Reference",[343,549,551],{"id":550},"reindex","REINDEX",[234,553,554],{},"Migrate data between tables with advanced options.",[251,556,558],{"className":319,"code":557,"language":321,"meta":259,"style":259},"REINDEX old_index INTO new_index WITH (SKIP_IF_NO_SOURCE = TRUE);\n",[238,559,560],{"__ignoreMap":259},[325,561,562],{"class":327,"line":328},[325,563,557],{},[343,565,567],{"id":566},"insert-into","INSERT INTO",[234,569,570],{},"Add records to a table.",[251,572,574],{"className":319,"code":573,"language":321,"meta":259,"style":259},"INSERT INTO users (name, age, active) VALUES ('Jane', 28, true) WITH REFRESH;\n",[238,575,576],{"__ignoreMap":259},[325,577,578],{"class":327,"line":328},[325,579,573],{},[234,581,582],{},"Composite columns take an object literal, and a NESTED column an array of them:",[251,584,586],{"className":319,"code":585,"language":321,"meta":259,"style":259},"INSERT INTO persons (id, address, tags) VALUES (\n    'p-1',\n    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n) WITH REFRESH;\n",[238,587,588,593,598,603,608],{"__ignoreMap":259},[325,589,590],{"class":327,"line":328},[325,591,592],{},"INSERT INTO persons (id, address, tags) VALUES (\n",[325,594,595],{"class":327,"line":334},[325,596,597],{},"    'p-1',\n",[325,599,600],{"class":327,"line":443},[325,601,602],{},"    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n",[325,604,605],{"class":327,"line":449},[325,606,607],{},"    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n",[325,609,610],{"class":327,"line":518},[325,611,612],{},") WITH REFRESH;\n",[614,615,617,618,621,622,624,625,627,628,632],"callout",{"type":616},"warning","If your table has a logical ",[238,619,620],{},"id"," field, always include the ",[238,623,620],{}," column in the INSERT. The value becomes the document's storage identifier, which is how find-by-id lookups resolve the document. An INSERT that omits ",[238,626,620],{}," stores the row with a random identifier and it can only be located via search — not via a direct id lookup. See the ",[544,629,631],{"href":630},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#the-id-column","Migration SQL Grammar reference"," for details.",[343,634,636],{"id":635},"update-set-where","UPDATE ... SET ... WHERE",[234,638,639],{},"Modify existing records.",[251,641,643],{"className":319,"code":642,"language":321,"meta":259,"style":259},"UPDATE users SET active = false WHERE age \u003C 18 WITH REFRESH;\n",[238,644,645],{"__ignoreMap":259},[325,646,647],{"class":327,"line":328},[325,648,642],{},[234,650,651],{},"A composite column is set from the same literals INSERT uses. An object literal merges into the\nstored object — recursively, and leaving sub-fields it does not mention alone — so you can change\none sub-field by naming only that one. Arrays and scalars are replaced outright:",[251,653,655],{"className":319,"code":654,"language":321,"meta":259,"style":259},"-- street keeps its stored value; only city changes\nUPDATE persons SET address = { city: 'Shelbyville' } WHERE id == 'p-1' WITH REFRESH;\n",[238,656,657,662],{"__ignoreMap":259},[325,658,659],{"class":327,"line":328},[325,660,661],{},"-- street keeps its stored value; only city changes\n",[325,663,664],{"class":327,"line":334},[325,665,666],{},"UPDATE persons SET address = { city: 'Shelbyville' } WHERE id == 'p-1' WITH REFRESH;\n",[234,668,669,670,673],{},"Since omitting a sub-field keeps it, ",[238,671,672],{},"null"," is what clears one. The literal's nesting addresses the\nfield, so any depth is reachable:",[251,675,677],{"className":319,"code":676,"language":321,"meta":259,"style":259},"UPDATE persons SET address = { street: null } WHERE id == 'p-1' WITH REFRESH;          -- address.street\nUPDATE persons SET address = { coords: { lat: null } } WHERE id == 'p-1' WITH REFRESH; -- address.coords.lat\nUPDATE persons SET nickname = null WHERE id == 'p-1' WITH REFRESH;                     -- the whole column\n",[238,678,679,684,689],{"__ignoreMap":259},[325,680,681],{"class":327,"line":328},[325,682,683],{},"UPDATE persons SET address = { street: null } WHERE id == 'p-1' WITH REFRESH;          -- address.street\n",[325,685,686],{"class":327,"line":334},[325,687,688],{},"UPDATE persons SET address = { coords: { lat: null } } WHERE id == 'p-1' WITH REFRESH; -- address.coords.lat\n",[325,690,691],{"class":327,"line":443},[325,692,693],{},"UPDATE persons SET nickname = null WHERE id == 'p-1' WITH REFRESH;                     -- the whole column\n",[343,695,697],{"id":696},"delete-from-where","DELETE FROM ... WHERE",[234,699,700],{},"Remove records matching a condition.",[251,702,704],{"className":319,"code":703,"language":321,"meta":259,"style":259},"DELETE FROM users WHERE active == false WITH REFRESH;\n",[238,705,706],{"__ignoreMap":259},[325,707,708],{"class":327,"line":328},[325,709,703],{},[243,711,713],{"id":712},"best-practices","Best Practices",[264,715,716,722,732,740,748,754],{},[267,717,718,721],{},[422,719,720],{},"Increment version numbers sequentially"," - Gaps are allowed but order must be maintained",[267,723,724,731],{},[422,725,726,727,730],{},"Use ",[238,728,729],{},"IF NOT EXISTS"," where available"," - Makes migrations safe to re-run if the tracking state is reset",[267,733,734,739],{},[422,735,726,736],{},[238,737,738],{},"WITH REFRESH"," on INSERT, UPDATE, and DELETE when subsequent migrations depend on the changed data being immediately visible",[267,741,742,747],{},[422,743,726,744],{},[238,745,746],{},"SKIP_IF_NO_SOURCE = TRUE"," on REINDEX operations for idempotent data migrations",[267,749,750,753],{},[422,751,752],{},"Keep migrations small and focused"," - One logical change per migration file",[267,755,756,759],{},[422,757,758],{},"Never modify a migration after it has been applied"," - Create a new migration instead",[234,761,762,763,241],{},"For the complete SQL grammar reference, see the ",[544,764,547],{"href":140},[766,767,768],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-sty