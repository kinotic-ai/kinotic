m\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"id":224,"title":88,"body":225,"description":781,"extension":782,"links":783,"meta":784,"navigation":785,"path":89,"seo":786,"stem":90,"__hash__":787},"docs\u002F01.apps\u002F05.persistence\u002F07.migrations.md",{"type":226,"value":227,"toc":764},"minimark",[228,237,242,245,255,258,277,284,288,305,308,312,333,337,342,345,353,357,360,369,373,376,385,389,392,407,411,414,421,448,454,477,487,528,535,543,547,550,559,563,566,575,578,608,628,632,635,644,647,662,669,689,693,696,705,709,755,760],[229,230,231,232,236],"p",{},"Migrations let you evolve your data schema in a controlled, versioned way. They are written in a SQL-like syntax and executed automatically during ",[233,234,235],"code",{},"kinotic sync",".",[238,239,241],"h2",{"id":240},"file-naming","File Naming",[229,243,244],{},"Migration files follow a strict naming convention:",[246,247,252],"pre",{"className":248,"code":250,"language":251},[249],"language-text","V\u003Cnumber>__\u003Cdescription>.sql\n","text",[233,253,250],{"__ignoreMap":254},"",[229,256,257],{},"Examples:",[259,260,261,267,272],"ul",{},[262,263,264],"li",{},[233,265,266],{},"V1__initial_schema.sql",[262,268,269],{},[233,270,271],{},"V2__add_email_field.sql",[262,273,274],{},[233,275,276],{},"V3__create_sensor_readings.sql",[229,278,279,280,283],{},"The version number determines execution order. The double underscore (",[233,281,282],{},"__",") separates the version from the description.",[238,285,287],{"id":286},"how-it-works","How It Works",[289,290,291,294,297,300],"ol",{},[262,292,293],{},"Migration files are discovered and sorted by version number",[262,295,296],{},"Only unapplied migrations are parsed and executed",[262,298,299],{},"Each migration is recorded after successful execution to prevent re-runs",[262,301,302,303],{},"Migrations run during ",[233,304,235],{},[229,306,307],{},"A migration file containing a syntax error fails the entire migration run — nothing from that file is applied and the file is not recorded. The error names the file, line, and offending token.",[238,309,311],{"id":310},"example-migration","Example Migration",[246,313,317],{"className":314,"code":315,"language":316,"meta":254,"style":254},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- V1__initial_schema.sql\nCREATE TABLE users (name TEXT, age INTEGER, active BOOLEAN);\n","sql",[233,318,319,327],{"__ignoreMap":254},[320,321,324],"span",{"class":322,"line":323},"line",1,[320,325,326],{},"-- V1__initial_schema.sql\n",[320,328,330],{"class":322,"line":329},2,[320,331,332],{},"CREATE TABLE users (name TEXT, age INTEGER, active BOOLEAN);\n",[238,334,336],{"id":335},"supported-statements","Supported Statements",[338,339,341],"h3",{"id":340},"create-table","CREATE TABLE",[229,343,344],{},"Create a new table with field mappings.",[246,346,347],{"className":314,"code":332,"language":316,"meta":254,"style":254},[233,348,349],{"__ignoreMap":254},[320,350,351],{"class":322,"line":323},[320,352,332],{},[338,354,356],{"id":355},"create-component-template","CREATE COMPONENT TEMPLATE",[229,358,359],{},"Define reusable templates with settings that can be applied to multiple tables.",[246,361,363],{"className":314,"code":362,"language":316,"meta":254,"style":254},"CREATE COMPONENT TEMPLATE my_settings (NUMBER_OF_SHARDS = 1, NUMBER_OF_REPLICAS = 0);\n",[233,364,365],{"__ignoreMap":254},[320,366,367],{"class":322,"line":323},[320,368,362],{},[338,370,372],{"id":371},"create-index-template","CREATE INDEX TEMPLATE",[229,374,375],{},"Create templates that automatically apply to tables matching a name pattern.",[246,377,379],{"className":314,"code":378,"language":316,"meta":254,"style":254},"CREATE INDEX TEMPLATE my_template FOR 'logs-*' USING 'my_settings';\n",[233,380,381],{"__ignoreMap":254},[320,382,383],{"class":322,"line":323},[320,384,378],{},[338,386,388],{"id":387},"alter-table-add-column","ALTER TABLE ADD COLUMN",[229,390,391],{},"Add new fields to an existing table. Composite types are supported — you can add an OBJECT, NESTED, or UNION column just like any other type.",[246,393,395],{"className":314,"code":394,"language":316,"meta":254,"style":254},"ALTER TABLE users ADD COLUMN email TEXT;\nALTER TABLE users ADD COLUMN address OBJECT (street TEXT, city KEYWORD, zip KEYWORD);\n",[233,396,397,402],{"__ignoreMap":254},[320,398,399],{"class":322,"line":323},[320,400,401],{},"ALTER TABLE users ADD COLUMN email TEXT;\n",[320,403,404],{"class":322,"line":329},[320,405,406],{},"ALTER TABLE users ADD COLUMN address OBJECT (street TEXT, city KEYWORD, zip KEYWORD);\n",[338,408,410],{"id":409},"composite-column-types","Composite Column Types",[229,412,413],{},"In addition to scalar types, columns can be structured objects.",[229,415,416,420],{},[417,418,419],"strong",{},"OBJECT"," — a single embedded sub-document:",[246,422,424],{"className":314,"code":423,"language":316,"meta":254,"style":254},"CREATE TABLE persons (\n    id KEYWORD,\n    address OBJECT (street TEXT, city KEYWORD, state KEYWORD, zip KEYWORD)\n);\n",[233,425,426,431,436,442],{"__ignoreMap":254},[320,427,428],{"class":322,"line":323},[320,429,430],{},"CREATE TABLE persons (\n",[320,432,433],{"class":322,"line":329},[320,434,435],{},"    id KEYWORD,\n",[320,437,439],{"class":322,"line":438},3,[320,440,441],{},"    address OBJECT (street TEXT, city KEYWORD, state KEYWORD, zip KEYWORD)\n",[320,443,445],{"class":322,"line":444},4,[320,446,447],{},");\n",[229,449,450,453],{},[417,451,452],{},"NESTED"," — an array of independently-queryable sub-documents. Use this when a field holds a list of items and you need to filter on individual list entries without cross-element matching:",[246,455,457],{"className":314,"code":456,"language":316,"meta":254,"style":254},"CREATE TABLE articles (\n    id KEYWORD,\n    tags NESTED (label TEXT, value KEYWORD)\n);\n",[233,458,459,464,468,473],{"__ignoreMap":254},[320,460,461],{"class":322,"line":323},[320,462,463],{},"CREATE TABLE articles (\n",[320,465,466],{"class":322,"line":329},[320,467,435],{},[320,469,470],{"class":322,"line":438},[320,471,472],{},"    tags NESTED (label TEXT, value KEYWORD)\n",[320,474,475],{"class":322,"line":444},[320,476,447],{},[229,478,479,482,483,486],{},[417,480,481],{},"UNION"," — a field that can hold one of several named object variants. All variant fields are merged into a single object. Include a shared field (e.g. ",[233,484,485],{},"kind KEYWORD",") in each variant so your application can identify which variant it received at runtime:",[246,488,490],{"className":314,"code":489,"language":316,"meta":254,"style":254},"CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n",[233,491,492,497,501,506,511,517,523],{"__ignoreMap":254},[320,493,494],{"class":322,"line":323},[320,495,496],{},"CREATE TABLE assets (\n",[320,498,499],{"class":322,"line":329},[320,500,435],{},[320,502,503],{"class":322,"line":438},[320,504,505],{},"    item UNION (\n",[320,507,508],{"class":322,"line":444},[320,509,510],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[320,512,514],{"class":322,"line":513},5,[320,515,516],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[320,518,520],{"class":322,"line":519},6,[320,521,522],{},"    )\n",[320,524,526],{"class":322,"line":525},7,[320,527,447],{},[229,529,530,531,534],{},"All composite types support ",[233,532,533],{},"NOT INDEXED"," (except NESTED) to store data without making it searchable. They also support recursive nesting — an OBJECT inside a NESTED, for example, is valid.",[229,536,537,538,236],{},"For the complete syntax and options, see the ",[539,540,542],"a",{"href":541},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#composite-types","Migration SQL Grammar Reference",[338,544,546],{"id":545},"reindex","REINDEX",[229,548,549],{},"Migrate data between tables with advanced options.",[246,551,553],{"className":314,"code":552,"language":316,"meta":254,"style":254},"REINDEX old_index INTO new_index WITH (SKIP_IF_NO_SOURCE = TRUE);\n",[233,554,555],{"__ignoreMap":254},[320,556,557],{"class":322,"line":323},[320,558,552],{},[338,560,562],{"id":561},"insert-into","INSERT INTO",[229,564,565],{},"Add records to a table.",[246,567,569],{"className":314,"code":568,"language":316,"meta":254,"style":254},"INSERT INTO users (name, age, active) VALUES ('Jane', 28, true) WITH REFRESH;\n",[233,570,571],{"__ignoreMap":254},[320,572,573],{"class":322,"line":323},[320,574,568],{},[229,576,577],{},"Composite columns take an object literal, and a NESTED column an array of them:",[246,579,581],{"className":314,"code":580,"language":316,"meta":254,"style":254},"INSERT INTO persons (id, address, tags) VALUES (\n    'p-1',\n    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n) WITH REFRESH;\n",[233,582,583,588,593,598,603],{"__ignoreMap":254},[320,584,585],{"class":322,"line":323},[320,586,587],{},"INSERT INTO persons (id, address, tags) VALUES (\n",[320,589,590],{"class":322,"line":329},[320,591,592],{},"    'p-1',\n",[320,594,595],{"class":322,"line":438},[320,596,597],{},"    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n",[320,599,600],{"class":322,"line":444},[320,601,602],{},"    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n",[320,604,605],{"class":322,"line":513},[320,606,607],{},") WITH REFRESH;\n",[609,610,612,613,616,617,619,620,622,623,627],"callout",{"type":611},"warning","If your table has a logical ",[233,614,615],{},"id"," field, always include the ",[233,618,615],{}," column in the INSERT. The value becomes the document's storage identifier, which is how find-by-id lookups resolve the document. An INSERT that omits ",[233,621,615],{}," stores the row with a random identifier and it can only be located via search — not via a direct id lookup. See the ",[539,624,626],{"href":625},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#the-id-column","Migration SQL Grammar reference"," for details.",[338,629,631],{"id":630},"update-set-where","UPDATE ... SET ... WHERE",[229,633,634],{},"Modify existing records.",[246,636,638],{"className":314,"code":637,"language":316,"meta":254,"style":254},"UPDATE users SET active = false WHERE age \u003C 18 WITH REFRESH;\n",[233,639,640],{"__ignoreMap":254},[320,641,642],{"class":322,"line":323},[320,643,637],{},[229,645,646],{},"A composite column is set from the same literals INSERT uses. An object literal merges into the\nstored object — recursively, and leaving sub-fields it does not mention alone — so you can change\none sub-field by naming only that one. Arrays and scalars are replaced outright:",[246,648,650],{"className":314,"code":649,"language":316,"meta":254,"style":254},"-- street keeps its stored value; only city changes\nUPDATE persons SET address = { city: 'Shelbyville' } WHERE id == 'p-1' WITH REFRESH;\n",[233,651,652,657],{"__ignoreMap":254},[320,653,654],{"class":322,"line":323},[320,655,656],{},"-- street keeps its stored value; only city changes\n",[320,658,659],{"class":322,"line":329},[320,660,661],{},"UPDATE persons SET address = { city: 'Shelbyville' } WHERE id == 'p-1' WITH REFRESH;\n",[229,663,664,665,668],{},"Since omitting a sub-field keeps it, ",[233,666,667],{},"null"," is what clears one. The literal's nesting addresses the\nfield, so any depth is reachable:",[246,670,672],{"className":314,"code":671,"language":316,"meta":254,"style":254},"UPDATE persons SET address = { street: null } WHERE id == 'p-1' WITH REFRESH;          -- address.street\nUPDATE persons SET address = { coords: { lat: null } } WHERE id == 'p-1' WITH REFRESH; -- address.coords.lat\nUPDATE persons SET nickname = null WHERE id == 'p-1' WITH REFRESH;                     -- the whole column\n",[233,673,674,679,684],{"__ignoreMap":254},[320,675,676],{"class":322,"line":323},[320,677,678],{},"UPDATE persons SET address = { street: null } WHERE id == 'p-1' WITH REFRESH;          -- address.street\n",[320,680,681],{"class":322,"line":329},[320,682,683],{},"UPDATE persons SET address = { coords: { lat: null } } WHERE id == 'p-1' WITH REFRESH; -- address.coords.lat\n",[320,685,686],{"class":322,"line":438},[320,687,688],{},"UPDATE persons SET nickname = null WHERE id == 'p-1' WITH REFRESH;                     -- the whole column\n",[338,690,692],{"id":691},"delete-from-where","DELETE FROM ... WHERE",[229,694,695],{},"Remove records matching a condition.",[246,697,699],{"className":314,"code":698,"language":316,"meta":254,"style":254},"DELETE FROM users WHERE active == false WITH REFRESH;\n",[233,700,701],{"__ignoreMap":254},[320,702,703],{"class":322,"line":323},[320,704,698],{},[238,706,708],{"id":707},"best-practices","Best Practices",[259,710,711,717,727,735,743,749],{},[262,712,713,716],{},[417,714,715],{},"Increment version numbers sequentially"," - Gaps are allowed but order must be maintained",[262,718,719,726],{},[417,720,721,722,725],{},"Use ",[233,723,724],{},"IF NOT EXISTS"," where available"," - Makes migrations safe to re-run if the tracking state is reset",[262,728,729,734],{},[417,730,721,731],{},[233,732,733],{},"WITH REFRESH"," on INSERT, UPDATE, and DELETE when subsequent migrations depend on the changed data being immediately visible",[262,736,737,742],{},[417,738,721,739],{},[233,740,741],{},"SKIP_IF_NO_SOURCE = TRUE"," on REINDEX operations for idempotent data migrations",[262,744,745,748],{},[417,746,747],{},"Keep migrations small and focused"," - One logical change per migration file",[262,750,751,754],{},[417,752,753],{},"Never modify a migration after it has been applied"," - Create a new migration instead",[229,756,757,758,236],{},"For the complete SQL grammar reference, see the ",[539,759,542],{"href":140},[761,762,763],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);fon