33,"stem":234,"icon":235},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":237,"path":238,"stem":239,"icon":240},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":242,"path":243,"stem":244,"icon":179},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":246,"path":247,"stem":248,"icon":38},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":250,"path":251,"stem":252,"icon":253},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":255,"path":256,"stem":257,"icon":258},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":260,"path":261,"stem":262,"icon":263},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":265,"title":110,"body":266,"description":1092,"extension":1093,"links":1094,"meta":1095,"navigation":374,"path":111,"seo":1096,"stem":112,"__hash__":1097},"docs\u002F03.apps\u002F05.persistence\u002F05.named-queries.md",{"type":267,"value":268,"toc":1081},"minimark",[269,278,281,286,313,317,327,621,627,630,634,676,680,695,735,739,750,778,782,846,850,871,875,887,1069,1077],[270,271,272,273,277],"p",{},"Named queries let you define custom query methods on your repositories. You declare methods with the ",[274,275,276],"code",{},"@Query"," decorator, sync them with the server, and the CLI generates the implementation.",[270,279,280],{},"A named query belongs to the entity of its repository and acts on that entity alone: the statement names that entity, and a statement that names any other entity fails.",[282,283,285],"h2",{"id":284},"workflow","Workflow",[287,288,289,297,303],"ol",{},[290,291,292,293,296],"li",{},"Run ",[274,294,295],{},"kinotic sync"," to sync your entities and generate the base repository classes",[290,298,299,300,302],{},"Add custom methods with the ",[274,301,276],{}," decorator to the generated repository class",[290,304,292,305,308,309,312],{},[274,306,307],{},"kinotic generate"," to regenerate the repository with your query implementations (",[274,310,311],{},"generate"," runs locally without syncing to the server)",[282,314,316],{"id":315},"defining-named-queries","Defining Named Queries",[270,318,319,320,322,323,326],{},"Add methods with the ",[274,321,276],{}," decorator to your repository class. Use ",[274,324,325],{},":paramName"," syntax for parameter binding; each parameter takes the method argument of the same name.",[328,329,334],"pre",{"className":330,"code":331,"language":332,"meta":333,"style":333},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100')\n    findByStatus(status: string): Promise\u003COrder[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('UPDATE Order SET status = :status WHERE id = :id WITH REFRESH')\n    updateStatus(id: string, status: string): Promise\u003CWriteCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[274,335,336,369,376,399,404,428,467,474,480,485,503,543,548,553,558,576,605,610,615],{"__ignoreMap":333},[337,338,341,345,349,353,356,359,362,366],"span",{"class":339,"line":340},"line",1,[337,342,344],{"class":343},"s7zQu","import",[337,346,348],{"class":347},"sMK4o"," {",[337,350,352],{"class":351},"sTEyZ"," Query",[337,354,355],{"class":347}," }",[337,357,358],{"class":343}," from",[337,360,361],{"class":347}," '",[337,363,365],{"class":364},"sfazB","@kinotic-ai\u002Fpersistence",[337,367,368],{"class":347},"'\n",[337,370,372],{"class":339,"line":371},2,[337,373,375],{"emptyLinePlaceholder":374},true,"\n",[337,377,379,382,386,390,393,396],{"class":339,"line":378},3,[337,380,381],{"class":343},"export",[337,383,385],{"class":384},"spNyl"," class",[337,387,389],{"class":388},"sBMFI"," OrderRepository",[337,391,392],{"class":384}," extends",[337,394,395],{"class":388}," BaseOrderRepository",[337,397,398],{"class":347}," {\n",[337,400,402],{"class":339,"line":401},4,[337,403,375],{"emptyLinePlaceholder":374},[337,405,407,410,414,417,420,423,425],{"class":339,"line":406},5,[337,408,409],{"class":347},"    @",[337,411,413],{"class":412},"s2Zo4","Query",[337,415,416],{"class":351},"(",[337,418,419],{"class":347},"'",[337,421,422],{"class":364},"SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100",[337,424,419],{"class":347},[337,426,427],{"class":351},")\n",[337,429,431,435,437,441,444,447,450,453,456,459,462,465],{"class":339,"line":430},6,[337,432,434],{"class":433},"swJcz","    findByStatus",[337,436,416],{"class":347},[337,438,440],{"class":439},"sHdIc","status",[337,442,443],{"class":347},":",[337,445,446],{"class":388}," string",[337,448,449],{"class":347},"):",[337,451,452],{"class":388}," Promise",[337,454,455],{"class":347},"\u003C",[337,457,458],{"class":388},"Order",[337,460,461],{"class":351},"[]",[337,463,464],{"class":347},">",[337,466,398],{"class":347},[337,468,470],{"class":339,"line":469},7,[337,471,473],{"class":472},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[337,475,477],{"class":339,"line":476},8,[337,478,479],{"class":347},"    }\n",[337,481,483],{"class":339,"line":482},9,[337,484,375],{"emptyLinePlaceholder":374},[337,486,488,490,492,494,496,499,501],{"class":339,"line":487},10,[337,489,409],{"class":347},[337,491,413],{"class":412},[337,493,416],{"class":351},[337,495,419],{"class":347},[337,497,498],{"class":364},"UPDATE Order SET status = :status WHERE id = :id WITH REFRESH",[337,500,419],{"class":347},[337,502,427],{"class":351},[337,504,506,509,511,514,516,518,521,524,526,528,530,532,534,537,539,541],{"class":339,"line":505},11,[337,507,508],{"class":433},"    updateStatus",[337,510,416],{"class":347},[337,512,513],{"class":439},"id",[337,515,443],{"class":347},[337,517,446],{"class":388},[337,519,520],{"class":347},",",[337,522,523],{"class":439}," status",[337,525,443],{"class":347},[337,527,446],{"class":388},[337,529,449],{"class":347},[337,531,452],{"class":388},[337,533,455],{"class":347},[337,535,536],{"class":388},"WriteCount",[337,538,461],{"class":351},[337,540,464],{"class":347},[337,542,398],{"class":347},[337,544,546],{"class":339,"line":545},12,[337,547,473],{"class":472},[337,549,551],{"class":339,"line":550},13,[337,552,479],{"class":347},[337,554,556],{"class":339,"line":555},14,[337,557,375],{"emptyLinePlaceholder":374},[337,559,561,563,565,567,569,572,574],{"class":339,"line":560},15,[337,562,409],{"class":347},[337,564,413],{"class":412},[337,566,416],{"class":351},[337,568,419],{"class":347},[337,570,571],{"class":364},"SELECT COUNT(*) AS count FROM Order WHERE status = :status",[337,573,419],{"class":347},[337,575,427],{"class":351},[337,577,579,582,584,586,588,590,592,594,596,599,601,603],{"class":339,"line":578},16,[337,580,581],{"class":433},"    countByStatus",[337,583,416],{"class":347},[337,585,440],{"class":439},[337,587,443],{"class":347},[337,589,446],{"class":388},[337,591,449],{"class":347},[337,593,452],{"class":388},[337,595,455],{"class":347},[337,597,598],{"class":388},"StatusCount",[337,600,461],{"class":351},[337,602,464],{"class":347},[337,604,398],{"class":347},[337,606,608],{"class":339,"line":607},17,[337,609,473],{"class":472},[337,611,613],{"class":339,"line":612},18,[337,614,479],{"class":347},[337,616,618],{"class":339,"line":617},19,[337,619,620],{"class":347},"}\n",[270,622,623,624,626],{},"The method body is left empty because ",[274,625,307],{}," fills in the implementation.",[270,628,629],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[282,631,633],{"id":632},"statements","Statements",[270,635,636,637,640,641,640,644,647,648,651,652,656,657,647,660,663,664,647,667,670,671,675],{},"A named query is one statement. ",[274,638,639],{},"SELECT",", ",[274,642,643],{},"INSERT",[274,645,646],{},"UPDATE"," and ",[274,649,650],{},"DELETE"," are statements of the ",[653,654,655],"a",{"href":168},"Kinotic SQL grammar",", the one migrations use, written without the terminating semicolon. Keywords match in any case, but entity and field names are case-sensitive and must be written the way the entity class spells them: ",[274,658,659],{},"Person",[274,661,662],{},"lastName",", not ",[274,665,666],{},"person",[274,668,669],{},"LASTNAME",". A field name in the wrong case is not an error: the query gets nothing back, no rows read and none written. See ",[653,672,674],{"href":673},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#case","Case",".",[677,678,639],"h3",{"id":679},"select",[270,681,682,683,686,687,690,691,694],{},"Returns the rows of the entity that match the ",[274,684,685],{},"WHERE"," clause, shaped the way the entity class shapes them: nested objects and lists come back whole, since the rows are read from the stored documents. ",[274,688,689],{},"SELECT *"," returns whole rows; ",[274,692,693],{},"SELECT firstName, address"," returns the listed top-level fields only, each whole.",[696,697,698,708,715],"ul",{},[290,699,700,703,704,707],{},[274,701,702],{},"ORDER BY"," orders the rows. A sort the caller gives on a ",[274,705,706],{},"Pageable"," follows it.",[290,709,710,711,714],{},"A method that returns an array gets every matching row up to ",[274,712,713],{},"LIMIT",", or 1000 rows when the statement names no limit.",[290,716,717,718,721,722,725,726,728,729,731,732,675],{},"A method with a ",[274,719,720],{},"pageable: Pageable"," parameter returns a ",[274,723,724],{},"Page",", and the ",[274,727,706],{}," sets the page size. Cursor paging orders by the statement's ",[274,730,702],{},", so give it one that orders the rows fully, such as ",[274,733,734],{},"ORDER BY lastName, id",[677,736,738],{"id":737},"insert-update-and-delete","INSERT, UPDATE and DELETE",[270,740,741,742,745,746,749],{},"A write returns one row, ",[274,743,744],{},"{ count }",", holding the number of rows it wrote. Add ",[274,747,748],{},"WITH REFRESH"," when the next read must see the write.",[696,751,752,768],{},[290,753,754,756,757,760,761,647,764,767],{},[274,755,643],{}," stores the row the way the repository's ",[274,758,759],{},"save"," would: the row states the entity's id field, and the platform stores it under the participant's tenant, so the row is found by id afterwards. ",[274,762,763],{},"ROUTING",[274,765,766],{},"DOCUMENT_ID"," are not accepted, since both are derived.",[290,769,770,647,772,774,775,777],{},[274,771,646],{},[274,773,650],{}," act on the rows that match the ",[274,776,685],{}," clause.",[677,779,781],{"id":780},"aggregates","Aggregates",[270,783,784,785,787,788,640,791,640,794,640,797,640,800,640,803,640,806,809,810,813,814,820,821,824,825,828,829,831,832,835,836,839,840,843,844,675],{},"A ",[274,786,639],{}," that calls a function (",[274,789,790],{},"COUNT(*)",[274,792,793],{},"SUM",[274,795,796],{},"AVG",[274,798,799],{},"MIN",[274,801,802],{},"MAX",[274,804,805],{},"PERCENTILE",[274,807,808],{},"HISTOGRAM",", …) or has a ",[274,811,812],{},"GROUP BY"," is an aggregate. It runs on Elasticsearch SQL, so it can call any of ",[653,815,819],{"href":816,"rel":817},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Freference\u002Fquery-languages\u002Fsql\u002Fsql-functions",[818],"nofollow","its functions",", and returns one row per group, shaped by the projection: ",[274,822,823],{},"AS"," names a column, and a column or group can be a sub-field (",[274,826,827],{},"address.city","). It is written in the same grammar as every other statement, with the same ",[274,830,685],{}," clause and ",[274,833,834],{},":name"," parameters, and names the query's own entity in ",[274,837,838],{},"FROM","; see ",[653,841,639],{"href":842},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#select",". A paged aggregate takes a cursor ",[274,845,706],{},[282,847,849],{"id":848},"multi-tenancy","Multi-tenancy",[270,851,852,853,855,856,858,859,861,862,864,865,867,868,870],{},"Every named query is confined to the participant's tenant, the way every repository method is: a ",[274,854,639],{}," or aggregate reads only the rows of that tenant, an ",[274,857,643],{}," stores its row under it, and an ",[274,860,646],{}," or ",[274,863,650],{}," touches only its rows, whatever the ",[274,866,685],{}," clause says. An ",[274,869,643],{}," may state the entity's tenant field with the participant's own tenant; any other value is refused.",[282,872,874],{"id":873},"admin-repository-queries","Admin Repository Queries",[270,876,877,878,882,883,886],{},"A named query on an ",[653,879,881],{"href":880},"\u002Fapps\u002Fpersistence\u002Fmulti-tenancy#admin-repository","admin repository"," runs against the tenants the caller selects, so it declares a ",[274,884,885],{},"TenantSelection"," parameter like every other admin repository method. The generated implementation sends it as the query's tenant selection rather than as a query parameter. A read runs against every tenant the selection names; a write acts on one tenant, so its selection names exactly one.",[328,888,890],{"className":330,"code":889,"language":332,"meta":33