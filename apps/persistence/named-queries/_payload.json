tension":1057,"links":1058,"meta":1059,"navigation":338,"path":81,"seo":1060,"stem":82,"__hash__":1061},"docs\u002F01.apps\u002F05.persistence\u002F05.named-queries.md",{"type":231,"value":232,"toc":1045},"minimark",[233,242,245,250,277,281,291,585,591,594,598,640,644,659,699,703,714,742,746,810,814,835,839,851,1033,1041],[234,235,236,237,241],"p",{},"Named queries let you define custom query methods on your repositories. You declare methods with the ",[238,239,240],"code",{},"@Query"," decorator, sync them with the server, and the CLI generates the implementation.",[234,243,244],{},"A named query belongs to the entity of its repository and acts on that entity alone: the statement names that entity, and a statement that names any other entity fails.",[246,247,249],"h2",{"id":248},"workflow","Workflow",[251,252,253,261,267],"ol",{},[254,255,256,257,260],"li",{},"Run ",[238,258,259],{},"kinotic sync"," to sync your entities and generate the base repository classes",[254,262,263,264,266],{},"Add custom methods with the ",[238,265,240],{}," decorator to the generated repository class",[254,268,256,269,272,273,276],{},[238,270,271],{},"kinotic generate"," to regenerate the repository with your query implementations (",[238,274,275],{},"generate"," runs locally without syncing to the server)",[246,278,280],{"id":279},"defining-named-queries","Defining Named Queries",[234,282,283,284,286,287,290],{},"Add methods with the ",[238,285,240],{}," decorator to your repository class. Use ",[238,288,289],{},":paramName"," syntax for parameter binding; each parameter takes the method argument of the same name.",[292,293,298],"pre",{"className":294,"code":295,"language":296,"meta":297,"style":297},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100')\n    findByStatus(status: string): Promise\u003COrder[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('UPDATE Order SET status = :status WHERE id = :id WITH REFRESH')\n    updateStatus(id: string, status: string): Promise\u003CWriteCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[238,299,300,333,340,363,368,392,431,438,444,449,467,507,512,517,522,540,569,574,579],{"__ignoreMap":297},[301,302,305,309,313,317,320,323,326,330],"span",{"class":303,"line":304},"line",1,[301,306,308],{"class":307},"s7zQu","import",[301,310,312],{"class":311},"sMK4o"," {",[301,314,316],{"class":315},"sTEyZ"," Query",[301,318,319],{"class":311}," }",[301,321,322],{"class":307}," from",[301,324,325],{"class":311}," '",[301,327,329],{"class":328},"sfazB","@kinotic-ai\u002Fpersistence",[301,331,332],{"class":311},"'\n",[301,334,336],{"class":303,"line":335},2,[301,337,339],{"emptyLinePlaceholder":338},true,"\n",[301,341,343,346,350,354,357,360],{"class":303,"line":342},3,[301,344,345],{"class":307},"export",[301,347,349],{"class":348},"spNyl"," class",[301,351,353],{"class":352},"sBMFI"," OrderRepository",[301,355,356],{"class":348}," extends",[301,358,359],{"class":352}," BaseOrderRepository",[301,361,362],{"class":311}," {\n",[301,364,366],{"class":303,"line":365},4,[301,367,339],{"emptyLinePlaceholder":338},[301,369,371,374,378,381,384,387,389],{"class":303,"line":370},5,[301,372,373],{"class":311},"    @",[301,375,377],{"class":376},"s2Zo4","Query",[301,379,380],{"class":315},"(",[301,382,383],{"class":311},"'",[301,385,386],{"class":328},"SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100",[301,388,383],{"class":311},[301,390,391],{"class":315},")\n",[301,393,395,399,401,405,408,411,414,417,420,423,426,429],{"class":303,"line":394},6,[301,396,398],{"class":397},"swJcz","    findByStatus",[301,400,380],{"class":311},[301,402,404],{"class":403},"sHdIc","status",[301,406,407],{"class":311},":",[301,409,410],{"class":352}," string",[301,412,413],{"class":311},"):",[301,415,416],{"class":352}," Promise",[301,418,419],{"class":311},"\u003C",[301,421,422],{"class":352},"Order",[301,424,425],{"class":315},"[]",[301,427,428],{"class":311},">",[301,430,362],{"class":311},[301,432,434],{"class":303,"line":433},7,[301,435,437],{"class":436},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[301,439,441],{"class":303,"line":440},8,[301,442,443],{"class":311},"    }\n",[301,445,447],{"class":303,"line":446},9,[301,448,339],{"emptyLinePlaceholder":338},[301,450,452,454,456,458,460,463,465],{"class":303,"line":451},10,[301,453,373],{"class":311},[301,455,377],{"class":376},[301,457,380],{"class":315},[301,459,383],{"class":311},[301,461,462],{"class":328},"UPDATE Order SET status = :status WHERE id = :id WITH REFRESH",[301,464,383],{"class":311},[301,466,391],{"class":315},[301,468,470,473,475,478,480,482,485,488,490,492,494,496,498,501,503,505],{"class":303,"line":469},11,[301,471,472],{"class":397},"    updateStatus",[301,474,380],{"class":311},[301,476,477],{"class":403},"id",[301,479,407],{"class":311},[301,481,410],{"class":352},[301,483,484],{"class":311},",",[301,486,487],{"class":403}," status",[301,489,407],{"class":311},[301,491,410],{"class":352},[301,493,413],{"class":311},[301,495,416],{"class":352},[301,497,419],{"class":311},[301,499,500],{"class":352},"WriteCount",[301,502,425],{"class":315},[301,504,428],{"class":311},[301,506,362],{"class":311},[301,508,510],{"class":303,"line":509},12,[301,511,437],{"class":436},[301,513,515],{"class":303,"line":514},13,[301,516,443],{"class":311},[301,518,520],{"class":303,"line":519},14,[301,521,339],{"emptyLinePlaceholder":338},[301,523,525,527,529,531,533,536,538],{"class":303,"line":524},15,[301,526,373],{"class":311},[301,528,377],{"class":376},[301,530,380],{"class":315},[301,532,383],{"class":311},[301,534,535],{"class":328},"SELECT COUNT(*) AS count FROM Order WHERE status = :status",[301,537,383],{"class":311},[301,539,391],{"class":315},[301,541,543,546,548,550,552,554,556,558,560,563,565,567],{"class":303,"line":542},16,[301,544,545],{"class":397},"    countByStatus",[301,547,380],{"class":311},[301,549,404],{"class":403},[301,551,407],{"class":311},[301,553,410],{"class":352},[301,555,413],{"class":311},[301,557,416],{"class":352},[301,559,419],{"class":311},[301,561,562],{"class":352},"StatusCount",[301,564,425],{"class":315},[301,566,428],{"class":311},[301,568,362],{"class":311},[301,570,572],{"class":303,"line":571},17,[301,573,437],{"class":436},[301,575,577],{"class":303,"line":576},18,[301,578,443],{"class":311},[301,580,582],{"class":303,"line":581},19,[301,583,584],{"class":311},"}\n",[234,586,587,588,590],{},"The method body is left empty because ",[238,589,271],{}," fills in the implementation.",[234,592,593],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[246,595,597],{"id":596},"statements","Statements",[234,599,600,601,604,605,604,608,611,612,615,616,620,621,611,624,627,628,611,631,634,635,639],{},"A named query is one statement. ",[238,602,603],{},"SELECT",", ",[238,606,607],{},"INSERT",[238,609,610],{},"UPDATE"," and ",[238,613,614],{},"DELETE"," are statements of the ",[617,618,619],"a",{"href":140},"Kinotic SQL grammar",", the one migrations use, written without the terminating semicolon. Keywords match in any case, but entity and field names are case-sensitive and must be written the way the entity class spells them: ",[238,622,623],{},"Person",[238,625,626],{},"lastName",", not ",[238,629,630],{},"person",[238,632,633],{},"LASTNAME",". A field name in the wrong case is not an error: the query gets nothing back, no rows read and none written. See ",[617,636,638],{"href":637},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#case","Case",".",[641,642,603],"h3",{"id":643},"select",[234,645,646,647,650,651,654,655,658],{},"Returns the rows of the entity that match the ",[238,648,649],{},"WHERE"," clause, shaped the way the entity class shapes them: nested objects and lists come back whole, since the rows are read from the stored documents. ",[238,652,653],{},"SELECT *"," returns whole rows; ",[238,656,657],{},"SELECT firstName, address"," returns the listed top-level fields only, each whole.",[660,661,662,672,679],"ul",{},[254,663,664,667,668,671],{},[238,665,666],{},"ORDER BY"," orders the rows. A sort the caller gives on a ",[238,669,670],{},"Pageable"," follows it.",[254,673,674,675,678],{},"A method that returns an array gets every matching row up to ",[238,676,677],{},"LIMIT",", or 1000 rows when the statement names no limit.",[254,680,681,682,685,686,689,690,692,693,695,696,639],{},"A method with a ",[238,683,684],{},"pageable: Pageable"," parameter returns a ",[238,687,688],{},"Page",", and the ",[238,691,670],{}," sets the page size. Cursor paging orders by the statement's ",[238,694,666],{},", so give it one that orders the rows fully, such as ",[238,697,698],{},"ORDER BY lastName, id",[641,700,702],{"id":701},"insert-update-and-delete","INSERT, UPDATE and DELETE",[234,704,705,706,709,710,713],{},"A write returns one row, ",[238,707,708],{},"{ count }",", holding the number of rows it wrote. Add ",[238,711,712],{},"WITH REFRESH"," when the next read must see the write.",[660,715,716,732],{},[254,717,718,720,721,724,725,611,728,731],{},[238,719,607],{}," stores the row the way the repository's ",[238,722,723],{},"save"," would: the row states the entity's id field, and the platform stores it under the participant's tenant, so the row is found by id afterwards. ",[238,726,727],{},"ROUTING",[238,729,730],{},"DOCUMENT_ID"," are not accepted, since both are derived.",[254,733,734,611,736,738,739,741],{},[238,735,610],{},[238,737,614],{}," act on the rows that match the ",[238,740,649],{}," clause.",[641,743,745],{"id":744},"aggregates","Aggregates",[234,747,748,749,751,752,604,755,604,758,604,761,604,764,604,767,604,770,773,774,777,778,784,785,788,789,792,793,795,796,799,800,803,804,807,808,639],{},"A ",[238,750,603],{}," that calls a function (",[238,753,754],{},"COUNT(*)",[238,756,757],{},"SUM",[238,759,760],{},"AVG",[238,762,763],{},"MIN",[238,765,766],{},"MAX",[238,768,769],{},"PERCENTILE",[238,771,772],{},"HISTOGRAM",", …) or has a ",[238,775,776],{},"GROUP BY"," is an aggregate. It runs on Elasticsearch SQL, so it can call any of ",[617,779,783],{"href":780,"rel":781},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Freference\u002Fquery-languages\u002Fsql\u002Fsql-functions",[782],"nofollow","its functions",", and returns one row per group, shaped by the projection: ",[238,786,787],{},"AS"," names a column, and a column or group can be a sub-field (",[238,790,791],{},"address.city","). It is written in the same grammar as every other statement, with the same ",[238,794,649],{}," clause and ",[238,797,798],{},":name"," parameters, and names the query's own entity in ",[238,801,802],{},"FROM","; see ",[617,805,603],{"href":806},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#select",". A paged aggregate takes a cursor ",[238,809,670],{},[246,811,813],{"id":812},"multi-tenancy","Multi-tenancy",[234,815,816,817,819,820,822,823,825,826,828,829,831,832,834],{},"Every named query is confined to the participant's tenant, the way every repository method is: a ",[238,818,603],{}," or aggregate reads only the rows of that tenant, an ",[238,821,607],{}," stores its row under it, and an ",[238,824,610],{}," or ",[238,827,614],{}," touches only its rows, whatever the ",[238,830,649],{}," clause says. An ",[238,833,607],{}," may state the entity's tenant field with the participant's own tenant; any other value is refused.",[246,836,838],{"id":837},"admin-repository-queries","Admin Repository Queries",[234,840,841,842,846,847,850],{},"A named query on an ",[617,843,845],{"href":844},"\u002Fapps\u002Fpersistence\u002Fmulti-tenancy#admin-repository","admin repository"," runs against the tenants the caller selects, so it declares a ",[238,848,849],{},"TenantSelection"," parameter like every other admin repository method. The generated implementation sends it as the query's tenant selection rather than as a query parameter. A read runs against every tenant the selection names; a write acts on one tenant, so its selection names exactly one.",[292,852,854],{"className":294,"code":853,"language":296,"meta":297,"style":297},"import { Query, type TenantSelection } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderAdminRepository extends BaseOrderAdminRepository {\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string, tenantSelection: TenantSelection): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n\nconst openOrders = await new OrderAdminRepository().countByStatus('OPEN', ['tenant-123', 'tenant-456'])\n",[238,855,856,882,886,902,906,922,957,961,965,969,973],{"__ignoreMap":297},[301,857,858,860,862,864,866,869,872,874,876,878,880],{"class":303,"line":304},[301,859,308],{"class":307},[301,861,312],{"class":311},[301,863,316],{"class":315},[301,865,484],{"class":311},[301,867,868],{"class":307}," type",[301,870,871],{"class":315}," TenantSelection",[301,873,319],{"class":311},[301,875,322],{"class":307},[301,877,325],{"class":311},[301,879,329],{"class":328},[301,881,332],{"class":311},[301,883,884],{"class":303,"line":335},[301,885,339],{"emptyLinePlaceholder":338},[301,887,888,890,892,895,897,900],{"class":303,"line":342},[301,889,345],{"class":307},[301,891,349],{"class":348},[301,893,894],{"class":352}," OrderAdminRepository",[301,896,356],{"class":348},[301,898