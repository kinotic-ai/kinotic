id":234},"workflow","Workflow",[237,238,239,247,253],"ol",{},[240,241,242,243,246],"li",{},"Run ",[219,244,245],{},"kinotic sync"," to sync your entities and generate the base repository classes",[240,248,249,250,252],{},"Add custom methods with the ",[219,251,221],{}," decorator to the generated repository class",[240,254,242,255,258,259,262],{},[219,256,257],{},"kinotic generate"," to regenerate the repository with your query implementations (",[219,260,261],{},"generate"," runs locally without syncing to the server)",[232,264,266],{"id":265},"defining-named-queries","Defining Named Queries",[215,268,269,270,272,273,276],{},"Add methods with the ",[219,271,221],{}," decorator to your repository class. Use ",[219,274,275],{},":paramName"," syntax for parameter binding.",[278,279,284],"pre",{"className":280,"code":281,"language":282,"meta":283,"style":283},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT COUNT(*) FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003Cnumber> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT SUM(amount) FROM Order WHERE customerId = :customerId')\n    totalSpentByCustomer(customerId: string): Promise\u003Cnumber> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[219,285,286,319,326,349,354,378,414,421,427,432,450,477,482,487],{"__ignoreMap":283},[287,288,291,295,299,303,306,309,312,316],"span",{"class":289,"line":290},"line",1,[287,292,294],{"class":293},"s7zQu","import",[287,296,298],{"class":297},"sMK4o"," {",[287,300,302],{"class":301},"sTEyZ"," Query",[287,304,305],{"class":297}," }",[287,307,308],{"class":293}," from",[287,310,311],{"class":297}," '",[287,313,315],{"class":314},"sfazB","@kinotic-ai\u002Fpersistence",[287,317,3