210,247,248],{},"kinotic generate"," to regenerate the repository with your query implementations (",[210,251,252],{},"generate"," runs locally without syncing to the server)",[223,255,257],{"id":256},"defining-named-queries","Defining Named Queries",[206,259,260,261,263,264,267],{},"Add methods with the ",[210,262,212],{}," decorator to your repository class. Use ",[210,265,266],{},":paramName"," syntax for parameter binding.",[269,270,275],"pre",{"className":271,"code":272,"language":273,"meta":274,"style":274},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT COUNT(*) FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003Cnumber> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT SUM(amount) FROM Order WHERE customerId = :customerId')\n    totalSpentByCustomer(customerId: string): Promise\u003Cnumber> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[210,276,277,310,317,340,345,369,405,412,418,423,441,468,473,478],{"__ignoreMap":274},[278,279,282,286,290,294,297,300,303,307],"span",{"class":280,"line":281},"line",1,[278,283,285],{"class":284},"s7zQu","import",[278,287,289],{"class":288},"sMK4o"," {",[278,291,293],{"class":292},"sTEyZ"," Query",[278,295,296],{"class":288}," }",[278,298,299],{"class":284}," from",[278,301,302],{"class":288}," '",[278,304,306],{"class":305},"sfazB","@kinotic-ai\u002Fpersistence",[278,308,309],{"class":288},"'\n",[278,311,313],{"class":280,"line":312},2,[278,314,316],{"emptyLinePlaceholder":315},true,"\n",[278,318,320,323,327,331,334,337],{"class":280,"line":319},3,[278,321,322],{"class":284},"export",[278,324,326],{"class":325},"spNyl"," class",[278,328,330],{"class":329},"sBMFI"," OrderRepository",[278,332,333],{"class":325}," extends",[278,335,336],{"class":329}," BaseOrderRepository",[278,338,339],{"class":288}," {\n",[278,341,343],{"class":280,"line":342},4,[278,344,316],{"emptyLinePlaceholder":315},[278,346,348,351,355,358,361,364,366],{"class":280,"line":347},5,[278,349,350],{"class":288},"    @",[278,352,354],{"class":353},"s2Zo4","Query",[278,356,357],{"class":292},"(",[278,359,360],{"class":288},"'",[278,362,363],{"class":305},"SELECT COUNT(*) FROM Order WHERE status = :status",[278,365,360],{"class":288},[278,367,368],{"class":292},")\n",[278,370,372,376,378,382,385,388,391,394,397,400,403],{"class":280,"line":371},6,[278,373,375],{"class":374},"swJcz","    countByStatus",[278,377,357],{"class":288},[278,379,381],{"class":380},"sHdIc","status",[278,383,384],{"class":288},":",[278,386,387],{"class":329}," string",[278,389,390],{"class":288},"):",[278,392,393],{"class":329}," Promise",[278,395,396],{"class":288},"\u003C",[278,398,399],{"class":329},"number",[278,401,402],{"class":288},">",[278,404,339],{"class":288},[278,406,408],{"class":280,"line":407},7,[278,409,411],{"class":410},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[278,413,415],{"class":280,"line":414},8,[278,416,417],{"class":288},"    }\n",[278,419,421],{"class":280,"line":420},9,[278,422,316],{"emptyLinePlaceholder":315},[278,424,426,428,430,432,434,437,439],{"class":280,"line":425},10,[278,427,350],{"class":288},[278,429,354],{"class":353},[278,431,357],{"class":292},[278,433,360],{"class":288},[278,435,436],{"class":305},"SELECT SUM(amount) FROM Order WHERE customerId = :customerId",[278,438,360],{"class":288},[278,440,368],{"class":292},[278,442,444,447,449,452,454,456,458,460,462,464,466],{"class":280,"line":443},11,[278,445,446],{"class":374},"    totalSpentByCustomer",[278,448,357],{"class":288},[278,450,451],{"class":380},"customerId",[278,453,384],{"class":288},[278,455,387],{"class":329},[278,457,390],{"class":288},[278,459,393],{"class":329},[278,461,396],{"class":288},[278,463,399],{"class":329},[278,465,402],{"class":288},[278,467,339],{"class":288},[278,469,471],{"class":280,"line":470},12,[278,472,411],{"class":410},[278,474,476],{"class":280,"line":475},13,[278,477,417],{"class":288},[278,479,481],{"class":280,"line":480},14,[278,482,483],{"class":288},"}\n",[206,485,486,487,489],{},"The method body is left empty because ",[210,488,248],{}," fills in the implementation.",[206,491,492],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[223,494,496],{"id":495},"query-parameters","Query Parameters",[206,498,499,500,502],{},"Each parameter in the query uses ",[210,501,266],{}," syntax. At runtime, the generated method maps its arguments to the corresponding placeholders.",[504,505,506],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sHdIc, html code.shiki .sHdIc{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#EEFFFF;--shiki-def