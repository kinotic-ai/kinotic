tension":1019,"links":1020,"meta":1021,"navigation":338,"path":81,"seo":1022,"stem":82,"__hash__":1023},"docs\u002F01.apps\u002F05.persistence\u002F05.named-queries.md",{"type":231,"value":232,"toc":1007},"minimark",[233,242,245,250,277,281,291,585,591,594,598,626,630,645,686,690,701,729,733,773,777,798,802,814,995,1003],[234,235,236,237,241],"p",{},"Named queries let you define custom query methods on your repositories. You declare methods with the ",[238,239,240],"code",{},"@Query"," decorator, sync them with the server, and the CLI generates the implementation.",[234,243,244],{},"A named query belongs to the entity of its repository and acts on that entity alone: the statement names that entity, and a statement that names any other entity fails.",[246,247,249],"h2",{"id":248},"workflow","Workflow",[251,252,253,261,267],"ol",{},[254,255,256,257,260],"li",{},"Run ",[238,258,259],{},"kinotic sync"," to sync your entities and generate the base repository classes",[254,262,263,264,266],{},"Add custom methods with the ",[238,265,240],{}," decorator to the generated repository class",[254,268,256,269,272,273,276],{},[238,270,271],{},"kinotic generate"," to regenerate the repository with your query implementations (",[238,274,275],{},"generate"," runs locally without syncing to the server)",[246,278,280],{"id":279},"defining-named-queries","Defining Named Queries",[234,282,283,284,286,287,290],{},"Add methods with the ",[238,285,240],{}," decorator to your repository class. Use ",[238,288,289],{},":paramName"," syntax for parameter binding; each parameter takes the method argument of the same name.",[292,293,298],"pre",{"className":294,"code":295,"language":296,"meta":297,"style":297},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT * FROM Order WHERE status == :status ORDER BY placedAt DESC LIMIT 100')\n    findByStatus(status: string): Promise\u003COrder[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('UPDATE Order SET status = :status WHERE id == :id WITH REFRESH')\n    updateStatus(id: string, status: string): Promise\u003CWriteCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[238,299,300,333,340,363,368,392,431,438,444,449,467,507,512,517,522,540,569,574,579],{"__ignoreMap":297},[301,302,305,309,313,317,320,323,326,330],"span",{"class":303,"line":304},"line",1,[301,306,308],{"class":307},"s7zQu","import",[301,310,312],{"class":311},"sMK4o"," {",[301,314,316],{"class":315},"sTEyZ"," Query",[301,318,319],{"class":311}," }",[301,321,322],{"class":307}," from",[301,324,325],{"class":311}," '",[301,327,329],{"class":328},"sfazB","@kinotic-ai\u002Fpersistence",[301,331,332],{"class":311},"'\n",[301,334,336],{"class":303,"line":335},2,[301,337,339],{"emptyLinePlaceholder":338},true,"\n",[301,341,343,346,350,354,357,360],{"class":303,"line":342},3,[301,344,345],{"class":307},"export",[301,347,349],{"class":348},"spNyl"," class",[301,351,353],{"class":352},"sBMFI"," OrderRepository",[301,355,356],{"class":348}," extends",[301,358,359],{"class":352}," BaseOrderRepository",[301,361,362],{"class":311}," {\n",[301,364,366],{"class":303,"line":365},4,[301,367,339],{"emptyLinePlaceholder":338},[301,369,371,374,378,381,384,387,389],{"class":303,"line":370},5,[301,372,373],{"class":311},"    @",[301,375,377],{"class":376},"s2Zo4","Query",[301,379,380],{"class":315},"(",[301,382,383],{"class":311},"'",[301,385,386],{"class":328},"SELECT * FROM Order WHERE status == :status ORDER BY placedAt DESC LIMIT 100",[301,388,383],{"class":311},[301,390,391],{"class":315},")\n",[301,393,395,399,401,405,408,411,414,417,420,423,426,429],{"class":303,"line":394},6,[301,396,398],{"class":397},"swJcz","    findByStatus",[301,400,380],{"class":311},[301,402,404],{"class":403},"sHdIc","status",[301,406,407],{"class":311},":",[301,409,410],{"class":352}," string",[301,412,413],{"class":311},"):",[301,415,416],{"class":352}," Promise",[301,418,419],{"class":311},"\u003C",[301,421,422],{"class":352},"Order",[301,424,425],{"class":315},"[]",[301,427,428],{"class":311},">",[301,430,362],{"class":311},[301,432,434],{"class":303,"line":433},7,[301,435,437],{"class":436},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[301,439,441],{"class":303,"line":440},8,[301,442,443],{"class":311},"    }\n",[301,445,447],{"class":303,"line":446},9,[301,448,339],{"emptyLinePlaceholder":338},[301,450,452,454,456,458,460,463,465],{"class":303,"line":451},10,[301,453,373],{"class":311},[301,455,377],{"class":376},[301,457,380],{"class":315},[301,459,383],{"class":311},[301,461,462],{"class":328},"UPDATE Order SET status = :status WHERE id == :id WITH REFRESH",[301,464,383],{"class":311},[301,466,391],{"class":315},[301,468,470,473,475,478,480,482,485,488,490,492,494,496,498,501,503,505],{"class":303,"line":469},11,[301,471,472],{"class":397},"    updateStatus",[301,474,380],{"class":311},[301,476,477],{"class":403},"id",[301,479,407],{"class":311},[301,481,410],{"class":352},[301,483,484],{"class":311},",",[301,486,487],{"class":403}," status",[301,489,407],{"class":311},[301,491,410],{"class":352},[301,493,413],{"class":311},[301,495,416],{"class":352},[301,497,419],{"class":311},[301,499,500],{"class":352},"WriteCount",[301,502,425],{"class":315},[301,504,428],{"class":311},[301,506,362],{"class":311},[301,508,510],{"class":303,"line":509},12,[301,511,437],{"class":436},[301,513,515],{"class":303,"line":514},13,[301,516,443],{"class":311},[301,518,520],{"class":303,"line":519},14,[301,521,339],{"emptyLinePlaceholder":338},[301,523,525,527,529,531,533,536,538],{"class":303,"line":524},15,[301,526,373],{"class":311},[301,528,377],{"class":376},[301,530,380],{"class":315},[301,532,383],{"class":311},[301,534,535],{"class":328},"SELECT COUNT(*) AS count FROM Order WHERE status = :status",[301,537,383],{"class":311},[301,539,391],{"class":315},[301,541,543,546,548,550,552,554,556,558,560,563,565,567],{"class":303,"line":542},16,[301,544,545],{"class":397},"    countByStatus",[301,547,380],{"class":311},[301,549,404],{"class":403},[301,551,407],{"class":311},[301,553,410],{"class":352},[301,555,413],{"class":311},[301,557,416],{"class":352},[301,559,419],{"class":311},[301,561,562],{"class":352},"StatusCount",[301,564,425],{"class":315},[301,566,428],{"class":311},[301,568,362],{"class":311},[301,570,572],{"class":303,"line":571},17,[301,573,437],{"class":436},[301,575,577],{"class":303,"line":576},18,[301,578,443],{"class":311},[301,580,582],{"class":303,"line":581},19,[301,583,584],{"class":311},"}\n",[234,586,587,588,590],{},"The method body is left empty because ",[238,589,271],{}," fills in the implementation.",[234,592,593],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[246,595,597],{"id":596},"statements","Statements",[234,599,600,601,604,605,604,608,611,612,615,616,620,621,625],{},"A named query is one statement. ",[238,602,603],{},"SELECT",", ",[238,606,607],{},"INSERT",[238,609,610],{},"UPDATE"," and ",[238,613,614],{},"DELETE"," are statements of the ",[617,618,619],"a",{"href":140},"Kinotic SQL grammar",", the one migrations use, written without the terminating semicolon. An ",[617,622,624],{"href":623},"#aggregates","aggregate"," is Elasticsearch SQL.",[627,628,603],"h3",{"id":629},"select",[234,631,632,633,636,637,640,641,644],{},"Returns the rows of the entity that match the ",[238,634,635],{},"WHERE"," clause, shaped the way the entity class shapes them: nested objects and lists come back whole, since the rows are read from the stored documents. ",[238,638,639],{},"SELECT *"," returns whole rows; ",[238,642,643],{},"SELECT firstName, address"," returns the listed top-level fields only, each whole.",[646,647,648,658,665],"ul",{},[254,649,650,653,654,657],{},[238,651,652],{},"ORDER BY"," orders the rows. A sort the caller gives on a ",[238,655,656],{},"Pageable"," follows it.",[254,659,660,661,664],{},"A method that returns an array gets every matching row up to ",[238,662,663],{},"LIMIT",", or 1000 rows when the statement names no limit.",[254,666,667,668,671,672,675,676,678,679,681,682,685],{},"A method with a ",[238,669,670],{},"pageable: Pageable"," parameter returns a ",[238,673,674],{},"Page",", and the ",[238,677,656],{}," sets the page size. Cursor paging orders by the statement's ",[238,680,652],{},", so give it one that orders the rows fully, such as ",[238,683,684],{},"ORDER BY lastName, id",".",[627,687,689],{"id":688},"insert-update-and-delete","INSERT, UPDATE and DELETE",[234,691,692,693,696,697,700],{},"A write returns one row, ",[238,694,695],{},"{ count }",", holding the number of rows it wrote. Add ",[238,698,699],{},"WITH REFRESH"," when the next read must see the write.",[646,702,703,719],{},[254,704,705,707,708,711,712,611,715,718],{},[238,706,607],{}," stores the row the way the repository's ",[238,709,710],{},"save"," would: the row states the entity's id field, and the platform stores it under the participant's tenant, so the row is found by id afterwards. ",[238,713,714],{},"ROUTING",[238,716,717],{},"DOCUMENT_ID"," are not accepted, since both are derived.",[254,720,721,611,723,725,726,728],{},[238,722,610],{},[238,724,614],{}," act on the rows that match the ",[238,727,635],{}," clause.",[627,730,732],{"id":731},"aggregates","Aggregates",[234,734,735,736,738,739,604,742,604,745,604,748,604,751,754,755,758,759,762,763,766,767,770,771,685],{},"A ",[238,737,603],{}," with an aggregate function (",[238,740,741],{},"COUNT",[238,743,744],{},"SUM",[238,746,747],{},"AVG",[238,749,750],{},"MIN",[238,752,753],{},"MAX",", …) runs on Elasticsearch SQL, in its syntax: ",[238,756,757],{},"="," compares and ",[238,760,761],{},"GROUP BY"," groups. It returns one row per group, shaped by the projection. It names the entity in ",[238,764,765],{},"FROM"," and takes ",[238,768,769],{},":name"," parameters like every other statement. A paged aggregate takes a cursor ",[238,772,656],{},[246,774,776],{"id":775},"multi-tenancy","Multi-tenancy",[234,778,779,780,782,783,785,786,788,789,791,792,794,795,797],{},"Every named query is confined to the participant's tenant, the way every repository method is: a ",[238,781,603],{}," or aggregate reads only the rows of that tenant, an ",[238,784,607],{}," stores its row under it, and an ",[238,787,610],{}," or ",[238,790,614],{}," touches only its rows, whatever the ",[238,793,635],{}," clause says. An ",[238,796,607],{}," may state the entity's tenant field with the participant's own tenant; any other value is refused.",[246,799,801],{"id":800},"admin-repository-queries","Admin Repository Queries",[234,803,804,805,809,810,813],{},"A named query on an ",[617,806,808],{"href":807},"\u002Fapps\u002Fpersistence\u002Fmulti-tenancy#admin-repository","admin repository"," runs against the tenants the caller selects, so it declares a ",[238,811,812],{},"TenantSelection"," parameter like every other admin repository method. The generated implementation sends it as the query's tenant selection rather than as a query parameter. A read runs against every tenant the selection names; a write acts on one tenant, so its selection names exactly one.",[292,815,817],{"className":294,"code":816,"language":296,"meta":297,"style":297},"import { Query, type TenantSelection } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderAdminRepository extends BaseOrderAdminRepository {\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string, tenantSelection: TenantSelection): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n\nconst openOrders = await new OrderAdminRepository().countByStatus('OPEN', ['tenant-123', 'tenant-456'])\n",[238,818,819,845,849,865,869,885,920,924,928,932,936],{"__ignoreMap":297},[301,820,821,823,825,827,829,832,835,837,839,841,843],{"class":303,"line":304},[301,822,308],{"class":307},[301,824,312],{"class":311},[301,826,316],{"class":315},[301,828,484],{"class":311},[301,830,831],{"class":307}," type",[301,833,834],{"class":315}," TenantSelection",[301,836,319],{"class":311},[301,838,322],{"class":307},[301,840,325],{"class":311},[301,842,329],{"class":328},[301,844,332],{"class":311},[301,846,847],{"class":303,"line":335},[301,848,339],{"emptyLinePlaceholder":338},[301,850,851,853,855,858,860,863],{"class":303,"line":342},[301,852,345],{"class":307},[301,854,349],{"class":348},[301,856,857],{"class":352}," OrderAdminRepository",[301,859,356],{"class":348},[301,861,862],{"class":352}," BaseOrderAdminRepository",[301,864,362],{"class":311},[301,866,867],{"class":303,"line":365},[301,868,339],{"emptyLinePlaceholder":338},[301,870,871,873,875,877,879,881,883],{"class":303,"line":370},[301,872,373],{"class":311},[301,874,377],{"class":376},[301,876,380],{"class":315},[301,878,383],{"class":311},[301,880,535],{"class":328},[301,882,383],{"class":311},[301,884,391],{"class":315},[301,886,887,889,891,893,895,897,899,902,904,906,908,910,912,914,916,918],{"class":303,"line":394},[301,888,545],{"class":397},[301,890,380],{"class":311},[301,892,404],{"class":403},[301,894,407],{"class":311},[301,896,410],{"class":352},[301,898,484],{"class":311},[301,900,901],{"class":403}," tenantSelection",[301,903,407],{"class":311},[301,905,834],{"class":352},[301,907,413],{"class":311},[301,909,416],{"class":352},[301,911,419],{"class":311},[301,913,562],{"class":352},[301,915,425],{"class":315},[301,917,428],{"class":311},[301,919,362],{"class":311},[301,921