n Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":233,"path":234,"stem":235,"icon":236},"Enterprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":238,"title":80,"body":239,"description":1065,"extension":1066,"links":1067,"meta":1068,"navigation":347,"path":81,"seo":1069,"stem":82,"__hash__":1070},"docs\u002F01.apps\u002F05.persistence\u002F05.named-queries.md",{"type":240,"value":241,"toc":1054},"minimark",[242,251,254,259,286,290,300,594,600,603,607,649,653,668,708,712,723,751,755,819,823,844,848,860,1042,1050],[243,244,245,246,250],"p",{},"Named queries let you define custom query methods on your repositories. You declare methods with the ",[247,248,249],"code",{},"@Query"," decorator, sync them with the server, and the CLI generates the implementation.",[243,252,253],{},"A named query belongs to the entity of its repository and acts on that entity alone: the statement names that entity, and a statement that names any other entity fails.",[255,256,258],"h2",{"id":257},"workflow","Workflow",[260,261,262,270,276],"ol",{},[263,264,265,266,269],"li",{},"Run ",[247,267,268],{},"kinotic sync"," to sync your entities and generate the base repository classes",[263,271,272,273,275],{},"Add custom methods with the ",[247,274,249],{}," decorator to the generated repository class",[263,277,265,278,281,282,285],{},[247,279,280],{},"kinotic generate"," to regenerate the repository with your query implementations (",[247,283,284],{},"generate"," runs locally without syncing to the server)",[255,287,289],{"id":288},"defining-named-queries","Defining Named Queries",[243,291,292,293,295,296,299],{},"Add methods with the ",[247,294,249],{}," decorator to your repository class. Use ",[247,297,298],{},":paramName"," syntax for parameter binding; each parameter takes the method argument of the same name.",[301,302,307],"pre",{"className":303,"code":304,"language":305,"meta":306,"style":306},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100')\n    findByStatus(status: string): Promise\u003COrder[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('UPDATE Order SET status = :status WHERE id = :id WITH REFRESH')\n    updateStatus(id: string, status: string): Promise\u003CWriteCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[247,308,309,342,349,372,377,401,440,447,453,458,476,516,521,526,531,549,578,583,588],{"__ignoreMap":306},[310,311,314,318,322,326,329,332,335,339],"span",{"class":312,"line":313},"line",1,[310,315,317],{"class":316},"s7zQu","import",[310,319,321],{"class":320},"sMK4o"," {",[310,323,325],{"class":324},"sTEyZ"," Query",[310,327,328],{"class":320}," }",[310,330,331],{"class":316}," from",[310,333,334],{"class":320}," '",[310,336,338],{"class":337},"sfazB","@kinotic-ai\u002Fpersistence",[310,340,341],{"class":320},"'\n",[310,343,345],{"class":312,"line":344},2,[310,346,348],{"emptyLinePlaceholder":347},true,"\n",[310,350,352,355,359,363,366,369],{"class":312,"line":351},3,[310,353,354],{"class":316},"export",[310,356,358],{"class":357},"spNyl"," class",[310,360,362],{"class":361},"sBMFI"," OrderRepository",[310,364,365],{"class":357}," extends",[310,367,368],{"class":361}," BaseOrderRepository",[310,370,371],{"class":320}," {\n",[310,373,375],{"class":312,"line":374},4,[310,376,348],{"emptyLinePlaceholder":347},[310,378,380,383,387,390,393,396,398],{"class":312,"line":379},5,[310,381,382],{"class":320},"    @",[310,384,386],{"class":385},"s2Zo4","Query",[310,388,389],{"class":324},"(",[310,391,392],{"class":320},"'",[310,394,395],{"class":337},"SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100",[310,397,392],{"class":320},[310,399,400],{"class":324},")\n",[310,402,404,408,410,414,417,420,423,426,429,432,435,438],{"class":312,"line":403},6,[310,405,407],{"class":406},"swJcz","    findByStatus",[310,409,389],{"class":320},[310,411,413],{"class":412},"sHdIc","status",[310,415,416],{"class":320},":",[310,418,419],{"class":361}," string",[310,421,422],{"class":320},"):",[310,424,425],{"class":361}," Promise",[310,427,428],{"class":320},"\u003C",[310,430,431],{"class":361},"Order",[310,433,434],{"class":324},"[]",[310,436,437],{"class":320},">",[310,439,371],{"class":320},[310,441,443],{"class":312,"line":442},7,[310,444,446],{"class":445},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[310,448,450],{"class":312,"line":449},8,[310,451,452],{"class":320},"    }\n",[310,454,456],{"class":312,"line":455},9,[310,457,348],{"emptyLinePlaceholder":347},[310,459,461,463,465,467,469,472,474],{"class":312,"line":460},10,[310,462,382],{"class":320},[310,464,386],{"class":385},[310,466,389],{"class":324},[310,468,392],{"class":320},[310,470,471],{"class":337},"UPDATE Order SET status = :status WHERE id = :id WITH REFRESH",[310,473,392],{"class":320},[310,475,400],{"class":324},[310,477,479,482,484,487,489,491,494,497,499,501,503,505,507,510,512,514],{"class":312,"line":478},11,[310,480,481],{"class":406},"    updateStatus",[310,483,389],{"class":320},[310,485,486],{"class":412},"id",[310,488,416],{"class":320},[310,490,419],{"class":361},[310,492,493],{"class":320},",",[310,495,496],{"class":412}," status",[310,498,416],{"class":320},[310,500,419],{"class":361},[310,502,422],{"class":320},[310,504,425],{"class":361},[310,506,428],{"class":320},[310,508,509],{"class":361},"WriteCount",[310,511,434],{"class":324},[310,513,437],{"class":320},[310,515,371],{"class":320},[310,517,519],{"class":312,"line":518},12,[310,520,446],{"class":445},[310,522,524],{"class":312,"line":523},13,[310,525,452],{"class":320},[310,527,529],{"class":312,"line":528},14,[310,530,348],{"emptyLinePlaceholder":347},[310,532,534,536,538,540,542,545,547],{"class":312,"line":533},15,[310,535,382],{"class":320},[310,537,386],{"class":385},[310,539,389],{"class":324},[310,541,392],{"class":320},[310,543,544],{"class":337},"SELECT COUNT(*) AS count FROM Order WHERE status = :status",[310,546,392],{"class":320},[310,548,400],{"class":324},[310,550,552,555,557,559,561,563,565,567,569,572,574,576],{"class":312,"line":551},16,[310,553,554],{"class":406},"    countByStatus",[310,556,389],{"class":320},[310,558,413],{"class":412},[310,560,416],{"class":320},[310,562,419],{"class":361},[310,564,422],{"class":320},[310,566,425],{"class":361},[310,568,428],{"class":320},[310,570,571],{"class":361},"StatusCount",[310,573,434],{"class":324},[310,575,437],{"class":320},[310,577,371],{"class":320},[310,579,581],{"class":312,"line":580},17,[310,582,446],{"class":445},[310,584,586],{"class":312,"line":585},18,[310,587,452],{"class":320},[310,589,591],{"class":312,"line":590},19,[310,592,593],{"class":320},"}\n",[243,595,596,597,599],{},"The method body is left empty because ",[247,598,280],{}," fills in the implementation.",[243,601,602],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[255,604,606],{"id":605},"statements","Statements",[243,608,609,610,613,614,613,617,620,621,624,625,629,630,620,633,636,637,620,640,643,644,648],{},"A named query is one statement. ",[247,611,612],{},"SELECT",", ",[247,615,616],{},"INSERT",[247,618,619],{},"UPDATE"," and ",[247,622,623],{},"DELETE"," are statements of the ",[626,627,628],"a",{"href":140},"Kinotic SQL grammar",", the one migrations use, written without the terminating semicolon. Keywords match in any case, but entity and field names are case-sensitive and must be written the way the entity class spells them: ",[247,631,632],{},"Person",[247,634,635],{},"lastName",", not ",[247,638,639],{},"person",[247,641,642],{},"LASTNAME",". A field name in the wrong case is not an error: the query gets nothing back, no rows read and none written. See ",[626,645,647],{"href":646},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#case","Case",".",[650,651,612],"h3",{"id":652},"select",[243,654,655,656,659,660,663,664,667],{},"Returns the rows of the entity that match the ",[247,657,658],{},"WHERE"," clause, shaped the way the entity class shapes them: nested objects and lists come back whole, since the rows are read from the stored documents. ",[247,661,662],{},"SELECT *"," returns whole rows; ",[247,665,666],{},"SELECT firstName, address"," returns the listed top-level fields only, each whole.",[669,670,671,681,688],"ul",{},[263,672,673,676,677,680],{},[247,674,675],{},"ORDER BY"," orders the rows. A sort the caller gives on a ",[247,678,679],{},"Pageable"," follows it.",[263,682,683,684,687],{},"A method that returns an array gets every matching row up to ",[247,685,686],{},"LIMIT",", or 1000 rows when the statement names no limit.",[263,689,690,691,694,695,698,699,701,702,704,705,648],{},"A method with a ",[247,692,693],{},"pageable: Pageable"," parameter returns a ",[247,696,697],{},"Page",", and the ",[247,700,679],{}," sets the page size. Cursor paging orders by the statement's ",[247,703,675],{},", so give it one that orders the rows fully, such as ",[247,706,707],{},"ORDER BY lastName, id",[650,709,711],{"id":710},"insert-update-and-delete","INSERT, UPDATE and DELETE",[243,713,714,715,718,719,722],{},"A write returns one row, ",[247,716,717],{},"{ count }",", holding the number of rows it wrote. Add ",[247,720,721],{},"WITH REFRESH"," when the next read must see the write.",[669,724,725,741],{},[263,726,727,729,730,733,734,620,737,740],{},[247,728,616],{}," stores the row the way the repository's ",[247,731,732],{},"save"," would: the row states the entity's id field, and the platform stores it under the participant's tenant, so the row is found by id afterwards. ",[247,735,736],{},"ROUTING",[247,738,739],{},"DOCUMENT_ID"," are not accepted, since both are derived.",[263,742,743,620,745,747,748,750],{},[247,744,619],{},[247,746,623],{}," act on the rows that match the ",[247,749,658],{}," clause.",[650,752,754],{"id":753},"aggregates","Aggregates",[243,756,757,758,760,761,613,764,613,767,613,770,613,773,613,776,613,779,782,783,786,787,793,794,797,798,801,802,804,805,808,809,812,813,816,817,648],{},"A ",[247,759,612],{}," that calls a function (",[247,762,763],{},"COUNT(*)",[247,765,766],{},"SUM",[247,768,769],{},"AVG",[247,771,772],{},"MIN",[247,774,775],{},"MAX",[247,777,778],{},"PERCENTILE",[247,780,781],{},"HISTOGRAM",", …) or has a ",[247,784,785],{},"GROUP BY"," is an aggregate. It runs on Elasticsearch SQL, so it can call any of ",[626,788,792],{"href":789,"rel":790},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Freference\u002Fquery-languages\u002Fsql\u002Fsql-functions",[791],"nofollow","its functions",", and returns one row per group, shaped by the projection: ",[247,795,796],{},"AS"," names a column, and a column or group can be a sub-field (",[247,799,800],{},"address.city","). It is written in the same grammar as every other statement, with the same ",[247,803,658],{}," clause and ",[247,806,807],{},":name"," parameters, and names the query's own entity in ",[247,810,811],{},"FROM","; see ",[626,814,612],{"href":815},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#select",". A paged aggregate takes a cursor ",[247,818,679],{},[255,820,822],{"id":821},"multi-tenancy","Multi-tenancy",[243,824,825,826,828,829,831,832,834,835,837,838,840,841,843],{},"Every named query is confined to the participant's tenant, the way every repository method is: a ",[247,827,612],{}," or aggregate reads only the rows of that tenant, an ",[247,830,616],{}," stores its row under it, and an ",[247,833,619],{}," or ",[247,836,623],{}," touches only its rows, whatever the ",[247,839,658],{}," clause says. An ",[247,842,616],{}," may state the entity's tenant field with the participant's own tenant; any other value is refused.",[255,845,847],{"id":846},"admin-repository-queries","Admin Repository Queries",[243,849,850,851,855,856,859],{},"A named query on an ",[626,852,854],{"href":853},"\u002Fapps\u002Fpersistence\u002Fmulti-tenancy#admin-repository","admin repository"," runs against the tenants the caller selects, so it declares a ",[247,857,858],{},"TenantSelection"," parameter like every other admin repository method. The generated implementation sends it as the query's tenant selection rather than as a query parameter. A read runs against every tenant the selection names; a write acts on one tenant, so its selection names exactly one.",[301,861,863],{"className":303,"code":862,"language":305,"meta":306,"style":306},"import { Query, type TenantSelection } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderAdminRepository extends BaseOrderAdminRepository {\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string, tenantSelection: TenantSelection): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n\nconst openOrders = await new OrderAdminRepository().countByStatus('OPEN', ['tenant-123', 'tenant-456'])\n",[247,864,865,891,895,911,915,931,966,970,974,978,982],{"__ignoreMap":306},[310,866,867,869,871,873,875,878,881,883,885,887,889],{"class":312,"line":313},[310,868,317],{"class":316},[310,870,321],{"class":320},[310,872,325],{"class":324},[310,874,493],{"class":320},[310,876,877],{"class":316}," type",[310,879,880],{"class":324}," TenantSelection",[310,882,328],{"class":320},[310,884,331],{"class":316},[310,886,334],{"c