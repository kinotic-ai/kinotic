c":530},"minimark",[228,237,245,250,277,281,291,507,513,516,520,526],[229,230,231,232,236],"p",{},"Named queries let you define custom query methods on your repositories. You declare methods with the ",[233,234,235],"code",{},"@Query"," decorator using a SQL-like syntax, sync them with the server, and the CLI generates the implementation.",[229,238,239,240,244],{},"Currently named queries support ",[241,242,243],"strong",{},"aggregate queries"," (COUNT, SUM, AVG, MIN, MAX, etc.). Support for SELECT, UPDATE, and DELETE queries is coming soon.",[246,247,249],"h2",{"id":248},"workflow","Workflow",[251,252,253,261,267],"ol",{},[254,255,256,257,260],"li",{},"Run ",[233,258,259],{},"kinotic sync"," to sync your entities and generate the base repository classes",[254,262,263,264,266],{},"Add custom methods with the ",[233,265,235],{}," decorator to the generated repository class",[254,268,256,269,272,273,276],{},[233,270,271],{},"kinotic generate"," to regenerate the repository with your query implementations (",[233,274,275],{},"generate"," runs locally without syncing to the server)",[246,278,280],{"id":279},"defining-named-queries","Defining Named Queries",[229,282,283,284,286,287,290],{},"Add methods with the ",[233,285,235],{}," decorator to your repository class. Use ",[233,288,289],{},":paramName"," syntax for parameter binding.",[292,293,298],"pre",{"className":294,"code":295,"language":296,"meta":297,"style":297},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT COUNT(*) FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003Cnumber> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT SUM(amount) FROM Order WHERE customerId = :customerId')\n    totalSpentByCustomer(customerId: string): Promise\u003Cnumber> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[233,299,300,333,340,363,368,392,428,435,441,446,464,491,496,501],{"__ignoreMap":297},[301,302,305,309,313,317,320,323,326,330],"span",{"class":303,"line":304},"line",1,[301,306,308],{"class":307},"s7zQu","import",[301,310,312],{"class":311},"sMK4o"," {",[301,314,316],{"class":315},"sTEyZ"," Query",[301,318,319],{"class":311}," }",[301,321,322],{"class":307}," from",[301,324,325],{"class":311}," '",[301,327,329],{"class":328},"sfazB","@kinotic-ai\u002Fpersistence",[301,331,332],{"class":311},"'\n",[301,334,336],{"class":303,"line":335},2,[301,337,339],{"emptyLinePlaceholder":338},true,"\n",[301,341,343,346,350,354,357,360],{"class":303,"line":342},3,[301,344,345],{"class":307},"export",[301,347,349],{"class":348},"spNyl"," class",[301,351,353],{"class":352},"sBMFI"," OrderRepository",[301,355,356],{"class":348}," extends",[301,358,359],{"class":352}," BaseOrderRepository",[301,361,362],{"class":311}," {\n",[301,364,366],{"class":303,"line":365},4,[301,367,339],{"emptyLinePlaceholder":338},[301,369,371,374,378,381,384,387,389],{"class":303,"line":370},5,[301,372,373],{"class":311},"    @",[301,375,377],{"class":376},"s2Zo4","Query",[301,379,380],{"class":315},"(",[301,382,383],{"class":311},"'",[301,385,386],{"class":328},"SELECT COUNT(*) FROM Order WHERE status = :status",[301,388,383],{"class":311},[301,390,391],{"class":315},")\n",[301,393,395,399,401,405,408,411,414,417,420,423,426],{"class":303,"line":394},6,[301,396,398],{"class":397},"swJcz","    countByStatus",[301,400,380],{"class":311},[301,402,404],{"class":403},"sHdIc","status",[301,406,407],{"class":311},":",[301,409,410],{"class":352}," string",[301,412,413],{"class":311},"):",[301,415,416],{"class":352}," Promise",[301,418,419],{"class":311},"\u003C",[301,421,422],{"class":352},"number",[301,424,425],{"class":311},">",[301,427,362],{"class":311},[301,429,431],{"class":303,"line":430},7,[301,432,434],{"class":433}