hat entity, and a statement that names any other entity fails.",[281,282,284],"h2",{"id":283},"workflow","Workflow",[286,287,288,296,302],"ol",{},[289,290,291,292,295],"li",{},"Run ",[273,293,294],{},"kinotic sync"," to sync your entities and generate the base repository classes",[289,297,298,299,301],{},"Add custom methods with the ",[273,300,275],{}," decorator to the generated repository class",[289,303,291,304,307,308,311],{},[273,305,306],{},"kinotic generate"," to regenerate the repository with your query implementations (",[273,309,310],{},"generate"," runs locally without syncing to the server)",[281,313,315],{"id":314},"defining-named-queries","Defining Named Queries",[269,317,318,319,321,322,325],{},"Add methods with the ",[273,320,275],{}," decorator to your repository class. Use ",[273,323,324],{},":paramName"," syntax for parameter binding; each parameter takes the method argument of the same name.",[327,328,333],"pre",{"className":329,"code":330,"language":331,"meta":332,"style":332},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100')\n    findByStatus(status: string): Promise\u003COrder[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('UPDATE Order SET status = :status WHERE id = :id WITH REFRESH')\n    updateStatus(id: string, status: string): Promise\u003CWriteCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[273,334,335,368,375,398,403,427,466,473,479,484,502,542,547,552,557,575,604,609,614],{"__ignoreMap":332},[336,337,340,344,348,352,355,358,361,365],"span",{"class":338,"line":339},"line",1,[336,341,343],{"class":342},"s7zQu","import",[336,345,347],{"class":346},"sMK4o"," {",[336,349,351],{"class":350},"sTEyZ"," Query",[336,353,354],{"class":346}," }",[336,356,357],{"class":342}," from",[336,359,360],{"class":346}," '",[336,362,364],{"class":363},"sfazB","@kinotic-ai\u002Fpersistence",[336,366,367],{"class":346},"'\n",[336,369,371],{"class":338,"line":370},2,[336,372,374],{"emptyLinePlaceholder":373},true,"\n",[336,376,378,381,385,389,392,395],{"class":338,"line":377},3,[336,379,380],{"class":342},"export",[336,382,384],{"class":383},"spNyl"," class",[336,386,388],{"class":387},"sBMFI"," OrderRepository",[336,390,391],{"class":383}," extends",[336,393,394],{"class":387}," BaseOrderRepository",[336,396,397],{"class":346}," {\n",[336,399,401],{"class":338,"line":400},4,[336,402,374],{"emptyLinePlaceholder":373},[336,404,406,409,413,416,419,422,424],{"class":338,"line":405},5,[336,407,408],{"class":346},"    @",[336,410,412],{"class":411},"s2Zo4","Query",[336,414,415],{"class":350},"(",[336,417,418],{"class":346},"'",[336,420,421],{"class":363},"SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100",[336,423,418],{"class":346},[336,425,426],{"class":350},")\n",[336,428,430,434,436,440,443,446,449,452,455,458,461,464],{"class":338,"line":429},6,[336,431,433],{"class":432},"swJcz","    findByStatus",[336,435,415],{"class":346},[336,437,439],{"class":438},"sHdIc","status",[336,441,442],{"class":346},":",[336,444,445],{"class":387}," string",[336,447,448],{"class":346},"):",[336,450,451],{"class":387}," Promise",[336,453,454],{"class":346},"\u003C",[336,456,457],{"class":387},"Order",[336,459,460],{"class":350},"[]",[336,462,463],{"class":346},">",[336,465,397],{"class":346},[336,467,469],{"class":338,"line":468},7,[336,470,472],{"class":471},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[336,474,476],{"class":338,"line":475},8,[336,477,478],{"class":346},"    }\n",[336,480,482],{"class":338,"line":481},9,[336,483,374],{"emptyLinePlaceholder":373},[336,485,487,489,491,493,495,498,500],{"class":338,"line":486},10,[336,488,408],{"class":346},[336,490,412],{"class":411},[336,492,415],{"class":350},[336,494,418],{"class":346},[336,496,497],{"class":363},"UPDATE Order SET status = :status WHERE id = :id WITH REFRESH",[336,499,418],{"class":346},[336,501,426],{"class":350},[336,503,505,508,510,513,515,517,520,523,525,527,529,531,533,536,538,540],{"class":338,"line":504},11,[336,506,507],{"class":432},"    updateStatus",[336,509,415],{"class":346},[336,511,512],{"class":438},"id",[336,514,442],{"class":346},[336,516,445],{"class":387},[336,518,519],{"class":346},",",[336,521,522],{"class":438}," status",[336,524,442],{"class":346},[336,526,445],{"class":387},[336,528,448],{"class":346},[336,530,451],{"class":387},[336,532,454],{"class":346},[336,534,535],{"class":387},"WriteCount",[336,537,460],{"class":350},[336,539,463],{"class":346},[336,541,397],{"class":346},[336,543,545],{"class":338,"line":544},12,[336,546,472],{"class":471},[336,548,550],{"class":338,"line":549},13,[336,551,478],{"class":346},[336,553,555],{"class":338,"line":554},14,[336,556,374],{"emptyLinePlaceholder":373},[336,558,560,562,564,566,568,571,573],{"class":338,"line":559},15,[336,561,408],{"class":346},[336,563,412],{"class":411},[336,565,415],{"class":350},[336,567,418],{"class":346},[336,569,570],{"class":363},"SELECT COUNT(*) AS count FROM Order WHERE status = :status",[336,572,418],{"class":346},[336,574,426],{"class":350},[336,576,578,581,583,585,587,589,591,593,595,598,600,602],{"class":338,"line":577},16,[336,579,580],{"class":432},"    countByStatus",[336,582,415],{"class":346},[336,584,439],{"class":438},[336,586,442],{"class":346},[336,588,445],{"class":387},[336,590,448],{"class":346},[336,592,451],{"class":387},[336,594,454],{"class":346},[336,596,597],{"class":387},"StatusCount",[336,599,460],{"class":350},[336,601,463],{"class":346},[336,603,397],{"class":346},[336,605,607],{"class":338,"line":606},17,[336,608,472],{"class":471},[336,610,612],{"class":338,"line":611},18,[336,613,478],{"class":346},[336,615,617],{"class":338,"line":616},19,[336,618,619],{"class":346},"}\n",[269,621,622,623,625],{},"The method body is left empty because ",[273,624,306],{}," fills in the implementation.",[269,627,628],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[281,630,632],{"id":631},"statements","Statements",[269,634,635,636,639,640,639,643,646,647,650,651,655,656,646,659,662,663,646,666,669,670,674],{},"A named query is one statement. ",[273,637,638],{},"SELECT",", ",[273,641,642],{},"INSERT",[273,644,645],{},"UPDATE"," and ",[273,648,649],{},"DELETE"," are statements of the ",[652,653,654],"a",{"href":167},"Kinotic SQL grammar",", the one migrations use, written without the terminating semicolon. Keywords match in any case, but entity and field names are case-sensitive and must be written the way the entity class spells them: ",[273,657,658],{},"Person",[273,660,661],{},"lastName",", not ",[273,664,665],{},"person",[273,667,668],{},"LASTNAME",". A field name in the wrong case is not an error: the query gets nothing back, no rows read and none written. See ",[652,671,673],{"href":672},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#case","Case",".",[676,677,638],"h3",{"id":678},"select",[269,680,681,682,685,686,689,690,693],{},"Returns the rows of the entity that match the ",[273,683,684],{},"WHERE"," clause, shaped the way the entity class shapes them: nested objects and lists come back whole, since the rows are read from the stored documents. ",[273,687,688],{},"SELECT *"," returns whole rows; ",[273,691,692],{},"SELECT firstName, address"," returns the listed top-level fields only, each whole.",[695,696,697,707,714],"ul",{},[289,698,699,702,703,706],{},[273,700,701],{},"ORDER BY"," orders the rows. A sort the caller gives on a ",[273,704,705],{},"Pageable"," follows it.",[289,708,709,710,713],{},"A method that returns an array gets every matching row up to ",[273,711,712],{},"LIMIT",", or 1000 rows when the statement names no limit.",[289,715,716,717,720,721,724,725,727,728,730,731,674],{},"A method with a ",[273,718,719],{},"pageable: Pageable"," parameter returns a ",[273,722,723],{},"Page",", and the ",[273,726,705],{}," sets the page size. Cursor paging orders by the statement's ",[273,729,701],{},", so give it one that orders the rows fully, such as ",[273,732,733],{},"ORDER BY lastName, id",[676,735,737],{"id":736},"insert-update-and-delete","INSERT, UPDATE and DELETE",[269,739,740,741,744,745,748],{},"A write returns one row, ",[273,742,743],{},"{ count }",", holding the number of rows it wrote. Add ",[273,746,747],{},"WITH REFRESH"," when the next read must see the write.",[695,750,751,767],{},[289,752,753,755,756,759,760,646,763,766],{},[273,754,642],{}," stores the row the way the repository's ",[273,757,758],{},"save"," would: the row states the entity's id field, and the platform stores it under the participant's tenant, so the row is found by id afterwards. ",[273,761,762],{},"ROUTING",[273,764,765],{},"DOCUMENT_ID"," are not accepted, since both are derived.",[289,768,769,646,771,773,774,776],{},[273,770,645],{},[273,772,649],{}," act on the rows that match the ",[273,775,684],{}," clause.",[676,778,780],{"id":779},"aggregates","Aggregates",[269,782,783,784,786,787,639,790,639,793,639,796,639,799,639,802,639,805,808,809,812,813,819,820,823,824,827,828,830,831,834,835,838,839,842,843,674],{},"A ",[273,785,638],{}," that calls a function (",[273,788,789],{},"COUNT(*)",[273,791,792],{},"SUM",[273,794,795],{},"AVG",[273,797,798],{},"MIN",[273,800,801],{},"MAX",[273,803,804],{},"PERCENTILE",[273,806,807],{},"HISTOGRAM",", …) or has a ",[273,810,811],{},"GROUP BY"," is an aggregate. It runs on Elasticsearch SQL, so it can call any of ",[652,814,818],{"href":815,"rel":816},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Freference\u002Fquery-languages\u002Fsql\u002Fsql-functions",[817],"nofollow","its functions",", and returns one row per group, shaped by the projection: ",[273,821,822],{},"AS"," names a column, and a column or group can be a sub-field (",[273,825,826],{},"address.city","). It is written in the same grammar as every other statement, with the same ",[273,829,684],{}," clause and ",[273,832,833],{},":name"," parameters, and names the query's own entity in ",[273,836,837],{},"FROM","; see ",[652,840,638],{"href":841},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#select",". A paged aggregate takes a cursor ",[273,844,705],{},[281,846,848],{"id":847},"multi-tenancy","Multi-tenancy",[269,850,851,852,854,855,857,858,860,861,863,864,866,867,869],{},"Every named query is confined to the participant's tenant, the way every repository method is: a ",[273,853,638],{}," or aggregate reads only the rows of that tenant, an ",[273,856,642],{}," stores its row under it, and an ",[273,859,645],{}," or ",[273,862,649],{}," touches only its rows, whatever the ",[273,865,684],{}," clause says. An ",[273,868,642],{}," may state the entity's tenant field with the participant's own tenant; any other value is refused.",[281,871,873],{"id":872},"admin-repository-queries","Admin Repository Queries",[269,875,876,877,881,882,885],{},"A named query on an ",[652,878,880],{"href":879},"\u002Fapps\u002Fpersistence\u002Fmulti-tenancy#admin-repository","admin repository"," runs against the tenants the caller selects, so it declares a ",[273,883,884],{},"TenantSelection"," parameter like every other admin repository method. The generated implementation sends it as the query's tenant selection rather than as a query parameter. A read runs against every tenant the selection names; a write acts on one tenant, so its selection names exactly one.",[327,887,889],{"className":329,"code":888,"language":331