tem":234,"icon":235},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":237,"path":238,"stem":239,"icon":174},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":241,"path":242,"stem":243,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":245,"path":246,"stem":247,"icon":248},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":250,"path":251,"stem":252,"icon":253},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":255,"path":256,"stem":257,"icon":258},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":260,"title":105,"body":261,"description":1087,"extension":1088,"links":1089,"meta":1090,"navigation":369,"path":106,"seo":1091,"stem":107,"__hash__":1092},"docs\u002F03.apps\u002F05.persistence\u002F05.named-queries.md",{"type":262,"value":263,"toc":1076},"minimark",[264,273,276,281,308,312,322,616,622,625,629,671,675,690,730,734,745,773,777,841,845,866,870,882,1064,1072],[265,266,267,268,272],"p",{},"Named queries let you define custom query methods on your repositories. You declare methods with the ",[269,270,271],"code",{},"@Query"," decorator, sync them with the server, and the CLI generates the implementation.",[265,274,275],{},"A named query belongs to the entity of its repository and acts on that entity alone: the statement names that entity, and a statement that names any other entity fails.",[277,278,280],"h2",{"id":279},"workflow","Workflow",[282,283,284,292,298],"ol",{},[285,286,287,288,291],"li",{},"Run ",[269,289,290],{},"kinotic sync"," to sync your entities and generate the base repository classes",[285,293,294,295,297],{},"Add custom methods with the ",[269,296,271],{}," decorator to the generated repository class",[285,299,287,300,303,304,307],{},[269,301,302],{},"kinotic generate"," to regenerate the repository with your query implementations (",[269,305,306],{},"generate"," runs locally without syncing to the server)",[277,309,311],{"id":310},"defining-named-queries","Defining Named Queries",[265,313,314,315,317,318,321],{},"Add methods with the ",[269,316,271],{}," decorator to your repository class. Use ",[269,319,320],{},":paramName"," syntax for parameter binding; each parameter takes the method argument of the same name.",[323,324,329],"pre",{"className":325,"code":326,"language":327,"meta":328,"style":328},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100')\n    findByStatus(status: string): Promise\u003COrder[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('UPDATE Order SET status = :status WHERE id = :id WITH REFRESH')\n    updateStatus(id: string, status: string): Promise\u003CWriteCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[269,330,331,364,371,394,399,423,462,469,475,480,498,538,543,548,553,571,600,605,610],{"__ignoreMap":328},[332,333,336,340,344,348,351,354,357,361],"span",{"class":334,"line":335},"line",1,[332,337,339],{"class":338},"s7zQu","import",[332,341,343],{"class":342},"sMK4o"," {",[332,345,347],{"class":346},"sTEyZ"," Query",[332,349,350],{"class":342}," }",[332,352,353],{"class":338}," from",[332,355,356],{"class":342}," '",[332,358,360],{"class":359},"sfazB","@kinotic-ai\u002Fpersistence",[332,362,363],{"class":342},"'\n",[332,365,367],{"class":334,"line":366},2,[332,368,370],{"emptyLinePlaceholder":369},true,"\n",[332,372,374,377,381,385,388,391],{"class":334,"line":373},3,[332,375,376],{"class":338},"export",[332,378,380],{"class":379},"spNyl"," class",[332,382,384],{"class":383},"sBMFI"," OrderRepository",[332,386,387],{"class":379}," extends",[332,389,390],{"class":383}," BaseOrderRepository",[332,392,393],{"class":342}," {\n",[332,395,397],{"class":334,"line":396},4,[332,398,370],{"emptyLinePlaceholder":369},[332,400,402,405,409,412,415,418,420],{"class":334,"line":401},5,[332,403,404],{"class":342},"    @",[332,406,408],{"class":407},"s2Zo4","Query",[332,410,411],{"class":346},"(",[332,413,414],{"class":342},"'",[332,416,417],{"class":359},"SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100",[332,419,414],{"class":342},[332,421,422],{"class":346},")\n",[332,424,426,430,432,436,439,442,445,448,451,454,457,460],{"class":334,"line":425},6,[332,427,429],{"class":428},"swJcz","    findByStatus",[332,431,411],{"class":342},[332,433,435],{"class":434},"sHdIc","status",[332,437,438],{"class":342},":",[332,440,441],{"class":383}," string",[332,443,444],{"class":342},"):",[332,446,447],{"class":383}," Promise",[332,449,450],{"class":342},"\u003C",[332,452,453],{"class":383},"Order",[332,455,456],{"class":346},"[]",[332,458,459],{"class":342},">",[332,461,393],{"class":342},[332,463,465],{"class":334,"line":464},7,[332,466,468],{"class":467},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[332,470,472],{"class":334,"line":471},8,[332,473,474],{"class":342},"    }\n",[332,476,478],{"class":334,"line":477},9,[332,479,370],{"emptyLinePlaceholder":369},[332,481,483,485,487,489,491,494,496],{"class":334,"line":482},10,[332,484,404],{"class":342},[332,486,408],{"class":407},[332,488,411],{"class":346},[332,490,414],{"class":342},[332,492,493],{"class":359},"UPDATE Order SET status = :status WHERE id = :id WITH REFRESH",[332,495,414],{"class":342},[332,497,422],{"class":346},[332,499,501,504,506,509,511,513,516,519,521,523,525,527,529,532,534,536],{"class":334,"line":500},11,[332,502,503],{"class":428},"    updateStatus",[332,505,411],{"class":342},[332,507,508],{"class":434},"id",[332,510,438],{"class":342},[332,512,441],{"class":383},[332,514,515],{"class":342},",",[332,517,518],{"class":434}," status",[332,520,438],{"class":342},[332,522,441],{"class":383},[332,524,444],{"class":342},[332,526,447],{"class":383},[332,528,450],{"class":342},[332,530,531],{"class":383},"WriteCount",[332,533,456],{"class":346},[332,535,459],{"class":342},[332,537,393],{"class":342},[332,539,541],{"class":334,"line":540},12,[332,542,468],{"class":467},[332,544,546],{"class":334,"line":545},13,[332,547,474],{"class":342},[332,549,551],{"class":334,"line":550},14,[332,552,370],{"emptyLinePlaceholder":369},[332,554,556,558,560,562,564,567,569],{"class":334,"line":555},15,[332,557,404],{"class":342},[332,559,408],{"class":407},[332,561,411],{"class":346},[332,563,414],{"class":342},[332,565,566],{"class":359},"SELECT COUNT(*) AS count FROM Order WHERE status = :status",[332,568,414],{"class":342},[332,570,422],{"class":346},[332,572,574,577,579,581,583,585,587,589,591,594,596,598],{"class":334,"line":573},16,[332,575,576],{"class":428},"    countByStatus",[332,578,411],{"class":342},[332,580,435],{"class":434},[332,582,438],{"class":342},[332,584,441],{"class":383},[332,586,444],{"class":342},[332,588,447],{"class":383},[332,590,450],{"class":342},[332,592,593],{"class":383},"StatusCount",[332,595,456],{"class":346},[332,597,459],{"class":342},[332,599,393],{"class":342},[332,601,603],{"class":334,"line":602},17,[332,604,468],{"class":467},[332,606,608],{"class":334,"line":607},18,[332,609,474],{"class":342},[332,611,613],{"class":334,"line":612},19,[332,614,615],{"class":342},"}\n",[265,617,618,619,621],{},"The method body is left empty because ",[269,620,302],{}," fills in the implementation.",[265,623,624],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[277,626,628],{"id":627},"statements","Statements",[265,630,631,632,635,636,635,639,642,643,646,647,651,652,642,655,658,659,642,662,665,666,670],{},"A named query is one statement. ",[269,633,634],{},"SELECT",", ",[269,637,638],{},"INSERT",[269,640,641],{},"UPDATE"," and ",[269,644,645],{},"DELETE"," are statements of the ",[648,649,650],"a",{"href":163},"Kinotic SQL grammar",", the one migrations use, written without the terminating semicolon. Keywords match in any case, but entity and field names are case-sensitive and must be written the way the entity class spells them: ",[269,653,654],{},"Person",[269,656,657],{},"lastName",", not ",[269,660,661],{},"person",[269,663,664],{},"LASTNAME",". A field name in the wrong case is not an error: the query gets nothing back, no rows read and none written. See ",[648,667,669],{"href":668},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#case","Case",".",[672,673,634],"h3",{"id":674},"select",[265,676,677,678,681,682,685,686,689],{},"Returns the rows of the entity that match the ",[269,679,680],{},"WHERE"," clause, shaped the way the entity class shapes them: nested objects and lists come back whole, since the rows are read from the stored documents. ",[269,683,684],{},"SELECT *"," returns whole rows; ",[269,687,688],{},"SELECT firstName, address"," returns the listed top-level fields only, each whole.",[691,692,693,703,710],"ul",{},[285,694,695,698,699,702],{},[269,696,697],{},"ORDER BY"," orders the rows. A sort the caller gives on a ",[269,700,701],{},"Pageable"," follows it.",[285,704,705,706,709],{},"A method that returns an array gets every matching row up to ",[269,707,708],{},"LIMIT",", or 1000 rows when the statement names no limit.",[285,711,712,713,716,717,720,721,723,724,726,727,670],{},"A method with a ",[269,714,715],{},"pageable: Pageable"," parameter returns a ",[269,718,719],{},"Page",", and the ",[269,722,701],{}," sets the page size. Cursor paging orders by the statement's ",[269,725,697],{},", so give it one that orders the rows fully, such as ",[269,728,729],{},"ORDER BY lastName, id",[672,731,733],{"id":732},"insert-update-and-delete","INSERT, UPDATE and DELETE",[265,735,736,737,740,741,744],{},"A write returns one row, ",[269,738,739],{},"{ count }",", holding the number of rows it wrote. Add ",[269,742,743],{},"WITH REFRESH"," when the next read must see the write.",[691,746,747,763],{},[285,748,749,751,752,755,756,642,759,762],{},[269,750,638],{}," stores the row the way the repository's ",[269,753,754],{},"save"," would: the row states the entity's id field, and the platform stores it under the participant's tenant, so the row is found by id afterwards. ",[269,757,758],{},"ROUTING",[269,760,761],{},"DOCUMENT_ID"," are not accepted, since both are derived.",[285,764,765,642,767,769,770,772],{},[269,766,641],{},[269,768,645],{}," act on the rows that match the ",[269,771,680],{}," clause.",[672,774,776],{"id":775},"aggregates","Aggregates",[265,778,779,780,782,783,635,786,635,789,635,792,635,795,635,798,635,801,804,805,808,809,815,816,819,820,823,824,826,827,830,831,834,835,838,839,670],{},"A ",[269,781,634],{}," that calls a function (",[269,784,785],{},"COUNT(*)",[269,787,788],{},"SUM",[269,790,791],{},"AVG",[269,793,794],{},"MIN",[269,796,797],{},"MAX",[269,799,800],{},"PERCENTILE",[269,802,803],{},"HISTOGRAM",", …) or has a ",[269,806,807],{},"GROUP BY"," is an aggregate. It runs on Elasticsearch SQL, so it can call any of ",[648,810,814],{"href":811,"rel":812},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Freference\u002Fquery-languages\u002Fsql\u002Fsql-functions",[813],"nofollow","its functions",", and returns one row per group, shaped by the projection: ",[269,817,818],{},"AS"," names a column, and a column or group can be a sub-field (",[269,821,822],{},"address.city","). It is written in the same grammar as every other statement, with the same ",[269,825,680],{}," clause and ",[269,828,829],{},":name"," parameters, and names the query's own entity in ",[269,832,833],{},"FROM","; see ",[648,836,634],{"href":837},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#select",". A paged aggregate takes a cursor ",[269,840,701],{},[277,842,844],{"id":843},"multi-tenancy","Multi-tenancy",[265,846,847,848,850,851,853,854,856,857,859,860,862,863,865],{},"Every named query is confined to the participant's tenant, the way every repository method is: a ",[269,849,634],{}," or aggregate reads only the rows of that tenant, an ",[269,852,638],{}," stores its row under it, and an ",[269,855,641],{}," or ",[269,858,645],{}," touches only its rows, whatever the ",[269,861,680],{}," clause says. An ",[269,864,638],{}," may state the entity's tenant field with the participant's own tenant; any other value is refused.",[277,867,869],{"id":868},"admin-repository-queries","Admin Repository Queries",[265,871,872,873,877,878,881],{},"A named query on an ",[648,874,876],{"href":875},"\u002Fapps\u002Fpersistence\u002Fmulti-tenancy#admin-repository","admin repository"," runs against the tenants the caller selects, so it declares a ",[269,879,880],{},"TenantSelection"," parameter like every other admin repository method. The generated implementation sends it as the query's tenant selection rather than as a query parameter. A read runs against every tenant the selection names; a write acts on one tenant, so its selection names exactly one.",[323,883,885],{"className":325,"code":884,"language":327,"meta":328,"style":328},"import { Query, type TenantSelection } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderAdminRepository extends BaseOrderAdminRepository {\n\n    @Query('SE