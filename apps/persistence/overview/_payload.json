61],"ul",{},[231,232,233,237],"li",{},[234,235,236],"strong",{},"Automatic CRUD generation"," - Define an entity class and get a complete service with create, read, update, delete, search, and count operations",[231,239,240,243,244,248],{},[234,241,242],{},"Full-text search"," - Mark fields with ",[245,246,247],"code",{},"@Text"," to enable full-text search out of the box",[231,250,251,254],{},[234,252,253],{},"Schema evolution"," - Use versioned migration scripts to evolve your data schema safely over time",[231,256,257,260],{},[234,258,259],{},"Multi-tenancy"," - Built-in tenant isolation at the data layer with shared index support",[231,262,263,266],{},[234,264,265],{},"Named queries"," - Define custom query methods with a SQL-like syntax",[223,268,270],{"id":269},"workflow","Workflow",[219,272,273],{},"The typical workflow for working with Kinotic persistence is:",[275,276,277,286,296],"ol",{},[231,278,279,282,283],{},[234,280,281],{},"Define your entity"," - Create a TypeScript class with decorators from ",[245,284,285],{},"@kinotic-ai\u002Fpersistence",[231,287,288,291,292,295],{},[234,289,290],{},"Sync to server"," - Run ",[245,293,294],{},"kinotic sync"," to push your entity definitions to the Kinotic server and generate typed service classes",[231,297,298,301],{},[234,299,300],{},"Use in your app"," - Import and use the generated services to perform data operations",[223,303,305],{"id":304},"packages","Packages",[219,307,308],{},"Two packages work together to provide the persistence layer:",[228,310,311,331],{},[231,312,313,317,318,321,322,321,325,321,328,330],{},[234,314,315],{},[245,316,285],{}," - Provides entity decorators (",[245,319,320],{},"@Entity",", ",[245,323,324],{},"@AutoGeneratedId",[245,326,327],{},"@NotNull",[245,329,247],{},", etc.), entity service interfaces, and the persistence plugin",[231,332,333,338,339,342],{},[234,334,335],{},[245,336,337],{},"@kinotic-ai\u002Fcore"," - Provides the connection layer (",[245,340,341],{},"Kinotic.connect()","), pagination types, and core utilities shared across all Kinotic packages",{"title":344,"searchDepth":345,"depth":345,"links":346},"",2,[347,348,349],{"id":225,"depth":345,"text":226},{"id":269,"depth":345,"text":270},{"id":304,"depth":345,"text":305},"Kinotic's persistence layer provides declarative data management with automatic CRUD service generation from TypeScript entity definitions.","md",null,{},true,{"title":25,"description":350},"sgwciN4UxMGGqqWq9TLwhEfjY-sUhA5nQbcCAXm8m_s",[358,360],{"title":55,"path":56,"stem":57,"description":359,"children":-1},"Real-time data streaming between services and clients.",{"title":68,"path":69,"stem":70,"description":361,"children":-1},"How to define entities using TypeScript decorators for Kinotic's persistence layer.",1788492744832]