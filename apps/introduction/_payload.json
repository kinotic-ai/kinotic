.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":128,"icon":129,"path":196,"stem":197,"children":198,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[199,204],{"title":200,"path":201,"stem":202,"icon":203},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"title":205,"path":206,"stem":207,"icon":208},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F11.reference\u002F02.grind-jobs","i-lucide-workflow",{"id":210,"title":11,"body":211,"description":415,"extension":416,"links":417,"meta":418,"navigation":419,"path":12,"seo":420,"stem":13,"__hash__":421},"docs\u002F01.apps\u002F01.introduction.md",{"type":212,"value":213,"toc":407},"minimark",[214,218,223,226,230,257,261,342,348,354,360,364,367,400],[215,216,217],"p",{},"Kinotic is a next-generation cloud operating system that abstracts away infrastructure complexity so developers and AI agents can focus on what matters: building great applications.",[219,220,222],"h2",{"id":221},"humane-representation-of-thought","Humane Representation of Thought",[215,224,225],{},"The rise of AI-assisted development has unlocked a new paradigm -- rapid iteration driven by natural-language intent and intelligent code generation. Kinotic is purpose-built for this paradigm. Whether a human developer or an AI agent is writing the code, Kinotic provides the guardrails, services, and runtime that turn quick prototypes into production-grade systems.",[219,227,229],{"id":228},"core-components","Core Components",[231,232,233,240,245,251],"ul",{},[234,235,236,239],"li",{},[237,238,5],"strong",{}," -- Applications that run on Kinotic OS. Today, Kinotic Apps are built with TypeScript running on Bun -- you write standard TypeScript for domain models, business logic, and UI, and the platform handles infrastructure, deployment, and scaling. Support for Go, Java, and Python backends is coming soon.",[234,241,242,244],{},[237,243,143],{}," -- The cloud operating system that runs your apps. It provides authentication, authorization, persistence, service mesh, observability, and deployment infrastructure out of the box.",[234,246,247,250],{},[237,248,249],{},"Kinotic OS Cloud"," -- A fully managed SaaS offering of Kinotic OS. No servers to provision, no infrastructure to maintain.",[234,252,253,256],{},[237,254,255],{},"Kinotic CLI"," -- The developer tool that ties it all together. Use it to initialize projects, define entities, generate service code, and deploy applications.",[219,258,260],{"id":259},"why-kinotic","Why Kinotic?",[262,263,264,280],"table",{},[265,266,267],"thead",{},[268,269,270,274,277],"tr",{},[271,272,273],"th",{},"Concern",[271,275,276],{},"Without Kinotic",[271,278,279],{},"With Kinotic",[281,282,283,295,310,321,332],"tbody",{},[268,284,285,289,292],{},[286,287,288],"td",{},"Authentication & Authorization",[286,290,291],{},"Wire up OIDC and session management yourself",[286,293,294],{},"Built in -- configure once, enforce everywhere",[268,296,297,299,302],{},[286,298,59],{},[286,300,301],{},"Choose a database, write migrations, build CRUD endpoints",[286,303,304,305,309],{},"Define entities, run ",[306,307,308],"code",{},"kinotic sync",", get a full service layer",[268,311,312,315,318],{},[286,313,314],{},"Service Mesh",[286,316,317],{},"Deploy sidecars, configure routing, handle retries",[286,319,320],{},"Automatic service discovery and RPC across the application",[268,322,323,326,329],{},[286,324,325],{},"CI\u002FCD",[286,327,328],{},"Maintain pipelines, container registries, rollout strategies",[286,330,331],{},"Handled by the platform",[268,333,334,336,339],{},[286,335,181],{},[286,337,338],{},"Instrument code, deploy collectors, build dashboards",[286,340,341],{},"SBOM generation, metrics, and tracing are included",[215,343,344,347],{},[237,345,346],{},"Rapid prototyping."," Go from an idea to a running application in minutes with the CLI and generated services.",[215,349,350,353],{},[237,351,352],{},"Enterprise-ready."," Software bill of materials and full observability mean you never have to rewrite for production.",[215,355,356,359],{},[237,357,358],{},"Internet scale."," The platform is designed to scale horizontally from day one.",[219,361,363],{"id":362},"what-these-docs-cover","What These Docs Cover",[215,365,366],{},"This documentation walks through everything you need to build and ship a Kinotic App:",[368,369,370,375,380,385,390,395],"ol",{},[234,371,372,374],{},[237,373,15],{}," -- Scaffold a project and persist your first entity in under five minutes.",[234,376,377,379],{},[237,378,19],{}," -- Understand how organizations, applications, projects, and artifacts fit together.",[234,381,382,384],{},[237,383,38],{}," -- Publish and consume services across your application.",[234,386,387,389],{},[237,388,59],{}," -- Define entities, configure indexes, and run queries.",[234,391,392,394],{},[237,393,92],{}," -- Set up authentication and authorization.",[234,396,397,399],{},[237,398,103],{}," -- Ship your application to Kinotic OS or Kinotic OS Cloud.",[215,401,402,403,406],{},"Ready to build something? Head to the ",[404,405,15],"a",{"href":16}," to create your first Kinotic App.",{"title":408,"searchDepth":409,"depth":409,"links":410},"",2,[411,412,413,414],{"id":221,"depth":409,"text":222},{"id":228,"depth":409,"text":229},{"id":259,"depth":409,"text":260},{"id":362,"depth":409,"text":363},"Learn what Kinotic is, why it exists, and how it helps developers and AI agents build enterprise-grade applications at scale.","md",null,{},true,{"title":11,"description":415},"kWAFExdJBuvap6cvr7VlVEwd-U_8NHeOdkZ707K3NTM",[417,423],{"title":15,"path":16,"stem":17,"description":424,"children":-1},"Get started building your first Kinotic App -- from a provisioned project to a running CRUD service in under five minutes.",1788337938185]