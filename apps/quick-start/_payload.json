0,243,244],{},"A Kinotic account"," with a linked GitHub organization",[219,247,249],{"id":248},"create-your-application","Create Your Application",[215,251,252],{},"Kinotic OS creates your Application and Project and provisions a GitHub repository for it, already scaffolded as a Bun workspace with the Kinotic CLI vendored as a dev dependency -- there is nothing to install globally.",[215,254,255],{},"The fastest way is the official Claude Code plugin, which drives the whole flow conversationally:",[257,258,263],"pre",{"className":259,"code":261,"language":262},[260],"language-text","\u002Fplugin marketplace add kinotic-ai\u002Fclaude-plugin\n\u002Fplugin install kinotic@kinotic\n\u002Fkinotic:new-app my-app\n","text",[264,265,261],"code",{"__ignoreMap":266},"",[215,268,269],{},"You can also create the Application and Project from the Kinotic OS dashboard; either way you end up with a provisioned repository.",[219,271,273],{"id":272},"clone-and-install","Clone and Install",[257,275,279],{"className":276,"code":277,"language":278,"meta":266,"style":266},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","git clone \u003Cyour-provisioned-repo> && cd \u003Cyour-repo>\nbun install\n","bash",[264,280,281,325],{"__ignoreMap":266},[282,283,286,290,294,298,301,305,308,311,315,317,320,322],"span",{"class":284,"line":285},"line",1,[282,287,289],{"class":288},"sBMFI","git",[282,291,293],{"class":292},"sfazB"," clone",[282,295,297],{"class":296},"sMK4o"," \u003C",[282,299,300],{"class":292},"your-provisioned-rep",[282,302,304],{"class":303},"sTEyZ","o",[282,306,307],{"class":296},">",[282,309,310],{"class":296}," &&",[282,312,314],{"class":313},"s2Zo4"," cd",[282,316,297],{"class":296},[282,318,319],{"class":292},"your-rep",[282,321,304],{"class":303},[282,323,324],{"class":296},">\n",[282,326,328,331],{"class":284,"line":327},2,[282,329,330],{"class":288},"bun",[282,332,333],{"class":292}," install\n",[215,335,336,337,340,341,344,