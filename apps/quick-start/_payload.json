230,244],"ul",{},[231,232,233,237,238],"li",{},[234,235,236],"strong",{},"Bun"," -- Install from ",[239,240,241],"a",{"href":241,"rel":242},"https:\u002F\u002Fbun.sh",[243],"nofollow",[231,245,246,249],{},[234,247,248],{},"A Kinotic account"," with a linked GitHub organization",[223,251,253],{"id":252},"create-your-application","Create Your Application",[219,255,256],{},"Kinotic OS creates your Application and Project and provisions a GitHub repository for it, already scaffolded as a Bun workspace with the Kinotic CLI vendored as a dev dependency -- there is nothing to install globally.",[219,258,259],{},"The fastest way is the official Claude Code plugin, which drives the whole flow conversationally:",[261,262,267],"pre",{"className":263,"code":265,"language":266},[264],"language-text","\u002Fplugin marketplace add kinotic-ai\u002Fclaude-plugin\n\u002Fplugin install kinotic@kinotic\n\u002Fkinotic:new-app my-app\n","text",[268,269,265],"code",{"__ignoreMap":270},"",[219,272,273],{},"You can also create the Application and Project from the Kinotic OS dashboard; either way you end up with a provisioned repository.",[223,275,277],{"id":276},"clone-and-install","Clone and Install",[261,279,283],{"className":280,"code":281,"language":282,"meta":270,"style":270},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","git clone \u003Cyour-provisioned-repo> && cd \u003Cyour-repo>\nbun install\n","bash",[268,284,285,329],{"__ignoreMap":270},[286,287,290,294,298,302,305,309,312,315,319,321,324,326],"span",{"class":288,"line":289},"line",1,[286,291,293],{"class":292},"sBMFI","git",[286,295,297],{"class":296},"sfazB"," clone",[286,299,301],{"class":300},"sMK4o"," \u003C",[286,303,304],{"class":296},"your-provisioned-rep",[286,306,308],{"class":307},"sTEyZ","o",[286,310,311],{"class":300},">",[286,313,314],{"class":300}," &&",[286,316,318],{"class":317},"s2Zo4"," cd",[286,320,301],{"class":300},[286,322,323],{"class":296},"your-rep",[28