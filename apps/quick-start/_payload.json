67,270,281,284,288,348,363,367,374,604,607,633,637,661,672,714,718,760,763,767,778,1191,1194,1208,1211,1215,1218,1235],[229,230,231],"p",{},"This guide walks you through creating a Kinotic App, defining an entity, generating its repository, and using the repository to read and write data.",[233,234,236],"h2",{"id":235},"prerequisites","Prerequisites",[238,239,240,254],"ul",{},[241,242,243,247,248],"li",{},[244,245,246],"strong",{},"Bun"," -- Install from ",[249,250,251],"a",{"href":251,"rel":252},"https:\u002F\u002Fbun.sh",[253],"nofollow",[241,255,256,259],{},[244,257,258],{},"A Kinotic account"," with a linked GitHub organization",[233,261,263],{"id":262},"create-your-application","Create Your Application",[229,265,266],{},"Kinotic OS creates your Application and Project and provisions a GitHub repository for it, already scaffolded as a Bun workspace with the Kinotic CLI vendored as a dev dependency -- there is nothing to install globally.",[229,268,269],{},"The fastest way is the official Claude Code plugin, which drives the whole flow conversationally:",[271,272,277],"pre",{"className":273,"code":275,"language":276},[274],"language-text","\u002Fplugin marketplace add kinotic-ai\u002Fclaude-plugin\n\u002Fplugin install kinotic@kinotic\n\u002Fkinotic:new-app my-app\n","text",[278,279,275],"code",{"__ignoreMap":280},"",[229,282,283],{},"You can also create the Application and Project from the Kinotic OS dashboard; either way you end up with a provisioned repository.",[233,285,287],{"id":286},"clone-and-install","Clone and Install",[271,289,293],{"className":290,"code":291,"language":292,"meta":280,"style":280},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","git clone \u003Cyour-provisioned-repo> && cd \u003Cyour-repo>\nbun install\n","bash",[278,294,295,339],{"__ignoreMap":280},[296,297,300,304,308,312,315,319,322,325,329,331,334,336],"span",{"class":298,"line":299},"line",1,[296,301,303],{"class":302},"sBMFI","git",[296,305,307],{"class":306},"sfazB"," clone",[296,309,311],{"class":310},"sMK4o"," \u003C",[296,313,314],{"class":306},"your-provisioned-rep",[296,316,318],{"class":317},"sTEyZ","o",[296,320,321],{"class":310},">",[296,323,324],{"class":310}," &&",[296,326,328],{"class":327},"s2Zo4"," cd",[296,330,311],{"class":310},[296,332,333],{"class":306},"your-rep",[296,335,318],{"class":317},[296,337,338],{"class":310},">\n",[296,340,342,345],{"class":298,"line":341},2,[296,343,344],{"class":302},"bun",[296,346,347],{"class":306}," install\n",[229,349,350,351,354,355,358,359,362],{},"The repository comes with a ",[278,352,353],{},".config\u002Fkinotic.config.ts"," already wired to your organization, application, and project, pointing entity discovery at ",[278,356,357],{},"packages\u002Fdomain\u002Fmodel"," and repository generation at ",[278,360,361],{},"packages\u002Fdomain\u002Frepositories",".",[233,364,366],{"id":365},"define-an-entity","Define an Entity",[229,368,369,370,373],{},"Create a file at ",[278,371,372],{},"packages\u002Fdomain\u002Fmodel\u002FPerson.ts",":",[271,375,379],{"className":376,"code":377,"language":378,"meta":280,"style":280},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, NotNull, Precision, PrecisionType, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.NONE)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @NotNull\n    firstName: string = ''\n\n    @NotNull\n    lastName: string = ''\n\n    @Precision(PrecisionType.SHORT)\n    age: number = 0\n}\n","typescript",[278,380,381,434,440,457,473,482,506,511,519,534,539,546,560,565,581,598],{"__ignoreMap":280},[296,382,383,387,390,393,396,399,401,404,406,409,411,414,416,419,422,425,428,431],{"class":298,"line":299},[296,384,386],{"class":385},"s7zQu","import",[296,388,389],{"class":310}," {",[296,391,392],{"class":317}," Entity",[296,394,395],{"