,"line":552},13,[286,554,429],{"emptyLinePlaceholder":428},[286,556,558,560,563,566,568],{"class":288,"line":557},14,[286,559,468],{"class":300},[286,561,562],{"class":317},"Precision",[286,564,565],{"class":307},"(PrecisionType",[286,567,352],{"class":300},[286,569,570],{"class":307},"SHORT)\n",[286,572,574,577,579,582,584],{"class":288,"line":573},15,[286,575,576],{"class":477},"    age",[286,578,363],{"class":300},[286,580,581],{"class":292}," number",[286,583,492],{"class":300},[286,585,587],{"class":586},"sbssI"," 0\n",[286,589,591],{"class":288,"line":590},16,[286,592,593],{"class":300},"}\n",[219,595,596],{},"A few things to note:",[228,598,599,605,611,617],{},[231,600,601,604],{},[268,602,603],{},"@Entity(MultiTenancyType.NONE)"," marks the class as a persisted entity with no multi-tenancy.",[231,606,607,610],{},[268,608,609],{},"@AutoGeneratedId"," tells the platform to generate an ID when one is not provided.",[231,612,613,616],{},[268,614,615],{},"@NotNull"," enforces that a field must have a value.",[231,618,619,622],{},[268,620,621],{},"@Precision(PrecisionType.SHORT)"," tells the platform this number is a short integer, which influences how it is stored and indexed.",[223,624,626],{"id":625},"generate-the-repository","Generate the Repository",[261,628,630],{"className":280,"code":629,"language":282,"meta":270,"style":270},"bun run generate\nbun run type-check\n",[268,631,632,642],{"__ignoreMap":270},[286,633,634,636,639],{"class":288,"line":289},[286,635,334],{"class":292},[286,637,638],{"class":296}," run",[286,640,641],{"class":296}," generate\n",[286,643,644,646,648],{"class":288,"line":331},[286,645,334],{"class":292},[286,647,638],{"class":296},[286,649,650],{"class":296}," type-check\n",[219,652,653,654,657,658,661],{},"This writes ",[268,655,656],{},"packages\u002Fdomain\u002Frepositories\u002FPersonRepository.ts"," (yours to extend) along with a generated base class, and saves the entity's schema under ",[268,659,660],{},".config\u002Fc3\u002F"