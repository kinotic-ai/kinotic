line":577},16,[273,579,580],{"class":287},"}\n",[206,582,583],{},"A few things to note:",[215,585,586,592,598,604],{},[218,587,588,591],{},[255,589,590],{},"@Entity(MultiTenancyType.NONE)"," marks the class as a persisted entity with no multi-tenancy.",[218,593,594,597],{},[255,595,596],{},"@AutoGeneratedId"," tells the platform to generate an ID when one is not provided.",[218,599,600,603],{},[255,601,602],{},"@NotNull"," enforces that a field must have a value.",[218,605,606,609],{},[255,607,608],{},"@Precision(PrecisionType.SHORT)"," tells the platform this number is a short integer, which influences how it is stored and indexed.",[210,611,613],{"id":612},"generate-the-repository","Generate the Repository",[248,615,617],{"className":267,"code":616,"language":269,"meta":257,"style":257},"bun run generate\nbun run type-check\n",[255,618,619,629],{"__ignoreMap":257},[273,620,621,623,626],{"class":275,"line":276},[273,622,321],{"class":279},[273,624,625],{"class":283}," run",[273,627,628],{"class":283}," generate\n",[273,630,631,633,635],{"class":275,"line":318},[273,632,321],{"class":279},[273,634,625],{"class":283},[273,636,637],{"class":283}," type-check\n",[206,639,640,641,644,645,648],{},"This writes ",[255,642,643],{},"packages\u002Fdomain\u002Frepositories\u002FPersonRepository.ts"," (yours to extend) along with a generated base class, and saves the entity's schema under ",[255,646,647],{},".config\u002Fc3\u002F",". Export both from the domain package's entry so other packages can import them:",[248,650,652],{"className":353,"code":651,"language":355,"meta":257,"style":257},"\u002F\u002F packages\u002Fdomain\u002Findex.ts\nexport * from '.\u002Fmodel\u002FPerson.js'\nexport * from '.\u002Frepositories\u002FPersonRepository.js'\n",[255,653,654,660,676],{"__ignoreMap":257},[273,655,656],{"class":275,"line":276},[273,657,659],{"class":658},"sHwdD","\u002F\u002F packages\u002Fdomain\u002Findex.ts\n",[273,661,662,664,667,669,671,674],{"class":275,"line":318},[273,6