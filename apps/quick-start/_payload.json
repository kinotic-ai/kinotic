1,648,649,651,654],{"class":303,"line":304},[301,650,349],{"class":307},[301,652,653],{"class":311}," run",[301,655,656],{"class":311}," generate\n",[301,658,659,661,663],{"class":303,"line":346},[301,660,349],{"class":307},[301,662,653],{"class":311},[301,664,665],{"class":311}," type-check\n",[234,667,668,669,672,673,676],{},"This writes ",[283,670,671],{},"packages\u002Fdomain\u002Frepositories\u002FPersonRepository.ts"," (yours to extend) along with a generated base class, and saves the entity's schema under ",[283,674,675],{},".config\u002Fc3\u002F",". Export both from the domain package's entry so other packages can import them:",[276,678,680],{"className":381,"code":679,"language":383,"meta":285,"style":285},"\u002F\u002F packages\u002Fdomain\u002Findex.ts\nexport * from '.\u002Fmodel\u002FPerson.js'\nexport * from '.\u002Frepositories\u002FPersonRepository.js'\n",[283,681,682,688,704],{"__ignoreMap":285},[301,683,684],{"class":303,"line":304},[301,685,687],{"class":686},"sHwdD","\u002F\u002F packages\u002Fdomain\u002Findex.ts\n",[301,689,690,692,695,697,699,702],{"class":303,"line":346},[301,691,467],{"class":390},[301,693,694],{"class":315}," *",[301,696,429],{"class":390},[301,698,432],{"class":315},[301,700,701],{"class":311},".\u002Fmodel\u002FPerson.js",[301,703,438],{"class":315},[301,705,706,708,710,712,714,717],{"class":303,"line":447},[301,707,467],{"class":390},[301,709,694],{"class":315},[301,711,429],{"class":390},[301,713,432],{"class":315},[301,715,716],{"class":311},".\u002Frepositories\u002FPersonRepository.js",[301,718,438],{"class":315},[238,720,722],{"id":721},"push-to-sync","Push to Sync",[276,724,726],{"className":295,"code":725,"language":297,"meta":285,"style":285},"git add . && git commit -m \"Add Person entity\" && git push\n",[283,727,728],{"__ignoreMap":285},[301,729,730,732,735,738,740,743,746,749,752,755,758,760,762],{"class":303,"line":304},[301,731,308],{"class":307},[301,733,734],{"class":311}," add",[301,736,737],{"class":311}," .",[301,739,329],{"class":315},[301,741,742],{"class":307}," git",[301,744,745],{"class":311}," commit",[301,747,748],{"class":311}," -m",[301,750,751],{"class":315}," \"",[301,753,754],{"class":311},"Add Person entity",[301,756,757],{"class":315},"\"",[301,759,329],{"class":315},[301,761,742],{"class":307},[301,763,764],{"class":311}," push\n",[234,766,767],{},"Kinotic OS reads entity definitions from the connected GitHub repository and synchronizes them for you -- publishing the entity creates the backing storage and registers its services. There is nothing to log in to or push from your machine besides git.",[238,769,771],{"id":770},"use-the-generated-repository","Use the Generated Repository",[234,773,774,775,778,779,782],{},"The provisioned repository ships a starter microservice at ",[283,776,777],{},"packages\u002Fmicroservices\u002Fmain"," that already sets the zone and connects. Extend its ",[283,780,781],{},"src\u002Fmain.ts"," to try the repository out:",[276,784,786],{"className":381,"code":785,"language":383,"meta":285,"style":285},"import { Kinotic, Pageable } from '@kinotic-ai\u002Fcore'\nimport { PersistencePlugin } from '@kinotic-ai\u002Fpersistence'\nimport { PersonRepository } from '@my-app\u002Fdomain'\nimport { appZone } from '@kinotic-ai\u002Fmanagement-api'\nimport config from '..\u002F..\u002F..\u002F..\u002F.config\u002Fkinotic.config'\n\nKinotic.use(PersistencePlugin)\nKinotic.zonePrefix = appZone(config.organizationId, config.applicationId)\n\n\u002F\u002F server and credentials resolve from the environment: KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL,\n\u002F\u002F KINOTIC_CLIENT_ID\u002FKINOTIC_CLIENT_SECRET — https:\u002F\u002Fapi.kinotic.ai when nothing is set\nawait Kinotic.connect()\n\nconst personRepository = new PersonRepository()\n\n\u002F\u002F Create a person\nconst person = await personRepository.save({\n    id: null,\n    firstName: 'Jane',\n    lastName: 'Doe',\n    age: 28\n})\n\nconsole.log('Saved:', person)\n\n\u002F\u0