meta":1257,"navigation":443,"path":16,"seo":1258,"stem":17,"__hash__":1259},"docs\u002F01.apps\u002F02.quick-start.md",{"type":231,"value":232,"toc":1244},"minimark",[233,237,242,265,269,272,275,286,289,293,353,368,372,379,609,612,638,642,666,677,719,723,765,768,772,783,1196,1199,1213,1216,1220,1223,1240],[234,235,236],"p",{},"This guide walks you through creating a Kinotic App, defining an entity, generating its repository, and using the repository to read and write data.",[238,239,241],"h2",{"id":240},"prerequisites","Prerequisites",[243,244,245,259],"ul",{},[246,247,248,252,253],"li",{},[249,250,251],"strong",{},"Bun"," -- Install from ",[254,255,256],"a",{"href":256,"rel":257},"https:\u002F\u002Fbun.sh",[258],"nofollow",[246,260,261,264],{},[249,262,263],{},"A Kinotic account"," with a linked GitHub organization",[238,266,268],{"id":267},"create-your-application","Create Your Application",[234,270,271],{},"Kinotic OS creates your Application and Project and provisions a GitHub repository for it, already scaffolded as a Bun workspace with the Kinotic CLI vendored as a dev dependency -- there is nothing to install globally.",[234,273,274],{},"The fastest way is the official Claude Code plugin, which drives the whole flow conversationally:",[276,277,282],"pre",{"className":278,"code":280,"language":281},[279],"language-text","\u002Fplugin marketplace add kinotic-ai\u002Fclaude-plugin\n\u002Fplugin install kinotic@kinotic\n\u002Fkinotic:new-app my-app\n","text",[283,284,280],"code",{"__ignoreMap":285},"",[234,287,288],{},"You can also create the Application and Project from the Kinotic OS dashboard; either way you end up with a provisioned repository.",[238,290,292],{"id":291},"clone-and-install","Clone and Install",[276,294,298],{"className":295,"code":296,"language":297,"meta":285,"style":285},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","git clone \u003Cyour-provisioned-repo> && cd \u003Cyour-repo>\nbun install\n","bash",[283,299,300,344],{"__ignoreMap":285},[301,302,305,309,313,317,320,324,327,330,334,336,339,341],"span",{"class":303,"line":304},"line",1,[301,306,308],{"class":307},"sBMFI","git",[301,310,312],{"class":311},"sfazB"," clone",[301,314,316],{"class":315},"sMK4o"," \u003C",[301,318,319],{"class":311},"your-provisioned-rep",[301,321,323],{"class":322},"sTEyZ","o",[301,325,326],{"class":315},">",[301,328,329],{"class":315}," &&",[301,331,333],{"class":332},"s2Zo4"," cd",[301,335,316],{"class":315},[301,337,338],{"class":311},"your-rep",[301,340,323],{"class":322},[301,342,343],{"class":315},">\n",[301,345,347,350],{"class":303,"line":346},2,[301,348,349],{"class":307},"bun",[301,351,352],{"class":311}," install\n",[234,354,355,356,359,360,363,364,367],{},"The repository comes with a ",[283,357,358],{},".config\u002Fkinotic.config.ts"," already wired to your organization, application, and project, pointing entity discovery at ",[283,361,362],{},"packages\u002Fdomain\u002Fmodel"," and repository generation at ",[283,365,366],{},"packages\u002Fdomain\u002Frepositories",".",[238,369,371],{"id":370},"define-an-entity","Define an Entity",[234,373,374,375,378],{},"Create a file at ",[283,376,377],{},"packages\u002Fdomain\u002Fmodel\u002FPerson.ts",":",[276,380,384],{"className":381,"code":382,"language":383,"meta":285,"style":285},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, NotNull, Precision, PrecisionType, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.NONE)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @NotNull\n    firstName: string = ''\n\n    @NotNull\n    lastName: string = ''\n\n    @Precision(PrecisionType.SHORT)\n    age: number = 0\n}\n","typescript",[283,385,386,439,445,462,478,487,511,516,524,539,544,551,565,570,586,603],{"__ignoreMap":285},[301,387,388,392,395,398,401,404,406,409,411,414,41