con":234},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","04.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":236,"path":237,"stem":238,"icon":239},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","04.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":241,"path":242,"stem":243,"icon":178},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","04.platform\u002F12.reference\u002F03.project-publishing-design",{"title":245,"path":246,"stem":247,"icon":33},"Sign-In Design","\u002Fplatform\u002Freference\u002Fsign-in-design","04.platform\u002F12.reference\u002F04.sign-in-design",{"title":249,"path":250,"stem":251,"icon":252},"Development Server","\u002Fplatform\u002Fdevelopment-server","04.platform\u002F13.development-server","i-lucide-server-cog",{"title":254,"path":255,"stem":256,"icon":257},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","04.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":259,"path":260,"stem":261,"icon":262},"Enterprise License","\u002Fplatform\u002Fenterprise-license","04.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":264,"title":150,"body":265,"description":894,"extension":895,"links":896,"meta":897,"navigation":898,"path":151,"seo":899,"stem":152,"__hash__":900},"docs\u002F03.apps\u002F08.cli-reference.md",{"type":266,"value":267,"toc":883},"minimark",[268,273,282,310,328,332,347,354,359,385,391,435,438,444,467,527,559,603,605,614,624,635,654,685,689,721,723,731,764,796,800,866,868,879],[269,270,272],"h2",{"id":271},"installation","Installation",[274,275,276,277,281],"p",{},"Provisioned project repositories vendor the CLI as a dev dependency, so inside a\nproject the CLI is already available -- ",[278,279,280],"code",{},"bun run generate"," runs it with no global\ninstall. To use the CLI outside a project:",[283,284,289],"pre",{"className":285,"code":286,"language":287,"meta":288,"style":288},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","bun install -g @kinotic-ai\u002Fkinotic-cli@beta\n","bash","",[278,290,291],{"__ignoreMap":288},[292,293,296,300,304,307],"span",{"class":294,"line":295},"line",1,[292,297,299],{"class":298},"sBMFI","bun",[292,301,303],{"class":302},"sfazB"," install",[292,305,306],{"class":302}," -g",[292,308,309],{"class":302}," @kinotic-ai\u002Fkinotic-cli@beta\n",[274,311,312,313,316,317,320,321,323,324,327],{},"Bun installs the ",[278,314,315],{},"kinotic"," command into its global bin folder, which ",[278,318,319],{},"bun pm bin -g"," prints. If your shell\ncan't find ",[278,322,315],{},", add that folder to your ",[278,325,326],{},"PATH",".",[269,329,331],{"id":330},"commands","Commands",[274,333,334,335,338,339,342,343,346],{},"Project commands (",[278,336,337],{},"kinotic generate",", ",[278,340,341],{},"kinotic sync",") locate the project by searching upward from the current directory for a ",[278,344,345],{},".config\u002Fkinotic.config.*"," file, so they can be run from any directory inside the project.",[348,349,351],"h3",{"id":350},"kinotic-login",[278,352,353],{},"kinotic login",[274,355,356,357,327],{},"Log in to a Kinotic server and store credentials for subsequent commands. Runs the OAuth device-authorization flow: the CLI opens a browser once for you to approve, then stores a refresh token so later commands are non-interactive. The server you log in to becomes the default server for commands like ",[278,358,341],{},[283,360,362],{"className":285,"code":361,"language":287,"meta":288,"style":288},"kinotic login --server http:\u002F\u002Flocalhost:58503\nkinotic login\n",[278,363,364,377],{"__ignoreMap":288},[292,365,366,368,371,374],{"class":294,"line":295},[292,367,315],{"class":298},[292,369,370],{"class":302}," login",[292,372,373],{"class":302}," --server",[292,375,376],{"class":302}," http:\u002F\u002Flocalhost:58503\n",[292,378,380,382],{"class":294,"line":379},2,[292,381,315],{"class":298},[292,383,384],{"class":302}," login\n",[274,386,387],{},[388,389,390],"strong",{},"Flags:",[392,393,394,407],"table",{},[395,396,397],"thead",{},[398,399,400,404],"tr",{},[401,402,403],"th",{},"Flag",[401,405,406],{},"Description",[408,409,410],"tbody",{},[398,411,412,418],{},[413,414,415],"td",{},[278,416,417],{},"-s, --server",[413,419,420,421,424,425,338,428,431,432],{},"The Kinotic server URL to log in to. When omitted, the stored default server is used. A plain ",[278,422,423],{},"http:\u002F\u002F"," URL is accepted only for a loopback host (",[278,426,427],{},"localhost",[278,429,430],{},"127.0.0.1","); a remote server is reached over ",[278,433,434],{},"https:\u002F\u002F",[436,437],"hr",{},[348,439,441],{"id":440},"kinotic-local",[278,442,443],{},"kinotic local",[274,445,446,447,450,451,454,455,458,459,462,463,466],{},"Run Kinotic on this machine: its servers, the portal and system console, the Git server that holds your projects'\nrepositories, and the node your projects deploy to. The stack runs in Docker from the compose files bundled with\nthe CLI, at the Kinotic version that CLI release names; the node is the ",[278,448,449],{},"@kinotic-ai\u002Fvm-manager"," release it names,\nwhich Bun downloads on first start and runs in the background. The stack's files, the node's process id and its\nlog live under ",[278,452,453],{},"local"," in the CLI's data directory (",[278,456,457],{},"~\u002F.local\u002Fshare\u002Fkinotic\u002Flocal","). The\n",[460,461,15],"a",{"href":16}," installs the CLI and runs ",[278,464,465],{},"kinotic local up"," in one line.",[283,468,470],{"className":285,"code":469,"language":287,"meta":288,"style":288},"kinotic local up            # start Kinotic and the node; the first start takes a few minutes\nkinotic local status        # each container's state, and whether the node runs\nkinotic local logs node     # the node's log; name a container instead, or none for every container's\nkinotic local down          # stop Kinotic and the apps it deployed, keeping its data\n",[278,471,472,486,498,514],{"__ignoreMap":288},[292,473,474,476,479,482],{"class":294,"line":295},[292,475,315],{"class":298},[292,477,478],{"class":302}," local",[292,480,481],{"class":302}," up",[292,483,485],{"class":484},"sHwdD","            # start Kinotic and the node; the first start takes a few minutes\n",[292,487,488,490,492,495],{"class":294,"line":379},[292,489,315],{"class":298},[292,491,478],{"class":302},[292,493,494],{"class":302}," status",[292,496,497],{"class":484},"        # each container's state, and whether the node runs\n",[292,499,501,503,505,508,511],{"class":294,"line":500},3,[292,502,315],{"class":298},[292,504,478],{"class":302},[292,506,507],{"class":302}," logs",[292,509,510],{"class":302}," node",[292,512,513],{"class":484},"     # the node's log; name a container instead, or none for every container's\n",[292,515,517,519,521,524],{"class":294,"line":516},4,[292,518,315],{"class":298},[292,520,478],{"class":302},[292,522,523],{"class":302}," down",[292,525,526],{"class":484},"          # stop Kinotic and the apps it deployed, keeping its data\n",[274,528,529,531,532,535,536,539,540,542,543,546,547,550,551,554,555,558],{},[278,530,465],{}," needs Docker running with Compose v2, and Bun to run the node. Each start downloads the newest\nimages of that version, and stops with an error when it cannot, rather than start a copy left from an earlier version.\nA Docker Hub login that Docker Hub rejects is the usual cause: ",[278,533,534],{},"docker logout",", or ",[278,537,538],{},"docker login"," again, fixes it. When\na container starts and then stops with an error, ",[278,541,465],{}," names it and prints the end of its log. The\nnode runs on macOS on Apple silicon, or Linux with KVM (",[278,544,545],{},"\u002Fdev\u002Fkvm",", which your user must be allowed to open, usually\nthrough the ",[278,548,549],{},"kvm"," group);\nelsewhere Kinotic starts without one, and projects do not deploy. Once the servers answer, create your organization at\n",[278,552,553],{},"http:\u002F\u002Flocalhost:9090\u002Fsignup",". ",[278,556,557],{},"kinotic local down"," stops the node first, which stops and removes every app it\ndeployed on this machine, then the stack.",[392,560,561,572],{},[395,562,563],{},[398,564,565,568,570],{},[401,566,567],{},"Command",[401,569,403],{},[401,571,406],{},[408,573,574,588],{},[398,575,576,580,585],{},[413,577,578],{},[278,579,557],{},[413,581,582],{},[278,583,584],{},"--delete-data",[413,586,587],{},"Also delete everything Kinotic stored: its organizations, projects, data and deployed apps' files",[398,589,590,595,600],{},[413,591,592],{},[278,593,594],{},"kinotic local logs [SERVICE]",[413,596,597],{},[278,598,599],{},"-f, --follow",[413,601,602],{},"Keep printing new lines until interrupted",[436,604],{},[348,606,608,610,611],{"id":607},"kinotic-generate-kinotic-gen",[278,609,337],{}," \u002F ",[278,612,613],{},"kinotic gen",[274,615,616,617,620,621,327],{},"Generate Repository classes from your entity definitions. This runs locally without connecting to the server, and fills in the implementations of ",[460,618,619],{"href":110},"named query"," methods declared with ",[278,622,623],{},"@Query",[274,625,626,627,630,631,634],{},"Each entity's C3Type schema is written as JSON to ",[278,628,629],{},".config\u002Fc3\u002Fentities\u002F\u003Cnamespace>.\u003Cname>.json",", and the named queries declared on a Repository to ",[278,632,633],{},".config\u002Fc3\u002Fqueries\u002F\u003CRepositoryName>.json",". Removing the last named query from a Repository removes its queries file.",[274,636,637,638,641,642,645,646,649,650,653],{},"Every class decorated with ",[278,639,640],{},"@Publish"," under the project's ",[278,643,644],{},"servicesPaths"," gets a service definition: its functions, with the parameters a request carries and their types. The definitions are written to ",[278,647,648],{},"ServiceDefinitions.ts"," under ",[278,651,652],{},"generatedPath",", a module the project imports so each service registers in the platform's service directory as it comes online.",[283,655,657],{"className":285,"code":656,"language":287,"meta":288,"style":288},"kinotic generate\nkinotic gen -v\nkinotic gen --force\n",[278,658,659,666,676],{"__ignoreMap":288},[292,660,661,663],{"class":294,"line":295},[292,662,315],{"class":298},[292,664,665],{"class":302}," generate\n",[292,667,668,670,673],{"class":294,"line":379},[292,669,315],{"class":298},[292,671,672],{"class":302}," gen",[292,674,675],{"class":302}," -v\n",[292,677,678,680,682],{"class":294,"line":500},[292,679,315],{"class":298},[292,681,672],{"class":302},[292,683,684],{"class":302}," --force\n",[274,686,687],{},[388,688,390],{},[392,690,691,699],{},[395,692,693],{},[398,694,695,697],{},[401,696,403],{},[401,698,406],{},[408,700,701,711],{},[398,702,703,708],{},[413,704,705],{},[278,706,707],{},"-v, --verbose",[413,709,710],{},"Enable verbose logging",[398,712,713,718],{},[413,714,715],{},[278,716,717],{},"-f, --force",[413,719,720],{},"Force full regeneration, ignoring incremental change detection",[436,722],{},[348,724,726,610,728],{"id":725},"kinotic-sync-kinotic-synchronize",[278,727,341],{},[278,729,730],{},"kinotic synchronize",[274,732,733,734,737,738,741,742,745,746,749,750,752,753,756,757,760,761,763],{},"Synchronize local entity definitions with the Kinotic server. This uploads your entity classes so the server can set up the backing data stores and register the entity services, and applies any pending ",[460,735,736],{"href":118},"migrations"," from the ",[278,739,740],{},".\u002Fmigrations"," directory. The entities are synchronized into the project named by ",[278,743,744],{},"projectId"," in ",[278,747,748],{},".config\u002Fkinotic.config.ts",", which must already exist in Kinotic OS. It runs the same generation as ",[278,751,337],{},", so the repository classes, ",[278,754,755],{},".config\u002Fc3"," and the ",