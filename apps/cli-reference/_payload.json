 shiki-themes material-theme-lighter material-theme material-theme-palenight","bun install -g @kinotic-ai\u002Fkinotic-cli\n","bash","",[279,291,292],{"__ignoreMap":289},[293,294,297,301,305,308],"span",{"class":295,"line":296},"line",1,[293,298,300],{"class":299},"sBMFI","bun",[293,302,304],{"class":303},"sfazB"," install",[293,306,307],{"class":303}," -g",[293,309,310],{"class":303}," @kinotic-ai\u002Fkinotic-cli\n",[270,312,314],{"id":313},"commands","Commands",[275,316,317,318,321,322,325,326,329],{},"Project commands (",[279,319,320],{},"kinotic generate",", ",[279,323,324],{},"kinotic sync",") locate the project by searching upward from the current directory for a ",[279,327,328],{},".config\u002Fkinotic.config.*"," file, so they can be run from any directory inside the project.",[331,332,334],"h3",{"id":333},"kinotic-login",[279,335,336],{},"kinotic login",[275,338,339,340,342],{},"Log in to a Kinotic server and store credentials for subsequent commands. Runs the OAuth device-authorization flow: the CLI opens a browser once for you to approve, then stores a refresh token so later commands are non-interactive. The server you log in to becomes the default server for commands like ",[279,341,324],{},".",[284,344,346],{"className":286,"code":345,"language":288,"meta":289,"style":289},"kinotic login --server http:\u002F\u002Flocalhost:58503\nkinotic login\n",[279,347,348,362],{"__ignoreMap":289},[293,349,350,353,356,359],{"class":295,"line":296},[293,351,352],{"class":299},"kinotic",[293,354,355],{"class":303}," login",[293,357,358],{"class":303}," --server",[293,360,361],{"class":303}," http:\u002F\u002Flocalhost:58503\n",[293,363,365,367],{"class":295,"line":364},2,[293,366,352],{"class":299},[293,368,369],{"class":303}," login\n",[275,371,372],{},[373,374,375],"strong",{},"Flags:",[377,378,379,392],"table",{},[380,381,382],"thead",{},[383,384,385,389],"tr",{},[386,387,388],"th",{},"Flag",[386,390,391],{},"Description",[393,394,395],"tbody",{},[383,396,397,403],{},[398,399,400],"td",{},[279,401,402],{},"-s, --server",[398,404,405],{},"The Kinotic server URL to log in to. When omitted, the stored default server is used",[407,408],"hr",{},[331,410,412,414,415],{"id":411},"kinotic-generate-kinotic-gen",[279,413,320],{}," \u002F ",[279,416,417],{},"kinotic gen",[275,419,420,421,425,426,342],{},"Generate Repository classes from your entity definitions. This runs locally without connecting to the server, and fills in the implementations of ",[422,423,424],"a",{"href":111},"named query"," methods declared with ",[279,427,428],{},"@Query",[275,430,431,432,435,436,439],{},"Each entity's C3Type schema is written as JSON to ",[279,433,434],{},".config\u002Fc3\u002Fentities\u002F\u003Cnamespace>.\u003Cname>.json",", and the named queries declared on a Repository to ",[279,437,438],{},".config\u002Fc3\u002Fqueries\u002F\u003CRepositoryName>.json",". Removing the last named query from a Repository removes its queries file.",[275,441,442,443,446,447,450,451,454,455,458],{},"Every class decorated with ",[279,444,445],{},"@Publish"," under the project's ",[279,448,449],{},"servicesPaths"," gets a service definition: its functions, with the parameters a request carries and their types. The definitions are written to ",[279,452,453],{},"ServiceDefinitions.ts"," under ",[279,456,457],{},"generatedPath",", a module the project imports so each service registers in the platform's service directory as it comes online.",[284,460,462],{"className":286,"code":461,"language":288,"meta":289,"style":289},"kinotic generate\nkinotic gen -v\nkinotic gen --force\n",[279,463,464,471,481],{"__ignoreMap":289},[293,465,466,468],{"class":295,"line":296},[293,467,352],{"class":299},[293,469,470],{"class":303}," generate\n",[293,472,473,475,478],{"class":295,"line":364},[293,474,352],{"class":299},[293,476,477],{"class":303}," gen",[293,479,480],{"class":303}," -v\n",[293,482,484,486,488],{"class":295,"line":483},3,[293,485,352],{"class":299},[293,487,477],{"class":303},[293,489,490],{"class":303}," --force\n",[275,492,493],{},[373,494,375],{},[377,496,497,505],{},[380,498,499],{},[383,500,501,503],{},[386,502,388],{},[386,504,391],{},[393,506,507,517],{},[383,508,509,514],{},[398,510,511],{},[279,512,513],{},"-v, --verbose",[398,515,516],{},"Enable verbose logging",[383,518,519,524],{},[398,520,521],{},[279,522,523],{},"-f, --force",[398,525,526],{},"Force full regeneration, ignoring incremental change detection",[407,528],{},[331,530,532,414,534],{"id":531},"kinotic-sync-kinotic-synchronize",[279,533,324],{},[279,535,536],{},"kinotic synchronize",[275,538,539,540,543,544,547,548,551,552,555,556,558,559,562,563,566,567,569],{},"Synchronize local entity definitions with the Kinotic server. This uploads your entity classes so the server can set up the backing data stores and register the entity services, and applies any pending ",[422,541,542],{"href":119},"migrations"," from the ",[279,545,546],{},".\u002Fmigrations"," directory. The entities are synchronized into the project named by ",[279,549,550],{},"projectId"," in ",[279,553,554],{},".config\u002Fkinotic.config.ts",", which must already exist in Kinotic OS. It runs the same generation as ",[279,557,320],{},", so the repository classes, ",[279,560,561],{},".config\u002Fc3"," and the ",[279,564,565],{},"ServiceDefinitions"," module are refreshed as well; the service definitions reach the server from the runtime, as each service comes online, not from the sync. Requires a prior ",[279,568,336],{}," against the target server.",[284,571,573],{"className":286,"code":572,"language":288,"meta":289,"style":289},"kinotic sync -p\nkinotic sync -p -v -s http:\u002F\u002Flocalhost:58503\n",[279,574,575,585],{"__ignoreMap":289},[293,576,577,579,582],{"class":295,"line":296},[293,578,352],{"class":299},[293,580,581],{"class":303}," sync",[293,583,584],{"class":303}," -p\n",[293,586,587,589,591,594,597,600],{"class":295,"line":364},[293,588,352],{"class":299},[293,590,581],{"class":303},[293,592,593],{"class":303}," -p",[293,595,596],{"class":303}," -v",[293,598,599],{"class":303}," -s",[293,601,361],{"class":303},[275,603,604],{},[373,605,375],{},[377,607,608,616],{},[380,609,610],{},[383,611,612,614],{},[386,613,388],{},[386,615,391],{},[393,617,618,627,637,645,655],{},[383,619,620,624],{},[398,621,622],{},[279,623,402],{},[398,625,626],{},"The Kinotic server URL. When omitted, the stored default server is used",[383,628,629,634],{},[398,630,631],{},[279,632,633],{},"-p, --publish",[398,635,636],{},"Publish each entity after save\u002Fupdate",[383,638,639,643],{},[398,640,641],{},[279,642,513],{},[398,644,516],{},[383,646,647,652],{},[398,648,649],{},[279,650,651],{},"--dryRun",[398,653,654],{},"Enables verbose logging and does not save any changes to the server",[383,656,657,662],{},[398,658,659],{},[279,660,661],{},"--force",[398,663,526],{},[407,665],{},[275,667,668,669,672,673,676],{},"Run ",[279,670,671],{},"kinotic --help"," or ",[279,674,675],{},"kinotic \u003Ccommand> --help"," for the full list of commands and options.",[678,679,680],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text