u002Fkinotic-cli\n",[206,248,250],{"id":249},"commands","Commands",[211,252,253,254,257,258,261,262,265],{},"Project commands (",[215,255,256],{},"kinotic generate",", ",[215,259,260],{},"kinotic sync",") locate the project by searching upward from the current directory for a ",[215,263,264],{},".config\u002Fkinotic.config.*"," file, so they can be run from any directory inside the project.",[267,268,270],"h3",{"id":269},"kinotic-login",[215,271,272],{},"kinotic login",[211,274,275,276,278],{},"Log in to a Kinotic server and store credentials for subsequent commands. Runs the OAuth device-authorization flow: the CLI opens a browser once for you to approve, then stores a refresh token so later commands are non-interactive. The server you log in to becomes the default server for commands like ",[215,277,260],{},".",[220,280,282],{"className":222,"code":281,"language":224,"meta":225,"style":225},"kinotic login --server http:\u002F\u002Flocalhost:58503\nkinotic login\n",[215,283,284,298],{"__ignoreMap":225},[229,285,286,289,292,295],{"class":231,"line":232},[229,287,288],{"class":235},"kinotic",[229,290,291],{"class":239}," login",[229,293,294],{"class":239}," --server",[229,296,297],{"class":239}," http:\u002F\u002Flocalhost:58503\n",[229,299,301,303],{"class":231,"line":300},2,[229,302,288],{"class":235},[229,304,305],{"class":239}," login\n",[211,307,308],{},[309,310,311],"strong",{},"Flags:",[313,314,315,328],"table",{},[316,317,318],"thead",{},[319,320,321,325],"tr",{},[322,323,324],"th",{},"Flag",[322,326,327],{},"Description",[329,330,331],"tbody",{},[319,332,333,339],{},[334,335,336],"td",{},[215,337,338],{},"-s, --server",[334,340,341],{},"The Kinotic server URL to log in to. When omitted, the stored default server is used",[343,344],"hr",{},[267,346,348,350,351],{"id":347},"kinotic-generate-kinotic-gen",[215,349,256],{}," \u002F ",[215,352,353],{},"kinotic gen",[211,355,356,357,361,362,278],{},"Generate Repository classes from your entity definitions. This runs locally without connecting to the server, and fills in the implementations of ",[358,359,360],"a",{"href":81},"named query"," methods declared with ",[215,363,364],{},"@Query",[211,366,367,368,371,372,375],{},"Each entity's C3Type schema is written as JSON to ",[215,369,370],{},".config\u002Fc3\u002Fentities\u002F\u003Cnamespace>.\u003Cname>.json",", and the named queries declared on a Repository to ",[215,373,374],{},".config\u002Fc3\u002Fqueries\u002F\u003CRepositoryName>.json",". Removing the last named query from a Repository removes its queries file.",[220,377,379],{"className":222,"code":378,"language":224,"meta":225,"style":225},"kinotic generate\nkinotic gen -v\nkinotic gen --force\n",[215,380,381,388,398],{"__ignoreMap":225},[229,382,383,385],{"class":231,"line":232},[229,384,288],{"class":235},[229,386,387],{"class":239}," generate\n",[229,389,390,392,395],{"class":231,"line":300},[229,391,288],{"class":235},[229,393,394],{"class":239}," gen",[229,396,397],{"class":239}," -v\n",[229,399,401,403,405],{"class":231,"line":400},3,[229,402,288],{"class":235},[229,404,394],{"class":239},[229,406,407],{"class":239}," --force\n",[211,409,410],{},[309,411,311],{},[313,413,414,422],{},[316,415,416],{},[319,417,418,420],{},[322,419,324],{},[322,421,327],{},[329,423,424,434],{},[319,425,426,431],{},[334,427,428],{},[215,429,430],{},"-v, --verbose",[334,432,433],{},"Enable verbose logging",[319,435,436,441],{},[334,437,438],{},[215,439,440],{},"-f, --force",[334,442,443],{},"Force full regeneration, ignoring incremental change detection",[343,445],{},[267,447,449,350,451],{"id":448},"kinotic-sync-kinotic-synchronize",[215,450,260],{},[215,452,453],{},"kinotic synchronize",[211,455,456,457,460,461,464,465,467,468,471,472,474],{},"Synchronize local entity definitions with the Kinotic server. This uploads your entity classes so the server can set up the backing data stores and register the entity services, and applies any pending ",[358,458,459],{"href":89},"migrations"," from the ",[215,462,463],{},".\u002Fmigrations"," directory. It runs the same generation as ",[215,466,256],{},", so the repository classes and ",[215,469,470],{},".config\u002Fc3"," are refreshed as well. Requires a prior ",[215,473,272],{}," against the target server.",[220,476,478],{"className":222,"code":477,"language":224,"meta":225,"style":225},"kinotic sync -p\nkinotic sync -p -v -s http:\u002F\u002Flocalhost:58503\n",[215,479,480,490],{"__ignoreMap":225},[229,481,482,484,487],{"class":231,"line":232},[229,483,288],{"class":235},[229,485,486],{"class":239}," sync",[229,488,489],{"class":239}," -p\n",[229,491,492,494,496,499,502,505],{"class":231,"line":300},[229,493,288],{"class":235},[229,495,486],{"class":239},[229,497,498],{"class":239}," -p",[229,500,501],{"class":239}," -v",[229,503,504],{"class":239}," -s",[229,506,297],{"class":239},[211,508,509],{},[309,510,311],{},[313,512,513,521],{},[316,514,515],{},[319,516,517,519],{},[322,518,324],{},[322,520,327],{},[329,522,523,532,542,550,560],{},[319,524,525,529],{},[334,526,527],{},[215,528,338],{},[334,530,531],{},"The Kinotic server URL. When omitted, the stored default server is used",[319,533,534,539],{},[334,535,536],{},[215,537,538],{},"-p, --publish",[334,540,541],{},"Publish each entity after save\u002Fupdate",[319,543,544,548],{},[334,545,546],{},[215,547,430],{},[334,549,433],{},[319,551,552,557],{},[334,553,554],{},[215,555,556],{},"--dryRun",[334,558,559],{},"Enables verbose logging and does not save any changes to the server",[319,561,562,567],{},[334,563,564],{},[215,565,566],{},"--force",[334,568,443],{},[343,570],{},[211,572,573,574,577,578,581],{},"Run ",[215,575,576],{},"kinotic --help"," or ",[215,579,580],{},"kinotic \u003Ccommand> --help"," for the full list of commands and options.",[583,584,585],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-