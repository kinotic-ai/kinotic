Fplatform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"title":224,"path":225,"stem":226,"icon":227},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"id":229,"title":98,"body":230,"description":1565,"extension":1566,"links":1567,"meta":1568,"navigation":1569,"path":99,"seo":1570,"stem":100,"__hash__":1571},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":231,"value":232,"toc":1552},"minimark",[233,237,241,246,263,278,282,293,355,361,365,384,552,565,576,614,718,735,739,750,857,865,869,884,1428,1447,1451,1483,1487,1497,1506,1510,1521,1528,1542,1548],[234,235,25],"h2",{"id":236},"overview",[238,239,240],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[242,243,245],"h3",{"id":244},"authentication-methods","Authentication Methods",[247,248,249,257],"ul",{},[250,251,252,256],"li",{},[253,254,255],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[250,258,259,262],{},[253,260,261],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including platform-provided social providers pre-registered with Kinotic OS.",[238,264,265,266,270,271,274,275,277],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[267,268,269],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[272,273,167],"a",{"href":168}," and ",[272,276,162],{"href":163},".",[242,279,281],{"id":280},"scoped-authentication","Scoped Authentication",[238,283,284,285,288,289,292],{},"Authentication happens at the ",[253,286,287],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[253,290,291],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[294,295,296,316],"table",{},[297,298,299],"thead",{},[300,301,302,308,313],"tr",{},[303,304,305],"th",{},[267,306,307],{},"organizationId",[303,309,310],{},[267,311,312],{},"applicationId",[303,314,315],{},"Resulting scope",[317,318,319,332,344],"tbody",{},[300,320,321,325,327],{},[322,323,324],"td",{},"absent",[322,326,324],{},[322,328,329],{},[267,330,331],{},"SYSTEM",[300,333,334,337,339],{},[322,335,336],{},"present",[322,338,324],{},[322,340,341],{},[267,342,343],{},"ORGANIZATION",[300,345,346,348,350],{},[322,347,336],{},[322,349,336],{},[322,351,352],{},[267,353,354],{},"APPLICATION",[238,356,357,358,360],{},"For application developers this is always the ",[267,359,354],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[234,362,364],{"id":363},"connecting-with-email-and-password","Connecting with Email and Password",[238,366,367,368,371,372,375,376,375,379,375,381,383],{},"In Node, pass a ",[267,369,370],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[267,373,374],{},"clientId",", ",[267,377,378],{},"clientSecret",[267,380,307],{},[267,382,312],{},"); they are presented as headers on the WebSocket upgrade:",[385,386,391],"pre",{"className":387,"code":388,"language":389,"meta":390,"style":390},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[267,392,393,432,453,460,470,489,544],{"__ignoreMap":390},[394,395,398,402,406,410,413,416,419,422,425,429],"span",{"class":396,"line":397},"line",1,[394,399,401],{"class":400},"s7zQu","import",[394,403,405],{"class":404},"sMK4o"," {",[394,407,409],{"class":408},"sTEyZ"," BasicCredentialsResolver",[394,411,412],{"class":404},",",[394,414,415],{"class":408}," Kinotic",[394,417,418],{"class":404}," }",[394,420,421],{"class":400}," from",[394,423,424],{"class":404}," '",[394,426,428],{"class":427},"sfazB","@kinotic-ai\u002Fcore",[394,430,431],{"class":404},"'\n",[394,433,435,437,439,442,444,446,448,451],{"class":396,"line":434},2,[394,436,401],{"class":400},[394,438,405],{"class":404},[394,440,441],{"class":408}," ensureNodeWebSocket",[394,443,418],{"class":404},[394,445,421],{"class":400},[394,447,424],{"class":404},[394,449,450],{"class":427},"@kinotic-ai\u002Fcore\u002Fnode",[394,452,431],{"class":404},[394,454,456],{"class":396,"line":455},3,[394,457,459],{"emptyLinePlaceholder":458},true,"\n",[394,461,463,467],{"class":396,"line":462},4,[394,464,466],{"class":465},"s2Zo4","ensureNodeWebSocket",[394,468,469],{"class":408},"()\n",[394,471,473,476,478,480,483,486],{"class":396,"line":472},5,[394,474,475],{"class":400},"await",[394,477,415],{"class":408},[394,479,277],{"class":404},[394,481,482],{"class":465},"connect",[394,484,485],{"class":408},"(",[394,487,488],{"class":404},"{\n",[394,490,492,496,499,502,504,506,509,512,514,516,518,521,523,525,527,530,532,534,536,539,541],{"class":396,"line":491},6,[394,493,495],{"class":494},"swJcz","    credentials",[394,497,498],{"class":404},":",[394,500,501],{"class":404}," new",[394,503,409],{"class":465},[394,505,485],{"class":408},[394,507,508],{"class":404},"'",[394,510,511],{"class":427},"user@example.com",[394,513,508],{"class":404},[394,515,412],{"class":404},[394,517,424],{"class":404},[394,519,520],{"class":427},"password",[394,522,508],{"class":404},[394,524,412],{"class":404},[394,526,424],{"class":404},[394,528,529],{"class":427},"my-organization",[394,531,508],{"class":404},[394,533,412],{"class":404},[394,535,424],{"class":404},[394,537,538],{"class":427},"my-application",[394,540,508],{"class":404},[394,542,543],{"class":408},")\n",[394,545,547,550],{"class":396,"line":546},7,[394,548,549],{"class":404},"}",[394,551,543],{"class":408},[238,553,554,555,558,559,561,562,564],{},"The constructor is ",[267,556,557],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[267,560,374],{}," is your user's email and ",[267,563,378],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[238,566,567,568,571,572,575],{},"Your application's users and machines connect to the app server, at your application's API host (the ",[267,569,570],{},"VITE_KINOTIC_HOST"," a UI build receives, ",[267,573,574],{},"\u003CorganizationId>--\u003CapplicationId>"," under the platform's application domain) or at the app server's own address. The app server authenticates only application identities and the runtime workloads of your organization's applications: organization and platform credentials fail there as invalid, and on an application's API host so do the credentials of any other application.",[238,577,578,579,582,583,586,587,590,591,594,595,590,598,601,602,605,606,609,610,613],{},"With no ",[267,580,581],{},"credentials"," at all, ",[267,584,585],{},"Kinotic.connect()"," resolves through the default chain: the ",[267,588,589],{},"KINOTIC_CLIENT_ID"," \u002F ",[267,592,593],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[267,596,597],{},"KINOTIC_ORGANIZATION_ID",[267,599,600],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[267,603,604],{},"server"," option, the ",[267,607,608],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then the management server at ",[267,611,612],{},"https:\u002F\u002Fapi.kinotic.ai",", so an application's client names its API host. To pin the server explicitly, pass it alongside the credentials:",[385,615,617],{"className":387,"code":616,"language":389,"meta":390,"style":390},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[267,618,619,633,668,712],{"__ignoreMap":390},[394,620,621,623,625,627,629,631],{"class":396,"line":397},[394,622,475],{"class":400},[394,624,415],{"class":408},[394,626,277],{"class":404},[394,628,482],{"class":465},[394,630,485],{"class":408},[394,632,488],{"class":404},[394,634,635,638,640,642,645,647,649,652,654,656,659,661,665],{"class":396,"line":434},[394,636,637],{"class":494},"    server",[394,639,498],{"class":404},[394,641,405],{"class":404},[394,643,644],{"class":494}," host",[394,646,498],{"class":404},[394,648,424],{"class":404},[394,650,651],{"class":427},"kinotic.example.com",[394,653,508],{"class":404},[394,655,412],{"class":404},[394,657,658],{"class":494}," useSSL",[394,660,498],{"class":404},[394,662,664],{"class":663},"sfNiH"," true",[394,666,667],{"class":404}," },\n",[394,669,670,672,674,676,678,680,682,684,686,688,690,692,694,696,698,700,702,704,706,708,710],{"class":396,"line":455},[394,671,495],{"class":494},[394,673,498],{"class":404},[394,675,501],{"class":404},[394,677,409],{"class":465},[394,679,485],{"class":408},[394,681,508],{"class":404},[394,683,511],{"class":427},[394,685,508],{"class":404},[394,687,412],{"class":404},[394,689,424],{"class":404},[394,691,520],{"class":427},[394,693,508],{"class":404},[394,695,412],{"class":404},[394,697,424],{"class":404},[394,699,529],{"class":427},[394,701,508],{"class":404},[394,703,412],{"class":404},[394,705,424],{"class":404},[394,707,538],{"class":427},[394,709,508],{"class":404},[394,711,543],{"class":408},[394,713,714,716],{"class":396,"line":462},[394,715,549],{"class":404},[394,717,543],{"class":408},[238,719,720,721,723,724,727,728,731,732,277],{},"Absent ",[267,722,604],{}," fields fall through to the environment — ",[267,725,726],{},"{ host }"," alone means no TLS and port ",[267,729,730],{},"58503",", the management server's gateway port, so a connection to a local app server names its port, ",[267,733,734],{},"58505",[234,736,738],{"id":737},"connecting-with-oidc","Connecting with OIDC",[238,740,741,742,745,746,749],{},"For token-based authentication, pass a Bearer token via ",[267,743,744],{},"BearerCredentialsResolver",". The resolver sends ",[267,747,748],{},"Authorization: Bearer \u003Ctoken>"," on every (re)connect; pass a supplier function to refresh a short-lived token before each connect:",[385,751,753],{"className":387,"code":752,"language":389,"meta":390,"style":390},"import { BearerCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BearerCredentialsResolver(async () => await getToken())\n})\n",[267,754,755,778,796,800,806,820,851],{"__ignoreMap":390},[394,756,757,759,761,764,766,768,770,772,774,776],{"class":396,"line":397},[394,758,401],{"class":400},[394,760,405],{"class":404},[394,762,763],{"class":408}," BearerCredentialsResolver",[394,765,412],{"class":404},[394,767,415],{"class":408},[394,769,418],{"class":404},[394,771,421],{"class":400},[394,773,424],{"class":404},[394,775,428],{"class":427},[394,777,431],{"class":404},[394,779,780,782,784,786,788,790,792,794],{"class":396,"line":434},[394,781,401],{"class":400},[394,783,405],{"class":404},[394,785,441],{"class":408},[394,787,418],{"class":404},[394,789,421],{"class":400},[394,791,424],{"class":404},[394,793,450],{"class":427},[394,795,431],{"class":404},[394,797,798],{"class":396,"line":455},[394,799,459],{"emptyLinePlaceholder":458},[394,801,802,804],{"class":396,"line":462},[394,803,466],{"class":465},[394,805,469],{"class":408},[394,807,808,810,812,814,816,818],{"class":396,"line":472},[394,809,475],{"class":400},[394,811,415],{"class":408},[394,813,277],{"class":404},[394,815,482],{"class":465},[394,817,485],{"class":408},[394,819,488],{"class":404},[394,821,822,824,826,828,830,832,836,839,842,845,848],{"class":396,"line":491},[394,823,495],{"class":494},[394,825,498],{"class":404},[394,827,501],{"class":404},[394,829,763],{"class":465},[394,831,485],{"class":408},[394,833,835],{"class":834},"spNyl","async",[394,837,838],{"class":404}," ()",[394,840,841],{"class":834}," =>",[394,843,844],{"class":400}," await",[394,846,847],{"class":465}," getToken",[394,849,850],{"class":408},"())\n",[394,852,853,855],{"class":396,"line":546},[394,854,549],{"class":404},[394,856,543],{"class":408},[238,858,859,860,590,862,864],{},"A Kinotic-minted JWT already carries the ",[267,861,307],{},[267,863,312],{}," claims, so no scope headers are needed alongside it. The platform validates the JWT against the OIDC configurations enabled for your application, matches the token's email to a pre-existing user in your application's scope, and establishes a session.",[242,866,868],{"id":867},"browser-applications","Browser applications",[238,870,871,872,875,876,878,879,883],{},"A browser UI does ",[253,873,874],{},"not"," supply credentials. It signs its user in over REST at its application's API host, the ",[267,877,570],{}," of ",[272,880,882],{"href":881},"\u002Fapps\u002Fapplication-structure\u002Fapplications-and-projects#the-ui-build-contract","the UI build contract",", which sets a session cookie for that host, then connects to the same host with no credentials — the default resolution finds the session. The host names the application, so the UI never sends its organization or application id:",[385,885,887],{"className":387,"code":886,"language":389,"meta":390,"s