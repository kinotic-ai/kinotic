curity","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":233,"path":234,"stem":235,"icon":236},"Enterprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":238,"title":98,"body":239,"description":1789,"extension":1790,"links":1791,"meta":1792,"navigation":1793,"path":99,"seo":1794,"stem":100,"__hash__":1795},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":240,"value":241,"toc":1775},"minimark",[242,246,250,255,272,287,291,302,364,370,374,393,561,574,585,623,727,744,748,759,866,874,878,893,1517,1532,1551,1555,1592,1596,1656,1660,1696,1705,1709,1747,1765,1771],[243,244,25],"h2",{"id":245},"overview",[247,248,249],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[251,252,254],"h3",{"id":253},"authentication-methods","Authentication Methods",[256,257,258,266],"ul",{},[259,260,261,265],"li",{},[262,263,264],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[259,267,268,271],{},[262,269,270],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including the system's social providers pre-registered with Kinotic OS.",[247,273,274,275,279,280,283,284,286],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[276,277,278],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[281,282,167],"a",{"href":168}," and ",[281,285,162],{"href":163},".",[251,288,290],{"id":289},"scoped-authentication","Scoped Authentication",[247,292,293,294,297,298,301],{},"Authentication happens at the ",[262,295,296],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[262,299,300],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[303,304,305,325],"table",{},[306,307,308],"thead",{},[309,310,311,317,322],"tr",{},[312,313,314],"th",{},[276,315,316],{},"organizationId",[312,318,319],{},[276,320,321],{},"applicationId",[312,323,324],{},"Resulting scope",[326,327,328,341,353],"tbody",{},[309,329,330,334,336],{},[331,332,333],"td",{},"absent",[331,335,333],{},[331,337,338],{},[276,339,340],{},"SYSTEM",[309,342,343,346,348],{},[331,344,345],{},"present",[331,347,333],{},[331,349,350],{},[276,351,352],{},"ORGANIZATION",[309,354,355,357,359],{},[331,356,345],{},[331,358,345],{},[331,360,361],{},[276,362,363],{},"APPLICATION",[247,365,366,367,369],{},"For application developers this is always the ",[276,368,363],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[243,371,373],{"id":372},"connecting-with-email-and-password","Connecting with Email and Password",[247,375,376,377,380,381,384,385,384,388,384,390,392],{},"In Node, pass a ",[276,378,379],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[276,382,383],{},"clientId",", ",[276,386,387],{},"clientSecret",[276,389,316],{},[276,391,321],{},"); they are presented as headers on the WebSocket upgrade:",[394,395,400],"pre",{"className":396,"code":397,"language":398,"meta":399,"style":399},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[276,401,402,441,462,469,479,498,553],{"__ignoreMap":399},[403,404,407,411,415,419,422,425,428,431,434,438],"span",{"class":405,"line":406},"line",1,[403,408,410],{"class":409},"s7zQu","import",[403,412,414],{"class":413},"sMK4o"," {",[403,416,418],{"class":417},"sTEyZ"," BasicCredentialsResolver",[403,420,421],{"class":413},",",[403,423,424],{"class":417}," Kinotic",[403,426,427],{"class":413}," }",[403,429,430],{"class":409}," from",[403,432,433],{"class":413}," '",[403,435,437],{"class":436},"sfazB","@kinotic-ai\u002Fcore",[403,439,440],{"class":413},"'\n",[403,442,444,446,448,451,453,455,457,460],{"class":405,"line":443},2,[403,445,410],{"class":409},[403,447,414],{"class":413},[403,449,450],{"class":417}," ensureNodeWebSocket",[403,452,427],{"class":413},[403,454,430],{"class":409},[403,456,433],{"class":413},[403,458,459],{"class":436},"@kinotic-ai\u002Fcore\u002Fnode",[403,461,440],{"class":413},[403,463,465],{"class":405,"line":464},3,[403,466,468],{"emptyLinePlaceholder":467},true,"\n",[403,470,472,476],{"class":405,"line":471},4,[403,473,475],{"class":474},"s2Zo4","ensureNodeWebSocket",[403,477,478],{"class":417},"()\n",[403,480,482,485,487,489,492,495],{"class":405,"line":481},5,[403,483,484],{"class":409},"await",[403,486,424],{"class":417},[403,488,286],{"class":413},[403,490,491],{"class":474},"connect",[403,493,494],{"class":417},"(",[403,496,497],{"class":413},"{\n",[403,499,501,505,508,511,513,515,518,521,523,525,527,530,532,534,536,539,541,543,545,548,550],{"class":405,"line":500},6,[403,502,504],{"class":503},"swJcz","    credentials",[403,506,507],{"class":413},":",[403,509,510],{"class":413}," new",[403,512,418],{"class":474},[403,514,494],{"class":417},[403,516,517],{"class":413},"'",[403,519,520],{"class":436},"user@example.com",[403,522,517],{"class":413},[403,524,421],{"class":413},[403,526,433],{"class":413},[403,528,529],{"class":436},"password",[403,531,517],{"class":413},[403,533,421],{"class":413},[403,535,433],{"class":413},[403,537,538],{"class":436},"my-organization",[403,540,517],{"class":413},[403,542,421],{"class":413},[403,544,433],{"class":413},[403,546,547],{"class":436},"my-application",[403,549,517],{"class":413},[403,551,552],{"class":417},")\n",[403,554,556,559],{"class":405,"line":555},7,[403,557,558],{"class":413},"}",[403,560,552],{"class":417},[247,562,563,564,567,568,570,571,573],{},"The constructor is ",[276,565,566],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[276,569,383],{}," is your user's email and ",[276,572,387],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[247,575,576,577,580,581,584],{},"Your application's users and machines connect to the app server, at your application's API host (the ",[276,578,579],{},"VITE_KINOTIC_HOST"," a UI build receives, ",[276,582,583],{},"\u003CorganizationId>--\u003CapplicationId>"," under the platform's application domain) or at the app server's own address. The app server authenticates only application identities and the runtime workloads of your organization's applications: organization and system credentials fail there as invalid, and on an application's API host so do the credentials of any other application.",[247,586,587,588,591,592,595,596,599,600,603,604,599,607,610,611,614,615,618,619,622],{},"With no ",[276,589,590],{},"credentials"," at all, ",[276,593,594],{},"Kinotic.connect()"," resolves through the default chain: the ",[276,597,598],{},"KINOTIC_CLIENT_ID"," \u002F ",[276,601,602],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[276,605,606],{},"KINOTIC_ORGANIZATION_ID",[276,608,609],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[276,612,613],{},"server"," option, the ",[276,616,617],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then the management server at ",[276,620,621],{},"https:\u002F\u002Fapi.kinotic.ai",", so an application's client names its API host. To pin the server explicitly, pass it alongside the credentials:",[394,624,626],{"className":396,"code":625,"language":398,"meta":399,"style":399},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[276,627,628,642,677,721],{"__ignoreMap":399},[403,629,630,632,634,636,638,640],{"class":405,"line":406},[403,631,484],{"class":409},[403,633,424],{"class":417},[403,635,286],{"class":413},[403,637,491],{"class":474},[403,639,494],{"class":417},[403,641,497],{"class":413},[403,643,644,647,649,651,654,656,658,661,663,665,668,670,674],{"class":405,"line":443},[403,645,646],{"class":503},"    server",[403,648,507],{"class":413},[403,650,414],{"class":413},[403,652,653],{"class":503}," host",[403,655,507],{"class":413},[403,657,433],{"class":413},[403,659,660],{"class":436},"kinotic.example.com",[403,662,517],{"class":413},[403,664,421],{"class":413},[403,666,667],{"class":503}," useSSL",[403,669,507],{"class":413},[403,671,673],{"class":672},"sfNiH"," true",[403,675,676],{"class":413}," },\n",[403,678,679,681,683,685,687,689,691,693,695,697,699,701,703,705,707,709,711,713,715,717,719],{"class":405,"line":464},[403,680,504],{"class":503},[403,682,507],{"class":413},[403,684,510],{"class":413},[403,686,418],{"class":474},[403,688,494],{"class":417},[403,690,517],{"class":413},[403,692,520],{"class":436},[403,694,517],{"class":413},[403,696,421],{"class":413},[403,698,433],{"class":413},[403,700,529],{"class":436},[403,702,517],{"class":413},[403,704,421],{"class":413},[403,706,433],{"class":413},[403,708,538],{"class":436},[403,710,517],{"class":413},[403,712,421],{"class":413},[403,714,433],{"class":413},[403,716,547],{"class":436},[403,718,517],{"class":413},[403,720,552],{"class":417},[403,722,723,725],{"class":405,"line":471},[403,724,558],{"class":413},[403,726,552],{"class":417},[247,728,729,730,732,733,736,737,740,741,286],{},"Absent ",[276,731,613],{}," fields fall through to the environment — ",[276,734,735],{},"{ host }"," alone means no TLS and port ",[276,738,739],{},"58503",", the management server's gateway port, so a connection to a local app server names its port, ",[276,742,743],{},"58505",[243,745,747],{"id":746},"connecting-with-oidc","Connecting with OIDC",[247,749,750,751,754,755,758],{},"For token-based authentication, pass a Bearer token via ",[276,752,753],{},"BearerCredentialsResolver",". The resolver sends ",[276,756,757],{},"Authorization: Bearer \u003Ctoken>"," on every (re)connect; pass a supplier function to refresh a short-lived token before each connect:",[394,760,762],{"className":396,"code":761,"language":398,"meta":399,"style":399},"import { BearerCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BearerCredentialsResolver(async () => await getToken())\n})\n",[276,763,764,787,805,809,815,829,860],{"__ignoreMap":399},[403,765,766,768,770,773,775,777,779,781,783,785],{"class":405,"line":406},[403,767,410],{"class":409},[403,769,414],{"class":413},[403,771,772],{"class":417}," BearerCredentialsResolver",[403,774,421],{"class":413},[403,776,424],{"class":417},[403,778,427],{"class":413},[403,780,430],{"class":409},[403,782,433],{"class":413},[403,784,437],{"class":436},[403,786,440],{"class":413},[403,788,789,791,793,795,797,799,801,803],{"class":405,"line":443},[403,790,410],{"class":409},[403,792,414],{"class":413},[403,794,450],{"class":417},[403,796,427],{"class":413},[403,798,430],{"class":409},[403,800,433],{"class":413},[403,802,459],{"class":436},[403,804,440],{"class":413},[403,806,807],{"class":405,"line":464},[403,808,468],{"emptyLinePlaceholder":467},[403,810,811,813],{"class":405,"line":471},[403,812,475],{"class":474},[403,814,478],{"class":417},[403,816,817,819,821,823,825,827],{"class":405,"line":481},[403,818,484],{"class":409},[403,820,424],{"class":417},[403,822,286],{"class":413},[403,824,491],{"class":474},[403,826,494],{"class":417},[403,828,497],{"class":413},[403,830,831,833,835,837,839,841,845,848,851,854,857],{"class":405,"line":500},[403,832,504],{"class":503},[403,834,507],{"class":413},[403,836,510],{"class":413},[403,838,772],{"class":474},[403,840,494],{"class":417},[403,842,844],{"class":843},"spNyl","async",[403,846,847],{"class":413}," ()",[403,849,850],{"class":843}," =>",[403,852,853],{"class":409}," await",[403,855,856],{"class":474}," getToken",[403,858,859],{"class":417},"())\n",[403,861,862,864],{"class":405,"line":555},[403,863,558],{"class":413},[403,865,552],{"class":417},[247,867,868,869,599,871,873],{},"A Kinotic-minted JWT already carries the ",[276,870,316],{},[276,872,321],{}," claims, so no scope headers are needed alongside it. The platform validates the JWT against the OIDC configurations enabled for your application, matches the token's email to a pre-existing user in your application's scope, and establishes a session.",[251,875,877],{"id":876},"browser-applications","Browser applications",[247,879,880,881,884,885,887,888,892],{},"A browser UI does ",[262,882,883],{},"not"," supply credentials. It signs its user in over REST at its application's API host, the ",[276,886,579],{}," of ",[281,889,891],{"href":890},"\u002Fapps\u002Fapplication-structure\u002Fapplications-and-projects#the-ui-build-contract","the UI build contract",", which sets a session cookie for that host, then connects to the same host with no credentials — the default resolution finds the session. The host names the application, so the UI never sends its organization or application id:",[394,894,896],{"className":396,"code":895,"language":398,"meta":399,"style":399},"import { Kinotic } from '@kinotic-ai\u002Fcore'\n\nconst env = import.meta.env\nconst server = { host: env.VITE_KINOTIC_HOST, port: parseInt(env.VITE_KINOTIC_PORT), useSSL: env.VITE_KINOTIC_USE_SSL === 'true' }\nconst api = `${server.useSSL ? 'https' : 'http'}:\u002F\u002F${server.host}:${server.port}\u002Fapi\u002Fauth`\nconst post = (path: string, body: object) => fetch(`${api}${path}`, {\n    method: 'POST',\n    credentials: 'include',\n    headers: { 'Content-Type': 'application\u002Fjson' },\n    body: JSON.stringify(body),\n})\n\n\u002F\u002F the password form\nif ((await post('\u002Fapp\u002Flogin', { email, password })).status === 204) {\n    await Kinotic.connect({ server })\n}\n\n\u002F\u002F one \"Continue with \u003Cname>\" button per provider the login offers\nconst providers = await (await fetch(`${api}\u002Fapp\u002Flogin\u002Fproviders`, { credentials: 'include' })).json()\nasync function continueWith(provider: { id: string }) {\n    const start = await (await post(`\u002Fapp\u002Flogin\u002Foidc\u002Fstart\u002F${provider.id}`, {})).json()\n    window.location.assign(start.redirect)\n}\n",[276,897,898,916,920,944,1010,1084,1145,1162,1178,1206,1227,1234,1239,1246,1302,1326,1332,1337,1343,1401,1433,1484,1512],{"__ignoreMap":399},[403,899,900,902,904,906,908,910,912,914],{"class":405,"line":406},[403,901,410],{"class":409},[403,903,414],{"class":413},[403,905,424],{"class":417},[403,907,427],{"class":413},[403,909,430],{"class":409},[403,911,433],{"class":413},[403,913,437],{"class":436},[403,915,440],{"class":413},[403,917,918],{"class":405,"line":443},[403,919,468],{"emptyLinePlaceholder":