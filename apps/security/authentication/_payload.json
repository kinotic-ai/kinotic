2Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":128,"icon":129,"path":196,"stem":197,"children":198,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[199,204],{"title":200,"path":201,"stem":202,"icon":203},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"title":205,"path":206,"stem":207,"icon":208},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F11.reference\u002F02.grind-jobs","i-lucide-workflow",{"id":210,"title":98,"body":211,"description":990,"extension":991,"links":992,"meta":993,"navigation":994,"path":99,"seo":995,"stem":100,"__hash__":996},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":212,"value":213,"toc":977},"minimark",[214,218,222,227,244,259,263,274,336,342,346,365,533,546,584,688,701,705,716,823,831,835,842,881,885,908,912,922,931,935,946,953,967,973],[215,216,25],"h2",{"id":217},"overview",[219,220,221],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[223,224,226],"h3",{"id":225},"authentication-methods","Authentication Methods",[228,229,230,238],"ul",{},[231,232,233,237],"li",{},[234,235,236],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[231,239,240,243],{},[234,241,242],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including platform-provided social providers pre-registered with Kinotic OS.",[219,245,246,247,251,252,255,256,258],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[248,249,250],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[253,254,167],"a",{"href":168}," and ",[253,257,162],{"href":163},".",[223,260,262],{"id":261},"scoped-authentication","Scoped Authentication",[219,264,265,266,269,270,273],{},"Authentication happens at the ",[234,267,268],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[234,271,272],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[275,276,277,297],"table",{},[278,279,280],"thead",{},[281,282,283,289,294],"tr",{},[284,285,286],"th",{},[248,287,288],{},"organizationId",[284,290,291],{},[248,292,293],{},"applicationId",[284,295,296],{},"Resulting scope",[298,299,300,313,325],"tbody",{},[281,301,302,306,308],{},[303,304,305],"td",{},"absent",[303,307,305],{},[303,309,310],{},[248,311,312],{},"SYSTEM",[281,314,315,318,320],{},[303,316,317],{},"present",[303,319,305],{},[303,321,322],{},[248,323,324],{},"ORGANIZATION",[281,326,327,329,331],{},[303,328,317],{},[303,330,317],{},[303,332,333],{},[248,334,335],{},"APPLICATION",[219,337,338,339,341],{},"For application developers this is always the ",[248,340,335],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[215,343,345],{"id":344},"connecting-with-email-and-password","Connecting with Email and Password",[219,347,348,349,352,353,356,357,356,360,356,362,364],{},"In Node, pass a ",[248,350,351],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[248,354,355],{},"clientId",", ",[248,358,359],{},"clientSecret",[248,361,288],{},[248,363,293],{},"); they are presented as headers on the WebSocket upgrade:",[366,367,372],"pre",{"className":368,"code":369,"language":370,"meta":371,"style":371},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[248,373,374,413,434,441,451,470,525],{"__ignoreMap":371},[375,376,379,383,387,391,394,397,400,403,406,410],"span",{"class":377,"line":378},"line",1,[375,380,382],{"class":381},"s7zQu","import",[375,384,386],{"class":385},"sMK4o"," {",[375,388,390],{"class":389},"sTEyZ"," BasicCredentialsResolver",[375,392,393],{"class":385},",",[375,395,396],{"class":389}," Kinotic",[375,398,399],{"class":385}," }",[375,401,402],{"class":381}," from",[375,404,405],{"class":385}," '",[375,407,409],{"class":408},"sfazB","@kinotic-ai\u002Fcore",[375,411,412],{"class":385},"'\n",[375,414,416,418,420,423,425,427,429,432],{"class":377,"line":415},2,[375,417,382],{"class":381},[375,419,386],{"class":385},[375,421,422],{"class":389}," ensureNodeWebSocket",[375,424,399],{"class":385},[375,426,402],{"class":381},[375,428,405],{"class":385},[375,430,431],{"class":408},"@kinotic-ai\u002Fcore\u002Fnode",[375,433,412],{"class":385},[375,435,437],{"class":377,"line":436},3,[375,438,440],{"emptyLinePlaceholder":439},true,"\n",[375,442,444,448],{"class":377,"line":443},4,[375,445,447],{"class":446},"s2Zo4","ensureNodeWebSocket",[375,449,450],{"class":389},"()\n",[375,452,454,457,459,461,464,467],{"class":377,"line":453},5,[375,455,456],{"class":381},"await",[375,458,396],{"class":389},[375,460,258],{"class":385},[375,462,463],{"class":446},"connect",[375,465,466],{"class":389},"(",[375,468,469],{"class":385},"{\n",[375,471,473,477,480,483,485,487,490,493,495,497,499,502,504,506,508,511,513,515,517,520,522],{"class":377,"line":472},6,[375,474,476],{"class":475},"swJcz","    credentials",[375,478,479],{"class":385},":",[375,481,482],{"class":385}," new",[375,484,390],{"class":446},[375,486,466],{"class":389},[375,488,489],{"class":385},"'",[375,491,492],{"class":408},"user@example.com",[375,494,489],{"class":385},[375,496,393],{"class":385},[375,498,405],{"class":385},[375,500,501],{"class":408},"password",[375,503,489],{"class":385},[375,505,393],{"class":385},[375,507,405],{"class":385},[375,509,510],{"class":408},"my-organization",[375,512,489],{"class":385},[375,514,393],{"class":385},[375,516,405],{"class":385},[375,518,519],{"class":408},"my-application",[375,521,489],{"class":385},[375,523,524],{"class":389},")\n",[375,526,528,531],{"class":377,"line":527},7,[375,529,530],{"class":385},"}",[375,532,524],{"class":389},[219,534,535,536,539,540,542,543,545],{},"The constructor is ",[248,537,538],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[248,541,355],{}," is your user's email and ",[248,544,359],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[219,547,548,549,552,553,556,557,560,561,564,565,560,568,571,572,575,576,579,580,583],{},"With no ",[248,550,551],{},"credentials"," at all, ",[248,554,555],{},"Kinotic.connect()"," resolves through the default chain: the ",[248,558,559],{},"KINOTIC_CLIENT_ID"," \u002F ",[248,562,563],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[248,566,567],{},"KINOTIC_ORGANIZATION_ID",[248,569,570],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[248,573,574],{},"server"," option, the ",[248,577,578],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then ",[248,581,582],{},"https:\u002F\u002Fapi.kinotic.ai",". To pin the server explicitly, pass it alongside the credentials:",[366,585,587],{"className":368,"code":586,"language":370,"meta":371,"style":371},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[248,588,589,603,638,682],{"__ignoreMap":371},[375,590,591,593,595,597,599,601],{"class":377,"line":378},[375,592,456],{"class":381},[375,594,396],{"class":389},[375,596,258],{"class":385},[375,598,463],{"class":446},[375,600,466],{"class":389},[375,602,469],{"class":385},[375,604,605,608,610,612,615,617,619,622,624,626,629,631,635],{"class":377,"line":415},[375,606,607],{"class":475},"    server",[375,609,479],{"class":385},[375,611,386],{"class":385},[375,613,614],{"class":475}," host",[375,616,479],{"class":385},[375,618,405],{"class":385},[375,620,621],{"class":408},"kinotic.example.com",[375,623,489],{"class":385},[375,625,393],{"class":385},[375,627,628],{"class":475}," useSSL",[375,630,479],{"class":385},[375,632,634],{"class":633},"sfNiH"," true",[375,636,637],{"class":385}," },\n",[375,639,640,642,644,646,648,650,652,654,656,658,660,662,664,666,668,670,672,674,676,678,680],{"class":377,"line":436},[375,641,476],{"class":475},[375,643,479],{"class":385},[375,645,482],{"class":385},[375,647,390],{"class":446},[375,649,466],{"class":389},[375,651,489],{"class":385},[375,653,492],{"class":408},[375,655,489],{"class":385},[375,657,393],{"class":385},[375,659,405],{"class":385},[375,661,501],{"class":408},[375,663,489],{"class":385},[375,665,393],{"class":385},[375,667,405],{"class":385},[375,669,510],{"class":408},[375,671,489],{"class":385},[375,673,393],{"class":385},[375,675,405],{"class":385},[375,677,519],{"class":408},[375,679,489],{"class":385},[375,681,524],{"class":389},[375,683,684,686],{"class":377,"line":443},[375,685,530],{"class":385},[375,687,524],{"class":389},[219,689,690,691,693,694,697,698,258],{},"Absent ",[248,692,574],{}," fields fall through to the environment — ",[248,695,696],{},"{ host }"," alone means no TLS and the gateway port ",[248,699,700],{},"58503",[215,702,704],{"id":703},"connecting-with-oidc","Connecting with OIDC",[219,706,707,708,711,712,715],{},"For token-based authentication, pass a Bearer token via ",[248,709,710],{},"BearerCredentialsResolver",". The resolver sends ",[248,713,714],{},"Authorization: Bearer \u003Ctoken>"," on every (re)connect; pass a supplier function to refresh a short-lived token before each connect:",[366,717,719],{"className":368,"code":718,"language":370,"meta":371,"style":371},"import { BearerCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BearerCredentialsResolver(async () => await getToken())\n})\n",[248,720,721,744,762,766,772,786,817],{"__ignoreMap":371},[375,722,723,725,727,730,732,734,736,738,740,742],{"class":377,"line":378},[375,724,382],{"class":381},[375,726,386],{"class":385},[375,728,729],{"class":389}," BearerCredentialsResolver",[375,731,393],{"class":385},[375,733,396],{"class":389},[375,735,399],{"class":385},[375,737,402],{"class":381},[375,739,405],{"class":385},[375,741,409],{"class":408},[375,743,412],{"class":385},[375,745,746,748,750,752,754,756,758,760],{"class":377,"line":415},[375,747,382],{"class":381},[375,749,386],{"class":385},[375,751,422],{"class":389},[375,753,399],{"class":385},[375,755,402],{"class":381},[375,757,405],{"class":385},[375,759,431],{"class":408},[375,761,412],{"class":385},[375,763,764],{"class":377,"line":436},[375,765,440],{"emptyLinePlaceholder":439},[375,767,768,770],{"class":377,"line":443},[375,769,447],{"class":446},[375,771,450],{"class":389},[375,773,774,776,778,780,782,784],{"class":377,"line":453},[375,775,456],{"class":381},[375,777,396],{"class":389},[375,779,258],{"class":385},[375,781,463],{"class":446},[375,783,466],{"class":389},[375,785,469],{"class":385},[375,787,788,790,792,794,796,798,802,805,808,811,814],{"class":377,"line":472},[375,789,476],{"class":475},[375,791,479],{"class":385},[375,793,482],{"class":385},[375,795,729],{"class":446},[375,797,466],{"class":389},[375,799,801],{"class":800},"spNyl","async",[375,803,804],{"class":385}," ()",[375,806,807],{"class":800}," =>",[375,809,810],{"class":381}," await",[375,812,813],{"class":446}," getToken",[375,815,816],{"class":389},"())\n",[375,818,819,821],{"class":377,"line":527},[375,820,530],{"class":385},[375,822,524],{"class":389},[219,824,825,826,560,828,830],{},"A Kinotic-minted JWT already carries the ",[248,827,288],{},[248,829,293],{}," claims, so no scope headers are needed alongside it. The platform validates the JWT against the OIDC configurations enabled for your application, matches the token's email to a pre-existing user in your application's scope, and establishes a session.",[223,832,834],{"id":833},"browser-applications","Browser applications",[219,836,837,838,841],{},"A browser SPA does ",[234,839,840],{},"not"," supply credentials. It logs in through the OIDC\u002FREST flow, which establishes a session cookie, then connects with nothing — the default resolution finds the session, and the server settings come from the page's own location:",[366,843,845],{"className":368,"code":844,"language":370,"meta":371,"style":371},"import { Kinotic } from '@kinotic-ai\u002Fcore'\n\nawait Kinotic.connect()\n",[248,846,847,865,869],{"__ignoreMap":371},[375,848,849,851,853,855,857,859,861,863],{"class":377,"line":378},[375,850,382],{"class":381},[375,852,386],{"class":385},[375,854,396],{"class":389},[375,856,399],{"class":385},[375,858,402],{"class":381},[375,860,405],{"class":385},[375,862,409],{"class":408},[375,864,412],{"class":385},[375,866,867],{"class":377,"line":415},[375,868,440],{"emptyLinePlaceholder":439},[375,870,871,873,875,877,879],{"class":377,"line":436},[375,872,456],{"class":381},[375,874,396],{"class":389},[375,876,258],{"class":385},[375,878,463],{"class":446},[375,880,450],{"class":389},[223,882,884],{"id":883},"how-oidc-works-with-your-application","How OIDC Works with Your Application",[886,887,888,891,894,897,905],"ol",{},[231,889,890],{},"Your platform administrator enables one or more OIDC configurations for your application (e.g., Google, Microsoft)",[231,892,893],{},"Your frontend initiates the OAuth flow with the provider — the user sees the provider's consent screen",[231,895,896],{},"The provider returns a JWT to your frontend",[231,898,899,900,560,902,904],{},"Your frontend connects to Kinotic — in the browser via the session cookie established by the REST login; the Kinotic-minted JWT carries the ",[248,901,288],{},[248,903,293],{}," claims that identify the scope",[231,906,907],{},"The platform validates the token, looks up the user, and creates a session",[223,909,911],{"id":910},"reusable-providers","Reusable Providers",[219,913,914,915,917,918,921],{},"Kinotic OS registers once with providers like Google and Microsoft. The platform operator provisions these as ",[248,916,250],{}," entities; your organization admin enables them for your application by adding the configuration id to your application's ",[248,919,920],{},"oidcConfigurationIds",". End users see \"Kinotic OS\" on the consent screen, and your application benefits without any provider registration.",[219,923,924,925,927,928,930],{},"The same ",[248,926,250],{}," shape is used for an organization's enterprise SSO (e.g. a corporate Okta instance) — see ",[253,929,167],{"href":168}," for how the platform-vs-org distinction is captured by reference rather than by a flag on the entity.",[215,932,934],{"id":933},"user-management","User Management",[219,936,937,938,941,942,945],{},"Application-scope users are ",[234,939,940],{},"pre-created"," by an administrator before they can authenticate. This is a deliberate security design — having a valid Google account does not automatically grant access to your application. Self-service signup applies to the ",[253,943,944],{"href":163},"Organization scope"," (the admin who runs the org); the same data model supports application-scope self-signup, but enabling it is admin-controlled.",[219,947,948,949,952],{},"Your organization administrator manages your application's users from the organization's ",[234,950,951],{},"Members"," page:",[228,954,955,961],{},[231,956,957,960],{},[234,958,959],{},"Local users"," are created with an email and password",[231,962,963,966],{},[234,964,965],{},"OIDC users"," are created with an email only — the OIDC subject is linked automatically on first login",[219,968,969,970,972],{},"For details on user and OIDC configuration management, see the ",[253,971,162],{"href":163}," platform guide.",[974,975,976],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFF