tform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"id":224,"title":98,"body":225,"description":1004,"extension":1005,"links":1006,"meta":1007,"navigation":1008,"path":99,"seo":1009,"stem":100,"__hash__":1010},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":226,"value":227,"toc":991},"minimark",[228,232,236,241,258,273,277,288,350,356,360,379,547,560,598,702,715,719,730,837,845,849,856,895,899,922,926,936,945,949,960,967,981,987],[229,230,25],"h2",{"id":231},"overview",[233,234,235],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[237,238,240],"h3",{"id":239},"authentication-methods","Authentication Methods",[242,243,244,252],"ul",{},[245,246,247,251],"li",{},[248,249,250],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[245,253,254,257],{},[248,255,256],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including platform-provided social providers pre-registered with Kinotic OS.",[233,259,260,261,265,266,269,270,272],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[262,263,264],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[267,268,167],"a",{"href":168}," and ",[267,271,162],{"href":163},".",[237,274,276],{"id":275},"scoped-authentication","Scoped Authentication",[233,278,279,280,283,284,287],{},"Authentication happens at the ",[248,281,282],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[248,285,286],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[289,290,291,311],"table",{},[292,293,294],"thead",{},[295,296,297,303,308],"tr",{},[298,299,300],"th",{},[262,301,302],{},"organizationId",[298,304,305],{},[262,306,307],{},"applicationId",[298,309,310],{},"Resulting scope",[312,313,314,327,339],"tbody",{},[295,315,316,320,322],{},[317,318,319],"td",{},"absent",[317,321,319],{},[317,323,324],{},[262,325,326],{},"SYSTEM",[295,328,329,332,334],{},[317,330,331],{},"present",[317,333,319],{},[317,335,336],{},[262,337,338],{},"ORGANIZATION",[295,340,341,343,345],{},[317,342,331],{},[317,344,331],{},[317,346,347],{},[262,348,349],{},"APPLICATION",[233,351,352,353,355],{},"For application developers this is always the ",[262,354,349],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[229,357,359],{"id":358},"connecting-with-email-and-password","Connecting with Email and Password",[233,361,362,363,366,367,370,371,370,374,370,376,378],{},"In Node, pass a ",[262,364,365],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[262,368,369],{},"clientId",", ",[262,372,373],{},"clientSecret",[262,375,302],{},[262,377,307],{},"); they are presented as headers on the WebSocket upgrade:",[380,381,386],"pre",{"className":382,"code":383,"language":384,"meta":385,"style":385},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[262,387,388,427,448,455,465,484,539],{"__ignoreMap":385},[389,390,393,397,401,405,408,411,414,417,420,424],"span",{"class":391,"line":392},"line",1,[389,394,396],{"class":395},"s7zQu","import",[389,398,400],{"class":399},"sMK4o"," {",[389,402,404],{"class":403},"sTEyZ"," BasicCredentialsResolver",[389,406,407],{"class":399},",",[389,409,410],{"class":403}," Kinotic",[389,412,413],{"class":399}," }",[389,415,416],{"class":395}," from",[389,418,419],{"class":399}," '",[389,421,423],{"class":422},"sfazB","@kinotic-ai\u002Fcore",[389,425,426],{"class":399},"'\n",[389,428,430,432,434,437,439,441,443,446],{"class":391,"line":429},2,[389,431,396],{"class":395},[389,433,400],{"class":399},[389,435,436],{"class":403}," ensureNodeWebSocket",[389,438,413],{"class":399},[389,440,416],{"class":395},[389,442,419],{"class":399},[389,444,445],{"class":422},"@kinotic-ai\u002Fcore\u002Fnode",[389,447,426],{"class":399},[389,449,451],{"class":391,"line":450},3,[389,452,454],{"emptyLinePlaceholder":453},true,"\n",[389,456,458,462],{"class":391,"line":457},4,[389,459,461],{"class":460},"s2Zo4","ensureNodeWebSocket",[389,463,464],{"class":403},"()\n",[389,466,468,471,473,475,478,481],{"class":391,"line":467},5,[389,469,470],{"class":395},"await",[389,472,410],{"class":403},[389,474,272],{"class":399},[389,476,477],{"class":460},"connect",[389,479,480],{"class":403},"(",[389,482,483],{"class":399},"{\n",[389,485,487,491,494,497,499,501,504,507,509,511,513,516,518,520,522,525,527,529,531,534,536],{"class":391,"line":486},6,[389,488,490],{"class":489},"swJcz","    credentials",[389,492,493],{"class":399},":",[389,495,496],{"class":399}," new",[389,498,404],{"class":460},[389,500,480],{"class":403},[389,502,503],{"class":399},"'",[389,505,506],{"class":422},"user@example.com",[389,508,503],{"class":399},[389,510,407],{"class":399},[389,512,419],{"class":399},[389,514,515],{"class":422},"password",[389,517,503],{"class":399},[389,519,407],{"class":399},[389,521,419],{"class":399},[389,523,524],{"class":422},"my-organization",[389,526,503],{"class":399},[389,528,407],{"class":399},[389,530,419],{"class":399},[389,532,533],{"class":422},"my-application",[389,535,503],{"class":399},[389,537,538],{"class":403},")\n",[389,540,542,545],{"class":391,"line":541},7,[389,543,544],{"class":399},"}",[389,546,538],{"class":403},[233,548,549,550,553,554,556,557,559],{},"The constructor is ",[262,551,552],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[262,555,369],{}," is your user's email and ",[262,558,373],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[233,561,562,563,566,567,570,571,574,575,578,579,574,582,585,586,589,590,593,594,597],{},"With no ",[262,564,565],{},"credentials"," at all, ",[262,568,569],{},"Kinotic.connect()"," resolves through the default chain: the ",[262,572,573],{},"KINOTIC_CLIENT_ID"," \u002F ",[262,576,577],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[262,580,581],{},"KINOTIC_ORGANIZATION_ID",[262,583,584],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[262,587,588],{},"server"," option, the ",[262,591,592],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then ",[262,595,596],{},"https:\u002F\u002Fapi.kinotic.ai",". To pin the server explicitly, pass it alongside the credentials:",[380,599,601],{"className":382,"code":600,"language":384,"meta":385,"style":385},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[262,602,603,617,652,696],{"__ignoreMap":385},[389,604,605,607,609,611,613,615],{"class":391,"line":392},[389,606,470],{"class":395},[389,608,410],{"class":403},[389,610,272],{"class":399},[389,612,477],{"class":460},[389,614,480],{"class":403},[389,616,483],{"class":399},[389,618,619,622,624,626,629,631,633,636,638,640,643,645,649],{"class":391,"line":429},[389,620,621],{"class":489},"    server",[389,623,493],{"class":399},[389,625,400],{"class":399},[389,627,628],{"class":489}," host",[389,630,493],{"class":399},[389,632,419],{"class":399},[389,634,635],{"class":422},"kinotic.example.com",[389,637,503],{"class":399},[389,639,407],{"class":399},[389,641,642],{"class":489}," useSSL",[389,644,493],{"class":399},[389,646,648],{"class":647},"sfNiH"," true",[389,650,651],{"class":399}," },\n",[389,653,654,656,658,660,662,664,666,668,670,672,674,676,678,680,682,684,686,688,690,692,694],{"class":391,"line":450},[389,655,490],{"class":489},[389,657,493],{"class":399},[389,659,496],{"class":399},[389,661,404],{"class":460},[389,663,480],{"class":403},[389,665,503],{"class":399},[389,667,506],{"class":422},[389,669,503],{"class":399},[389,671,407],{"class":399},[389,673,419],{"class":399},[389,675,515],{"class":422},[389,677,503],{"class":399},[389,679,407],{"class":399},[389,681,419],{"class":399},[389,683,524],{"class":422},[389,685,503],{"class":399},[389,687,407],{"class":399},[389,689,419],{"class":399},[389,691,533],{"class":422},[389,693,503],{"class":399},[389,695,538],{"class":403},[389,697,698,700],{"class":391,"line":457},[389,699,544],{"class":399},[389,701,538],{"class":403},[233,703,704,705,707,708,711,712,272],{},"Absent ",[262,706,588],{}," fields fall through to the environment — ",[262,709,710],{},"{ host }"," alone means no TLS and the gateway port ",[262,713,714],{},"58503",[229,716,718],{"id":717},"connecting-with-oidc","Connecting with OIDC",[233,720,721,722,725,726,729],{},"For token-based authentication, pass a Bearer token via ",[262,723,724],{},"BearerCredentialsResolver",". The resolver sends ",[262,727,728],{},"Authorization: Bearer \u003Ctoken>"," on every (re)connect; pass a supplier function to refresh a short-lived token before each connect:",[380,731,733],{"className":382,"code":732,"language":384,"meta":385,"style":385},"import { BearerCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BearerCredentialsResolver(async () => await getToken())\n})\n",[262,734,735,758,776,780,786,800,831],{"__ignoreMap":385},[389,736,737,739,741,744,746,748,750,752,754,756],{"class":391,"line":392},[389,738,396],{"class":395},[389,740,400],{"class":399},[389,742,743],{"class":403}," BearerCredentialsResolver",[389,745,407],{"class":399},[389,747,410],{"class":403},[389,749,413],{"class":399},[389,751,416],{"class":395},[389,753,419],{"class":399},[389,755,423],{"class":422},[389,757,426],{"class":399},[389,759,760,762,764,766,768,770,772,774],{"class":391,"line":429},[389,761,396],{"class":395},[389,763,400],{"class":399},[389,765,436],{"class":403},[389,767,413],{"class":399},[389,769,416],{"class":395},[389,771,419],{"class":399},[389,773,445],{"class":422},[389,775,426],{"class":399},[389,777,778],{"class":391,"line":450},[389,779,454],{"emptyLinePlaceholder":453},[389,781,782,784],{"class":391,"line":457},[389,783,461],{"class":460},[389,785,464],{"class":403},[389,787,788,790,792,794,796,798],{"class":391,"line":467},[389,789,470],{"class":395},[389,791,410],{"class":403},[389,793,272],{"class":399},[389,795,477],{"class":460},[389,797,480],{"class":403},[389,799,483],{"class":399},[389,801,802,804,806,808,810,812,816,819,822,825,828],{"class":391,"line":486},[389,803,490],{"class":489},[389,805,493],{"class":399},[389,807,496],{"class":399},[389,809,743],{"class":460},[389,811,480],{"class":403},[389,813,815],{"class":814},"spNyl","async",[389,817,818],{"class":399}," ()",[389,820,821],{"class":814}," =>",[389,823,824],{"class":395}," await",[389,826,827],{"class":460}," getToken",[389,829,830],{"class":403},"())\n",[389,832,833,835],{"class":391,"line":541},[389,834,544],{"class":399},[389,836,538],{"class":403},[233,838,839,840,574,842,844],{},"A Kinotic-minted JWT already carries the ",[262,841,302],{},[262,843,307],{}," claims, so no scope headers are needed alongside it. The platform validates the JWT against the OIDC configurations enabled for your application, matches the token's email to a pre-existing user in your application's scope, and establishes a session.",[237,846,848],{"id":847},"browser-applications","Browser applications",[233,850,851,852,855],{},"A browser SPA does ",[248,853,854],{},"not"," supply credentials. It logs in through the OIDC\u002FREST flow, which establishes a session cookie, then connects with nothing — the default resolution finds the session, and the server settings come from the page's own location:",[380,857,859],{"className":382,"code":858,"language":384,"meta":385,"style":385},"import { Kinotic } from '@kinotic-ai\u002Fcore'\n\nawait Kinotic.connect()\n",[262,860,861,879,883],{"__ignoreMap":385},[389,862,863,865,867,869,871,873,875,877],{"class":391,"line":392},[389,864,396],{"class":395},[389,866,400],{"class":399},[389,868,410],{"class":403},[389,870,413],{"class":399},[389,872,416],{"class":395},[389,874,419],{"class":399},[389,876,423],{"class":422},[389,878,426],{"class":399},[389,880,881],{"class":391,"line":429},[389,882,454],{"emptyLinePlaceholder":453},[389,884,885,887,889,891,893],{"class":391,"line":450},[389,886,470],{"class":395},[389,888,410],{"class":403},[389,890,272],{"class":399},[389,892,477],{"class":460},[389,894,464],{"class":403},[237,896,898],{"id":897},"how-oidc-works-with-your-application","How OIDC Works with Your Application",[900,901,902,905,908,911,919],"ol",{},[245,903,904],{},"Your platform administrator enables one or more OIDC configurations for your application (e.g., Google, Microsoft)",[245,906,907],{},"Your frontend initiates the OAuth flow with the provider — the user sees the provider's consent screen",[245,909,910],{},"The provider returns a JWT to your frontend",[245,912,913,914,574,916,918],{},"Your frontend connects to Kinotic — in the browser via the session cookie established by the REST login; the Kinotic-minted JWT carries the ",[262,915,302],{},[262,917,307],{}," claims that identify the scope",[245,920,921],{},"The platform validates the token, looks up the user, and creates a session",[237,923,925],{"id":924},"reusable-providers","Reusable Providers",[233,927,928,929,931,932,935],{},"Kinotic OS registers once with providers like Google and Microsoft. The platform operator provisions these as ",[262,930,264],{}," entities; your organization admin enables them for your application by adding the configuration id to your application's ",[262,933,934],{},"oidcConfigurationIds",". End users see \"Kinotic OS\" on the consent screen, and your application benefits without any provider registration.",[233,937,938,939,941,942,944],{},"The same ",[262,940,264],{}," shape is used for an organization's enterprise SSO (e.g. a corporate Okta instance) — see ",[267,943,167],{"href":168}," for how the platform-vs-org distinction is captured by reference rather than by a flag on the entity.",[229,946,948],{"id":947},"user-management","User Management",[233,950,951,952,955,956,959],{},"Application-scope users are ",[248,953,954],{},"pre-created"," by an administrator before they can authenticate. This is a deliberate security design — having a valid Google account does not automatically grant access to your application. Self-service signup applies to the ",[267,957,958],{"href":163},"Organization scope"," (the admin who runs the org); the same data model supports application-scope self-signup, but enabling it is admin-controlled.",[233,961,962,963,966],{},"Your organization administrator manages your application's users from the organization's ",[248,964,965],{},"Members"," page:",[242,968,969,975],{},[245,970,971,974],{},[248,972,973],{},"Local users"," are created with an email and password",[245,976,977,980],{},[248,978,979],{},"OIDC users"," are created with an email only — the OIDC subject is linked automatically on first login",[233,982,983,984,986],{},"For details on user and OIDC configuration management, see the ",[267,985,162],{"href":163}," platform guide.",[988,989,990],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}",{"title":385,"searchDepth":429,"depth":429,"links":992},[993,997,998,1003],{"id":231,"depth":429,"text":25,"children":994},[995,996],{"id":239,"depth":450,"text":240},{"id":275,"depth":450,"text":276},{"id":358,"depth":429,"text":359},{"id":717,"depth":429,"text":718,"children":999},[1000,1001,1002],{"id":847,"depth":450,"text":848},{"id":897,"depth":450,"text":898},{"id":924,"depth":450,"text":925},{"id":947,"depth":429,"text":948},"Authentication methods and identity management in Kinotic.","md",null,{},{"icon":101},{"title":98,"description":1004},"KTHmi0lMm0mZb3Et6xDYrikKMOu3j2k4FAqGvJvs4bs",[1012,1014],{"title":88,"path":89,"stem":90,"description":1013,"children":-1},"Schema evolution using versioned migration scripts for Kinotic's persistence layer.",{"title":109,"path":110,"stem":111,"description":1015,"icon":112,"children":-1},"The Kinotic deployment pipeline from development to production.",1789507130939]