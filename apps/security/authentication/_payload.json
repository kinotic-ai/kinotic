02Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":128,"icon":129,"path":196,"stem":197,"children":198,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[199,204,209],{"title":200,"path":201,"stem":202,"icon":203},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"title":205,"path":206,"stem":207,"icon":208},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F11.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":210,"path":211,"stem":212,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F11.reference\u002F03.project-publishing-design",{"id":214,"title":98,"body":215,"description":994,"extension":995,"links":996,"meta":997,"navigation":998,"path":99,"seo":999,"stem":100,"__hash__":1000},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":216,"value":217,"toc":981},"minimark",[218,222,226,231,248,263,267,278,340,346,350,369,537,550,588,692,705,709,720,827,835,839,846,885,889,912,916,926,935,939,950,957,971,977],[219,220,25],"h2",{"id":221},"overview",[223,224,225],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[227,228,230],"h3",{"id":229},"authentication-methods","Authentication Methods",[232,233,234,242],"ul",{},[235,236,237,241],"li",{},[238,239,240],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[235,243,244,247],{},[238,245,246],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including platform-provided social providers pre-registered with Kinotic OS.",[223,249,250,251,255,256,259,260,262],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[252,253,254],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[257,258,167],"a",{"href":168}," and ",[257,261,162],{"href":163},".",[227,264,266],{"id":265},"scoped-authentication","Scoped Authentication",[223,268,269,270,273,274,277],{},"Authentication happens at the ",[238,271,272],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[238,275,276],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[279,280,281,301],"table",{},[282,283,284],"thead",{},[285,286,287,293,298],"tr",{},[288,289,290],"th",{},[252,291,292],{},"organizationId",[288,294,295],{},[252,296,297],{},"applicationId",[288,299,300],{},"Resulting scope",[302,303,304,317,329],"tbody",{},[285,305,306,310,312],{},[307,308,309],"td",{},"absent",[307,311,309],{},[307,313,314],{},[252,315,316],{},"SYSTEM",[285,318,319,322,324],{},[307,320,321],{},"present",[307,323,309],{},[307,325,326],{},[252,327,328],{},"ORGANIZATION",[285,330,331,333,335],{},[307,332,321],{},[307,334,321],{},[307,336,337],{},[252,338,339],{},"APPLICATION",[223,341,342,343,345],{},"For application developers this is always the ",[252,344,339],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[219,347,349],{"id":348},"connecting-with-email-and-password","Connecting with Email and Password",[223,351,352,353,356,357,360,361,360,364,360,366,368],{},"In Node, pass a ",[252,354,355],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[252,358,359],{},"clientId",", ",[252,362,363],{},"clientSecret",[252,365,292],{},[252,367,297],{},"); they are presented as headers on the WebSocket upgrade:",[370,371,376],"pre",{"className":372,"code":373,"language":374,"meta":375,"style":375},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[252,377,378,417,438,445,455,474,529],{"__ignoreMap":375},[379,380,383,387,391,395,398,401,404,407,410,414],"span",{"class":381,"line":382},"line",1,[379,384,386],{"class":385},"s7zQu","import",[379,388,390],{"class":389},"sMK4o"," {",[379,392,394],{"class":393},"sTEyZ"," BasicCredentialsResolver",[379,396,397],{"class":389},",",[379,399,400],{"class":393}," Kinotic",[379,402,403],{"class":389}," }",[379,405,406],{"class":385}," from",[379,408,409],{"class":389}," '",[379,411,413],{"class":412},"sfazB","@kinotic-ai\u002Fcore",[379,415,416],{"class":389},"'\n",[379,418,420,422,424,427,429,431,433,436],{"class":381,"line":419},2,[379,421,386],{"class":385},[379,423,390],{"class":389},[379,425,426],{"class":393}," ensureNodeWebSocket",[379,428,403],{"class":389},[379,430,406],{"class":385},[379,432,409],{"class":389},[379,434,435],{"class":412},"@kinotic-ai\u002Fcore\u002Fnode",[379,437,416],{"class":389},[379,439,441],{"class":381,"line":440},3,[379,442,444],{"emptyLinePlaceholder":443},true,"\n",[379,446,448,452],{"class":381,"line":447},4,[379,449,451],{"class":450},"s2Zo4","ensureNodeWebSocket",[379,453,454],{"class":393},"()\n",[379,456,458,461,463,465,468,471],{"class":381,"line":457},5,[379,459,460],{"class":385},"await",[379,462,400],{"class":393},[379,464,262],{"class":389},[379,466,467],{"class":450},"connect",[379,469,470],{"class":393},"(",[379,472,473],{"class":389},"{\n",[379,475,477,481,484,487,489,491,494,497,499,501,503,506,508,510,512,515,517,519,521,524,526],{"class":381,"line":476},6,[379,478,480],{"class":479},"swJcz","    credentials",[379,482,483],{"class":389},":",[379,485,486],{"class":389}," new",[379,488,394],{"class":450},[379,490,470],{"class":393},[379,492,493],{"class":389},"'",[379,495,496],{"class":412},"user@example.com",[379,498,493],{"class":389},[379,500,397],{"class":389},[379,502,409],{"class":389},[379,504,505],{"class":412},"password",[379,507,493],{"class":389},[379,509,397],{"class":389},[379,511,409],{"class":389},[379,513,514],{"class":412},"my-organization",[379,516,493],{"class":389},[379,518,397],{"class":389},[379,520,409],{"class":389},[379,522,523],{"class":412},"my-application",[379,525,493],{"class":389},[379,527,528],{"class":393},")\n",[379,530,532,535],{"class":381,"line":531},7,[379,533,534],{"class":389},"}",[379,536,528],{"class":393},[223,538,539,540,543,544,546,547,549],{},"The constructor is ",[252,541,542],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[252,545,359],{}," is your user's email and ",[252,548,363],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[223,551,552,553,556,557,560,561,564,565,568,569,564,572,575,576,579,580,583,584,587],{},"With no ",[252,554,555],{},"credentials"," at all, ",[252,558,559],{},"Kinotic.connect()"," resolves through the default chain: the ",[252,562,563],{},"KINOTIC_CLIENT_ID"," \u002F ",[252,566,567],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[252,570,571],{},"KINOTIC_ORGANIZATION_ID",[252,573,574],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[252,577,578],{},"server"," option, the ",[252,581,582],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then ",[252,585,586],{},"https:\u002F\u002Fapi.kinotic.ai",". To pin the server explicitly, pass it alongside the credentials:",[370,589,591],{"className":372,"code":590,"language":374,"meta":375,"style":375},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[252,592,593,607,642,686],{"__ignoreMap":375},[379,594,595,597,599,601,603,605],{"class":381,"line":382},[379,596,460],{"class":385},[379,598,400],{"class":393},[379,600,262],{"class":389},[379,602,467],{"class":450},[379,604,470],{"class":393},[379,606,473],{"class":389},[379,608,609,612,614,616,619,621,623,626,628,630,633,635,639],{"class":381,"line":419},[379,610,611],{"class":479},"    server",[379,613,483],{"class":389},[379,615,390],{"class":389},[379,617,618],{"class":479}," host",[379,620,483],{"class":389},[379,622,409],{"class":389},[379,624,625],{"class":412},"kinotic.example.com",[379,627,493],{"class":389},[379,629,397],{"class":389},[379,631,632],{"class":479}," useSSL",[379,634,483],{"class":389},[379,636,638],{"class":637},"sfNiH"," true",[379,640,641],{"class":389}," },\n",[379,643,644,646,648,650,652,654,656,658,660,662,664,666,668,670,672,674,676,678,680,682,684],{"class":381,"line":440},[379,645,480],{"class":479},[379,647,483],{"class":389},[379,649,486],{"class":389},[379,651,394],{"class":450},[379,653,470],{"class":393},[379,655,493],{"class":389},[379,657,496],{"class":412},[379,659,493],{"class":389},[379,661,397],{"class":389},[379,663,409],{"class":389},[379,665,505],{"class":412},[379,667,493],{"class":389},[379,669,397],{"class":389},[379,671,409],{"class":389},[379,673,514],{"class":412},[379,675,493],{"class":389},[379,677,397],{"class":389},[379,679,409],{"class":389},[379,681,523],{"class":412},[379,683,493],{"class":389},[379,685,528],{"class":393},[379,687,688,690],{"class":381,"line":447},[379,689,534],{"class":389},[379,691,528],{"class":393},[223,693,694,695,697,698,701,702,262],{},"Absent ",[252,696,578],{}," fields fall through to the environment — ",[252,699,700],{},"{ host }"," alone means no TLS and the gateway port ",[252,703,704],{},"58503",[219,706,708],{"id":707},"connecting-with-oidc","Connecting with OIDC",[223,710,711,712,715,716,719],{},"For token-based authentication, pass a Bearer token via ",[252,713,714],{},"BearerCredentialsResolver",". The resolver sends ",[252,717,718],{},"Authorization: Bearer \u003Ctoken>"," on every (re)connect; pass a supplier function to refresh a short-lived token before each connect:",[370,721,723],{"className":372,"code":722,"language":374,"meta":375,"style":375},"import { BearerCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BearerCredentialsResolver(async () => await getToken())\n})\n",[252,724,725,748,766,770,776,790,821],{"__ignoreMap":375},[379,726,727,729,731,734,736,738,740,742,744,746],{"class":381,"line":382},[379,728,386],{"class":385},[379,730,390],{"class":389},[379,732,733],{"class":393}," BearerCredentialsResolver",[379,735,397],{"class":389},[379,737,400],{"class":393},[379,739,403],{"class":389},[379,741,406],{"class":385},[379,743,409],{"class":389},[379,745,413],{"class":412},[379,747,416],{"class":389},[379,749,750,752,754,756,758,760,762,764],{"class":381,"line":419},[379,751,386],{"class":385},[379,753,390],{"class":389},[379,755,426],{"class":393},[379,757,403],{"class":389},[379,759,406],{"class":385},[379,761,409],{"class":389},[379,763,435],{"class":412},[379,765,416],{"class":389},[379,767,768],{"class":381,"line":440},[379,769,444],{"emptyLinePlaceholder":443},[379,771,772,774],{"class":381,"line":447},[379,773,451],{"class":450},[379,775,454],{"class":393},[379,777,778,780,782,784,786,788],{"class":381,"line":457},[379,779,460],{"class":385},[379,781,400],{"class":393},[379,783,262],{"class":389},[379,785,467],{"class":450},[379,787,470],{"class":393},[379,789,473],{"class":389},[379,791,792,794,796,798,800,802,806,809,812,815,818],{"class":381,"line":476},[379,793,480],{"class":479},[379,795,483],{"class":389},[379,797,486],{"class":389},[379,799,733],{"class":450},[379,801,470],{"class":393},[379,803,805],{"class":804},"spNyl","async",[379,807,808],{"class":389}," ()",[379,810,811],{"class":804}," =>",[379,813,814],{"class":385}," await",[379,816,817],{"class":450}," getToken",[379,819,820],{"class":393},"())\n",[379,822,823,825],{"class":381,"line":531},[379,824,534],{"class":389},[379,826,528],{"class":393},[223,828,829,830,564,832,834],{},"A Kinotic-minted JWT already carries the ",[252,831,292],{},[252,833,297],{}," claims, so no scope headers are needed alongside it. The platform validates the JWT against the OIDC configurations enabled for your application, matches the token's email to a pre-existing user in your application's scope, and establishes a session.",[227,836,838],{"id":837},"browser-applications","Browser applications",[223,840,841,842,845],{},"A browser SPA does ",[238,843,844],{},"not"," supply credentials. It logs in through the OIDC\u002FREST flow, which establishes a session cookie, then connects with nothing — the default resolution finds the session, and the server settings come from the page's own location:",[370,847,849],{"className":372,"code":848,"language":374,"meta":375,"style":375},"import { Kinotic } from '@kinotic-ai\u002Fcore'\n\nawait Kinotic.connect()\n",[252,850,851,869,873],{"__ignoreMap":375},[379,852,853,855,857,859,861,863,865,867],{"class":381,"line":382},[379,854,386],{"class":385},[379,856,390],{"class":389},[379,858,400],{"class":393},[379,860,403],{"class":389},[379,862,406],{"class":385},[379,864,409],{"class":389},[379,866,413],{"class":412},[379,868,416],{"class":389},[379,870,871],{"class":381,"line":419},[379,872,444],{"emptyLinePlaceholder":443},[379,874,875,877,879,881,883],{"class":381,"line":440},[379,876,460],{"class":385},[379,878,400],{"class":393},[379,880,262],{"class":389},[379,882,467],{"class":450},[379,884,454],{"class":393},[227,886,888],{"id":887},"how-oidc-works-with-your-application","How OIDC Works with Your Application",[890,891,892,895,898,901,909],"ol",{},[235,893,894],{},"Your platform administrator enables one or more OIDC configurations for your application (e.g., Google, Microsoft)",[235,896,897],{},"Your frontend initiates the OAuth flow with the provider — the user sees the provider's consent screen",[235,899,900],{},"The provider returns a JWT to your frontend",[235,902,903,904,564,906,908],{},"Your frontend connects to Kinotic — in the browser via the session cookie established by the REST login; the Kinotic-minted JWT carries the ",[252,905,292],{},[252,907,297],{}," claims that identify the scope",[235,910,911],{},"The platform validates the token, looks up the user, and creates a session",[227,913,915],{"id":914},"reusable-providers","Reusable Providers",[223,917,918,919,921,922,925],{},"Kinotic OS registers once with providers like Google and Microsoft. The platform operator provisions these as ",[252,920,254],{}," entities; your organization admin enables them for your application by adding the configuration id to your application's ",[252,923,924],{},"oidcConfigurationIds",". End users see \"Kinotic OS\" on the consent screen, and your application benefits without any provider registration.",[223,927,928,929,931,932,934],{},"The same ",[252,930,254],{}," shape is used for an organization's enterprise SSO (e.g. a corporate Okta instance) — see ",[257,933,167],{"href":168}," for how the platform-vs-org distinction is captured by reference rather than by a flag on the entity.",[219,936,938],{"id":937},"user-management","User Management",[223,940,941,942,945,946,949],{},"Application-scope users are ",[238,943,944],{},"pre-created"," by an administrator before they can authenticate. This is a deliberate security design — having a valid Google account does not automatically grant access to your application. Self-service signup applies to the ",[257,947,948],{"href":163},"Organization scope"," (the admin who runs the org); the same data model supports application-scope self-signup, but enabling it is admin-controlled.",[223,951,952,953,956],{},"Your organization administrator manages your application's users from the organization's ",[238,954,955],{},"Members"," page:",[232,958,959,965],{},[235,960,961,964],{},[238,962,963],{},"Local users"," are created with an email and password",[235,966,967,970],{},[238,968,969],{},"OIDC users"," are created with an email only — the OIDC subject is linked automatically on first login",[223,972,973,974,976],{},"For details on user and OIDC configuration management, see the ",[257,975,162],{"href":163}," platform guide.",[978,979,980],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}htm