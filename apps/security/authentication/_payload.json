07.mcp-tools","i-lucide-bot",{"title":177,"path":178,"stem":179,"icon":180},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":182,"path":183,"stem":184,"icon":185},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":187,"path":188,"stem":189,"icon":190},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":124,"icon":125,"path":192,"stem":193,"children":194,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F11.reference",[195],{"title":196,"path":197,"stem":198,"icon":199},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F11.reference\u002F01.cri-format","i-lucide-link",{"id":201,"title":98,"body":202,"description":981,"extension":982,"links":983,"meta":984,"navigation":985,"path":99,"seo":986,"stem":100,"__hash__":987},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":203,"value":204,"toc":968},"minimark",[205,209,213,218,235,250,254,265,327,333,337,356,524,537,575,679,692,696,707,814,822,826,833,872,876,899,903,913,922,926,937,944,958,964],[206,207,25],"h2",{"id":208},"overview",[210,211,212],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[214,215,217],"h3",{"id":216},"authentication-methods","Authentication Methods",[219,220,221,229],"ul",{},[222,223,224,228],"li",{},[225,226,227],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[222,230,231,234],{},[225,232,233],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including platform-provided social providers pre-registered with Kinotic OS.",[210,236,237,238,242,243,246,247,249],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[239,240,241],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[244,245,163],"a",{"href":164}," and ",[244,248,158],{"href":159},".",[214,251,253],{"id":252},"scoped-authentication","Scoped Authentication",[210,255,256,257,260,261,264],{},"Authentication happens at the ",[225,258,259],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[225,262,263],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[266,267,268,288],"table",{},[269,270,271],"thead",{},[272,273,274,280,285],"tr",{},[275,276,277],"th",{},[239,278,279],{},"organizationId",[275,281,282],{},[239,283,284],{},"applicationId",[275,286,287],{},"Resulting scope",[289,290,291,304,316],"tbody",{},[272,292,293,297,299],{},[294,295,296],"td",{},"absent",[294,298,296],{},[294,300,301],{},[239,302,303],{},"SYSTEM",[272,305,306,309,311],{},[294,307,308],{},"present",[294,310,296],{},[294,312,313],{},[239,314,315],{},"ORGANIZATION",[272,317,318,320,322],{},[294,319,308],{},[294,321,308],{},[294,323,324],{},[239,325,326],{},"APPLICATION",[210,328,329,330,332],{},"For application developers this is always the ",[239,331,326],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[206,334,336],{"id":335},"connecting-with-email-and-password","Connecting with Email and Password",[210,338,339,340,343,344,347,348,347,351,347,353,355],{},"In Node, pass a ",[239,341,342],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[239,345,346],{},"clientId",", ",[239,349,350],{},"clientSecret",[239,352,279],{},[239,354,284],{},"); they are presented as headers on the WebSocket upgrade:",[357,358,363],"pre",{"className":359,"code":360,"language":361,"meta":362,"style":362},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[239,364,365,404,425,432,442,461,516],{"__ignoreMap":362},[366,367,370,374,378,382,385,388,391,394,397,401],"span",{"class":368,"line":369},"line",1,[366,371,373],{"class":372},"s7zQu","import",[366,375,377],{"class":376},"sMK4o"," {",[366,379,381],{"class":380},"sTEyZ"," BasicCredentialsResolver",[366,383,384],{"class":376},",",[366,386,387],{"class":380}," Kinotic",[366,389,390],{"class":376}," }",[366,392,393],{"class":372}," from",[366,395,396],{"class":376}," '",[366,398,400],{"class":399},"sfazB","@kinotic-ai\u002Fcore",[366,402,403],{"class":376},"'\n",[366,405,407,409,411,414,416,418,420,423],{"class":368,"line":406},2,[366,408,373],{"class":372},[366,410,377],{"class":376},[366,412,413],{"class":380}," ensureNodeWebSocket",[366,415,390],{"class":376},[366,417,393],{"class":372},[366,419,396],{"class":376},[366,421,422],{"class":399},"@kinotic-ai\u002Fcore\u002Fnode",[366,424,403],{"class":376},[366,426,428],{"class":368,"line":427},3,[366,429,431],{"emptyLinePlaceholder":430},true,"\n",[366,433,435,439],{"class":368,"line":434},4,[366,436,438],{"class":437},"s2Zo4","ensureNodeWebSocket",[366,440,441],{"class":380},"()\n",[366,443,445,448,450,452,455,458],{"class":368,"line":444},5,[366,446,447],{"class":372},"await",[366,449,387],{"class":380},[366,451,249],{"class":376},[366,453,454],{"class":437},"connect",[366,456,457],{"class":380},"(",[366,459,460],{"class":376},"{\n",[366,462,464,468,471,474,476,478,481,484,486,488,490,493,495,497,499,502,504,506,508,511,513],{"class":368,"line":463},6,[366,465,467],{"class":466},"swJcz","    credentials",[366,469,470],{"class":376},":",[366,472,473],{"class":376}," new",[366,475,381],{"class":437},[366,477,457],{"class":380},[366,479,480],{"class":376},"'",[366,482,483],{"class":399},"user@example.com",[366,485,480],{"class":376},[366,487,384],{"class":376},[366,489,396],{"class":376},[366,491,492],{"class":399},"password",[366,494,480],{"class":376},[366,496,384],{"class":376},[366,498,396],{"class":376},[366,500,501],{"class":399},"my-organization",[366,503,480],{"class":376},[366,505,384],{"class":376},[366,507,396],{"class":376},[366,509,510],{"class":399},"my-application",[366,512,480],{"class":376},[366,514,515],{"class":380},")\n",[366,517,519,522],{"class":368,"line":518},7,[366,520,521],{"class":376},"}",[366,523,515],{"class":380},[210,525,526,527,530,531,533,534,536],{},"The constructor is ",[239,528,529],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[239,532,346],{}," is your user's email and ",[239,535,350],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[210,538,539,540,543,544,547,548,551,552,555,556,551,559,562,563,566,567,570,571,574],{},"With no ",[239,541,542],{},"credentials"," at all, ",[239,545,546],{},"Kinotic.connect()"," resolves through the default chain: the ",[239,549,550],{},"KINOTIC_CLIENT_ID"," \u002F ",[239,553,554],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[239,557,558],{},"KINOTIC_ORGANIZATION_ID",[239,560,561],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[239,564,565],{},"server"," option, the ",[239,568,569],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then ",[239,572,573],{},"https:\u002F\u002Fapi.kinotic.ai",". To pin the server explicitly, pass it alongside the credentials:",[357,576,578],{"className":359,"code":577,"language":361,"meta":362,"style":362},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[239,579,580,594,629,673],{"__ignoreMap":362},[366,581,582,584,586,588,590,592],{"class":368,"line":369},[366,583,447],{"class":372},[366,585,387],{"class":380},[366,587,249],{"class":376},[366,589,454],{"class":437},[366,591,457],{"class":380},[366,593,460],{"class":376},[366,595,596,599,601,603,606,608,610,613,615,617,620,622,626],{"class":368,"line":406},[366,597,598],{"class":466},"    server",[366,600,470],{"class":376},[366,602,377],{"class":376},[366,604,605],{"class":466}," host",[366,607,470],{"class":376},[366,609,396],{"class":376},[366,611,612],{"class":399},"kinotic.example.com",[366,614,480],{"class":376},[366,616,384],{"class":376},[366,618,619],{"class":466}," useSSL",[366,621,470],{"class":376},[366,623,625],{"class":624},"sfNiH"," true",[366,627,628],{"class":376}," },\n",[366,630,631,633,635,637,639,641,643,645,647,649,651,653,655,657,659,661,663,665,667,669,671],{"class":368,"line":427},[366,632,467],{"class":466},[366,634,470],{"class":376},[366,636,473],{"class":376},[366,638,381],{"class":437},[366,640,457],{"class":380},[366,642,480],{"class":376},[366,644,483],{"class":399},[366,646,480],{"class":376},[366,648,384],{"class":376},[366,650,396],{"class":376},[366,652,492],{"class":399},[366,654,480],{"class":376},[366,656,384],{"class":376},[366,658,396],{"class":376},[366,660,501],{"class":399},[366,662,480],{"class":376},[366,664,384],{"class":376},[366,666,396],{"class":376},[366,668,510],{"class":399},[366,670,480],{"class":376},[366,672,515],{"class":380},[366,674,675,677],{"class":368,"line":434},[366,676,521],{"class":376},[366,678,515],{"class":380},[210,680,681,682,684,685,688,689,249],{},"Absent ",[239,683,565],{}," fields fall through to the environment — ",[239,686,687],{},"{ host }"," alone means no TLS and the gateway port ",[239,690,691],{},"58503",[206,693,695],{"id":694},"connecting-with-oidc","Connecting with OIDC",[210,697,698,699,702,703,706],{},"For token-based authentication, pass a Bearer token via ",[239,700,701],{},"BearerCredentialsResolver",". The resolver sends ",[239,704,705],{},"Authorization: Bearer \u003Ctoken>"," on every (re)connect; pass a supplier function to refresh a short-lived token before each connect:",[357,708,710],{"className":359,"code":709,"language":361,"meta":362,"style":362},"import { BearerCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BearerCredentialsResolver(async () => await getToken())\n})\n",[239,711,712,735,753,757,763,777,808],{"__ignoreMap":362},[366,713,714,716,718,721,723,725,727,729,731,733],{"class":368,"line":369},[366,715,373],{"class":372},[366,717,377],{"class":376},[366,719,720],{"class":380}," BearerCredentialsResolver",[366,722,384],{"class":376},[366,724,387],{"class":380},[366,726,390],{"class":376},[366,728,393],{"class":372},[366,730,396],{"class":376},[366,732,400],{"class":399},[366,734,403],{"class":376},[366,736,737,739,741,743,745,747,749,751],{"class":368,"line":406},[366,738,373],{"class":372},[366,740,377],{"class":376},[366,742,413],{"class":380},[366,744,390],{"class":376},[366,746,393],{"class":372},[366,748,396],{"class":376},[366,750,422],{"class":399},[366,752,403],{"class":376},[366,754,755],{"class":368,"line":427},[366,756,431],{"emptyLinePlaceholder":430},[366,758,759,761],{"class":368,"line":434},[366,760,438],{"class":437},[366,762,441],{"class":380},[366,764,765,767,769,771,773,775],{"class":368,"line":444},[366,766,447],{"class":372},[366,768,387],{"class":380},[366,770,249],{"class":376},[366,772,454],{"class":437},[366,774,457],{"class":380},[366,776,460],{"class":376},[366,778,779,781,783,785,787,789,793,796,799,802,805],{"class":368,"line":463},[366,780,467],{"class":466},[366,782,470],{"class":376},[366,784,473],{"class":376},[366,786,720],{"class":437},[366,788,457],{"class":380},[366,790,792],{"class":791},"spNyl","async",[366,794,795],{"class":376}," ()",[366,797,798],{"class":791}," =>",[366,800,801],{"class":372}," await",[366,803,804],{"class":437}," getToken",[366,806,807],{"class":380},"())\n",[366,809,810,812],{"class":368,"line":518},[366,811,521],{"class":376},[366,813,515],{"class":380},[210,815,816,817,551,819,821],{},"A Kinotic-minted JWT already carries the ",[239,818,279],{},[239,820,284],{}," claims, so no scope headers are needed alongside it. The platform validates the JWT against the OIDC configurations enabled for your application, matches the token's email to a pre-existing user in your application's scope, and establishes a session.",[214,823,825],{"id":824},"browser-applications","Browser applications",[210,827,828,829,832],{},"A browser SPA does ",[225,830,831],{},"not"," supply credentials. It logs in through the OIDC\u002FREST flow, which establishes a session cookie, then connects with nothing — the default resolution finds the session, and the server settings come from the page's own location:",[357,834,836],{"className":359,"code":835,"language":361,"meta":362,"style":362},"import { Kinotic } from '@kinotic-ai\u002Fcore'\n\nawait Kinotic.connect()\n",[239,837,838,856,860],{"__ignoreMap":362},[366,839,840,842,844,846,848,850,852,854],{"class":368,"line":369},[366,841,373],{"class":372},[366,843,377],{"class":376},[366,845,387],{"class":380},[366,847,390],{"class":376},[366,849,393],{"class":372},[366,851,396],{"class":376},[366,853,400],{"class":399},[366,855,403],{"class":376},[366,857,858],{"class":368,"line":406},[366,859,431],{"emptyLinePlaceholder":430},[366,861,862,864,866,868,870],{"class":368,"line":427},[366,863,447],{"class":372},[366,865,387],{"class":380},[366,867,249],{"class":376},[366,869,454],{"class":437},[366,871,441],{"class":380},[214,873,875],{"id":874},"how-oidc-works-with-your-application","How OIDC Works with Your Application",[877,878,879,882,885,888,896],"ol",{},[222,880,881],{},"Your platform administrator enables one or more OIDC configurations for your application (e.g., Google, Microsoft)",[222,883,884],{},"Your frontend initiates the OAuth flow with the provider — the user sees the provider's consent screen",[222,886,887],{},"The provider returns a JWT to your frontend",[222,889,890,891,551,893,895],{},"Your frontend connects to Kinotic — in the browser via the session cookie established by the REST login; the Kinotic-minted JWT carries the ",[239,892,279],{},[239,894,284],{}," claims that identify the scope",[222,897,898],{},"The platform validates the token, looks up the user, and creates a session",[214,900,902],{"id":901},"reusable-providers","Reusable Providers",[210,904,905,906,908,909,912],{},"Kinotic OS registers once with providers like Google and Microsoft. The platform operator provisions these as ",[239,907,241],{}," entities; your organization admin enables them for your application by adding the configuration id to your application's ",[239,910,911],{},"oidcConfigurationIds",". End users see \"Kinotic OS\" on the consent screen, and your application benefits without any provider registration.",[210,914,915,916,918,919,921],{},"The same ",[239,917,241],{}," shape is used for an organization's enterprise SSO (e.g. a corporate Okta instance) — see ",[244,920,163],{"href":164}," for how the platform-vs-org distinction is captured by reference rather than by a flag on the entity.",[206,923,925],{"id":924},"user-management","User Management",[210,927,928,929,932,933,936],{},"Application-scope users are ",[225,930,931],{},"pre-created"," by an administrator before they can authenticate. This is a deliberate security design — having a valid Google account does not automatically grant access to your application. Self-service signup applies to the ",[244,934,935],{"href":159},"Organization scope"," (the admin who runs the org); the same data model supports application-scope self-signup, but enabling it is admin-controlled.",[210,938,939,940,943],{},"Your organization administrator manages your application's users from the organization's ",[225,941,942],{},"Members"," page:",[219,945,946,952],{},[222,947,948,951],{},[225,949,950],{},"Local users"," are created with an email and password",[222,953,954,957],{},[225,955,956],{},"OIDC users"," are created with an email only — the OIDC subject is linked automatically on first login",[210,959,960,961,963],{},"For details on user and OIDC configuration management, see the ",[244,962,158],{"href":159}," platform guide.",[965,966,967],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F0