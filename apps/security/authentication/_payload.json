ion":1010,"links":1011,"meta":1012,"navigation":1013,"path":99,"seo":1014,"stem":100,"__hash__":1015},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":231,"value":232,"toc":996},"minimark",[233,237,241,246,263,278,282,293,355,361,365,384,552,565,603,707,720,724,735,842,850,854,861,900,904,927,931,941,950,954,965,972,986,992],[234,235,25],"h2",{"id":236},"overview",[238,239,240],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[242,243,245],"h3",{"id":244},"authentication-methods","Authentication Methods",[247,248,249,257],"ul",{},[250,251,252,256],"li",{},[253,254,255],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[250,258,259,262],{},[253,260,261],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including platform-provided social providers pre-registered with Kinotic OS.",[238,264,265,266,270,271,274,275,277],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[267,268,269],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[272,273,167],"a",{"href":168}," and ",[272,276,162],{"href":163},".",[242,279,281],{"id":280},"scoped-authentication","Scoped Authentication",[238,283,284,285,288,289,292],{},"Authentication happens at the ",[253,286,287],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[253,290,291],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[294,295,296,316],"table",{},[297,298,299],"thead",{},[300,301,302,308,313],"tr",{},[303,304,305],"th",{},[267,306,307],{},"organizationId",[303,309,310],{},[267,311,312],{},"applicationId",[303,314,315],{},"Resulting scope",[317,318,319,332,344],"tbody",{},[300,320,321,325,327],{},[322,323,324],"td",{},"absent",[322,326,324],{},[322,328,329],{},[267,330,331],{},"SYSTEM",[300,333,334,337,339],{},[322,335,336],{},"present",[322,338,324],{},[322,340,341],{},[267,342,343],{},"ORGANIZATION",[300,345,346,348,350],{},[322,347,336],{},[322,349,336],{},[322,351,352],{},[267,353,354],{},"APPLICATION",[238,356,357,358,360],{},"For application developers this is always the ",[267,359,354],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[234,362,364],{"id":363},"connecting-with-email-and-password","Connecting with Email and Password",[238,366,367,368,371,372,375,376,375,379,375,381,383],{},"In Node, pass a ",[267,369,370],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[267,373,374],{},"clientId",", ",[267,377,378],{},"clientSecret",[267,380,307],{},[267,382,312],{},"); they are presented as headers on the WebSocket upgrade:",[385,386,391],"pre",{"className":387,"code":388,"language":389,"meta":390,"style":390},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[267,392,393,432,453,460,470,489,544],{"__ignoreMap":390},[394,395,398,402,406,410,413,416,419,422,425,429],"span",{"class":396,"line":397},"line",1,[394,399,401],{"class":400},"s7zQu","import",[394,403,405],{"class":404},"sMK4o"," {",[394,407,409],{"class":408},"sTEyZ"," BasicCredentialsResolver",[394,411,412],{"class":404},",",[394,414,415],{"class":408}," Kinotic",[394,417,418],{"class":404}," }",[394,420,421],{"class":400}," from",[394,423,424],{"class":404}," '",[394,426,428],{"class":427},"sfazB","@kinotic-ai\u002Fcore",[394,430,431],{"class":404},"'\n",[394,433,435,437,439,442,444,446,448,451],{"class":396,"line":434},2,[394,436,401],{"class":400},[394,438,405],{"class":404},[394,440,441],{"class":408}," ensureNodeWebSocket",[394,443,418],{"class":404},[394,445,421],{"class":400},[394,447,424],{"class":404},[394,449,450],{"class":427},"@kinotic-ai\u002Fcore\u002Fnode",[394,452,431],{"class":404},[394,454,456],{"class":396,"line":455},3,[394,457,459],{"emptyLinePlaceholder":458},true,"\n",[394,461,463,467],{"class":396,"line":462},4,[394,464,466],{"class":465},"s2Zo4","ensureNodeWebSocket",[394,468,469],{"class":408},"()\n",[394,471,473,476,478,480,483,486],{"class":396,"line":472},5,[394,474,475],{"class":400},"await",[394,477,415],{"class":408},[394,479,277],{"class":404},[394,481,482],{"class":465},"connect",[394,484,485],{"class":408},"(",[394,487,488],{"class":404},"{\n",[394,490,492,496,499,502,504,506,509,512,514,516,518,521,523,525,527,530,532,534,536,539,541],{"class":396,"line":491},6,[394,493,495],{"class":494},"swJcz","    credentials",[394,497,498],{"class":404},":",[394,500,501],{"class":404}," new",[394,503,409],{"class":465},[394,505,485],{"class":408},[394,507,508],{"class":404},"'",[394,510,511],{"class":427},"user@example.com",[394,513,508],{"class":404},[394,515,412],{"class":404},[394,517,424],{"class":404},[394,519,520],{"class":427},"password",[394,522,508],{"class":404},[394,524,412],{"class":404},[394,526,424],{"class":404},[394,528,529],{"class":427},"my-organization",[394,531,508],{"class":404},[394,533,412],{"class":404},[394,535,424],{"class":404},[394,537,538],{"class":427},"my-application",[394,540,508],{"class":404},[394,542,543],{"class":408},")\n",[394,545,547,550],{"class":396,"line":546},7,[394,548,549],{"class":404},"}",[394,551,543],{"class":408},[238,553,554,555,558,559,561,562,564],{},"The constructor is ",[267,556,557],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[267,560,374],{}," is your user's email and ",[267,563,378],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[238,566,567,568,571,572,575,576,579,580,583,584,579,587,590,591,594,595,598,599,602],{},"With no ",[267,569,570],{},"credentials"," at all, ",[267,573,574],{},"Kinotic.connect()"," resolves through the default chain: the ",[267,577,578],{},"KINOTIC_CLIENT_ID"," \u002F ",[267,581,582],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[267,585,586],{},"KINOTIC_ORGANIZATION_ID",[267,588,589],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[267,592,593],{},"server"," option, the ",[267,596,597],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then ",[267,600,601],{},"https:\u002F\u002Fapi.kinotic.ai",". To pin the server explicitly, pass it alongside the credentials:",[385,604,606],{"className":387,"code":605,"language":389,"meta":390,"style":390},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[267,607,608,622,657,701],{"__ignoreMap":390},[394,609,610,612,614,616,618,620],{"class":396,"line":397},[394,611,475],{"class":400},[394,613,415],{