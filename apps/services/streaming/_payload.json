98,760,477],{"class":308},[298,762,684],{"class":393},[298,764,397],{"class":312},[298,766,400],{"class":308},[298,768,769],{"class":325},"Stream ended",[298,771,400],{"class":308},[298,773,408],{"class":312},[298,775,776,779],{"class":300,"line":425},[298,777,778],{"class":308},"}",[298,780,408],{"class":312},[298,782,783],{"class":300,"line":460},[298,784,384],{"emptyLinePlaceholder":383},[298,786,787],{"class":300,"line":486},[298,788,790],{"class":789},"sHwdD","\u002F\u002F Stop listening when done\n",[298,792,793,796,798,801],{"class":300,"line":506},[298,794,795],{"class":312},"subscription",[298,797,477],{"class":308},[298,799,800],{"class":393},"unsubscribe",[298,802,563],{"class":312},[278,804,806],{"id":805},"how-a-stream-ends","How a Stream Ends",[269,808,809],{},"A stream ends for its caller in one of five ways, and the service stops producing in every one of them:",[811,812,813,824,832,845,863],"ul",{},[814,815,816,820,821,823],"li",{},[817,818,819],"strong",{},"The service completes it."," The caller's ",[273,822,275],{}," completes.",[814,825,826,820,829,831],{},[817,827,828],{},"The service fails it.",[273,830,275],{}," errors with the exception the service threw or emitted.",[814,833,834,837,838,840,841,844],{},[817,835,836],{},"The caller unsubscribes."," A cancel reaches the service, which unsubscribes from the ",[273,839,275],{}," the method returned, so a finite source stops early and an ",[273,842,843],{},"interval"," stops ticking.",[814,846,847,820,850,852,853,856,857,862],{},[817,848,849],{},"The caller falls too far behind a stream that cannot be suspended.",[273,851,275],{}," errors with ",[273,854,855],{},"RpcStreamOverflowException"," (see ",[858,859,861],"a",{"href":860},"#a-caller-that-falls-behind","A Caller That Falls Behind",").",[814,864,865,868,869,862],{},[817,866,867],{},"The caller is gone."," The platform watches the caller's reply destination for every stream in progress, on the node hosting a Java service and on the gateway for a TypeScript one. When nothing listens there any more — the caller's connection closed, or its node left the cluster — the stream is cancelled the same way an unsubscribe cancels it. A TypeScript service whose own connection ends, however it ends, cancels every stream it was producing at that moment, because the gateway has already failed those callers (see ",[858,870,871],{"href":223},"service call liveness",[269,873,874],{},"A service that stops while producing a stream ends it with an error at the caller rather than a silent cancel.",[278,876,861],{"id":877},"a-caller-that-falls-behind",[269,879,880],{},"A caller connected through the gateway, such as a browser, the CLI or a TypeScript service, receives a stream only as fast as its connection takes it. The gateway counts what it has written to the connection that the socket has not sent yet. When that backlog passes 1 MiB, the gateway suspends each stream to the connection that can be suspended, as its next value arrives, and resumes them all once the backlog drains below 256 KiB. Values already on their way when the suspend went out still arrive, so the caller loses nothing and receives every value in order.",[269,882,883,884,887,888,887,891,894,895,898,899,902],{},"A stream produced by a Java service can be suspended. Once the suspend reaches the service, it sends nothing more until it is resumed, and its source has been asked for at most 32 values the service has not sent. A source that produces only as fast as it is asked stops there, whether it emits synchronously or not: ",[273,885,886],{},"Flux.range",", ",[273,889,890],{},"Flux.fromIterable",[273,892,893],{},"Flux.generate",", a database cursor, or a ",[273,896,897],{},"Flux.create"," that reads ",[273,900,901],{},"onRequest",". A source emitting on the service's own event loop also yields the loop every 16 values, so a long synchronous stream does not hold it.",[269,904,905],{},"A source that produces on its own schedule does not wait to be asked. Once its caller has been behind long enough to use up those 32 values, what happens depends on the source:",[907,908,909,922],"table",{},[910,911,912],"thead",{},[913,914,915,919],"tr",{},[916,917,918],"th",{},"Source",[916,920,921],{},"While its caller is behind",[923,924,925,936,946,956],"tbody",{},[913,926,927,933],{},[928,929,930],"td",{},[273,931,932],{},"Flux.interval",[928,934,935],{},"fails the stream with an overflow error",[913,937,938,943],{},[928,939,940,942],{},[273,941,897],{},", by default",[928,944,945],{},"keeps buffering inside the service, without limit",[913,947,948,953],{},[928,949,950],{},[273,951,952],{},"Sinks.many().multicast().directBestEffort()",[928,954,955],{},"drops the values for that caller, who never sees them",[913,957,958,969],{},[928,959,960,961,964,965,968],{},"a ",[273,962,963],{},"share()"," or ",[273,966,967],{},"publish()"," of one source",[928,970,971],{},"pauses every caller of the shared source, since it emits only as fast as its slowest subscriber asks",[269,973,974,975,978,979,982,983,986,987,990,991,993],{},"Give a stream like these an overflow strategy that says what its caller misses while it is behind: ",[273,976,977],{},"onBackpressureLatest()"," keeps only the newest value, ",[273,980,981],{},"onBackpressureDrop()"," drops values until the caller catches up, and ",[273,984,985],{},"onBackpressureBuffer(maxSize)"," holds up to ",[273,988,989],{},"maxSize"," values and fails the stream with an overflow error past them. Apply it to each caller's stream, after any ",[273,992,963],{},", so one slow caller does not hold back the others:",[289,995,999],{"className":996,"code":997,"language":998,"meta":294,"style":294},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@Override\npublic Flux\u003CReading> streamReadings(String sensorId) {\n    return readings.share()                                  \u002F\u002F one subscription to the sensor feed\n                   .filter(reading -> reading.sensorId().equals(sensorId))\n                   .onBackpressureLatest();                  \u002F\u002F a caller that falls behind skips to the newest reading\n}\n","java",[273,1000,1001,1006,1011,1016,1021,1026],{"__ignoreMap":294},[298,1002,1003],{"class":300,"line":301},[298,1004,1005],{},"@Override\n",[298,1007,1008],{"class":300,"line":332},[298,1009,1010],{},"public Flux\u003CReading> streamReadings(String sensorId) {\n",[298,1012,1013],{"class":300,"line":359},[298,1014,1015],{},"    return readings.share()                                  \u002F\u002F one subscription to the sensor feed\n",[298,1017,1018],{"class":300,"line":380},[298,1019,1020],{},"                   .filter(reading -> reading.sensorId().equals(sensorId))\n",[298,1022,1023],{"class":300,"line":387},[298,1024,1025],{},"                   .onBackpressureLatest();                  \u002F\u002F a caller that falls behind skips to the newest reading\n",[298,1027,1028],{"class":300,"line":411},[298,1029,590],{},[269,1031,1032,1033,1035],{},"A stream produced by a TypeScript service cannot be suspended. The gateway logs a warning when its caller falls behind, and once 32 MiB of that stream's own values are waiting to be sent it cancels the stream at the service and fails it at the caller with ",[273,1034,855],{},", so the caller can request it again. A backlog the connection's other streams built up never cancels it. A stream that declared it can be suspended but keeps sending more than 5 seconds after a suspend is treated the same way, with a warning that names it.",[269,1037,1038],{},"The gateway sends every suspend, resume and cancel to the address the caller sent its request to, whatever the stream's values say about where they came from.",[278,1040,1042],{"id":1041},"use-cases","Use Cases",[811,1044,1045,1051,1057,1063],{},[814,1046,1047,1050],{},[817,1048,1049],{},"Real-time data feeds"," -- IoT sensors, live metrics, dashboards",[814,1052,1053,1056],{},[817,1054,1055],{},"N