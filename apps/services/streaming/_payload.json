ks":866,"meta":867,"navigation":348,"path":56,"seo":868,"stem":57,"__hash__":869},"docs\u002F01.apps\u002F04.services\u002F04.streaming.md",{"type":231,"value":232,"toc":858},"minimark",[233,242,247,253,556,560,566,768,772,775,821,824,828,854],[234,235,236,237,241],"p",{},"Kinotic services can push multiple values to callers over time using the streaming pattern. Instead of returning a single response, a streaming method returns an ",[238,239,240],"code",{},"Observable"," that emits values as they become available.",[243,244,246],"h2",{"id":245},"defining-a-streaming-method","Defining a Streaming Method",[234,248,249,250,252],{},"Any service method that returns an ",[238,251,240],{}," is treated as a streaming endpoint.",[254,255,260],"pre",{"className":256,"code":257,"language":258,"meta":259,"style":259},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Publish } from '@kinotic-ai\u002Fcore'\nimport { Observable, interval } from 'rxjs'\nimport { map } from 'rxjs\u002Foperators'\n\n@Publish('com.example')\nclass SensorService {\n    streamReadings(sensorId: string): Observable\u003CSensorReading> {\n        return interval(1000).pipe(\n            map(() => ({\n                sensorId,\n                value: Math.random() * 100,\n                timestamp: new Date().toISOString()\n            }))\n        )\n    }\n}\n","typescript","",[238,261,262,295,322,343,350,374,388,423,449,469,478,505,529,538,544,550],{"__ignoreMap":259},[263,264,267,271,275,279,282,285,288,292],"span",{"class":265,"line":266},"line",1,[263,268,270],{"class":269},"s7zQu","import",[263,272,274],{"class":273},"sMK4o"," {",[263,276,278],{"class":277},"sTEyZ"," Publish",[263,280,281],{"class":273}," }",[263,283,284],{"class":269}," from",[263,286,287],{"class":273}," '",[263,289,291],{"class":290},"sfazB","@kinotic-ai\u002Fcore",[263,293,294],{"class":273},"'\n",[263,296,298,300,302,305,308,311,313,315,317,320],{"class":265,"line