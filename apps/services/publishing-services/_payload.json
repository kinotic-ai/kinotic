 — the same caller a Java service receives as its ",[269,1541,1542],{},"Participant"," parameter — plus whatever a registered ",[269,1545,1546],{},"ContextInterceptor"," adds.",[265,1549,1550,1554],{},[1551,1552,1553],"strong",{},"The context parameter must be the method's final parameter."," Callers never pass it — the platform appends it after the caller-supplied arguments.",[282,1556,1558],{"className":284,"code":1557,"language":286,"meta":287,"style":287},"import { Publish, Context, type ServiceContext } from '@kinotic-ai\u002Fcore'\nimport { isOrganizationParticipant, requireParticipant } from '@kinotic-ai\u002Fmanagement-api'\n\n@Publish('com.example')\nclass OrderService {\n    @Context\n    async listOrders(status: string, context: ServiceContext): Promise\u003COrder[]> {\n        const caller = requireParticipant(context.participant, isOrganizationParticipant)\n        return this.orders.findByOrganization(caller.organizationId, status)\n    }\n}\n",[269,1559,1560,1590,1614,1618,1634,1642,1649,1694,1721,1751,1755],{"__ignoreMap":287},[291,1561,1562,1564,1566,1568,1570,1573,1575,1577,1580,1582,1584,1586,1588],{"class":293,"line":294},[291,1563,298],{"class":297},[291,1565,302],{"class":301},[291,1567,306],{"class":305},[291,1569,309],{"class":301},[291,1571,1572],{"class":305}," Context",[291,1574,309],{"class":301},[291,1576,829],{"class":297},[291,1578,1579],{"class":305}," ServiceContext",[291,1581,315],{"class":301},[291,1583,318],{"class":297},[291,1585,321],{"class":301},[291,1587,325],{"class":324},[291,1589,328],{"class":301},[291,1591,1592,1594,1596,1599,1601,1604,1606,1608,1610,1612],{"class":293,"line":331},[291,1593,298],{"class":297},[291,1595,302],{"class":301},[291,1597,1598],{"class":305}," isOrganizationParticipant",[291,1600,309],{"class":301},[291,1602,1603],{"class":305}," requireParticipant",[291,1605,315],{"class":301},[291,1607,318],{"class":297},[291,1609,321],{"class":301},[291,1611,585],{"class":324},[291,1613,328],{"class":301},[29