 declared zones are appended to it, so a service can never register outside its application.",[223,486,488],{"className":225,"code":487,"language":227,"meta":228,"style":228},"import { Kinotic } from '@kinotic-ai\u002Fcore'\nimport { appZone } from '@kinotic-ai\u002Fos-api'\nimport config from '.\u002F.config\u002Fkinotic.config'\n\n\u002F\u002F In your application's entry point, before any @Publish class is instantiated\nKinotic.zonePrefix = appZone(config.organizationId, config.applicationId)\n",[210,489,490,509,529,546,550,556],{"__ignoreMap":228},[232,491,492,494,496,499,501,503,505,507],{"class":234,"line":235},[232,493,239],{"class":238},[232,495,243],{"class":242},[232,497,498],{"class":246}," Kinotic",[232,500,256],{"class":242},[232,502,259],{"class":238},[232,504,262],{"class":242},[232,506,266],{"class":265},[232,508,269],{"class":242},[232,510,511,513,515,518,520,522,524,527],{"class":234,"line":272},[232,512,239],{"class":238},[232,514,243],{"class":242},[232,516,517],{"class":246}," appZone",[232,519,256],{"class":242},[232,521,259],{"class":238},[232,523,262],{"class":242},[232,525,526],{"class":265},"@kinotic-ai\u002Fos-api",[232,528,269],{"class":242},[232,530,531,533,536,539,541,544],{"class":234,"line":279},[232,532,239],{"class":238},[232,534,535],{"class":246}," config ",[232,537,538],{"class":238},"from",[232,540,262],{"class":242},[232,542,543],{"class":265},".\u002F.config\u002Fkinotic.config",[232,545,269],{"class":242},[232,547,548],{"class":234,"line":303},[232,549,276],{"emptyLinePlaceholder":275},[232,551,552],{"class":234,"line":322},[232,553,555],{"class":554},"sHwdD","\u002F\u002F In your application's entry point, before any @Publish class is instantiated\n",[232,557,558,561,564,567,570,572,575,577,580,582,585,587],{"class":234,"line":336},[232,559,560],{"class":246},"Kinotic",[232,562,563],{"class":242},".",[232,565,566],{"class":246},"zonePrefix ",[232,568,569],{"class":242},"=",[232,571,517],{"class":285},[232,573,574],{"class":246},"(config",[232,576,563],{"class":242},[232,578,579],{"class":246},"organizationId",[232,581,250],{"class":242},[232,583,584],{"class":246}," config",[232,586,563],{"class":242},[232,588,589],{"class":246},"applicationId)\n",[206,591,592,594,595,598,599,602,603,606],{},[210,593,212],{}," classes may be instantiated before or after ",[210,596,597],{},"Kinotic.connect()",": a\nregistration made before the connection is up queues and subscribes once it is, and\nevery registration re-subscribes automatically on reconnect — including across an\nexplicit ",[210,600,601],{},"disconnect()"," \u002F ",[210,604,605],{},"connect()"," cycle.",[223,608,610],{"className":225,"code":609,"language":227,"meta":228,"style":228},"@Publish()                       \u002F\u002F → srv:\u002F\u002Fapp.acme-org.orders-app~OrderService\nclass OrderService { ... }\n\n@Zone('billing')                 \u002F\u002F → srv:\u002F\u002Fapp.acme-org.orders-app.billing~InvoiceService\n@Publish()\nclass InvoiceService { ... }\n",[210,611,612,624,639,643,665,674],{"__ignoreMap":228},[232,613,614,616,618,621],{"class":234,"line":235},[232,615,282],{"class":242},[232,617,308],{"class":285},[232,619,620],{"class":246},"()                       ",[232,622,623],{"class":554},"\u002F\u002F → srv:\u002F\u002Fapp.acme-org.orders-app~OrderService\n",[232,625,626,628,631,633,636],{"class":234,"line":272},[232,627,326],{"class":325},[232,629,630],{"class":329}," OrderService",[232,632,243],{"class":242},[232,634,635],{"class":242}," ...",[232,637,638],{"class":242}," }\n",[232,640,641],{"class":234,"line":279},[232,642,276],{"emptyLinePlaceholder":275},[232,644,645,647,650,652,654,657,659,662],{"class":234,"line":303},[232,646,282],{"class":242},[232,648,649],{"class":285},"Zone",[232,651,289],{"class":246},[232,653,292],{"class":242},[232,655,656],{"class":265},"billing",[232,658,292],{"class":242},[232,660,661],{"class":246},")                 ",[232,663,664],{"class":554},"\u002F\u002F → srv:\u002F\u002Fapp.