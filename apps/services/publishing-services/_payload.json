69,1024,1025],{"class":302},"app.acme-org.orders-app",[269,1027,329],{"class":279},[269,1029,337],{"class":283},[269,1031,1032,1035,1037,1039,1041,1044,1047,1049,1051,1053,1056],{"class":271,"line":399},[269,1033,1034],{"class":283},"host",[269,1036,600],{"class":279},[269,1038,869],{"class":283},[269,1040,600],{"class":279},[269,1042,1043],{"class":322},"register",[269,1045,1046],{"class":283},"(identifier",[269,1048,287],{"class":279},[269,1050,920],{"class":279},[269,1052,367],{"class":322},[269,1054,1055],{"class":283},"())   ",[269,1057,1058],{"class":591},"\u002F\u002F → srv:\u002F\u002Fapp.acme-org.orders-app~com.example.GreetingService\n",[269,1060,1061],{"class":271,"line":425},[269,1062,313],{"emptyLinePlaceholder":312},[269,1064,1065],{"class":271,"line":431},[269,1066,1067],{"class":591},"\u002F\u002F later, when the service should no longer be reachable\n",[269,1069,1070,1072,1074,1076,1078,1081],{"class":271,"line":436},[269,1071,1034],{"class":283},[269,1073,600],{"class":279},[269,1075,869],{"class":283},[269,1077,600],{"class":279},[269,1079,1080],{"class":322},"unRegister",[269,1082,1083],{"class":283},"(identifier)\n",[243,1085,1086,1087,1089,1090,1093,1094,1096,1097,1099],{},"The zone is the complete zone the service lives in: ",[247,1088,520],{}," and ",[247,1091,1092],{},"defaultZone"," apply to ",[247,1095,249],{}," classes only. Registering the same identifier twice on one client is a no-op, and ",[247,1098,1080],{}," ends any stream the service is still producing with an error to its caller.",[255,1101,1103],{"id":1102},"the-service-directory","The service directory",[243,1105,1106,1107,1110,1111,1089,1114,1117,1118,1121,1122,1125,1126,1128,1129,1132,1133,1136,1137,1140,1141,1143],{},"Every published class under the project's ",[247,1108,1109],{},"servicesPaths"," gets a service definition from ",[247,1112,1113],{},"kinotic generate",[247,1115,1116],{},"kinotic sync",", its functions with their parameters and types, written to the ",[247,1119,1120],{},"ServiceDefinitions"," module under ",[247,1123,1124],{},"generatedPath",". A project that imports that module has the runtime register each service in the platform's service directory as the service comes online: the services registered before ",[247,1127,937],{}," when the client connects, and a service registered on a connected client as it registers. Only a service in an application's zone, ",[247,1130,1131],{},"app.\u003CorganizationId>.\u003CapplicationId>"," or a zone under it, is registered, through the platform's ",[247,1134,1135],{},"ApplicationServiceDirectory"," in ",[247,1138,1139],{},"app-api",", which refuses a zone that is not the application's or an application outside the caller's organization. The directory then holds the application's services beside the platform's own, with their liveness; a service the project declares no definition for serves on its zone alone. A definition naming other functions than the class serves fails the registration, and with it the connection, until ",[247,1142,1116],{}," runs again.",[1145,1146,1148],"h3",{"id":1147},"parameter-and-return-types","Parameter and return types",[243,1150,1151],{},"Arguments and results travel as JSON, so a function's types are published as JSON carries them:",[1153,1154,1155,1171,1181,1202,1211,1224],"ul",{},[1156,1157,1158,1159,1162,1163,1166,1167,1170],"li",{},"A ",[247,1160,1161],{},"Promise"," or ",[247,1164,1165],{},"PromiseLike"," result is asynchronous and an ",[247,1168,1169],{},"Observable"," result is a stream, of the type it resolves to or emits.",[1156,1172,1173,1176,1177,1180],{},[247,1174,1175],{},"any",", ",[247,1178,1179],{},"unknown",", and a type parameter with no constraint accept anything; a constrained type parameter is its constraint.",[1156,1182,1183,1184,1187,1188,1089,1191,1194,1195,1176,1198,1201],{},"Interfaces, classes (their fields, without their methods), generic instantiations such as ",[247,1185,1186],{},"Page\u003CReport>",", mapped types such as ",[247,1189,1190],{},"Partial\u003CReport>",[247,1192,1193],{},"Pick\u003CReport, 'id'>",", intersections, and unions of objects are objects, named for the type and its type arguments (",[247,1196,1197],{},"Page_Report",[247,1199,1200],{},"Partial_Report",").",[1156,1203,1204,1089,1207,1210],{},[247,1205,1206],{},"Record\u003Cstring, V>",[247,1208,1209],{},"{[key: string]: V}"," are maps, enums are enums, and a union of string literals is a string.",[1156,1212,1158,1213,1216,1217,1219,1220,1223],{},[247,1214,1215],{},"Date"," is published as a date, but it arrives as the ISO-8601 string a date travels as: the service receives a string, and a TypeScript caller gets a string back. ",[247,1218,1113],{}," logs a warning for each one, and the directory carries the same warning in the ",[247,1221,1222],{},"warnings"," metadata of the parameter, or of the function for a result.",[1156,1225,1158,1226,1176,1229,1176,1232,1176,1235,1176,1238,1241],{},[247,1227,1228],{},"Map",[247,1230,1231],{},"Set",[247,1233,1234],{},"Uint8Array",[247,1236,1237],{},"Buffer",[247,1239,1240],{},"bigint",", tuple, or function fails generation with the reason and the type to declare instead.",[255,1243,1245],{"id":1244},"decorators","Decorators",[1145,1247,1249],{"id":1248},"publishnamespace-name-advertise","@Publish(namespace?, name?, advertise?)",[243,1251,1252,1253,1256,1257,1260,1261,1264,1265,1268,1269,1272],{},"Marks a class for publication. The full service identifier becomes ",[247,1254,1255],{},"namespace.ClassName","; both parts are optional (the name defaults to the class name). A service published with no namespace is addressed by its name in its zone, ",[247,1258,1259],{},"srv:\u002F\u002F\u003Czone>~ClassName",", and the platform's service directory names it in its zone's namespace, ",[247,1262,1263],{},"\u003Czone>.ClassName",", so services of the same name in different applications stay apart. Passing ",[247,1266,1267],{},"advertise"," as ",[247,1270,1271],{},"true"," additionally advertises the service in the platform service directory, so it appears in directory listings for browsing and invocation — publishing alone makes a service callable over RPC without listing it.",[1145,1274,1276],{"id":1275},"zonezone","@Zone(zone)",[243,1278,1279,1280,1282],{},"Declares the zone the service is addressable in, relative to the client's ",[247,1281,520],{},". The zone is one or more dot-separated labels of lowercase letters, digits, and interior dashes.",[1145,1284,1286],{"id":1285},"versionversion","@Version(version)",[243,1288,1289,1290,1293],{},"Sets the semantic version for the service in ",[247,1291,1292],{},"X.Y.Z"," format. Callers can pin to a specific version when resolving the service.",[1145,1295,1297],{"id":1296},"scope","@Scope",[243,1299,1300],{},"A getter or method decorator that marks the member providing the scope identifier. Scope targets requests at one specific instance of a service — for example the copy running on a particular node or device.",[260,1302,1304],{"className":262,"code":1303,"language":264,"meta":265,"style":265},"import { Publish, Scope } from '@kinotic-ai\u002Fcore'\n\n@Publish('com.example')\nclass DeviceService {\n    deviceId: string\n\n    @Scope\n    get scope(): string {\n        return this.deviceId\n    }\n\n    constructor(deviceId: string) {\n        this.deviceId = deviceId\n    }\n\n    getStatus(): string {\n        return `Status for device ${this.deviceId}`\n    }\n}\n",[247,1305,1306,1329,1333,1349,1358,1368,1372,1380,1395,1405,1409,1413,1432,1445,1450,1455,1467,1487,1492],{"__ignoreMap":265},[269,1307,1308,1310,1312,1314,1316,1319,1321,1323,1325,1327],{"class":271,"line":272},[269,1309,276],{"class":275},[269,1311,280],{"class":279},[269,1313,284],{"class":283},[269,1315,287],{"class":279},[269,1317,1318],{"class":283}," Scope",[269,1320,293],{"class":279},[269,1322,296],{"class":275},[269,1324,299],{"class":279},[269,1326,303],{"class":302},[269,1328,306],{"class":279},[269,1330,1331],{"class