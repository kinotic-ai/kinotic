viceIdentifier } from '@kinotic-ai\u002Fcore'\n\nconst host = new KinoticSingleton()\nawait host.connect({ server: { host: 'localhost', port: 58505 }, credentials })   \u002F\u002F the app server\n\nconst identifier = new ServiceIdentifier('com.example', 'GreetingService', 'app.acme-org.orders-app')\nhost.serviceRegistry.register(identifier, new GreetingService())   \u002F\u002F → srv:\u002F\u002Fapp.acme-org.orders-app~com.example.GreetingService\n\n\u002F\u002F later, when the service should no longer be reachable\nhost.serviceRegistry.unRegister(identifier)\n",[273,905,906,930,934,951,1011,1015,1056,1085,1089,1094],{"__ignoreMap":291},[295,907,908,910,912,915,917,920,922,924,926,928],{"class":297,"line":298},[295,909,302],{"class":301},[295,911,306],{"class":305},[295,913,914],{"class":309}," KinoticSingleton",[295,916,313],{"class":305},[295,918,919],{"class":309}," ServiceIdentifier",[295,921,319],{"class":305},[295,923,322],{"class":301},[295,925,325],{"class":305},[295,927,329],{"class":328},[295,929,332],{"class":305},[295,931,932],{"class":297,"line":335},[295,933,339],{"emptyLinePlaceholder":338},[295,935,936,939,942,944,947,949],{"class":297,"line":342},[295,937,938],{"class":388},"const",[295,940,941],{"class":309}," host ",[295,943,632],{"class":305},[295,945,946],{"class":305}," new",[295,948,914],{"class":348},[295,950,736],{"class":309},[295,952,953,956,959,961,964,966,968,971,973,975,977,979,981,984,986,988,991,993,997,1000,1003,1005,1008],{"class":297,"line":366},[295,954,955],{"class":301},"await",[295,957,958],{"class":309}," host",[295,960,626],{"class":305},[295,962,963],{"class":348},"connect",[295,965,352],{"class":309},[295,967,772],{"class":305},[295,969,970],{"class":402}," server",[295,972,412],{"class":305},[295,974,306],{"class":305},[295,976,958],{"class":402},[295,978,412],{"class":305},[295,980,325],{"class":305},[295,982,983],{"class":328},"localhost",[295,985,355],{"class":305},[295,987,313],{"class":305},[295,989,990],{"class":402}," port",[295,992,412],{"class":305},[295,994,996],{"class":995},"sbssI"," 58505",[295,998,999],{"class":305}," },",[295,1001,1002],{"class":309}," credentials ",[295,1004,442],{"class":305},[295,1006,1007],{"class":309},")   ",[295,1009,1010],{"class":617},"\u002F\u002F the app server\n",[295,1012,1013],{"class":297,"line":385},[295,1014,339],{"emptyLinePlaceholder":338},[295,1016,1017,1019,1022,1024,1026,1028,1030,1032,1034,1036,1038,1040,1043,1045,1047,1049,1052,1054],{"class":297,"line":399},[295,1018,938],{"class":388},[295,1020,1021],{"class":309}," identifier ",[295,1023,632],{"class":305},[295,1025,946],{"class":305},[295,1027,919],{"class":348},[295,1029,352],{"class":309},[295,1031,355],{"class":305},[295,1033,378],{"class":328},[295,1035,355],{"class":305},[295,1037,313],{"class":305},[295,1039,325],{"class":305},[295,1041,1042],{"class":328},"GreetingService",[295,1044,355],{"class":305},[295,1046,313],{"class":305},[295,1048,325],{"class":305},[295,1050,1051],{"class":328},"app.acme-org.orders-app",[295,1053,355],{"class":305},[295,1055,363],{"class":309},[295,1057,1058,1061,1063,1065,1067,1070,1073,1075,1077,1079,1082],{"class":297,"line":425},[295,1059,1060],{"class":309},"host",[295,1062,626],{"class":305},[295,1064,895],{"class":309},[295,1066,626],{"class":305},[295,1068,1069],{"class":348},"register",[295,1071,1072],{"class":309},"(identifier",[295,1074,313],{"class":305},[295,1076,946],{"class":305},[295,1078,393],{"class":348},[295,1080,1081],{"class":309},"())   ",[295,1083,1084],{"class":617},"\u002F\u002F → srv:\u002F\u002Fapp.acme-org.orders-app~com.example.GreetingService\n",[295,1086,1087],{"class":297,"line":451},[295,1088,339],{"emptyLinePlaceholder":338},[295,1090,1091],{"class":297,"line":457},[295,1092,1093],{"class":617},"\u002F\u002F later, when the service should no longer be reachable\n",[295,1095,1096,1098,1100,1102,1104,1107],{"class":297,"line":462},[295,1097,1060],{"class":309},[295,1099,626],{"class":305},[295,1101,895],{"class":309},[295,1103,626],{"class":305},[295,1105,1106],{"class":348},"unRegister",[295,1108,1109],{"class":309},"(identifier)\n",[269,1111,1112,1113,1115,1116,1119,1120,1122,1123,1125],{},"The zone is the complete zone the service lives in: ",[273,1114,546],{}," and ",[273,1117,1118],{},"defaultZone"," apply to ",[273,1121,275],{}," classes only. Registering the same identifier twice on one client is a no-op, and ",[273,1124,1106],{}," ends any stream the service is still producing with an error to its caller.",[281,1127,1129],{"id":1128},"the-service-directory","The service directory",[269,1131,1132,1133,1136,1137,1115,1140,1143,1144,1147,1148,1151,1152,1154,1155,1158,1159,1162,1163,1166,1167,1169],{},"Every published class under the project's ",[273,1134,1135],{},"servicesPaths"," gets a service definition from ",[273,1138,1139],{},"kinotic generate",[273,1141,1142],{},"kinotic sync",", its functions with their parameters and types, written to the ",[273,1145,1146],{},"ServiceDefinitions"," module under ",[273,1149,1150],{},"generatedPath",". A project that imports that module has the runtime register each service in the platform's service directory as the service comes online: the services registered before ",[273,1153,963],{}," when the client connects, and a service registered on a connected client as it registers. Only a service in an application's zone, ",[273,1156,1157],{},"app.\u003CorganizationId>.\u003CapplicationId>"," or a zone under it, is registered, through the platform's ",[273,1160,1161],{},"ApplicationServiceDirectory"," in ",[273,1164,1165],{},"app-api",", which refuses a zone that is not the application's or an application outside the caller's organization. The directory then holds the application's services beside the platform's own, with their liveness; a service the project declares no definition for serves on its zone alone. A definition naming other functions than the class serves fails the registration, and with it the connection, until ",[273,1168,1142],{}," runs again.",[1171,1172,1174],"h3",{"id":1173},"parameter-and-return-types","Parameter and return types",[269,1176,1177],{},"Arguments and results travel as JSON, so a function's types are published as JSON carries them:",[1179,1180,1181,1197,1207,1228,1237,1250],"ul",{},[1182,1183,1184,1185,1188,1189,1192,1193,1196],"li",{},"A ",[273,1186,1187],{},"Promise"," or ",[273,1190,1191],{},"PromiseLike"," result is asynchronous and an ",[273,1194,1195],{},"Observable"," result is a stream, of the type it resolves to or emits.",[1182,1198,1199,1202,1203,1206],{},[273,1200,1201],{},"any",", ",[273,1204,1205],{},"unknown",", and a type parameter with no constraint accept anything; a constrained type parameter is its constraint.",[1182,1208,1209,1210,1213,1214,1115,1217,1220,1221,1202,1224,1227],{},"Interfaces, classes (their fields, without their methods), generic instantiations such as ",[273,1211,1212],{},"Page\u003CReport>",", mapped types such as ",[273,1215,1216],{},"Partial\u003CReport>",[273,1218,1219],{},"Pick\u003CReport, 'id'>",", intersections, and unions of objects are objects, named for the type and its type arguments (",[273,1222,1223],{},"Page_Report",[273,1225,1226],{},"Partial_Report",").",[1182,1229,1230,1115,1233,1236],{},[273,1231,1232],{},"Record\u003Cstring, V>",[273,1234,1235],{},"{[key: string]: V}"," are maps, enums are enums, and a union of string literals is a string.",[1182,1238,1184,1239,1242,1243,1245,1246,1249],{},[273,1240,1241],{},"Date"," is published as a date, but it arrives as the ISO-8601 string a date travels as: the service receives a string, and a TypeScript caller gets a string back. ",[273,1244,1139],{}," logs a warning for each one, and the directory carries the same warning in the ",[273,1247,1248],{},"warnings"," metadata of the parameter, or of the function for a result.",[1182,1251,1184,1252,1202,1255,1202,1258,1202,1261,1202,1264,1267],{},[273,1253,1254],{},"Map",[273,1256,1257],{},"Set",[273,1259,1260],{},"Uint8Array",[273,1262,1263],{},"Buffer",[273,1265,1266],{},"bigint",", tuple, or function fails generation with the reason and the type to declare instead.",[281,1269,1271],{"id":1270},"decorators","Decorators",[1171,1273,1275],{"id":1274},"publishnamespace-name-advertise","@Publish(namespace?, name?, advertise?)",[269,1277,1278,1279,1282,1283,1115,1286,1289,1290,1293,1294,1297,1298,1301,1302,1305],{},"Marks a class for publication. The full service identifier becomes ",[273,1280,1281],{},"namespace.ClassName","; both parts are optional (the name defaults to the class name). The name is an identifier and the namespace a dotted identifier (letters, digits, ",[273,1284,1285],{},"_",[273,1287,1288],{},"$","), which the server checks when the service registers. A service published with no namespace is addressed by its name in its zone, ",[273,1291,1292],{},"srv:\u002F\u002F\u003Czone>~ClassName",", and the platform's service directory names it in its zone's namespace, ",[273,1295,1296],{},"\u003Czone>.ClassName",", so services of the same name in different applications stay apart. Passing ",[273,1299,1300],{},"advertise"," as ",[273,1303,1304],{},"true"," additionally advertises the service in the platform service directory, so it appears in directory listings for browsing and invocation — publishing alone makes a service callable over RPC without listing it.",[1171,1307,1309],{"id":1308},"zonezone","@Zone(zone)",[269,1311,1312,1313,1315],{},"Declares the zone the service is addressable in, relative to the client's ",[273,1314,546],{},". The zone is one or more dot-separated labels of lowercase letters, digits, and interior dashes.",[1171,1317,1319],{"id":1318},"versionversion","@Version(version)",[269,1321,1322,1323,1326],{},"Sets the semantic version for the service in ",[273,1324,1325],{},"X.Y.Z"," format. Callers can pin to a specific version when resolving the service.",[1171,1328,1330],{"id":1329},"scope","@Scope",[269,1332,1333],{},"A getter or method decorator that marks the member providing the scope identifier. Scope targets requests at one specific instance of a service — for example the copy running on a particular node or device.",[286,1335,1337],{"className":288,"code":1336,"language":290,"meta":291,"style":291},"import { Publish, Scope } from '@kinotic-ai\u002Fcore'\n\n@Publish('com.example')\nclass DeviceService {\n    deviceId: string\n\n    @Scope\n    get scope(): string {\n        return this.deviceId\n    }\n\n    constructor(deviceId: string) {\n        this.deviceId = deviceId\n    }\n\n    getStatus(): string {\n        return `Status for device ${this.deviceId}`\n    }\n}\n",[273,1338,1339,1362,1366,1382,1391,1401,1405,1413,1428,1438,1442,1446,1465,1478,1483,1488,1500,1520,1525],{"__ignoreMap":291},[295,1340,1341,1343,1345,1347,1349,1352,1354,1356,1358,1360],{"class":297,"line":298},[295,1342,302],{"class":301},[295,1344,306],{"class":305},[295,1346,310],{"class":309},[295,1348,313],{"class":305},[295,1350,1351],{"class":309}," Scope",[295,1353,319],{"class":305},[295,1355,322],{"class":301},[295,1357,325],{"class":305},[295,1359,329],{"class":328},[295,1361,332],{"class":305},[295,1363,1364],{"class":297,"line":335},[295,1365,339],{"emptyLinePlaceholder":338},[295,1367,1368,1370,1372,1374,1376,1378,1380],{"class":297,"line":342},[295,1369,345],{"class":305},[295,1371,371],{"class":348},[295,1373,352],{"class":309},[295,1375,355],{"class":305},[295,1377,378],{"class":328},[295,1379,355],{"class":305},[295,1381,363],{"class":309},[295,1383,1384,1386,1389],{"class":297,"line":366},[295,1385,389],{"class":388},[295,1387,1388],{"class":392}," DeviceService",[295,1390,396],{"class":305},[295,1392,1393,1396,1398],{"class":297,"line":385},[295,1394,1395],{"class":402},"    deviceId",[295,1397,412],{"class":305},[295,1399,1400],{"class":392}," string\n",[295,1402,1403],{"class":297,"line":399},[295,1404,339],{"emptyLinePlaceholder":338},[295,1406,1407,1410],{"class":297,"line":425},[295,1408,1409],{"class":305},