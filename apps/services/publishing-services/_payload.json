gets a specific scope (e.g., ",[273,1534,1535],{},"device-42","), the platform routes the request to the instance whose ",[273,1538,1455],{}," matches.",[1171,1541,1543],{"id":1542},"context","@Context",[269,1545,1546,1547,1550,1551,1554,1555,1558],{},"A method decorator that marks a method as receiving the request context: a ",[273,1548,1549],{},"ServiceContext"," carrying the calling participant — the same caller a Java service receives as its ",[273,1552,1553],{},"Participant"," parameter — plus whatever a registered ",[273,1556,1557],{},"ContextInterceptor"," adds.",[269,1560,1561,1565],{},[1562,1563,1564],"strong",{},"The context parameter must be the method's final parameter."," Callers never pass it — the platform appends it after the caller-supplied arguments.",[286,1567,1569],{"className":288,"code":1568,"language":290,"meta":291,"style":291},"import { Publish, Context, type ServiceContext } from '@kinotic-ai\u002Fcore'\nimport { isOrganizationParticipant, requireParticipant } from '@kinotic-ai\u002Fmanagement-api'\n\n@Publish('com.example')\nclass OrderService {\n    @Context\n    async listOrders(status: string, context: ServiceContext): Promise\u003COrder[]> {\n        const caller = requireParticipant(context.participant, isOrganizationParticipant)\n        return this.orders.findByOrganization(caller.organizationId, status)\n    }\n}\n",[273,1570,1571,1601,1625,1629,1645,1653,1660,1705,1732,1762,1766],{"__ignoreMap":291},[295,1572,1573,1575,1577,1579,1581,1584,1586,1588,1591,1593,1595,1597,1599],{"class":297,"line":298},[295,1574,302],{"class":301},[295,1576,306],{"class":305},[295,1578,310],{"class":309},[295,1580,313],{"class":305},[295,1582,1583],{"class":309}," Context",[295,1585,313],{"class":305},[295,1587,833],{"class":301},[295,1589,1590],{"class":309}," ServiceContext",[295,1592,319],{"class":305},[295,1594,322],{"class":301},[295,1596,325],{"class":305},[295,1598,329],{"class":328},[295,1600,332],{"class":305},[295,1602,1603,1605,1607,1610,16