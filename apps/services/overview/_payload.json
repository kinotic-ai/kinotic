ecome remotely callable",[281,294,295,298],{},[284,296,297],{},"Discover"," -- The platform automatically registers the service so consumers can reach it by its address",[281,300,301,304,305,309],{},[284,302,303],{},"Call"," -- Other services and frontends invoke methods through ",[306,307,308],"a",{"href":77},"service proxies"," as if they were local",[269,311,312],{},"You don't configure routing, serialization, or service discovery. The platform handles all of that.",[273,314,316],{"id":315},"communication-patterns","Communication Patterns",[269,318,319],{},"Kinotic supports two communication patterns.",[321,322,324],"h3",{"id":323},"request-response","Request-Response",[269,326,327,328,331],{},"Standard RPC. The caller invokes a method and receives a single result as a ",[289,329,330],{},"Promise",".",[333,334,339],"pre",{"className":335,"code":336,"language":337,"meta":338,"style":338},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","const result = await greetingService.hello('World')\n","typescript","",[289,340,341],{"__ignoreMap":338},[342,343,346,350,354,358,362,365,367,371,374,377,381,383],"span",{"class":344,"line":345},"line",1,[342,347,349],{"class":348},"spNyl","const",[342,351,353],{"class":352},"sTEyZ"," result ",[342,355,357],{"class":356},"sMK4o","=",[342,359,361],{"class":360},"s7zQu"," await",[342,363,364],{"class":352}," greetingService",[342,366,331],{"class":356},[342,368,370],{"class":369},"s2Zo4","hello",[342,372,373],{"class":352},"(",[342,375,376],{"class":356},"'",[342,378,380],{"class":379},"sfazB","World",[342,382,376],{"class":356},[342,384,385],{"class":352},")\n",[321,387,80],{"id":388},"streaming",[269,390,391,392,395],{},"The service pushes multiple values over time. The caller receives an ",[289,393,394],{},"Observable"," and can process each value as it arrives.",[333,397,399],{"className":335,"code":398,"language":337,"meta":338,"style":338},"const stream$ = sensorService.streamReadings('sensor-1')\nstream$.subscribe((reading) => console.log(reading))\n",[289,400,401,429],{"__ignoreMap":338},[342,402,403,405,408,410,413,415,418,420,422,425,427],{"class":344,"line":345},[342,404,349],{"class":348},[342,406,407],{"class":352}," stream$ ",[342,409,357],{"class":356},[342,411,412],{"class":352}," sensorService",[342,414,331],{"class":356},[342,416,417],{"class":369},"streamReadings",[342,419,373],{"class":352},[342,421,376],{"class":356},[342,423,424],{"class":379},"sensor-1",[342,426,376],{"class":356},[342,428,385],{"class":352},[342,430,432,435,437,440,442,444,448,451,454,457,459,462],{"class":344,"line":431},2,[342,433,434],{"class":352},"stream$",[342,436,331],{"class":356},[342,438,439],{"class":369},"subscribe",[342,441,373],{"class":352},[342,443,373],{"class":356},[342,445,447],{"class":446},"sHdIc","reading",[342,449,450],{"class":356},")",[342,452,453],{"class":348}," =>",[342,455,456],{"class":352}," console",[342,458,331],{"class":356},[342,460,461],{"class":369},"log",[342,463,464],{"class":352},"(reading))\n",[273,466,468],{"id":467},"service-to-service-calls","Service-to-Service Calls",[269,470,471],{},"Services can call other services transparently. A published service uses a proxy to another service and invokes it the same way any external client would. The platform routes the call without the caller needing to know where the target service is running.",[473,474,475],"style",{},"html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-fon